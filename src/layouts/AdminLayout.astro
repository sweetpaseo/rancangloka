---
import '../styles/global.css';
import { getDb, getSiteSettings } from '../lib/db';

interface Props {
  title?: string;
}

const { title = 'Admin Dashboard' } = Astro.props;

const db = await getDb(Astro.locals);
const siteSettings = await getSiteSettings(db);

const siteTitle = siteSettings.site_title || 'RancangLoka';
const siteFavicon = siteSettings.site_favicon || '🏡';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/admin';

const isActive = (path: string) => {
  const cleanPath = path.replace(/\/$/, '');
  if (cleanPath === '/admin') {
    return currentPath === '/admin';
  }
  if (cleanPath === '/admin/posts') {
    return currentPath === '/admin/posts' || (currentPath.startsWith('/admin/posts/') && !currentPath.includes('/new'));
  }
  return currentPath === cleanPath || currentPath.startsWith(cleanPath + '/');
};

const getNavClass = (path: string) => {
  if (isActive(path)) {
    return 'flex items-center gap-2.5 px-3 py-2 rounded-xl bg-[#0066ee] text-white font-bold shadow-xs text-xs transition';
  }
  return 'flex items-center gap-2.5 px-3 py-2 rounded-xl text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition font-medium text-xs';
};

const getIconClass = (path: string) => {
  return isActive(path) ? 'text-white' : 'text-slate-400';
};
---

<!doctype html>
<html lang="id" class="h-full bg-[#fbfbfd]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | CMS {siteTitle}</title>
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>${siteFavicon}</text></svg>`} />
    <meta name="robots" content="noindex, nofollow" />

    <!-- Google Fonts: Outfit (Display), Plus Jakarta Sans (UI), JetBrains Mono (Technical) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Outfit:wght@500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="h-full text-slate-900 bg-[#fbfbfd] font-sans flex flex-col md:flex-row antialiased">
    <!-- 1. Left Slim Navigation Rail (240px) -->
    <aside class="w-full md:w-60 bg-white border-r border-slate-200/80 flex-shrink-0 flex flex-col justify-between shadow-2xs z-30">
      <div class="flex flex-col flex-1 overflow-y-auto">
        <!-- Brand Header -->
        <a href="/admin" class="h-16 flex items-center px-5 border-b border-slate-100 gap-3 group">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-slate-900 text-white font-outfit font-black text-sm tracking-tight shadow-xs">
            R
          </span>
          <div class="min-w-0">
            <h1 class="font-outfit font-black text-xs text-slate-900 tracking-tight truncate group-hover:text-[#0066ee] transition uppercase">{siteTitle} CMS</h1>
            <span class="text-[9px] font-mono text-emerald-600 font-bold uppercase tracking-wider flex items-center gap-1">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Cloudflare Edge Live
            </span>
          </div>
        </a>

        <!-- Grouped Navigation -->
        <div class="p-3 space-y-5 flex-1">
          <!-- Group 1: Editorial -->
          <div>
            <span class="px-3 text-[10px] font-mono font-bold uppercase tracking-wider text-slate-400 block mb-1.5">
              EDITORIAL
            </span>
            <nav class="space-y-0.5">
              <a href="/admin" class={getNavClass('/admin')}>
                <svg class={`h-4 w-4 ${getIconClass('/admin')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                </svg>
                Overview
              </a>

              <a href="/admin/posts" class={getNavClass('/admin/posts')}>
                <svg class={`h-4 w-4 ${getIconClass('/admin/posts')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
                Artikel & Jurnal
              </a>

              <a href="/admin/posts/new" class={getNavClass('/admin/posts/new')}>
                <svg class={`h-4 w-4 ${getIconClass('/admin/posts/new')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Tulis Artikel Baru
              </a>

              <a href="/admin/import" class={getNavClass('/admin/import')}>
                <svg class={`h-4 w-4 ${getIconClass('/admin/import')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                </svg>
                Import Markdown (.md)
              </a>

              <a href="/admin/pages" class={getNavClass('/admin/pages')}>
                <svg class={`h-4 w-4 ${getIconClass('/admin/pages')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Halaman Statis
              </a>
            </nav>
          </div>

          <!-- Group 2: Research & Data -->
          <div>
            <span class="px-3 text-[10px] font-mono font-bold uppercase tracking-wider text-slate-400 block mb-1.5">
              DATA & AUDIT
            </span>
            <nav class="space-y-0.5">
              <a href="/admin/seo-audit" class={getNavClass('/admin/seo-audit')}>
                <svg class={`h-4 w-4 ${getIconClass('/admin/seo-audit')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
                SEO & CWV Auditor
              </a>

              <a href="/admin/categories" class={getNavClass('/admin/categories')}>
                <svg class={`h-4 w-4 ${getIconClass('/admin/categories')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                </svg>
                Kategori Topik
              </a>

              <a href="/admin/authors" class={getNavClass('/admin/authors')}>
                <svg class={`h-4 w-4 ${getIconClass('/admin/authors')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                Dewan Penulis E-E-A-T
              </a>
            </nav>
          </div>

          <!-- Group 3: System & Vault -->
          <div>
            <span class="px-3 text-[10px] font-mono font-bold uppercase tracking-wider text-slate-400 block mb-1.5">
              SYSTEM & VAULT
            </span>
            <nav class="space-y-0.5">
              <a href="/admin/media" class={getNavClass('/admin/media')}>
                <svg class={`h-4 w-4 ${getIconClass('/admin/media')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                Media Vault (R2)
              </a>

              <a href="/admin/subscribers" class={getNavClass('/admin/subscribers')}>
                <svg class={`h-4 w-4 ${getIconClass('/admin/subscribers')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                Subscribers (CSV)
              </a>

              <a href="/admin/settings" class={getNavClass('/admin/settings')}>
                <svg class={`h-4 w-4 ${getIconClass('/admin/settings')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Pengaturan Situs
              </a>
            </nav>
          </div>
        </div>
      </div>

      <!-- Bottom User & Latency Status -->
      <div class="p-3.5 border-t border-slate-100 bg-slate-50/60">
        <div class="flex items-center justify-between text-[11px] mb-2">
          <div class="flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
            <span class="font-bold text-slate-800">Editor-in-Chief</span>
          </div>
          <span class="font-mono text-[10px] text-slate-400">D1: 5ms</span>
        </div>
        <div class="flex items-center justify-between text-xs pt-1 border-t border-slate-200/60">
          <a href="/" target="_blank" class="text-xs text-[#0066ee] font-bold hover:underline">
            Lihat Web ↗
          </a>
          <a href="/admin/login" class="text-xs text-red-600 font-semibold hover:underline">
            Logout
          </a>
        </div>
      </div>
    </aside>

    <!-- 2. Main Content Area & Top Command Bar -->
    <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
      <!-- Top Command Bar -->
      <header class="h-16 bg-white/90 backdrop-blur-md border-b border-slate-200/80 px-6 sm:px-8 flex items-center justify-between shadow-2xs sticky top-0 z-20">
        <div class="flex items-center gap-3">
          <span class="text-xs font-mono font-bold uppercase text-slate-400 tracking-wider">PANEL CMS</span>
          <span class="text-slate-300 font-mono">/</span>
          <span class="text-sm font-outfit font-bold text-slate-900">{title}</span>
        </div>

        <div class="flex items-center gap-3">
          <div class="hidden sm:flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200/60 text-[10px] font-mono font-bold text-emerald-800">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Cloudflare D1: Connected • 99.4% Cache Hit</span>
          </div>

          <a
            href="/admin/posts/new"
            class="rounded-xl bg-[#0066ee] hover:bg-blue-600 text-white font-outfit font-bold px-3.5 py-1.5 text-xs transition shadow-xs flex items-center gap-1.5"
          >
            <span>+ Buat Artikel</span>
          </a>
        </div>
      </header>

      <div class="p-6 md:p-8 flex-1">
        <slot />
      </div>
    </main>
  </body>
</html>

