---
import '../styles/global.css';
import { getDb, getSiteSettings } from '../lib/db';

interface Props {
  title?: string;
}

const { title = 'Admin Dashboard' } = Astro.props;

const db = await getDb(Astro.locals);
const siteSettings = await getSiteSettings(db);

const siteTitle = siteSettings.site_title || 'RancangLoka';
const siteLogo = siteSettings.site_logo || '';
const siteFavicon = siteSettings.site_favicon || '🏡';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/admin';

const isActive = (path: string) => {
  const cleanPath = path.replace(/\/$/, '');
  if (cleanPath === '/admin') {
    return currentPath === '/admin';
  }
  if (cleanPath === '/admin/posts') {
    return currentPath === '/admin/posts' || currentPath.startsWith('/admin/posts/') && !currentPath.includes('/new');
  }
  return currentPath === cleanPath || currentPath.startsWith(cleanPath + '/');
};

const getNavClass = (path: string) => {
  if (isActive(path)) {
    return 'flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-[#0071e3] text-white font-bold shadow-md shadow-blue-500/20 transition';
  }
  return 'flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition font-medium';
};

const getIconClass = (path: string) => {
  return isActive(path) ? 'text-white' : 'text-slate-400';
};
---

<!doctype html>
<html lang="id" class="h-full bg-slate-50">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | CMS {siteTitle}</title>
    <link rel="icon" href={`data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>${siteFavicon}</text></svg>`} />
    <meta name="robots" content="noindex, nofollow" />
  </head>

  <body class="h-full text-slate-800 bg-slate-50 font-sans flex flex-col md:flex-row">
    <!-- Sidebar -->
    <aside class="w-full md:w-64 bg-white border-r border-slate-200 flex-shrink-0 flex flex-col justify-between shadow-sm">
      <div>
        <!-- Brand Header -->
        <a href="/admin" class="h-16 flex items-center px-6 border-b border-slate-200 gap-3 group">
          {siteLogo ? (
            <img src={siteLogo} alt={siteTitle} class="h-8 max-w-[40px] object-contain flex-shrink-0" />
          ) : (
            <span class="text-2xl">{siteFavicon}</span>
          )}
          <div class="min-w-0">
            <h1 class="font-black text-xs text-slate-900 tracking-tight truncate group-hover:text-primary transition">{siteTitle}</h1>
            <span class="text-[10px] text-emerald-600 font-bold uppercase tracking-wider flex items-center gap-1">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Admin CMS
            </span>
          </div>
        </a>

        <!-- Nav Links -->
        <nav class="p-4 space-y-1 text-sm">
          <a href="/admin" class={getNavClass('/admin')}>
            <svg class={`h-5 w-5 ${getIconClass('/admin')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
            Dashboard
          </a>

          <a href="/admin/posts" class={getNavClass('/admin/posts')}>
            <svg class={`h-5 w-5 ${getIconClass('/admin/posts')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
            Semua Artikel
          </a>

          <a href="/admin/pages" class={getNavClass('/admin/pages')}>
            <svg class={`h-5 w-5 ${getIconClass('/admin/pages')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Halaman (Pages)
          </a>

          <a href="/admin/media" class={getNavClass('/admin/media')}>
            <svg class={`h-5 w-5 ${getIconClass('/admin/media')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Media Library (R2)
          </a>

          <a href="/admin/categories" class={getNavClass('/admin/categories')}>
            <svg class={`h-5 w-5 ${getIconClass('/admin/categories')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
            Kategori Topik
          </a>

          <a href="/admin/authors" class={getNavClass('/admin/authors')}>
            <svg class={`h-5 w-5 ${getIconClass('/admin/authors')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            Penulis (E-E-A-T)
          </a>

          <a href="/admin/posts/new" class={getNavClass('/admin/posts/new')}>
            <svg class={`h-5 w-5 ${getIconClass('/admin/posts/new')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Tulis Artikel Baru
          </a>

          <a href="/admin/import" class={getNavClass('/admin/import')}>
            <svg class={`h-5 w-5 ${getIconClass('/admin/import')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
            </svg>
            Import Markdown (.md)
          </a>

          <a href="/admin/settings" class={getNavClass('/admin/settings')}>
            <svg class={`h-5 w-5 ${getIconClass('/admin/settings')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Pengaturan & Tema
          </a>

          <a href="/admin/backup" class={getNavClass('/admin/backup')}>
            <svg class={`h-5 w-5 ${getIconClass('/admin/backup')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
            </svg>
            Backup Data (JSON)
          </a>
        </nav>
      </div>

      <!-- Bottom User Section -->
      <div class="p-4 border-t border-slate-200 flex items-center justify-between">
        <a href="/" target="_blank" class="text-xs text-primary font-bold hover:underline flex items-center gap-1">
          <span>Lihat Website ↗</span>
        </a>
        <a href="/admin/login" class="text-xs text-red-600 font-semibold hover:underline">
          Logout
        </a>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
      <header class="h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between shadow-2xs">
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold text-slate-500">Panel CMS</span>
          <span class="text-slate-300">/</span>
          <span class="text-xs font-bold text-slate-800">{title}</span>
        </div>
        <div class="flex items-center gap-3">
          <div class="h-8 w-8 rounded-full bg-[#0071e3]/10 text-[#0071e3] flex items-center justify-center font-black text-xs">
            A
          </div>
        </div>
      </header>

      <div class="p-6 md:p-8 flex-1">
        <slot />
      </div>
    </main>
  </body>
</html>
