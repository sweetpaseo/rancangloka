---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import SearchModal from '../components/SearchModal.astro';
import BookmarkDrawer from '../components/BookmarkDrawer.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import type { Category } from '../lib/db';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  preloadImage?: string | { src: string; srcset?: string; sizes?: string };
  categories?: Category[];
  siteSettings?: Record<string, string>;
  isArticlePage?: boolean;
  showMobileBottomNav?: boolean;
  jsonLdSchema?: any;
  noindex?: boolean;
  robotsDirective?: string;
  publishedTime?: string;
  modifiedTime?: string;
  articleAuthor?: string;
  articleSection?: string;
}

const {
  title,
  description,
  ogImage,
  canonicalUrl,
  preloadImage,
  categories = [],
  siteSettings = {},
  isArticlePage = false,
  showMobileBottomNav = false,
  jsonLdSchema,
  noindex = false,
  robotsDirective,
  publishedTime,
  modifiedTime,
  articleAuthor,
  articleSection
} = Astro.props;

const siteTitle = siteSettings.site_title || 'RancangLoka';
const siteFavicon = siteSettings.site_favicon || '🏡';
const fullTitle = title ? `${title} | ${siteTitle}` : `${siteTitle} - ${siteSettings.site_tagline || 'Inspirasi Desain Interior, Arsitektur & Smart Living'}`;
const rawImage = ogImage || siteSettings.seo_default_og_image || 'https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=1200&auto=format&fit=crop&q=80';
const metaImage = rawImage.startsWith('http://') || rawImage.startsWith('https://')
  ? rawImage
  : `${siteSettings.site_url || 'https://rancangloka.com'}${rawImage.startsWith('/') ? '' : '/'}${rawImage}`;
const currentCanonical = canonicalUrl || Astro.url.href;
const metaDesc = description || siteSettings.site_description || 'Inspirasi Desain Interior, Arsitektur & Smart Living';

// Dynamic CSS Variables from Site Settings (Titanium Monochrome & Electric Sapphire)
const primaryColor = siteSettings.theme_primary_color || '#584A18';
const accentColor = siteSettings.theme_accent_color || '#73641E';

// Smart Webmaster Meta Tag Extraction
function cleanMetaCode(raw?: string) {
  if (!raw) return '';
  const trimmed = raw.trim();
  const match = trimmed.match(/content=["']([^"']+)["']/i);
  if (match && match[1]) return match[1].trim();
  if (trimmed.includes('=')) {
    return trimmed.split('=').pop()?.replace(/^["']|["']$/g, '').trim() || trimmed;
  }
  return trimmed;
}

const gscVerificationCode = cleanMetaCode(siteSettings.google_search_console_code);
const bingVerificationCode = cleanMetaCode(siteSettings.bing_webmaster_code);
const customHeadScripts = siteSettings.custom_head_scripts || '';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="generator" content="RancangLoka Custom Publishing Engine 2026" />
    <meta name="author" content="RancangLoka Editorial Team" />
    <meta name="robots" content={noindex || siteSettings.allow_indexing === 'false' ? 'noindex, nofollow, noarchive, nosnippet' : (robotsDirective || 'index, follow, max-image-preview:large')} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%2373641E'/><rect x='8' y='8' width='84' height='84' rx='16' fill='none' stroke='%23F5D95B' stroke-width='6'/><text x='50%' y='68%' font-family='Georgia, serif' font-weight='700' font-size='56' fill='%23FFFDF4' text-anchor='middle'>R</text></svg>" />
    {!noindex && <link rel="canonical" href={currentCanonical} />}
    <link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS Feed`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />

    <!-- Self-Hosted Editorial Typography: Plus Jakarta Sans Variable -->
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- LCP Image Preload Hint for Sub-Second Rendering (Responsive srcset-aware) -->
    {preloadImage && (
      typeof preloadImage === 'string' ? (
        <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
      ) : (
        <link
          rel="preload"
          as="image"
          href={preloadImage.src}
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          fetchpriority="high"
        />
      )
    )}

    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />

    <!-- OpenGraph & Twitter Cards -->
    <meta property="og:type" content={isArticlePage ? 'article' : 'website'} />
    <meta property="og:url" content={currentCanonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:site_name" content={siteTitle} />
    {isArticlePage && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {isArticlePage && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {isArticlePage && articleAuthor && (
      <meta property="article:author" content={articleAuthor} />
    )}
    {isArticlePage && articleSection && (
      <meta property="article:section" content={articleSection} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={metaImage} />

    <!-- Webmaster Verification -->
    {gscVerificationCode && (
      <meta name="google-site-verification" content={gscVerificationCode} />
    )}
    {bingVerificationCode && (
      <meta name="msvalidate.01" content={bingVerificationCode} />
    )}
    {customHeadScripts && (
      <Fragment set:html={customHeadScripts} />
    )}

    <!-- JSON-LD Structured Data Schema -->
    {jsonLdSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLdSchema)} />
    )}

    <!-- Google Analytics (GA4) -->
    {siteSettings.google_analytics_id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${siteSettings.google_analytics_id}`}></script>
        <script define:vars={{ gaId: siteSettings.google_analytics_id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>

  <body class="min-h-screen flex flex-col bg-[var(--canvas)] text-[var(--ink)] font-sans antialiased selection:bg-[#FFF2BF] selection:text-[#584A18]">
    <!-- Header -->
    <Header categories={categories} siteSettings={siteSettings} />

    <!-- Main Content -->
    <main class="flex-1 w-full">
      <slot />
    </main>

    <!-- V2 Footer -->
    <Footer siteTitle={siteTitle} copyright={siteSettings.footer_copyright} />

    <!-- Long-Form Reader Experience Principle:
         "On long-form editorial pages, navigation must not compete with or obscure the content being read."
         Article content is the primary task; navigation is secondary.
         Persistent bottom navigation dock is strictly suppressed on long-form article reading pages.
         Normal site header, search modal, and footer provide complete, unencumbered navigation access. -->
    {showMobileBottomNav && !isArticlePage && (
      <MobileBottomNav isArticlePage={isArticlePage} />
    )}

    <!-- Instant Search Modal -->
    <SearchModal />

    <!-- Bookmark Collection Drawer -->
    <BookmarkDrawer />

    <!-- Photo Lightbox Zoom Modal -->
    <ImageLightbox />

    <!-- Global Theme Switcher Script -->
    <script>
      document.querySelectorAll('.theme-toggle-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      });
    </script>
  </body>
</html>
