---
import Header from '../components/Header.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import SearchModal from '../components/SearchModal.astro';
import type { Category } from '../lib/db';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  categories?: Category[];
  siteSettings?: Record<string, string>;
  isArticlePage?: boolean;
  jsonLdSchema?: any;
}

const {
  title,
  description,
  ogImage,
  canonicalUrl,
  categories = [],
  siteSettings = {},
  isArticlePage = false,
  jsonLdSchema
} = Astro.props;

const siteTitle = siteSettings.site_title || 'METRO MAGAZINE';
const fullTitle = title ? `${title} | ${siteTitle}` : `${siteTitle} - ${siteSettings.site_tagline || 'Wawasan Terdepan'}`;
const metaDesc = description || siteSettings.site_description || 'Platform magazine berita modern dan wawasan masa depan.';
const metaImage = ogImage || siteSettings.seo_default_og_image || 'https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=1200&auto=format&fit=crop&q=80';
const currentCanonical = canonicalUrl || Astro.url.href;

// Dynamic CSS Variables from Site Settings
const primaryColor = siteSettings.theme_primary_color || '#2563eb';
const accentColor = siteSettings.theme_accent_color || '#f59e0b';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="robots" content={siteSettings.allow_indexing === 'false' ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220%22 100 100%22><text y=%22.9em%22 font-size=%2290%22>📰</text></svg>" />
    <link rel="canonical" href={currentCanonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS Feed`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />

    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />

    <!-- OpenGraph & Twitter Cards -->
    <meta property="og:type" content={isArticlePage ? 'article' : 'website'} />
    <meta property="og:url" content={currentCanonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:site_name" content={siteTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={metaImage} />

    <!-- Webmaster Verification -->
    {siteSettings.google_search_console_code && (
      <meta name="google-site-verification" content={siteSettings.google_search_console_code} />
    )}

    <!-- Dynamic Theme Colors Injected into Head (Anti-FOUC) -->
    <style define:vars={{ primaryColor, accentColor }}>
      :root {
        --color-primary: var(--primaryColor);
        --color-accent: var(--accentColor);
      }
    </style>

    <!-- Anti-FOUC Dark Mode Immediate Execution -->
    <script is:inline>
      const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- JSON-LD Structured Data Schema -->
    {jsonLdSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLdSchema)} />
    )}

    <!-- Google Analytics (GA4) -->
    {siteSettings.google_analytics_id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${siteSettings.google_analytics_id}`}></script>
        <script define:vars={{ gaId: siteSettings.google_analytics_id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>

  <body class="min-h-screen flex flex-col pb-16 md:pb-0">
    <!-- Header -->
    <Header categories={categories} siteSettings={siteSettings} />

    <!-- Main Content -->
    <main class="flex-1 mx-auto w-full max-w-7xl px-4 py-6 md:py-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-16 border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-950 py-12 text-slate-500 dark:text-slate-400">
      <div class="mx-auto max-w-7xl px-4 grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="md:col-span-2">
          <span class="font-display text-xl font-black text-slate-900 dark:text-white">{siteTitle}</span>
          <p class="mt-2 text-xs md:text-sm leading-relaxed max-w-sm">
            {siteSettings.site_description || 'Platform media digital masa depan yang didukung komputasi serverless edge Cloudflare.'}
          </p>
        </div>

        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-3">Kategori</h4>
          <ul class="space-y-2 text-xs">
            {categories.map((c) => (
              <li>
                <a href={`/category/${c.slug}`} class="hover:text-primary transition">{c.name}</a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-3">Navigasi</h4>
          <ul class="space-y-2 text-xs">
            <li><a href="/sitemap.xml" class="hover:text-primary transition">Sitemap Index</a></li>
            <li><a href="/rss.xml" class="hover:text-primary transition">RSS Feed</a></li>
            <li><a href="/admin" class="hover:text-primary transition">Admin CMS</a></li>
          </ul>
        </div>
      </div>

      <div class="mx-auto max-w-7xl px-4 mt-8 pt-6 border-t border-slate-200 dark:border-slate-800 text-center text-xs">
        <p>© 2026 {siteTitle}. All rights reserved. Powered 100% by Cloudflare Serverless.</p>
      </div>
    </footer>

    <!-- App-Like Mobile Bottom Nav -->
    <MobileBottomNav isArticlePage={isArticlePage} />

    <!-- Instant Search Modal -->
    <SearchModal />

    <!-- Global Theme Switcher Script -->
    <script>
      document.querySelectorAll('.theme-toggle-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      });
    </script>
  </body>
</html>
