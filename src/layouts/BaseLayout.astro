---
import Header from '../components/Header.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import SearchModal from '../components/SearchModal.astro';
import BookmarkDrawer from '../components/BookmarkDrawer.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import type { Category } from '../lib/db';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  categories?: Category[];
  siteSettings?: Record<string, string>;
  isArticlePage?: boolean;
  jsonLdSchema?: any;
}

const {
  title,
  description,
  ogImage,
  canonicalUrl,
  categories = [],
  siteSettings = {},
  isArticlePage = false,
  jsonLdSchema
} = Astro.props;

const siteTitle = siteSettings.site_title || 'RancangLoka';
const siteFavicon = siteSettings.site_favicon || '🏡';
const fullTitle = title ? `${title} | ${siteTitle}` : `${siteTitle} - ${siteSettings.site_tagline || 'Inspirasi Desain Interior, Arsitektur & Smart Living'}`;
const metaDesc = description || siteSettings.site_description || 'Platform editorial terdepan untuk inspirasi arsitektur modern, desain interior estetik, dan hunian impian di rancangloka.com.';
const metaImage = ogImage || siteSettings.seo_default_og_image || 'https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=1200&auto=format&fit=crop&q=80';
const currentCanonical = canonicalUrl || Astro.url.href;

// Dynamic CSS Variables from Site Settings
const primaryColor = siteSettings.theme_primary_color || '#2563eb';
const accentColor = siteSettings.theme_accent_color || '#f59e0b';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="generator" content="RancangLoka Custom Publishing Engine 2026" />
    <meta name="author" content="RancangLoka Editorial Team" />
    <meta name="robots" content={siteSettings.allow_indexing === 'false' ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='24' fill='%230f172a'/><text x='50%' y='68%' font-family='system-ui, -apple-system, sans-serif' font-weight='900' font-size='62' fill='%23ffffff' text-anchor='middle'>R</text></svg>" />
    <link rel="canonical" href={currentCanonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS Feed`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />

    <!-- Resource Preconnects for Ultra-Fast Asset Delivery -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />

    <!-- Non-Blocking Google Fonts Loading -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap"
      />
    </noscript>

    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />

    <!-- OpenGraph & Twitter Cards -->
    <meta property="og:type" content={isArticlePage ? 'article' : 'website'} />
    <meta property="og:url" content={currentCanonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:site_name" content={siteTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={metaImage} />

    <!-- Webmaster Verification -->
    {siteSettings.google_search_console_code && (
      <meta name="google-site-verification" content={siteSettings.google_search_console_code} />
    )}

    <!-- Dynamic Theme Colors Injected into Head (Anti-FOUC) -->
    <style define:vars={{ primaryColor, accentColor }}>
      :root {
        --color-primary: var(--primaryColor);
        --color-accent: var(--accentColor);
      }
    </style>

    <!-- Anti-FOUC Theme Immediate Execution (Default Elegant Light) -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- JSON-LD Structured Data Schema -->
    {jsonLdSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLdSchema)} />
    )}

    <!-- Google Analytics (GA4) -->
    {siteSettings.google_analytics_id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${siteSettings.google_analytics_id}`}></script>
        <script define:vars={{ gaId: siteSettings.google_analytics_id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>

  <body class="min-h-screen flex flex-col pb-28 md:pb-0">
    <!-- Header -->
    <Header categories={categories} siteSettings={siteSettings} />

    <!-- Main Content with generous breathing room -->
    <main class="flex-1 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-8 md:py-12">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-24 border-t border-black/[0.06] dark:border-white/[0.08] bg-slate-50/70 dark:bg-slate-950 py-16 text-slate-600 dark:text-slate-400">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-5 gap-10">
        <!-- Col 1: Brand & Manifesto (2 cols on md) -->
        <div class="md:col-span-2 space-y-4">
          <div class="flex items-center gap-2.5">
            <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-serif font-bold text-xs tracking-tighter shadow-xs">
              R
            </span>
            <span class="text-xl font-black text-slate-900 dark:text-white tracking-tight font-sans uppercase">{siteTitle}</span>
          </div>
          <p class="text-xs md:text-sm leading-relaxed max-w-sm text-slate-600 dark:text-slate-400 font-normal">
            Jurnal kurasi independen yang mendokumentasikan evolusi arsitektur tropis kontemporer, inovasi materialitas, dan kenyamanan spasial hunian modern.
          </p>

          <!-- Official Social Media Links (Minimalist Text Badges) -->
          <div class="pt-2 flex items-center gap-2">
            {siteSettings.social_instagram && (
              <a href={siteSettings.social_instagram} target="_blank" rel="noopener noreferrer" class="rounded-lg px-2.5 py-1 bg-white dark:bg-slate-900 border border-black/[0.06] dark:border-white/[0.08] text-[11px] font-mono font-bold text-slate-700 dark:text-slate-300 hover:text-[#0071e3] transition shadow-2xs">
                Instagram
              </a>
            )}
            {siteSettings.social_x && (
              <a href={siteSettings.social_x} target="_blank" rel="noopener noreferrer" class="rounded-lg px-2.5 py-1 bg-white dark:bg-slate-900 border border-black/[0.06] dark:border-white/[0.08] text-[11px] font-mono font-bold text-slate-700 dark:text-slate-300 hover:text-[#0071e3] transition shadow-2xs">
                𝕏
              </a>
            )}
            {siteSettings.social_pinterest && (
              <a href={siteSettings.social_pinterest} target="_blank" rel="noopener noreferrer" class="rounded-lg px-2.5 py-1 bg-white dark:bg-slate-900 border border-black/[0.06] dark:border-white/[0.08] text-[11px] font-mono font-bold text-slate-700 dark:text-slate-300 hover:text-[#0071e3] transition shadow-2xs">
                Pinterest
              </a>
            )}
            {siteSettings.social_linkedin && (
              <a href={siteSettings.social_linkedin} target="_blank" rel="noopener noreferrer" class="rounded-lg px-2.5 py-1 bg-white dark:bg-slate-900 border border-black/[0.06] dark:border-white/[0.08] text-[11px] font-mono font-bold text-slate-700 dark:text-slate-300 hover:text-[#0071e3] transition shadow-2xs">
                LinkedIn
              </a>
            )}
          </div>
        </div>

        <!-- Col 2: Categories -->
        <div>
          <h4 class="text-xs font-mono font-bold uppercase tracking-widest text-slate-900 dark:text-white mb-4">Kategori Liputan</h4>
          <ul class="space-y-2.5 text-xs text-slate-600 dark:text-slate-400">
            {categories.map((c) => (
              <li>
                <a href={`/category/${c.slug}`} class="hover:text-[#0071e3] transition text-slate-700 dark:text-slate-300 font-medium">{c.name}</a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Col 3: Static Pages -->
        <div>
          <h4 class="text-xs font-mono font-bold uppercase tracking-widest text-slate-900 dark:text-white mb-4">Halaman & Redaksi</h4>
          <ul class="space-y-2.5 text-xs text-slate-600 dark:text-slate-400">
            <li><a href="/editorial-standards" class="hover:text-[#0071e3] transition text-[#0071e3] font-bold">✦ Standar Editorial & Integritas</a></li>
            <li><a href="/metodologi" class="hover:text-[#0071e3] transition text-[#0071e3] font-bold">✦ Metodologi Riset Spasial</a></li>
            <li><a href="/tentang-kami" class="hover:text-[#0071e3] transition text-slate-700 dark:text-slate-300 font-medium">Tentang RancangLoka</a></li>
            <li><a href="/kontak" class="hover:text-[#0071e3] transition text-slate-700 dark:text-slate-300 font-medium">Hubungi Redaksi</a></li>
            <li><a href="/pedoman-media-siber" class="hover:text-[#0071e3] transition text-slate-700 dark:text-slate-300 font-medium">Pedoman Media Siber</a></li>
            <li><a href="/kebijakan-privasi" class="hover:text-[#0071e3] transition text-slate-700 dark:text-slate-300 font-medium">Kebijakan Privasi</a></li>
          </ul>
        </div>

        <!-- Col 4: Tools & Index -->
        <div>
          <h4 class="text-xs font-mono font-bold uppercase tracking-widest text-slate-900 dark:text-white mb-4">Alat & Riset Ruang</h4>
          <ul class="space-y-2.5 text-xs text-slate-600 dark:text-slate-400">
            <li><a href="/explore" class="hover:text-[#0071e3] transition text-[#0071e3] font-bold">✦ Design Explorer</a></li>
            <li><a href="/solusi" class="hover:text-[#0071e3] transition text-slate-700 dark:text-slate-300 font-medium">Problem Solver</a></li>
            <li><a href="/komparasi" class="hover:text-[#0071e3] transition text-slate-700 dark:text-slate-300 font-medium">Komparasi Material</a></li>
            <li><a href="/sitemap.xml" class="hover:text-[#0071e3] transition text-slate-700 dark:text-slate-300 font-medium">Sitemap Index (XML)</a></li>
            <li><a href="/rss.xml" class="hover:text-[#0071e3] transition text-slate-700 dark:text-slate-300 font-medium">RSS Syndication</a></li>
          </ul>
        </div>
      </div>

      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mt-12 pt-8 border-t border-black/[0.04] dark:border-white/[0.06] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500 dark:text-slate-400 font-mono">
        <p>{siteSettings.footer_copyright || `© 2026 ${siteTitle}. All rights reserved. Kurasi editorial independen.`}</p>
        <span class="text-[11px] text-slate-400">RancangLoka • Jurnal Kurasi Arsitektur & Hunian Tropis</span>
      </div>
    </footer>

    <!-- App-Like Mobile Bottom Nav -->
    <MobileBottomNav isArticlePage={isArticlePage} />

    <!-- Instant Search Modal -->
    <SearchModal />

    <!-- Bookmark Collection Drawer -->
    <BookmarkDrawer />

    <!-- Photo Lightbox Zoom Modal -->
    <ImageLightbox />

    <!-- Global Theme Switcher Script -->
    <script>
      document.querySelectorAll('.theme-toggle-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      });
    </script>
  </body>
</html>
