---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDb, getAllCategories, getSiteSettings } from '../lib/db';

const db = await getDb(Astro.locals);
const [categories, siteSettings] = await Promise.all([
  getAllCategories(db),
  getSiteSettings(db)
]);

const editorialPrinciples = [
  {
    num: '01',
    title: 'Bukti & Presisi di Atas Hype',
    desc: 'Kami menolak klaim sensasional yang tidak berdasar. Setiap ulasan efisiensi energi, performa isolasi akustik, atau spesifikasi material dievaluasi dan diulas berdasarkan prinsip fisika bangunan tropis, standar SNI terkait, dan observasi praktik konstruksi lapangan yang dapat dipertanggungjawabkan.'
  },
  {
    num: '02',
    title: 'Pemisahan Tegas Fotografi Proyek vs Visualisasi Konsep',
    desc: 'Kejujuran visual adalah fondasi kepercayaan. Seluruh dokumentasi spasial di RancangLoka secara eksplisit diberi label: [ Fotografi Proyek Nyata ] untuk karya terbangun, atau [ Visual Study / Konseptual ] untuk studi komparasi rancangan.'
  },
  {
    num: '03',
    title: 'Siklus Pembaruan & Freshness Log',
    desc: 'Dunia material dan regulasi arsitektur selalu bergerak. Kami secara berkala meninjau artikel lawas untuk memperbarui fluktuasi harga material, ketersediaan produk lokal, dan temuan standar ramah lingkungan terbaru.'
  },
  {
    num: '04',
    title: 'Independensi Kurasi & Label Kemitraan',
    desc: 'Rekomendasi material, pemilihan proyek, dan catatan kurasi redaksi murni didasarkan pada keunggulan estetika dan fungsi spasial. Segala bentuk kolaborasi komersial atau kemitraan materialitas akan selalu ditandai secara jelas sebagai [ Kemitraan Kurasi ].'
  },
  {
    num: '05',
    title: 'Apresiasi & Hak Cipta Karya Desainer',
    desc: 'Kami menjunjung tinggi hak cipta intelektual arsitek, desainer interior, fotografer arsitektur, dan perajin material. Setiap publikasi wajib mencantumkan nama perancang, lokasi proyek, serta atribusi fotografer resmi.'
  }
];
---

<BaseLayout
  title="Standar & Integritas Editorial"
  description="Piagam integritas, standar kurasi independen, dan komitmen transparansi dokumentasi arsitektur RancangLoka."
  categories={categories}
  siteSettings={siteSettings}
>
  <div class="mx-auto max-w-4xl py-6 sm:py-10">
    <!-- Header Badge -->
    <div class="text-center space-y-4 mb-16">
      <span class="inline-flex items-center gap-2 rounded-full bg-[#0071e3]/10 dark:bg-[#0071e3]/20 px-4 py-1 text-xs font-mono font-bold uppercase tracking-widest text-[#0071e3]">
        ✦ PIAGAM REDAKSI
      </span>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white leading-tight">
        Standar & Integritas Editorial
      </h1>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal">
        Bagaimana RancangLoka mengkurasi karya, mengevaluasi data materialitas, dan menjaga independensi jurnalisme arsitektur tropis kontemporer.
      </p>
    </div>

    <!-- Manifesto Statement Box -->
    <div class="mb-16 rounded-3xl bg-slate-900 text-white p-8 sm:p-12 shadow-xl border border-slate-800 relative overflow-hidden">
      <div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-blue-500/10 blur-3xl"></div>
      <blockquote class="relative z-10 text-lg sm:text-xl font-serif italic leading-relaxed text-slate-200">
        “Desain yang baik bukan sekadar estetika yang memikat mata di layar kaca, melainkan serangkaian keputusan sadar yang merespons iklim, menghargai kejujuran material, dan meningkatkan kenyamanan ruang penghuninya.”
      </blockquote>
      <div class="mt-6 flex items-center gap-3 text-xs font-mono text-slate-400">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
        <span>RancangLoka Editorial Desk</span>
      </div>
    </div>

    <!-- 5 Core Principles Grid -->
    <div class="space-y-8 mb-20">
      <h2 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight border-b border-black/[0.06] dark:border-white/[0.08] pb-4">
        5 Pilar Integritas Jurnal RancangLoka
      </h2>

      <div class="grid grid-cols-1 gap-6">
        {editorialPrinciples.map((item) => (
          <div class="apple-card p-6 sm:p-8 rounded-3xl border border-black/[0.06] dark:border-white/[0.08] bg-white dark:bg-slate-900 shadow-sm flex flex-col sm:flex-row gap-6 items-start">
            <span class="font-mono text-2xl font-black text-[#0071e3] opacity-60">
              {item.num}
            </span>
            <div class="space-y-2">
              <h3 class="text-lg font-bold text-slate-900 dark:text-white tracking-tight">
                {item.title}
              </h3>
              <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Transparency & Corrections Policy -->
    <div class="rounded-3xl border border-black/[0.06] dark:border-white/[0.08] bg-slate-50/80 dark:bg-slate-900/50 p-8 space-y-4">
      <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <span>✦</span>
        <span>Kebijakan Koreksi & Tanggapan Redaksi</span>
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        Jika Anda menemukan ketidakakuratan data teknis, atribusi kredit desainer yang belum tercantum, atau ingin mengirimkan sanggahan editorial, tim kurasi kami menyambut koreksi terbuka melalui email resmi: <a href="mailto:redaksi@rancangloka.com" class="text-[#0071e3] font-semibold underline underline-offset-2">redaksi@rancangloka.com</a>.
      </p>
    </div>
  </div>
</BaseLayout>
