---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getDb, getAllCategories, getSiteSettings } from '../lib/db';

const db = await getDb(Astro.locals);
const [categories, siteSettings] = await Promise.all([
  getAllCategories(db),
  getSiteSettings(db)
]);

const editorialPrinciples = [
  {
    num: '01',
    title: 'Evidence-First: Bukti & Presisi di Atas Klaim',
    desc: 'Kami menolak klaim bombastis tanpa dasar ilmiah. Setiap ulasan efisiensi energi, performa isolasi termal, atau spesifikasi material diuji berdasarkan prinsip fisika bangunan tropis, standar SNI terkait (seperti SNI 1727:2020), dan dokumentasi teknis pabrikan resmi yang dapat diverifikasi.'
  },
  {
    num: '02',
    title: 'Monetary Silence: Dilarang Mengarang Estimasi Biaya',
    desc: 'Harga material bangunan dan upah tukang bervariasi drastis antar-provinsi dan fluktuatif terhadap rantai pasok. RancangLoka tidak melempar angka estimasi rupiah fiktif demi sensasi klik. Jika data harga disajikan, ia wajib didukung tanggal survei empiris dan batasan wilayah yang jelas.'
  },
  {
    num: '03',
    title: 'Pemisahan Tegas Karya Bangun vs Visualisasi Konsep',
    desc: 'Kejujuran visual adalah fondasi kepercayaan pembaca. Seluruh gambar di RancangLoka secara eksplisit diverifikasi: foto asli proyek terbangun dibedakan secara tegas dari diagram potongan konsep atau ilustrasi pemodelan arsitektur.'
  },
  {
    num: '04',
    title: 'Independensi Kurasi & Label Kemitraan Transparan',
    desc: 'Rekomendasi teknis murni didasarkan pada keunggulan fungsi dan kesesuaian iklim tropis. Jika sebuah artikel merupakan kolaborasi atau ulasan bersponsor, label kemitraan dicantumkan secara transparan tanpa manipulasi editorial.'
  },
  {
    num: '05',
    title: 'Warm Advisory Tone: Berbicara Bahasa Orang Rumah',
    desc: 'Kami tidak menulis untuk membuat penulisnya terkesan pintar, melainkan agar pemilik rumah merasa dirinya sekarang mengerti. Kami menjelaskan trade-off dengan kehangatan konsultan ramah, lalu mengembalikan keputusan akhir secara percaya diri kepada pembaca.'
  }
];

const breadcrumbItems = [
  { name: 'Beranda', url: '/' },
  { name: 'Standar Editorial', url: '/editorial-standards' }
];
---

<BaseLayout
  title="Standar & Integritas Editorial"
  description="Piagam integritas, standar kurasi independen, dan komitmen transparansi dokumentasi arsitektur RancangLoka."
  categories={categories}
  siteSettings={siteSettings}
>
  <div class="editorial-container py-8 md:py-12 max-w-[860px]">
    <!-- 1. Breadcrumbs -->
    <div class="crumb mb-6">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <!-- 2. Header (Atlas T12) -->
    <header class="page-hero mb-8">
      <span class="eyebrow">Piagam Redaksi</span>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-normal text-[var(--ink)] leading-[1.12] my-3">
        Standar & Integritas Editorial
      </h1>
      <p class="text-base sm:text-lg text-[var(--muted)] leading-relaxed">
        Bagaimana RancangLoka menjaga independensi jurnalisme arsitektur, mengevaluasi bukti teknis bangunan, dan melayani kepentingan nyata pemilik rumah di Indonesia.
      </p>
    </header>

    <!-- 3. Manifesto Box (Atlas T12) -->
    <div class="my-8 p-6 sm:p-10 rounded-xl bg-[var(--wash)] border border-[var(--line)]">
      <span class="meta block mb-2">PRINSIP UTAMA</span>
      <blockquote class="font-serif text-lg sm:text-xl text-[var(--ink)] leading-relaxed italic my-2">
        “Media arsitektur dan hunian yang berbicara dengan bahasa orang rumah, tetapi berpikir seperti editor yang paham teknis.”
      </blockquote>
      <p class="text-xs sm:text-sm text-[var(--muted)] mt-4">
        — Dewan Redaksi RancangLoka
      </p>
    </div>

    <!-- 4. Five Core Principles List (Atlas T12) -->
    <section class="my-12 space-y-6">
      <h2 class="font-serif text-2xl text-[var(--ink)] pb-3 border-b border-[var(--line)]">
        5 Pilar Integritas Editorial RancangLoka
      </h2>

      <div class="divide-y divide-[var(--line)]">
        {editorialPrinciples.map((item) => (
          <div class="py-6 grid grid-cols-1 sm:grid-cols-[60px_1fr] gap-4 items-start">
            <span class="font-serif text-2xl font-bold text-[var(--primary)]">
              {item.num}
            </span>
            <div>
              <h3 class="font-serif text-lg sm:text-xl font-bold text-[var(--ink)] mb-2">
                {item.title}
              </h3>
              <p class="text-xs sm:text-sm text-[var(--muted)] leading-relaxed">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. Transparency & Correction Policy -->
    <div class="soft-note my-10">
      <b>Kebijakan Ralat & Transparansi:</b>
      <p class="mt-1 text-xs sm:text-sm">
        Jika Anda menemukan ketidaksesuaian data teknis, nomor standar SNI, atau kesalahan faktual pada kajian kami, hubungi redaksi melalui <a href="/kontak" class="text-[var(--primary)] font-bold hover:underline">Halaman Kontak</a>. Kami berkomitmen memeriksa dan memutakhirkan naskah secara transparan.
      </p>
    </div>
  </div>
</BaseLayout>
