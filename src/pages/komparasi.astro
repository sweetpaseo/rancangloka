---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getDb, getAllCategories, getSiteSettings } from '../lib/db';

const db = await getDb(Astro.locals);
const [categories, siteSettings] = await Promise.all([
  getAllCategories(db),
  getSiteSettings(db)
]);

const breadcrumbItems = [
  { name: 'Beranda', url: '/' },
  { name: 'Komparasi Material', url: '/komparasi' }
];

const comparisons = [
  {
    category: 'PENUTUP ATAP TROPIS',
    title: 'Atap Metal vs Genteng Beton',
    articleUrl: '/perbedaan-atap-metal-dan-genteng-beton-untuk-rumah-tropis',
    summary: 'Perbandingan dua material penutup atap paling umum pada perumahan Indonesia, ditinjau dari berat beban struktur, insulasi panas, dan kekedapan suara saat hujan deras.',
    specs: [
      { label: 'Berat Beban Sendiri (SNI 1727:2020)', itemA: '0,12 – 0,14 kN/m² (Sangat Ringan)', itemB: '0,50 kN/m² (3–4× Lebih Berat)' },
      { label: 'Kemiringan Minimum Standar', itemA: '2° – 3° (Sangat fleksibel)', itemB: '20° – 25° (Memerlukan atap curam)' },
      { label: 'Karakteristik Rambatan Panas', itemA: 'Cepat panas, cepat dingin saat malam', itemB: 'Menyerap panas lambat (thermal lag), melepas panas saat malam' },
      { label: 'Akustik Suara Hujan Deras', itemA: 'Bising jika tanpa insulasi foil/glasswool', itemB: 'Solid dan senyap secara alami' },
      { label: 'Kebutuhan Rangka Atap', itemA: 'Cukup baja ringan profil standar C75', itemB: 'Wajib kuda-kuda kokoh dan reng presisi' }
    ],
    verdictHandoff: 'Pilih atap metal jika denah rumahmu membutuhkan bentang lebar landai dengan struktur baja ringan hemat biaya. Pilih genteng beton jika hunianmu bertingkat di perumahan beratap curam yang mengutamakan kesenyapan akustik dan ketahanan angin kencang.'
  },
  {
    category: 'SISTEM BUKAAN & KUSEN',
    title: 'Kusen Aluminium vs UPVC',
    articleUrl: '/kusen-aluminium-vs-upvc-untuk-rumah-tropis-di-indonesia',
    summary: 'Analisis ketahanan cuaca tropis, risiko jembatan termal (thermal bridge), kekedapan suara akustik, dan perawatan jangka panjang.',
    specs: [
      { label: 'Konduktivitas Termal', itemA: 'Tinggi (Rambatan panas terasa pada profil dalam)', itemB: 'Sangat Rendah (Bahan plastik polimer non-konduktif)' },
      { label: 'Kekedapan Suara Jalan', itemA: 'Standar (Sambungan sekrup mekanis)', itemB: 'Tinggi (Sambungan las mati berongga chamber ganda)' },
      { label: 'Ketahanan Karat & Rayap', itemA: '100% Anti rayap & anti karat', itemB: '100% Anti rayap & tahan uap garam laut' },
      { label: 'Pilihan Ketebalan Kaca', itemA: 'Kaca tunggal 5–8 mm', itemB: 'Kaca ganda (double glazing) hingga 24 mm' },
      { label: 'Kebutuhan Perawatan', itemA: 'Sangat rendah (cukup dilap)', itemB: 'Rendah (perlu cek karet seal berkala)' }
    ],
    verdictHandoff: 'Pilih kusen aluminium untuk fasad modern minimalis berbukaan besar dengan anggaran efisien. Pilih UPVC jika kamar tidurmu berada persis di pinggir jalan raya bising atau ruangan kamar ber-AC penuh yang butuh insulasi termal maksimal.'
  }
];
---

<BaseLayout
  title="Komparasi Material: Atap, Kusen & Spesifikasi Bangunan"
  description="Matriks perbandingan spesifikasi teknis materialitas tropis independen: Atap metal vs genteng beton, kusen aluminium vs UPVC, ditinjau secara empiris."
  categories={categories}
  siteSettings={siteSettings}
>
  <div class="editorial-container py-8 md:py-12">
    <!-- 1. Breadcrumbs -->
    <div class="crumb mb-6">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <!-- 2. Lead Header (Atlas T08) -->
    <header class="page-hero mb-8">
      <span class="eyebrow">Matriks & Komparasi Material</span>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-normal text-[var(--ink)] leading-[1.12] my-3">
        Bandingkan Sebelum Membeli
      </h1>
      <p class="text-base sm:text-lg text-[var(--muted)] leading-relaxed max-w-[720px]">
        Setiap material bangunan membawa keunggulan fisik dan trade-off tertentu. Redaksi RancangLoka menyajikan data spesifikasi obyektif agar kamu bisa memilih dengan percaya diri sesuai prioritas rumahmu.
      </p>
    </header>

    <!-- 3. Comparison Sections (Atlas T08) -->
    <div class="space-y-12 my-10">
      {comparisons.map((comp) => (
        <section class="p-6 sm:p-10 rounded-xl bg-[var(--surface)] border border-[var(--line)] shadow-xs">
          <div class="flex items-center gap-3 mb-2">
            <span class="meta">{comp.category}</span>
            <span class="text-xs text-[var(--muted)]">· Analisis Dua Pilihan Utama</span>
          </div>

          <h2 class="font-serif text-2xl sm:text-3xl font-normal text-[var(--ink)] my-2">
            {comp.title}
          </h2>

          <p class="text-sm sm:text-base text-[var(--muted)] leading-relaxed mb-6 max-w-[760px]">
            {comp.summary}
          </p>

          <!-- Responsive Comparison Matrix Table (Atlas T08) -->
          <div class="overflow-x-auto my-6 border border-[var(--line)] rounded-lg">
            <table class="w-full min-w-[600px] text-left border-collapse text-xs sm:text-sm">
              <thead class="bg-[var(--warm)] border-b border-[var(--line)]">
                <tr>
                  <th class="p-3.5 sm:p-4 font-bold text-[var(--ink)] w-[32%]">Parameter Uji Teknis</th>
                  <th class="p-3.5 sm:p-4 font-bold text-[var(--primary)] w-[34%]">Pilihan A</th>
                  <th class="p-3.5 sm:p-4 font-bold text-[var(--ink)] w-[34%]">Pilihan B</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[var(--line)] bg-white text-[var(--ink)]">
                {comp.specs.map((spec) => (
                  <tr class="hover:bg-[var(--canvas)] transition-colors">
                    <td class="p-3.5 sm:p-4 font-medium text-[var(--muted)]">{spec.label}</td>
                    <td class="p-3.5 sm:p-4">{spec.itemA}</td>
                    <td class="p-3.5 sm:p-4">{spec.itemB}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- Warm Decision Handoff Card (Atlas T08) -->
          <div class="p-5 sm:p-6 rounded-lg bg-[var(--warm)] border border-[var(--line)] mt-6">
            <strong class="font-serif text-sm sm:text-base text-[var(--ink)] block mb-2">
              💡 Serah-Terima Keputusan Redaksi:
            </strong>
            <p class="text-xs sm:text-sm text-[var(--muted)] leading-relaxed mb-4">
              {comp.verdictHandoff}
            </p>
            <a href={comp.articleUrl} class="btn text-xs">
              Baca Kajian Lengkap & Data Rinci →
            </a>
          </div>
        </section>
      ))}
    </div>

    <!-- 4. Monetary Silence & Evidence Reminder -->
    <div class="soft-note my-10">
      <b>Kebijakan Bukti & Monetary Silence:</b>
      <p class="mt-1 text-xs sm:text-sm">
        RancangLoka tidak mencantumkan estimasi harga palsu atau angka perkiraan sepihak. Biaya material bangunan selalu dipengaruhi oleh ongkos kirim regional, jarak gudang distributor, ketebalan profil, dan keahlian tukang di kota Anda.
      </p>
    </div>
  </div>
</BaseLayout>
