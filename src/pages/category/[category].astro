---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getDb, getAllArticles, getAllCategories, getSiteSettings } from '../../lib/db';
import { getResponsiveImageAttrs } from '../../lib/image';

const { category } = Astro.params;
const db = await getDb(Astro.locals);

const [allArticles, categories, siteSettings] = await Promise.all([
  getAllArticles(db, 100, 0, 'published'),
  getAllCategories(db),
  getSiteSettings(db)
]);

// Atlas V2 & HGTV slug aliases to canonical DB category slugs
const CATEGORY_ALIASES: Record<string, string> = {
  'material': 'material-finishing',
  'renovasi': 'arsitektur-renovasi',
  'ruang': 'interior-design',
  'taman-outdoor': 'eksterior-lanskap'
};

const resolvedCategorySlug = (category && CATEGORY_ALIASES[category]) ? CATEGORY_ALIASES[category] : category;

const currentCategory = categories.find((c) => c.slug === resolvedCategorySlug || c.slug === category);
const filteredArticles = allArticles.filter((a) =>
  a.category_slug === resolvedCategorySlug ||
  a.category_slug === category ||
  (currentCategory && a.category_id === currentCategory.id)
);

const breadcrumbItems = [
  { name: 'Beranda', url: '/' },
  { name: currentCategory?.name || 'Kategori', url: `/category/${category}` }
];

function resolveCategoryCardImage(url?: string | null): string | null {
  if (!url || typeof url !== 'string') return null;
  const trimmed = url.trim();
  if (trimmed.length < 5 || trimmed.includes('[object') || trimmed.includes('undefined')) return null;
  if (trimmed.startsWith('/media/') || trimmed.startsWith('https://') || trimmed.startsWith('http://')) {
    return trimmed;
  }
  return null;
}
---

<BaseLayout
  title={`Kategori: ${currentCategory?.name || 'Arsip'}`}
  description={currentCategory?.description || `Kumpulan artikel dan panduan desain seputar ${currentCategory?.name || category}.`}
  categories={categories}
  siteSettings={siteSettings}
>
  <div class="editorial-container py-8 md:py-12">
    <!-- 1. Breadcrumbs -->
    <div class="crumb mb-6">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <!-- 2. Category Hero Lead (Atlas T02) -->
    <header class="page-hero mb-8">
      <span class="eyebrow">Kategori Liputan</span>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-normal text-[var(--ink)] leading-[1.12] my-3">
        {currentCategory?.name || category}
      </h1>
      <p class="text-base sm:text-lg text-[var(--muted)] leading-relaxed max-w-[700px]">
        {currentCategory?.description || 'Kumpulan kajian mendalam, panduan spesifikasi teknis, dan inspirasi ruang yang relevan untuk rumah di Indonesia.'}
      </p>
    </header>

    <!-- 3. Related Category Navigation Chips -->
    <div class="chips my-6">
      <b>Pilihan Kategori:</b>
      {categories.map((c) => (
        <a
          href={`/category/${c.slug}`}
          class={c.slug === category ? 'selected' : ''}
        >
          {c.name}
        </a>
      ))}
      <a href="/solusi" class="text-[var(--primary)] font-bold">✦ Solusi</a>
      <a href="/komparasi">Komparasi</a>
    </div>

    <!-- 4. Articles Grid (Atlas T02 Story Cards) -->
    {filteredArticles.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-10">
        {filteredArticles.map((article) => {
          const imgUrl = resolveCategoryCardImage(article.featured_image);
          const cardAttrs = imgUrl ? getResponsiveImageAttrs(imgUrl, article.image_alt || article.title, { slotType: 'card' }) : null;
          return (
            <a class={`story group ${!cardAttrs ? 'has-no-image' : ''}`} href={`/${article.slug}`} aria-label={article.title}>
              {cardAttrs ? (
                <div class="story-img">
                  <img
                    src={cardAttrs.src}
                    srcset={cardAttrs.srcset}
                    sizes={cardAttrs.sizes}
                    alt={cardAttrs.alt}
                    width={cardAttrs.width}
                    height={cardAttrs.height}
                    loading="lazy"
                    decoding="async"
                    style={cardAttrs.style}
                  />
                </div>
              ) : null}
              <div class="story-pad">
                <span class="meta">{currentCategory?.name || 'ARTIKEL'}</span>
                <h3>{article.title}</h3>
                <p>{article.description || 'Panduan praktis dan teruji untuk kenyamanan rumah tinggal tropis.'}</p>
                <small>{article.reading_time_minutes || 5} menit baca · Redaksi</small>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <!-- Empty State (Atlas T15 compliant) -->
      <div class="my-14 p-10 text-center rounded-lg bg-[var(--warm)] border border-[var(--line)] max-w-lg mx-auto">
        <span class="text-3xl block mb-3">🏡</span>
        <h3 class="font-serif text-xl font-bold text-[var(--ink)] mb-2">
          Belum ada artikel dalam kategori ini
        </h3>
        <p class="text-sm text-[var(--muted)] mb-6">
          Kajian untuk kategori ini sedang disiapkan oleh tim redaksi. Kamu bisa menelusuri kategori lain atau mencari topik spesifik.
        </p>
        <div class="flex justify-center gap-3">
          <a href="/" class="btn">
            ← Beranda
          </a>
          <a href="/explore" class="btn btn-secondary">
            Jelajahi Arsip
          </a>
        </div>
      </div>
    )}
  </div>
</BaseLayout>
