---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getDb, getAllArticles, getAllCategories, getSiteSettings } from '../../lib/db';

const { category } = Astro.params;
const db = await getDb(Astro.locals);

const [allArticles, categories, siteSettings] = await Promise.all([
  getAllArticles(db, 100, 0, 'published'),
  getAllCategories(db),
  getSiteSettings(db)
]);

const currentCategory = categories.find((c) => c.slug === category);
const filteredArticles = allArticles.filter((a) => a.category_slug === category || a.category_id === currentCategory?.id);

const breadcrumbItems = [
  { name: 'Kategori', url: '/' },
  { name: currentCategory?.name || 'Kategori', url: `/category/${category}` }
];
---

<BaseLayout
  title={`Kategori: ${currentCategory?.name || 'Arsip'}`}
  description={currentCategory?.description || `Kumpulan artikel terbaru dalam kategori ${currentCategory?.name || ''}`}
  categories={categories}
  siteSettings={siteSettings}
>
  <div class="max-w-7xl mx-auto">
    <Breadcrumbs items={breadcrumbItems} />

    <!-- Apple-style Category Header Banner -->
    <header class="my-8 rounded-[2rem] bg-slate-950 p-8 sm:p-12 text-white relative overflow-hidden shadow-[0_12px_36px_rgba(0,0,0,0.08)] border border-black/[0.05] dark:border-white/[0.08]">
      <div class="relative z-10 max-w-2xl">
        <span class="rounded-full px-3.5 py-1 text-[11px] font-bold uppercase tracking-wider text-white mb-4 inline-block shadow-2xs" style={`background-color: ${currentCategory?.color_badge || '#059669'};`}>
          Topik Liputan
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
          {currentCategory?.name || category}
        </h1>
        <p class="mt-4 text-sm sm:text-base text-slate-300 leading-relaxed font-normal">
          {currentCategory?.description || 'Telusuri kumpulan wawasan, panduan desain, dan inspirasi mendalam seputar topik ini.'}
        </p>
      </div>
      <div class="absolute -right-12 -bottom-12 h-64 w-64 rounded-full bg-[#0071e3]/20 blur-3xl pointer-events-none"></div>
    </header>

    <!-- Articles Grid -->
    {filteredArticles.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 my-12">
        {filteredArticles.map((article) => (
          <article class="apple-card group flex flex-col overflow-hidden">
            <a href={`/${article.slug}`} class="relative block overflow-hidden aspect-[16/10] bg-slate-100 dark:bg-slate-800">
              <img
                src={article.featured_image}
                alt={article.image_alt || article.title}
                class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-106"
                loading="lazy"
                onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&auto=format&fit=crop&q=80'"
              />
            </a>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-base sm:text-lg font-bold tracking-tight text-slate-900 dark:text-white line-clamp-2 group-hover:text-[#0071e3] transition-colors leading-snug">
                <a href={`/${article.slug}`}>
                  {article.title}
                </a>
              </h3>
              <p class="mt-2.5 text-xs sm:text-sm text-slate-500 dark:text-slate-400 line-clamp-2 flex-1 leading-relaxed">
                {article.description}
              </p>
              <div class="mt-5 flex items-center justify-between text-xs text-slate-400 border-t border-black/[0.04] dark:border-white/[0.06] pt-3.5">
                <span class="font-medium">{article.author_name || 'Redaksi'}</span>
                <span>⏱️ {article.reading_time_minutes} min read</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="my-16 text-center text-slate-500 py-16 border border-dashed border-slate-200 dark:border-slate-800 rounded-3xl bg-white dark:bg-slate-900">
        <p class="text-base font-semibold text-slate-800 dark:text-white">Belum ada artikel di kategori ini.</p>
        <a href="/" class="mt-4 inline-block text-xs text-[#0071e3] font-bold hover:underline">
          ← Kembali ke Beranda
        </a>
      </div>
    )}
  </div>
</BaseLayout>
