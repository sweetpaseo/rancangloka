---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getDb, getAllCategories, getSiteSettings, getAllArticles } from '../lib/db';

const db = await getDb(Astro.locals);
const [categories, siteSettings, articles] = await Promise.all([
  getAllCategories(db),
  getSiteSettings(db),
  getAllArticles(db, 20, 0, 'published')
]);

const activeProblem = Astro.url.searchParams.get('problem') || 'panas';

const problems = [
  {
    id: 'panas',
    icon: '☀️',
    badge: 'IKLIM & SUHU',
    title: 'Rumah Panas & Pengap di Siang dan Sore Hari',
    summary: 'Radiasi matahari sore barat menembus bukaan dan panas terperangkap di bawah plafon atau atap.',
    symptoms: [
      'Dinding barat masih terasa hangat saat disentuh jam 8 malam.',
      'Lantai atas jauh lebih panas dibanding lantai bawah.',
      'Ruang tetap pengap meski kipas angin menyala kencang.'
    ],
    causes: [
      'Bukaan kaca utama menghadap langsung ke lintasan matahari sore tanpa peneduh luar (overhang/shading).',
      'Atap metal atau genteng beton tanpa insulasi termal memadai dan tanpa ventilasi celah bubungan.',
      'Ketiadaan sirkulasi silang (cross-ventilation) sehingga udara panas terjebak di zona atas plafon.'
    ],
    steps: [
      {
        stage: 'Langkah Ringan (Tanpa Bongkar)',
        action: 'Pasang tirai luar / bamboo blind pada sisi luar jendela barat dan buka ventilasi atas saat sore hari.'
      },
      {
        stage: 'Langkah Sedang (Modifikasi Ringan)',
        action: 'Tambahkan louver kisi peneduh luar (secondary skin) dan insulasi aluminium foil bubble di bawah reng atap.'
      },
      {
        stage: 'Renovasi Struktural',
        action: 'Ciptakan bukaan ventilasi silang berhadapan dan buat efek cerobong (stack effect) melalui bukaan void atas.'
      }
    ],
    relevantLinks: [
      { title: 'Perbedaan Atap Metal dan Genteng Beton untuk Rumah Tropis', url: '/perbedaan-atap-metal-dan-genteng-beton-untuk-rumah-tropis' },
      { title: 'Memilih Sistem Shading Luar Rumah Tropis', url: '/memilih-sistem-shading-luar-rumah-tropis' },
      { title: 'Ventilasi Alami Rumah Tropis Tanpa AC', url: '/search?q=ventilasi' }
    ]
  },
  {
    id: 'sempit',
    icon: '📦',
    badge: 'TATA RUANG',
    title: 'Ruangan Terasa Sempit, Padat & Pengap',
    summary: 'Banyak sekat dinding masif yang memecah jarak pandang dan menghalangi aliran cahaya alami.',
    symptoms: [
      'Koridor antar-ruang terasa gelap dan terhimpit.',
      'Barang sehari-hari cepat menumpuk di meja dan lantai.',
      'Ruang tamu dan ruang makan tidak leluasa untuk aktivitas keluarga.'
    ],
    causes: [
      'Terlalu banyak dinding partisi permanen pada denah berdimensi kompak (tipe 36–60).',
      'Plafon standar rendah (2,6 m) tanpa kontinuitas visual vertikal.',
      'Furnitur berdimensi bulky yang memblokir jalur sirkulasi alami manusia.'
    ],
    steps: [
      {
        stage: 'Langkah Ringan',
        action: 'Ganti partisi masif dengan rak buku semi-terbuka dua sisi atau partisi kisi kayu tipis.'
      },
      {
        stage: 'Langkah Sedang',
        action: 'Terapkan konsep open-plan antara ruang duduk, makan, dan pantry untuk memanjangkan poros pandang.'
      },
      {
        stage: 'Renovasi Struktural',
        action: 'Buka void plafon ganda (double height ceiling) di atas area tengah denah untuk kelegaan vertikal.'
      }
    ],
    relevantLinks: [
      { title: 'Eksplorasi Ide & Tata Letak Ruang Keluarga', url: '/category/ruang' },
      { title: 'Panduan Renovasi Rumah Bertahap', url: '/category/renovasi' }
    ]
  },
  {
    id: 'lembab',
    icon: '💧',
    badge: 'REMBES & AIR',
    title: 'Dinding Lembap, Cat Mengelupas & Tempias Hujan',
    summary: 'Air hujan meresap dari sambungan luar atau kelembapan tanah naik ke struktur dinding bawah.',
    symptoms: [
      'Bercak hitam jamur muncul di sudut plafon atau dasar plin dinding.',
      'Bau apek tidak hilang meski ruangan diberi pengharum.',
      'Cat dinding menggelembung dan rontok menjadi serbuk kapur.'
    ],
    causes: [
      'Kemiringan atap terlalu landai sehingga air hujan meluap balik ke celah genteng saat angin kencang.',
      'Kurangnya teritisan atap (overhang) penangkal tempias pada bukaan jendela luar.',
      'Lapisan waterproofing dinding luar retak rambut atau ketiadaan lapisan trasram anti-kapilaritas.'
    ],
    steps: [
      {
        stage: 'Langkah Ringan',
        action: 'Bersihkan jamur dengan cairan fungisida dan perbaiki sirkulasi udara harian dengan membuka jendela pagi hari.'
      },
      {
        stage: 'Langkah Sedang',
        action: 'Tambahkan kanopi tempias minimal 60 cm di atas bukaan dan lapisi dinding luar dengan elastomeric coating.'
      },
      {
        stage: 'Renovasi Struktural',
        action: 'Periksa kemiringan atap (pastikan minimal 20° untuk genteng beton atau gunakan metal sambungan seam untuk atap landai).'
      }
    ],
    relevantLinks: [
      { title: 'Perbedaan Atap Metal dan Genteng Beton (Kemiringan & Risiko Bocor)', url: '/perbedaan-atap-metal-dan-genteng-beton-untuk-rumah-tropis' },
      { title: 'Kusen Aluminium vs UPVC Terhadap Kebocoran Air Tempias', url: '/kusen-aluminium-vs-upvc-untuk-rumah-tropis-di-indonesia' }
    ]
  },
  {
    id: 'bising',
    icon: '🔊',
    badge: 'AKUSTIK & PRIVASI',
    title: 'Kamar Terlalu Bising oleh Suara Jalan & Tetangga',
    summary: 'Gelombang suara frekuensi rendah dan tinggi lolos melalui celah jendela tipis atau dinding tunggal.',
    symptoms: [
      'Suara knalpot motor atau obrolan luar terdengar jelas di tempat tidur.',
      'Suara tetangga tembus melalui dinding kopel perumahan.',
      'Ruang kerja di rumah tidak tenang untuk rapat daring.'
    ],
    causes: [
      'Kusen jendela berongga tanpa seal karet kedap udara (weatherstripping).',
      'Kaca jendela tunggal tipis (3–5 mm) yang bergetar mentransmisikan suara jalan raya.',
      'Ketiadaan peredam lunak pada bidang reflektif kamar (gorden, karpet, panel dinding).'
    ],
    steps: [
      {
        stage: 'Langkah Ringan',
        action: 'Pasang karet seal spons/EPDM di sekeliling daun jendela dan gunakan gorden kain tebal berlapis.'
      },
      {
        stage: 'Langkah Sedang',
        action: 'Ganti kaca jendela dengan kaca laminasi minimal 6 mm atau kusen sistem kedap suara UPVC multi-chamber.'
      },
      {
        stage: 'Renovasi Struktural',
        action: 'Buat dinding ganda partisi gipsum berongga rockwool (air gap 5 cm) pada sisi dinding yang berbatasan langsung.'
      }
    ],
    relevantLinks: [
      { title: 'Kusen Aluminium vs UPVC: Analisa Performa Akustik', url: '/kusen-aluminium-vs-upvc-untuk-rumah-tropis-di-indonesia' },
      { title: 'Kajian Kebisingan Atap Metal Saat Hujan Deras', url: '/perbedaan-atap-metal-dan-genteng-beton-untuk-rumah-tropis' }
    ]
  }
];

const selectedProblemData = problems.find((p) => p.id === activeProblem) || problems[0];

const breadcrumbItems = [
  { name: 'Beranda', url: '/' },
  { name: 'Problem Solver', url: '/solusi' }
];
---

<BaseLayout
  title="Problem Solver: Diagnosa Masalah Hunian Berbasis Bukti"
  description="Identifikasi keluhan rumah: panas, sempit, lembap, atau bising. Kenali akar penyebab fisik dan langkah perbaikan bertahap yang masuk akal."
  categories={categories}
  siteSettings={siteSettings}
>
  <div class="editorial-container py-8 md:py-12">
    <!-- 1. Breadcrumbs -->
    <div class="crumb mb-6">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <!-- 2. Lead Header (Atlas T07) -->
    <header class="page-hero mb-8">
      <span class="eyebrow">Diagnosa & Solusi Hunian</span>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-normal text-[var(--ink)] leading-[1.12] my-3">
        Ada Masalah di Rumahmu?
      </h1>
      <p class="text-base sm:text-lg text-[var(--muted)] leading-relaxed max-w-[720px]">
        Mulai dari gejala fisik yang kamu rasakan sehari-hari. Redaksi RancangLoka menguraikan akar penyebab arsitektural dan panduan solusi bertahap: dari langkah tanpa bongkar hingga renovasi struktural.
      </p>
    </header>

    <!-- 3. Symptom Selector Chips / Choices (Atlas T07) -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 my-8">
      {problems.map((p) => {
        const isActive = p.id === selectedProblemData.id;
        return (
          <a
            href={`/solusi?problem=${p.id}`}
            class={`p-5 rounded-lg border transition text-center block ${
              isActive
                ? 'bg-[var(--wash)] border-[var(--lemon)] shadow-xs'
                : 'bg-[var(--surface)] border-[var(--line)] hover:bg-[var(--warm)]'
            }`}
          >
            <span class="text-3xl block mb-2">{p.icon}</span>
            <strong class="font-serif text-sm sm:text-base text-[var(--ink)] block">
              {p.id === 'panas' && 'Panas & Pengap'}
              {p.id === 'sempit' && 'Ruangan Sempit'}
              {p.id === 'lembab' && 'Dinding Lembap'}
              {p.id === 'bising' && 'Kamar Bising'}
            </strong>
            <span class="text-[11px] text-[var(--muted)] mt-1 block">
              {p.badge}
            </span>
          </a>
        );
      })}
    </div>

    <!-- 4. Active Problem Diagnostic Sheet (Atlas T07) -->
    <section class="my-10 p-6 sm:p-10 rounded-xl bg-[var(--surface)] border border-[var(--line)] shadow-xs">
      <!-- Badge & Title -->
      <div class="flex items-center gap-3 mb-2">
        <span class="meta">{selectedProblemData.badge}</span>
        <span class="text-xs text-[var(--muted)]">· Analisis Gejala Spasial</span>
      </div>

      <h2 class="font-serif text-2xl sm:text-3xl font-normal text-[var(--ink)] leading-snug my-2">
        {selectedProblemData.title}
      </h2>

      <p class="text-base text-[var(--muted)] leading-relaxed mb-8 max-w-[760px]">
        {selectedProblemData.summary}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-6 border-t border-[var(--line)]">
        <!-- Gejala Nyata di Lapangan -->
        <div class="p-5 rounded-lg bg-[var(--warm)] border border-[var(--line)]">
          <strong class="font-serif text-base text-[var(--ink)] block mb-3">
            🔍 Gejala yang Terlihat / Terasa:
          </strong>
          <ul class="space-y-2.5 text-xs sm:text-sm text-[var(--ink)] pl-4 list-disc">
            {selectedProblemData.symptoms.map((sym) => (
              <li class="leading-relaxed">{sym}</li>
            ))}
          </ul>
        </div>

        <!-- Akar Penyebab Teknis -->
        <div class="p-5 rounded-lg bg-[var(--warm)] border border-[var(--line)]">
          <strong class="font-serif text-base text-[var(--ink)] block mb-3">
            ⚙️ Akar Penyebab Arsitektural:
          </strong>
          <ul class="space-y-2.5 text-xs sm:text-sm text-[var(--ink)] pl-4 list-disc">
            {selectedProblemData.causes.map((cause) => (
              <li class="leading-relaxed">{cause}</li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Panduan Langkah Solusi Bertahap -->
      <div class="mt-8 pt-6 border-t border-[var(--line)]">
        <strong class="font-serif text-lg text-[var(--ink)] block mb-4">
          🛠️ Solusi Bertahap yang Masuk Akal:
        </strong>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {selectedProblemData.steps.map((step, idx) => (
            <div class="p-5 rounded-lg border border-[var(--line)] bg-[var(--canvas)]">
              <span class="inline-block text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-[var(--lemon)] text-[var(--deep)] mb-2">
                Tahap {idx + 1}
              </span>
              <h4 class="font-serif text-sm font-bold text-[var(--ink)] mb-2">
                {step.stage}
              </h4>
              <p class="text-xs text-[var(--muted)] leading-relaxed">
                {step.action}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- Rekomendasi Kajian Relevan -->
      {selectedProblemData.relevantLinks.length > 0 && (
        <div class="mt-8 pt-6 border-t border-[var(--line)]">
          <span class="meta block mb-2">BACAAN KAJIAN MENDALAM DARI REDAKSI:</span>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3">
            {selectedProblemData.relevantLinks.map((link) => (
              <a
                href={link.url}
                class="p-4 rounded-lg bg-[var(--warm)] border border-[var(--line)] hover:border-[var(--primary)] transition flex items-center justify-between gap-3 text-xs font-semibold text-[var(--ink)] group"
              >
                <span class="group-hover:text-[var(--primary)] transition-colors">{link.title}</span>
                <span class="text-[var(--primary)] group-hover:translate-x-1 transition-transform">→</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </section>

    <!-- 5. Decision Handoff Footer Note (Warm Advisory Tone) -->
    <div class="soft-note my-10">
      <b>Prinsip Redaksi RancangLoka:</b>
      <p class="mt-1 text-xs sm:text-sm">
        Setiap rumah memiliki orientasi matahari, hembusan angin lokal, dan kondisi fisik yang berbeda. Jangan terburu-buru merombak total sebelum memverifikasi arah datangnya panas atau jalur air hujan di hunianmu.
      </p>
    </div>
  </div>
</BaseLayout>
