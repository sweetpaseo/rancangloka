---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDb, getAllArticles, getAllCategories, getSiteSettings } from '../lib/db';

Astro.response.status = 404;
const db = await getDb(Astro.locals);
const [articles, categories, siteSettings] = await Promise.all([
  getAllArticles(db, 4, 0, 'published'),
  getAllCategories(db),
  getSiteSettings(db)
]);
---

<BaseLayout
  title="404 - Halaman Tidak Ditemukan"
  description="Maaf, halaman atau artikel yang Anda cari tidak ditemukan di RancangLoka."
  categories={categories}
  siteSettings={siteSettings}
>
  <div class="editorial-container py-16 text-center space-y-6 max-w-2xl mx-auto">
    <div class="font-serif text-7xl sm:text-9xl font-black text-lemon tracking-tight select-none">
      404
    </div>

    <h1 class="font-serif text-2xl sm:text-4xl font-bold text-ink">
      Halaman Tidak Ditemukan
    </h1>

    <p class="text-sm sm:text-base text-muted max-w-md mx-auto leading-relaxed">
      Artikel atau halaman yang Anda tuju mungkin telah dipindahkan, direvisi tautannya, atau sedang tidak tersedia dalam indeks kurasi.
    </p>

    <!-- Search Box directly in 404 -->
    <div class="pt-4 max-w-md mx-auto">
      <form action="/search" method="GET" class="flex gap-2">
        <input
          type="text"
          name="q"
          placeholder="Cari artikel, topik, atau solusi..."
          class="flex-1 rounded-full border border-line bg-surface px-4 py-2.5 text-xs text-ink placeholder:text-muted focus:outline-none focus:border-primary"
        />
        <button
          type="submit"
          class="btn bg-primary text-white hover:bg-deep text-xs font-semibold px-5 py-2.5 rounded-full transition"
        >
          Cari
        </button>
      </form>
    </div>

    <div class="pt-2 flex justify-center gap-3">
      <a
        href="/"
        class="inline-flex items-center text-xs font-semibold text-primary hover:text-deep transition underline underline-offset-4"
      >
        ← Kembali ke Beranda Editorial
      </a>
    </div>

    <!-- Recommended Articles -->
    {articles && articles.length > 0 && (
      <div class="mt-16 text-left pt-10 border-t border-line">
        <h2 class="font-serif text-lg font-bold text-ink mb-4">
          Bacaan Rekomendasi Terkini:
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {articles.map((article) => (
            <a
              href={`/${article.slug}`}
              class="flex items-center gap-3 p-3 rounded-lg border border-line bg-surface hover:border-lemon transition"
            >
              <img
                src={article.featured_image || 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=400&auto=format&fit=crop&q=80'}
                alt={article.title}
                class="h-14 w-20 rounded object-cover bg-warm flex-shrink-0"
              />
              <div class="min-w-0">
                <span class="eyebrow block text-meta text-[10px]">{article.category_name}</span>
                <h3 class="font-serif text-xs font-bold text-ink line-clamp-2 mt-0.5">{article.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
