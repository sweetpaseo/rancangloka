---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMagazine from '../components/HeroMagazine.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import DesignIndex from '../components/DesignIndex.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import { getDb, getAllArticles, getAllCategories, getSiteSettings } from '../lib/db';

const db = await getDb(Astro.locals);
const [articles, categories, siteSettings] = await Promise.all([
  getAllArticles(db, 30, 0, 'published'),
  getAllCategories(db),
  getSiteSettings(db)
]);

const featuredArticle = articles.find((a) => a.is_featured === 1) || articles[0];
const secondaryArticles = articles.filter((a) => a.id !== featuredArticle?.id).slice(0, 3);
const heroIds = new Set([featuredArticle?.id, ...secondaryArticles.map((a) => a.id)]);
const latestArticles = articles.filter((a) => !heroIds.has(a.id)).slice(0, 6);

// Exploration by User Intent
const userIntents = [
  { label: 'Rumah Terlalu Panas', link: '/solusi' },
  { label: 'Lahan Sempit 36/60', link: '/solusi' },
  { label: 'Ruang Gelap & Tertutup', link: '/solusi' },
  { label: 'Bising Jalan Raya', link: '/solusi' },
  { label: 'Aluminium vs UPVC', link: '/komparasi' },
  { label: 'Kayu Ulin vs Jati', link: '/komparasi' }
];

// JSON-LD Schema for Website
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteSettings.site_title || 'RancangLoka',
  url: siteSettings.site_url || 'https://rancangloka.com',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteSettings.site_url || 'https://rancangloka.com'}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};
---

<BaseLayout
  title="Jurnal Kurasi Arsitektur, Desain Interior & Spasial Tropis"
  categories={categories}
  siteSettings={siteSettings}
  jsonLdSchema={websiteSchema}
>
  <!-- 1. Hero Magazine: Issue #04 + Cover Story + Curated Reasons -->
  {featuredArticle && (
    <HeroMagazine featuredArticle={featuredArticle} secondaryArticles={secondaryArticles} />
  )}

  <!-- 2. Intent-Based Fast Navigation (User Intent Exploration) -->
  <div class="mb-14 overflow-x-auto no-scrollbar py-3.5 flex items-center gap-3 border-y border-black/[0.05] dark:border-white/[0.08]">
    <span class="flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-widest text-slate-900 dark:text-white whitespace-nowrap pl-1">
      <span class="text-[#0071e3]">✦</span>
      <span>Pencarian Cepat Kebutuhan:</span>
    </span>
    <div class="flex items-center gap-2">
      {userIntents.map((intent) => (
        <a
          href={intent.link}
          class="rounded-full bg-slate-100/90 dark:bg-slate-800/80 hover:bg-[#0071e3] hover:text-white dark:hover:bg-[#0071e3] dark:hover:text-white px-4 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-200 transition border border-black/[0.04] dark:border-white/[0.06] whitespace-nowrap shadow-2xs font-mono"
        >
          {intent.label}
        </a>
      ))}
    </div>
  </div>

  <!-- 3. Latest Stories (6 Clean Editorial Cards without Repetition) -->
  {latestArticles.length > 0 && (
    <section class="my-16">
      <div class="mb-8 flex items-center justify-between border-b border-black/[0.05] dark:border-white/[0.08] pb-4">
        <div>
          <span class="text-[11px] font-mono font-bold uppercase tracking-widest text-[#0071e3] block mb-1">
            ✦ JURNAL SPASIAL TERKINI
          </span>
          <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white">
            Kajian & Kurasi Terbaru
          </h2>
        </div>
        <a
          href="/explore"
          class="text-xs font-mono font-semibold text-[#0071e3] hover:underline flex items-center gap-1.5 group"
        >
          <span>Eksplorasi Seluruh 20 Artikel</span>
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
        {latestArticles.map((art) => (
          <article class="apple-card group flex flex-col h-full overflow-hidden bg-white dark:bg-slate-900/60 rounded-[1.75rem] border border-black/[0.05] dark:border-white/[0.06] hover:border-[#0071e3]/40 transition duration-300">
            <a href={`/${art.slug}`} class="relative block overflow-hidden aspect-[16/10] bg-slate-100 dark:bg-slate-800">
              <img
                src={art.featured_image}
                alt={art.image_alt || art.title}
                class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-105"
                loading="lazy"
                onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&auto=format&fit=crop&q=80'"
              />
              <span
                class="absolute top-3.5 left-3.5 px-3 py-1 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider text-white shadow-md backdrop-blur-md"
                style={`background-color: ${art.category_color || '#0071e3'}ee;`}
              >
                {art.category_name}
              </span>
            </a>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-base sm:text-lg font-bold tracking-tight text-slate-900 dark:text-white group-hover:text-[#0071e3] transition leading-snug line-clamp-2">
                <a href={`/${art.slug}`}>{art.title}</a>
              </h3>
              <p class="mt-2.5 text-xs text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed flex-1 font-normal">
                {art.description}
              </p>
              <div class="mt-5 pt-3.5 border-t border-black/[0.04] dark:border-white/[0.06] flex items-center justify-between text-[11px] font-mono text-slate-500 dark:text-slate-400">
                <span class="font-medium text-slate-700 dark:text-slate-300">{art.author_name}</span>
                <span>⏱️ {art.reading_time_minutes} min</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- 3. Signature Feature: Space Transformed (Before/After with Spatial Metrics) -->
  <section class="my-16 overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 text-white p-8 sm:p-14 shadow-2xl border border-slate-800 relative">
    <div class="pointer-events-none absolute -right-20 -top-20 h-80 w-80 rounded-full bg-blue-500/10 blur-3xl"></div>

    <div class="max-w-3xl mb-8">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1 text-[11px] font-mono font-bold uppercase tracking-widest text-[#0071e3] border border-white/15 mb-3">
        <span>✦</span>
        <span>VISUAL STUDY & REKAYASA SPASIAL</span>
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-white leading-tight">
        Visual Study: Rekayasa Fasad & Pencahayaan Hunian Tropis
      </h2>
      <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed font-normal">
        Komparasi visual konseptual: bagaimana pembongkaran sekat masif, kanopi peneduh, dan bukaan kaca selebar 6 meter melipatgandakan kenyamanan termal dan distribusi cahaya alami.
      </p>

      <!-- Spatial Impact Highlights Bar -->
      <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3 border-t border-white/15 pt-5">
        <div class="space-y-0.5">
          <span class="font-mono text-base font-black text-emerald-400">Optimal</span>
          <span class="block text-[11px] text-slate-400 font-medium">Cahaya Alami Siang Hari</span>
        </div>
        <div class="space-y-0.5">
          <span class="font-mono text-base font-black text-blue-400">+1 Sumbu</span>
          <span class="block text-[11px] text-slate-400 font-medium">Sirkulasi Silang</span>
        </div>
        <div class="space-y-0.5">
          <span class="font-mono text-base font-black text-purple-400">Open-Plan</span>
          <span class="block text-[11px] text-slate-400 font-medium">Persepsi Kelapangan</span>
        </div>
        <div class="space-y-0.5">
          <span class="font-mono text-xs font-bold text-amber-300">Kayu Ulin & Andesit</span>
          <span class="block text-[11px] text-slate-400 font-medium">Palet Materialitas</span>
        </div>
      </div>
    </div>

    <BeforeAfterSlider
      beforeImage="https://images.unsplash.com/photo-1513694203232-719a280e022f?w=1200&auto=format&fit=crop&q=80"
      afterImage="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1200&auto=format&fit=crop&q=80"
      beforeAlt="Visual Studi Kondisi Ruang Sebelum Rekayasa"
      afterAlt="Visual Studi Kondisi Ruang Sesudah Rekayasa"
      beforeLabel="SEBELUM"
      afterLabel="SESUDAH"
      caption="Visual Study Konseptual • Komparasi ilustratif rekayasa bukaan dan pencahayaan"
    />
  </section>

  <!-- 4. The Design & Material Index Component -->
  <DesignIndex />

  <!-- 5. Decision Tools Quick Dock -->
  <section class="my-16 grid grid-cols-1 md:grid-cols-2 gap-6">
    <a
      href="/solusi"
      class="apple-card p-8 rounded-[2rem] border border-black/[0.06] dark:border-white/[0.08] bg-white dark:bg-slate-900 hover:border-[#0071e3]/50 transition group flex flex-col justify-between"
    >
      <div>
        <span class="text-xs font-mono font-bold uppercase tracking-widest text-[#0071e3] block mb-2">
          ✦ ALAT DIAGNOSIS
        </span>
        <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-[#0071e3] transition">
          Design Problem Solver →
        </h3>
        <p class="mt-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
          Mendiagnosis masalah rumah panas, lahan mungil sempit, ruang gelap, atau bising dan menemukan solusi materialitas presisi.
        </p>
      </div>
      <div class="mt-6 pt-4 border-t border-black/[0.04] dark:border-white/[0.06] text-xs font-mono font-semibold text-[#0071e3]">
        Mulai Diagnosis Ruang →
      </div>
    </a>

    <a
      href="/komparasi"
      class="apple-card p-8 rounded-[2rem] border border-black/[0.06] dark:border-white/[0.08] bg-white dark:bg-slate-900 hover:border-[#0071e3]/50 transition group flex flex-col justify-between"
    >
      <div>
        <span class="text-xs font-mono font-bold uppercase tracking-widest text-[#0071e3] block mb-2">
          ✦ MATRIKS OBJEKTIF
        </span>
        <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-[#0071e3] transition">
          Comparison Engine →
        </h3>
        <p class="mt-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
          Perbandingan spesifikasi teknis material: Aluminium vs UPVC, Kayu Ulin vs Louver, dan evaluasi daya tahan tropis.
        </p>
      </div>
      <div class="mt-6 pt-4 border-t border-black/[0.04] dark:border-white/[0.06] text-xs font-mono font-semibold text-[#0071e3]">
        Buka Matriks Komparasi →
      </div>
    </a>
  </section>

  <!-- 6. RancangLoka Weekly Newsletter Product -->
  <NewsletterBox />
</BaseLayout>
