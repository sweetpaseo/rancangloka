---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMagazine from '../components/HeroMagazine.astro';
import CategoryBentoGrid from '../components/CategoryBentoGrid.astro';
import CategoryThreeColGrid from '../components/CategoryThreeColGrid.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import DesignIndex from '../components/DesignIndex.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import { getDb, getAllArticles, getAllCategories, getSiteSettings } from '../lib/db';

const db = await getDb(Astro.locals);
const [articles, categories, siteSettings] = await Promise.all([
  getAllArticles(db, 30, 0, 'published'),
  getAllCategories(db),
  getSiteSettings(db)
]);

const featuredArticle = articles.find((a) => a.is_featured === 1) || articles[0];
const secondaryArticles = articles.filter((a) => a.id !== featuredArticle?.id).slice(0, 3);

// Filter & sort categories configured to appear on homepage
const homeCategories = categories
  .filter((c) => c.show_on_home !== 0)
  .sort((a, b) => (a.display_order || 99) - (b.display_order || 99));

// Architectural focus topics
const focusTopics = [
  'Fasad Tropis',
  'Secondary Skin',
  'Japandi Modern',
  'Void & Skylight',
  'Kayu Ulin',
  'Batu Andesit',
  'Pencahayaan Alami',
  'Renovasi Tipe 36'
];

// JSON-LD Schema for Website
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteSettings.site_title || 'RancangLoka',
  url: siteSettings.site_url || 'https://rancangloka.com',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteSettings.site_url || 'https://rancangloka.com'}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};
---

<BaseLayout
  title="Jurnal Kurasi Arsitektur, Desain Interior & Spasial Tropis"
  categories={categories}
  siteSettings={siteSettings}
  jsonLdSchema={websiteSchema}
>
  <!-- 1. Hero Magazine Section: Full-Bleed Dramatic Feature + Catatan Kurasi Redaksi -->
  {featuredArticle && (
    <HeroMagazine featuredArticle={featuredArticle} secondaryArticles={secondaryArticles} />
  )}

  <!-- 2. Architectural Focus Topic Pills -->
  <div class="mb-14 -mt-6 overflow-x-auto no-scrollbar py-3 flex items-center gap-3 border-y border-black/[0.05] dark:border-white/[0.08]">
    <span class="flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-widest text-slate-900 dark:text-white whitespace-nowrap pl-1">
      <span class="text-[#0071e3]">✦</span>
      <span>Fokus Topik:</span>
    </span>
    <div class="flex items-center gap-2">
      {focusTopics.map((topic) => (
        <a
          href={`/search?q=${encodeURIComponent(topic)}`}
          class="rounded-full bg-slate-100/90 dark:bg-slate-800/80 hover:bg-slate-900 hover:text-white dark:hover:bg-white dark:hover:text-slate-900 px-4 py-1 text-xs font-semibold text-slate-600 dark:text-slate-300 transition border border-black/[0.04] dark:border-white/[0.06] whitespace-nowrap shadow-2xs"
        >
          {topic}
        </a>
      ))}
    </div>
  </div>

  <!-- 3. Dynamic Homepage Category Sections -->
  {homeCategories.map((category) => {
    const categoryArticles = articles.filter((a) => a.category_id === category.id);
    if (categoryArticles.length === 0) return null;

    if (category.layout_style === 'grid3') {
      return <CategoryThreeColGrid category={category} articles={categoryArticles} />;
    }

    // Default to Bento Grid (1 Big + 3 Side Articles)
    return <CategoryBentoGrid category={category} articles={categoryArticles} />;
  })}

  <!-- 4. Signature Feature: Space Transformed (Before/After with Spatial Metrics) -->
  <section class="my-20 overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 text-white p-8 sm:p-14 shadow-2xl border border-slate-800 relative">
    <div class="pointer-events-none absolute -right-20 -top-20 h-80 w-80 rounded-full bg-blue-500/10 blur-3xl"></div>

    <div class="max-w-3xl mb-8">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1 text-[11px] font-mono font-bold uppercase tracking-widest text-[#0071e3] border border-white/15 mb-3">
        <span>✦</span>
        <span>STUDI KASUS TRANSFORMASI RUANG</span>
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-white leading-tight">
        Sebelum & Sesudah: Rekayasa Fasad & Pencahayaan Hunian Tropis
      </h2>
      <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed font-normal">
        Geser garis pembatas untuk melihat bagaimana pembongkaran sekat masif, kanopi gantung, dan bukaan kaca selebar 6 meter melipatgandakan kenyamanan termal dan visual.
      </p>

      <!-- Spatial Impact Metrics Bar -->
      <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3 border-t border-white/15 pt-5">
        <div class="space-y-0.5">
          <span class="font-mono text-lg font-black text-emerald-400">+38%</span>
          <span class="block text-[11px] text-slate-400 font-medium">Cahaya Alami Siang Hari</span>
        </div>
        <div class="space-y-0.5">
          <span class="font-mono text-lg font-black text-blue-400">+1 Sumbu</span>
          <span class="block text-[11px] text-slate-400 font-medium">Sirkulasi Silang</span>
        </div>
        <div class="space-y-0.5">
          <span class="font-mono text-lg font-black text-purple-400">36m² ➔ 55m²</span>
          <span class="block text-[11px] text-slate-400 font-medium">Persepsi Kelapangan Ruang</span>
        </div>
        <div class="space-y-0.5">
          <span class="font-mono text-xs font-bold text-amber-300">Kayu Ulin & Andesit</span>
          <span class="block text-[11px] text-slate-400 font-medium">Palet Materialitas</span>
        </div>
      </div>
    </div>

    <BeforeAfterSlider
      beforeImage="https://images.unsplash.com/photo-1513694203232-719a280e022f?w=1200&auto=format&fit=crop&q=80"
      afterImage="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1200&auto=format&fit=crop&q=80"
      beforeAlt="Kondisi Rumah Sebelum Renovasi"
      afterAlt="Kondisi Rumah Sesudah Renovasi Modern"
      beforeLabel="SEBELUM"
      afterLabel="SESUDAH"
      caption="Proyek Revitalisasi Ruang Keluarga & Fasad Belakang • Geser ke kiri dan kanan"
    />
  </section>

  <!-- 5. The Design & Material Index Component -->
  <DesignIndex />

  <!-- 6. Latest Stories Grid -->
  {articles.length > 0 && (
    <section class="my-20">
      <div class="mb-8 flex items-center justify-between border-b border-black/[0.06] dark:border-white/[0.08] pb-4">
        <div>
          <span class="text-[11px] font-mono font-bold tracking-widest text-[#0071e3] uppercase block mb-1">
            LATEST CURATION
          </span>
          <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white">
            Wawasan Terkini & Dokumentasi Spasial
          </h2>
        </div>
        <span class="text-xs font-mono text-slate-400">Edisi Digital</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {articles.slice(0, 6).map((article) => (
          <article class="apple-card group flex flex-col overflow-hidden rounded-[2rem] border border-black/[0.06] dark:border-white/[0.08] bg-white dark:bg-slate-900 shadow-sm hover:shadow-lg transition duration-500">
            <a href={`/${article.slug}`} class="relative block overflow-hidden aspect-[16/10] bg-slate-100 dark:bg-slate-800">
              <img
                src={article.featured_image}
                alt={article.image_alt || article.title}
                class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-106"
                loading="lazy"
              />
              <span class="absolute top-4 left-4 rounded-full bg-slate-950/70 px-3.5 py-1 text-[10px] font-mono font-bold uppercase tracking-wider text-white backdrop-blur-md border border-white/20">
                {article.category_name || 'Kurasi'}
              </span>
            </a>
            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <h3 class="text-base sm:text-lg font-bold tracking-tight text-slate-900 dark:text-white line-clamp-2 group-hover:text-[#0071e3] transition-colors leading-snug">
                <a href={`/${article.slug}`}>
                  {article.title}
                </a>
              </h3>
              <p class="mt-3 text-xs sm:text-sm text-slate-500 dark:text-slate-400 line-clamp-2 flex-1 leading-relaxed">
                {article.description}
              </p>
              <div class="mt-6 flex items-center justify-between text-xs text-slate-400 border-t border-black/[0.05] dark:border-white/[0.06] pt-4 font-medium">
                <span class="font-semibold text-slate-700 dark:text-slate-300">{article.author_name || 'Tim Kurasi'}</span>
                <span>{article.reading_time_minutes} mnt baca</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- 7. RancangLoka Weekly Content Product (Newsletter) -->
  <NewsletterBox />
</BaseLayout>
