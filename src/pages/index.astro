---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroStory from '../components/HeroStory.astro';
import EditorialCuration from '../components/EditorialCuration.astro';
import ProblemDiscovery from '../components/ProblemDiscovery.astro';
import LatestJournal from '../components/LatestJournal.astro';
import VisualStudy from '../components/VisualStudy.astro';
import MaterialIndex from '../components/MaterialIndex.astro';
import DesignIntelligence from '../components/DesignIntelligence.astro';
import Newsletter from '../components/Newsletter.astro';
import { getDb, getAllArticles, getAllCategories, getSiteSettings } from '../lib/db';

const db = await getDb(Astro.locals);
const [articles, categories, siteSettings] = await Promise.all([
  getAllArticles(db, 30, 0, 'published'),
  getAllCategories(db),
  getSiteSettings(db)
]);

// 1. Featured Cover Story
const featuredArticle = articles.find((a) => a.is_featured === 1) || articles[0];

// 2. Editorial Curation (3 articles)
const remainingAfterHero = articles.filter((a) => a.id !== featuredArticle?.id);
const curationArticles = remainingAfterHero.slice(0, 3);

// 3. Latest Journal (1 + 2 articles)
const remainingAfterCuration = remainingAfterHero.filter((a) => !curationArticles.some((c) => c.id === a.id));
const journalArticles = remainingAfterCuration.slice(0, 3);

// Fallback if database has fewer articles
const safeJournalArticles = journalArticles.length > 0 ? journalArticles : articles.slice(0, 3);

// JSON-LD Schema for Website
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteSettings.site_title || 'RancangLoka',
  url: siteSettings.site_url || 'https://rancangloka.com',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteSettings.site_url || 'https://rancangloka.com'}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};
---

<BaseLayout
  title="Jurnal Kurasi Arsitektur, Desain Interior & Spasial Tropis"
  categories={categories}
  siteSettings={siteSettings}
  jsonLdSchema={websiteSchema}
>
  <div class="px-5 sm:px-8 lg:px-12">
    <!-- 1. Hero / Cover Story (1280px × 650px 2:1 Architecture Monolith) -->
    {featuredArticle && (
      <HeroStory article={featuredArticle} issueTag="ISSUE 04 · SPATIAL STUDY" />
    )}

    <!-- 2. The Editor's Curation (01, 02, 03 Numbered Index) -->
    <EditorialCuration articles={curationArticles.length > 0 ? curationArticles : articles.slice(0, 3)} />

    <!-- 3. What Are You Trying To Solve? (Design Intelligence Diagnostic) -->
    <ProblemDiscovery />

    <!-- 4. Latest Journal (Editorial Asymmetric 1 + 2 Layout) -->
    <LatestJournal articles={safeJournalArticles} />
  </div>

  <!-- 5. Featured Visual Study (Dark Monolith Interruption #11110F) -->
  <VisualStudy
    title="How Architecture Responds to Tropical Climate"
    subtitle="Dokumentasi riset lapangan mengenai orientasi fasad terhadap radiasi matahari siang, efisiensi termal material ulin & batu alam, serta ventilasi silang alami."
    link="/metodologi"
  />

  <div class="px-5 sm:px-8 lg:px-12">
    <!-- 6. Material & Component Directory Index -->
    <MaterialIndex />

    <!-- 7. Design Intelligence Hub (Problem Solver + Material Matrix) -->
    <DesignIntelligence />

    <!-- 8. RancangLoka Weekly Newsletter -->
    <Newsletter />
  </div>
</BaseLayout>
