---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMagazine from '../components/HeroMagazine.astro';
import CategoryBentoGrid from '../components/CategoryBentoGrid.astro';
import CategoryThreeColGrid from '../components/CategoryThreeColGrid.astro';
import { getDb, getAllArticles, getAllCategories, getSiteSettings } from '../lib/db';

const db = await getDb(Astro.locals);
const [articles, categories, siteSettings] = await Promise.all([
  getAllArticles(db, 30, 0, 'published'),
  getAllCategories(db),
  getSiteSettings(db)
]);

const featuredArticle = articles.find((a) => a.is_featured === 1) || articles[0];
const secondaryArticles = articles.filter((a) => a.id !== featuredArticle?.id).slice(0, 3);
const heroIds = new Set([featuredArticle?.id, ...secondaryArticles.map(a => a.id)].filter(Boolean));

// Filter & sort categories configured to appear on homepage
const homeCategories = categories
  .filter((c) => c.show_on_home !== 0)
  .sort((a, b) => (a.display_order || 99) - (b.display_order || 99));

// JSON-LD Schema for Website
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteSettings.site_title || 'Metro Magazine',
  url: siteSettings.site_url || 'https://magazine.pages.dev',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteSettings.site_url || 'https://magazine.pages.dev'}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};
---

<BaseLayout
  title="Berita Terkini & Wawasan Masa Depan"
  categories={categories}
  siteSettings={siteSettings}
  jsonLdSchema={websiteSchema}
>
  <!-- 1. Hero Magazine Section (Top) -->
  {featuredArticle && (
    <HeroMagazine featuredArticle={featuredArticle} secondaryArticles={secondaryArticles} />
  )}

  <!-- 2. Dynamic Homepage Sections based on Admin Category Configuration -->
  {homeCategories.map((category) => {
    const categoryArticles = articles.filter((a) => a.category_id === category.id);
    if (categoryArticles.length === 0) return null;

    if (category.layout_style === 'grid3') {
      return <CategoryThreeColGrid category={category} articles={categoryArticles} />;
    }

    // Default to Bento Grid (1 Big + 3 Side Articles)
    return <CategoryBentoGrid category={category} articles={categoryArticles} />;
  })}

  <!-- 3. Latest Feed Section (Bottom) -->
  {articles.length > 0 && (
    <section class="my-16">
      <div class="mb-7 flex items-center justify-between border-b border-black/[0.05] dark:border-white/[0.08] pb-3.5">
        <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white flex items-center gap-3">
          <span class="h-6 w-2 rounded-full bg-[#0071e3]"></span>
          Kabar Terhangat & Rangkuman Terkini
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {articles.slice(0, 6).map((article) => (
          <article class="apple-card group flex flex-col overflow-hidden">
            <a href={`/${article.slug}`} class="relative block overflow-hidden aspect-[16/10] bg-slate-100 dark:bg-slate-800">
              <img
                src={article.featured_image}
                alt={article.image_alt || article.title}
                class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-106"
                loading="lazy"
              />
              <span class="absolute top-3.5 left-3.5 rounded-full bg-black/60 px-3 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white backdrop-blur-md border border-white/20">
                {article.category_name || 'Artikel'}
              </span>
            </a>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-base sm:text-lg font-bold tracking-tight text-slate-900 dark:text-white line-clamp-2 group-hover:text-[#0071e3] transition-colors leading-snug">
                <a href={`/${article.slug}`}>
                  {article.title}
                </a>
              </h3>
              <p class="mt-2.5 text-xs sm:text-sm text-slate-500 dark:text-slate-400 line-clamp-2 flex-1 leading-relaxed">
                {article.description}
              </p>
              <div class="mt-5 flex items-center justify-between text-xs text-slate-400 border-t border-black/[0.04] dark:border-white/[0.06] pt-3.5">
                <span class="font-medium">{article.author_name || 'Redaksi'}</span>
                <span>⏱️ {article.reading_time_minutes} min read</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
