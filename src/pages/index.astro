---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrendingTopics from '../components/TrendingTopics.astro';
import HeroKompas from '../components/HeroKompas.astro';
import SidebarPopular from '../components/SidebarPopular.astro';
import VisualStudy from '../components/VisualStudy.astro';
import Newsletter from '../components/Newsletter.astro';
import { getDb, getAllArticles, getAllCategories, getSiteSettings } from '../lib/db';

const db = await getDb(Astro.locals);
const [articles, categories, siteSettings] = await Promise.all([
  getAllArticles(db, 30, 0, 'published'),
  getAllCategories(db),
  getSiteSettings(db)
]);

// 1. Hero articles (top 3)
const heroArticles = articles.slice(0, 3);
const heroIds = new Set(heroArticles.map((a) => a.id));

// 2. Feed stream articles
const feedArticles = articles.filter((a) => !heroIds.has(a.id));

// 3. Popular articles (by views or top order)
const popularArticles = [...articles].sort((a, b) => (b.views || 0) - (a.views || 0));

function getFeedThumb(url?: string) {
  if (!url) return 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=360&auto=format&fit=crop&q=70';
  if (url.includes('images.unsplash.com')) {
    return `${url.split('?')[0]}?w=360&auto=format&fit=crop&q=70`;
  }
  return url;
}

// JSON-LD Schema for Website
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteSettings.site_title || 'RancangLoka',
  url: siteSettings.site_url || 'https://rancangloka.com',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteSettings.site_url || 'https://rancangloka.com'}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};
---

<BaseLayout
  title="Jurnal Kurasi Arsitektur, Desain Interior & Spasial Tropis"
  categories={categories}
  siteSettings={siteSettings}
  jsonLdSchema={websiteSchema}
>
  <!-- 1. Topik Pilihan Bar (Kompas.id Style) -->
  <TrendingTopics />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
    <!-- 2. Hero Sorotan Utama Berlatar Gelap (Kompas.id Dark Monolith) -->
    <HeroKompas articles={heroArticles.length > 0 ? heroArticles : articles.slice(0, 3)} />

    <!-- 3. Main 2-Column Layout (Left Stream + Right Sidebar) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 my-10 items-start">
      <!-- Left Column: Article Stream Feed (Col 1-8: 65%) -->
      <main class="lg:col-span-8 space-y-8">
        <!-- Section Header -->
        <div class="flex items-center justify-between pb-3 border-b-2 border-[#003366] dark:border-blue-400">
          <h2 class="font-sans text-base sm:text-lg font-black uppercase tracking-wider text-[#003366] dark:text-blue-400">
            Kajian Terkini
          </h2>
          <a href="/explore" class="text-xs font-bold text-[#003366] dark:text-blue-400 hover:underline flex items-center gap-1">
            <span>Lihat Semua Arsip</span>
            <span>❯</span>
          </a>
        </div>

        <!-- Feed List: Kompas.id Horizontal Cards -->
        <div class="divide-y divide-slate-200 dark:divide-slate-800">
          {feedArticles.map((art) => (
            <article class="py-6 first:pt-0 flex flex-col sm:flex-row gap-5 group">
              <!-- Content Left (60-70%) -->
              <div class="flex-1 flex flex-col justify-between order-2 sm:order-1">
                <div>
                  <div class="flex items-center gap-2 mb-2">
                    <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-slate-800 dark:text-slate-200">
                      {art.category_name || 'ARSITEKTUR'}
                    </span>
                    <span class="text-slate-600 dark:text-slate-400 text-xs">•</span>
                    <span class="text-[11px] font-mono font-medium text-slate-600 dark:text-slate-400">
                      ⏱️ {art.reading_time_minutes || 4} mnt baca
                    </span>
                  </div>

                  <h3 class="font-serif text-lg sm:text-xl font-bold leading-snug text-slate-900 dark:text-white group-hover:text-[#003366] dark:group-hover:text-blue-400 transition mb-2">
                    <a href={`/${art.slug}`}>{art.title}</a>
                  </h3>

                  {art.description && (
                    <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed line-clamp-2 font-normal">
                      {art.description}
                    </p>
                  )}
                </div>

                <div class="mt-4 text-[11px] text-slate-600 dark:text-slate-400 font-mono font-medium flex items-center gap-2">
                  <span>Oleh {art.author_name || 'Dewan Redaksi Spasial'}</span>
                </div>
              </div>

              <!-- Thumbnail Right (30-40%) -->
              <a
                href={`/${art.slug}`}
                class="w-full sm:w-52 h-44 sm:h-32 flex-shrink-0 rounded-lg overflow-hidden bg-slate-100 dark:bg-slate-800 order-1 sm:order-2"
              >
                <img
                  src={getFeedThumb(art.featured_image)}
                  alt={art.title}
                  width="360"
                  height="225"
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            </article>
          ))}
        </div>
      </main>

      <!-- Right Column: Sidebar (Col 9-12: 35%) -->
      <div class="lg:col-span-4">
        <SidebarPopular popularArticles={popularArticles} />
      </div>
    </div>
  </div>

  <!-- 4. Featured Visual Study Monolith -->
  <VisualStudy
    title="Dokumentasi Visual & Riset Spasial Tropis"
    subtitle="Kajian lapangan mengenai performa fasad ulin, efisiensi termal bata ekspos, dan ventilasi silang hunian di Indonesia."
    link="/metodologi"
  />

  <!-- 5. Newsletter Section -->
  <div id="newsletter-section" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <Newsletter />
  </div>
</BaseLayout>
