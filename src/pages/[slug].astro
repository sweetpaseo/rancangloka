---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TableOfContents from '../components/TableOfContents.astro';
import AuthorCard from '../components/AuthorCard.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import SocialShareBar from '../components/SocialShareBar.astro';
import ArticleSupportModule from '../components/ArticleSupportModule.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import EditorialFAQ from '../components/EditorialFAQ.astro';
import { getDb, getPublishedArticleBySlug, getPageBySlug, getRelatedArticles, getInternalLinkCandidates, getAllArticles, getAllCategories, getSiteSettings } from '../lib/db';
import { extractEditorialFaqs, stripFaqCommentMarkers, type EditorialFaqItem } from '../lib/editorial/faq';
import { extractTableOfContents, injectHeadingIds, generateArticleSchema, processArticleContent } from '../lib/seo';
import { getActivePlaneALinks } from '../lib/internal-link/index.ts';
import { sanitizeArticleHtml, renderArticleMarkdownSafely } from '../lib/article/renderer.ts';
import { renderMediaSlotAnchors } from '../lib/media/renderer.ts';
import { getQuarantineRedirect, getArticleRobotsDirective, getArticleXRobotsTag } from '../lib/quarantine';
import { getArticleCacheTags } from '../lib/cache/index.ts';
import { getResponsiveImageAttrs } from '../lib/image';

const { slug } = Astro.params;

// 1. One-hop 301 permanent redirect for quarantined consolidation slugs
const quarantineRedirect = getQuarantineRedirect(slug || '');
if (quarantineRedirect) {
  return Astro.redirect(quarantineRedirect, 301);
}

const db = await getDb(Astro.locals);

let [article, page, categories, siteSettings] = await Promise.all([
  getPublishedArticleBySlug(db, slug || ''),
  getPageBySlug(db, slug || ''),
  getAllCategories(db),
  getSiteSettings(db)
]);

// In local development, allow rendering Batch 1 fixtures (e.g. Article 4 & C) if not seeded in local in-memory DB
if (!article && !page && Boolean((import.meta as any).env?.DEV)) {
  try {
    const { getDevLocalBatch1Article } = await import('../lib/approvals/dev-fixtures.ts');
    const devFixture = await getDevLocalBatch1Article(slug || '');
    if (devFixture) {
      const nowIso = new Date().toISOString();
      article = {
        ...devFixture,
        published_at: devFixture.created_at || nowIso,
        updated_at: devFixture.updated_at || nowIso,
        status: 'published' // Render as published article for local preview
      } as any;
    }
  } catch (err) {
    console.warn('[DEV] Could not load Batch 1 dev fixture for slug:', slug, err);
  }
}

function safeDateIso(dateStr?: string): string {
  if (!dateStr) return new Date().toISOString();
  const d = new Date(dateStr);
  return isNaN(d.getTime()) ? new Date().toISOString() : d.toISOString();
}

function safeDateLocal(dateStr?: string): string {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return isNaN(d.getTime()) || d.getTime() <= 0 ? '' : d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
}


let notFoundArticles: any[] = [];
if (!article && !page) {
  Astro.response.status = 404;
  notFoundArticles = await getAllArticles(db, 4, 0, 'published');
}

const isStaticPage = !article && !!page;
const siteUrl = siteSettings.site_url || 'https://rancangloka.com';

// If Article Page
let relatedArticles: any[] = [];
let planeALinks: any[] = [];
let toc: any[] = [];
let processedHtml = '';
let keyTakeaways: string[] = [];
let jsonLdSchema: any = null;
let breadcrumbItems: any[] = [];
let authorObj: any = null;
let articleFaqs: EditorialFaqItem[] = [];
const robotsDirective = article ? getArticleRobotsDirective(article.slug, siteSettings.allow_indexing) : undefined;
const xRobotsTag = article ? getArticleXRobotsTag(article.slug, siteSettings.allow_indexing) : null;
if (xRobotsTag) {
  Astro.response.headers.set('X-Robots-Tag', xRobotsTag);
}

// Compute Responsive Cover Image Attributes & LCP Preload
const articleCoverAttrs = article?.featured_image
  ? getResponsiveImageAttrs(article.featured_image, article.image_alt || article.title, { slotType: 'article-cover', isPriority: true })
  : null;
const lcpPreload = articleCoverAttrs ? { src: articleCoverAttrs.src, srcset: articleCoverAttrs.srcset, sizes: articleCoverAttrs.sizes } : undefined;

if (article) {
  articleFaqs = extractEditorialFaqs(article);
  const [fetchedRelated, internalLinkCandidates, fetchedPlaneALinks] = await Promise.all([
    getRelatedArticles(db, article.id, article.category_id, 8, {
      focusKeyword: article.focus_keyword,
      title: article.title,
      slug: article.slug,
      description: article.description
    }),
    getInternalLinkCandidates(db, 50),
    getActivePlaneALinks(db, article.id).catch(() => [])
  ]);
  planeALinks = fetchedPlaneALinks || [];

  // Surface deduplication across Plane A, BACA JUGA, and RelatedArticles footer
  const planeATargetIds = new Set(planeALinks.map((l: any) => l.target_article_id));
  const candidateRelated = (fetchedRelated || []).filter((art: any) => !planeATargetIds.has(art.id));
  const bacaJugaArticle = candidateRelated.length > 0 ? candidateRelated[0] : null;
  relatedArticles = candidateRelated.filter((art: any) => !bacaJugaArticle || art.id !== bacaJugaArticle.id).slice(0, 3);

  // Content Protection 1A: Derive deterministic cache tags and edge cache policy
  const cacheTags = getArticleCacheTags(article, { activePlaneALinks: planeALinks });
  Astro.response.headers.set('Cache-Tag', cacheTags.join(', '));
  Astro.response.headers.set('Cache-Control', 'public, max-age=60');
  Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'public, max-age=3600, stale-while-revalidate=86400');

  let rawContentHtml = stripFaqCommentMarkers(article.content_html || '');
  const hasLeakedMetadata =
    rawContentHtml.includes('title:') &&
    (rawContentHtml.includes('slug:') || rawContentHtml.includes('focus_keyword:') || rawContentHtml.includes('key_takeaways:')) &&
    /<(?:h[1-6]|p|blockquote|div)[^>]*>[\s\S]*?title:[\s\S]*?<\/(?:h[1-6]|p|blockquote|div)>/i.test(rawContentHtml);

  const isMalformedHtml =
    !rawContentHtml ||
    typeof rawContentHtml !== 'string' ||
    rawContentHtml.trim() === '[object Object]' ||
    rawContentHtml.trim().length < 50 ||
    hasLeakedMetadata;

  if (isMalformedHtml && article.content_md) {
    rawContentHtml = stripFaqCommentMarkers(await renderArticleMarkdownSafely(article.content_md));
  }


  const safeArticleHtml = await renderMediaSlotAnchors(db, article.id, sanitizeArticleHtml(rawContentHtml), {
    articleSlug: article.slug,
    contentMd: article.content_md,
    manifest: article.visual_manifest,
    autoLoadManifest: true,
    isDev: false,
    allowUnapprovedInPreview: false
  });
  toc = extractTableOfContents(safeArticleHtml);
  processedHtml = processArticleContent(
    safeArticleHtml,
    article,
    internalLinkCandidates,
    bacaJugaArticle,
    siteSettings,
    toc
  );

  // Enforce single semantic H1 on page:
  // Strips any duplicate H1 from rendered markdown body without altering canonical DB markdown or hash
  processedHtml = processedHtml.replace(/<h1[^>]*>[\s\S]*?<\/h1>/i, '');

  // Normalize comparison card headings (h4 -> h3) for accessibility heading hierarchy compliance
  processedHtml = processedHtml.replace(/<h4(\s+class="font-display[^"]*")/gi, '<h3$1').replace(/<\/h4>/gi, '</h3>');
  processedHtml = processedHtml.replace(/text-slate-400(\s+dark:text-slate-500">[\s\S]*?Karakteristik Lainnya)/gi, 'text-slate-600$1');

  if (article.key_takeaways) {
    try {
      keyTakeaways = JSON.parse(article.key_takeaways);
    } catch (e) {}
  }

  authorObj = {
    name: article.author_name,
    avatar: article.author_avatar,
    role: article.author_role,
    slug: article.author_slug || (article.author_name ? article.author_name.toLowerCase().replace(/\s+/g, '-') : 'redaksi')
  };
  jsonLdSchema = generateArticleSchema(article, siteUrl, authorObj, siteSettings);

  breadcrumbItems = [
    { name: article.category_name || 'Artikel', url: `/category/${article.category_slug || 'all'}` },
    { name: article.title, url: `/${article.slug}` }
  ];
} else if (page) {
  const safePageHtml = sanitizeArticleHtml(page.content_html);
  processedHtml = injectHeadingIds(safePageHtml);
  breadcrumbItems = [
    { name: 'Beranda', url: '/' },
    { name: page.title, url: `/${page.slug}` }
  ];
}
---

{(!article && !page) ? (
  <BaseLayout
    title="404 - Halaman Tidak Ditemukan"
    description="Maaf, halaman atau artikel yang Anda cari tidak ditemukan."
    categories={categories}
    siteSettings={siteSettings}
  >
    <div class="max-w-3xl mx-auto my-16 text-center space-y-6">
      <div class="inline-flex h-24 w-24 items-center justify-center rounded-3xl bg-primary/10 text-primary text-5xl">
        📰
      </div>

      <h1 class="font-display text-4xl md:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        404: Halaman Tidak Ditemukan
      </h1>

      <p class="text-base text-slate-600 dark:text-slate-400 max-w-md mx-auto">
        Artikel yang Anda tuju mungkin telah dipindahkan, diubah tautannya, atau sedang tidak tersedia.
      </p>

      <!-- Search Button -->
      <div class="pt-2 flex justify-center gap-3">
        <button
          data-search-trigger
          class="rounded-xl bg-primary px-6 py-3 text-sm font-bold text-white hover:bg-primary-hover transition shadow-lg shadow-primary/20 flex items-center gap-2"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Cari Artikel Lain
        </button>

        <a
          href="/"
          class="rounded-xl bg-slate-100 dark:bg-slate-800 px-6 py-3 text-sm font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition"
        >
          Ke Beranda
        </a>
      </div>

      <!-- Recommended Articles -->
      {notFoundArticles.length > 0 && (
        <div class="mt-16 text-left pt-12 border-t border-slate-200 dark:border-slate-800">
          <h2 class="text-base font-bold text-slate-900 dark:text-white mb-4">
            Rekomendasi Berita Populer untuk Anda:
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {notFoundArticles.map((art) => (
              <a
                href={`/${art.slug}`}
                class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900 hover:shadow-sm transition"
              >
                <img src={art.featured_image} alt={art.title} class="h-12 w-16 rounded-lg object-cover bg-slate-800 flex-shrink-0" />
                <div class="min-w-0">
                  <span class="text-[10px] font-bold text-primary uppercase">{art.category_name}</span>
                  <h3 class="text-xs font-bold text-slate-900 dark:text-white line-clamp-1">{art.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </BaseLayout>
) : (
  <BaseLayout
    title={article ? article.title : page!.title}
    description={article ? article.description : page!.description}
    ogImage={article ? article.featured_image : page!.featured_image || siteSettings.seo_default_og_image}
    canonicalUrl={`${siteUrl}/${article ? article.slug : page!.slug}`}
    preloadImage={lcpPreload}
    categories={categories}
    siteSettings={siteSettings}
    isArticlePage={!isStaticPage}
    jsonLdSchema={jsonLdSchema}
    robotsDirective={robotsDirective}
    publishedTime={article && article.published_at ? new Date(article.published_at).toISOString() : undefined}
    modifiedTime={article && (article.updated_at || article.published_at) ? new Date(article.updated_at || article.published_at).toISOString() : undefined}
    articleAuthor={article ? (authorObj.slug ? `${siteUrl}/author/${authorObj.slug}` : `${siteUrl}/author/redaksi`) : undefined}
    articleSection={article?.category_name}
  >
  <!-- Dynamic Reading Progress Bar (Top) -->
  <div id="reading-progress" class="fixed top-0 left-0 h-1 bg-[var(--lemon)] z-50 transition-all duration-100 ease-out" style="width: 0%;"></div>

  <!-- 🅰️ RENDER AS STATIC PAGE -->
  {isStaticPage && page && (
    <div class="editorial-container max-w-[900px] py-8">
      <div class="crumb mb-6">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <header class="mb-8 border-b border-[var(--line)] pb-6">
        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-normal text-[var(--ink)] leading-[1.15]">
          {page.title}
        </h1>
        {page.description && (
          <p class="mt-4 text-base sm:text-lg text-[var(--muted)] leading-relaxed">
            {page.description}
          </p>
        )}
      </header>

      {page.featured_image && (
        <div class="my-8 overflow-hidden rounded-lg bg-[var(--warm)] aspect-[16/10] border border-[var(--line)]">
          <img src={page.featured_image} alt={page.title} class="h-full w-full object-cover" />
        </div>
      )}

      <!-- Page Content -->
      <div class="prose-magazine text-[var(--ink)] mt-6" set:html={processedHtml} />

      <!-- Interactive Contact Form for template === 'contact' (Atlas T10) -->
      {page.template === 'contact' && (
        <div class="mt-10 rounded-lg bg-[var(--warm)] border border-[var(--line)] p-6 sm:p-8">
          <h3 class="font-serif text-xl font-bold text-[var(--ink)] mb-2">
            Kirim Pesan ke Redaksi
          </h3>
          <p class="text-xs text-[var(--muted)] mb-6">Tim redaksi RancangLoka akan merespons pesan Anda dalam 1x24 jam kerja.</p>

          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-[var(--ink)] mb-1">Nama Lengkap</label>
                <input type="text" required placeholder="Nama Anda" class="w-full rounded border border-[var(--line)] bg-white px-3.5 py-2.5 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--primary)]" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-[var(--ink)] mb-1">Alamat Email</label>
                <input type="email" required placeholder="email@domain.com" class="w-full rounded border border-[var(--line)] bg-white px-3.5 py-2.5 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--primary)]" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-[var(--ink)] mb-1">Subjek Pesan</label>
              <input type="text" required placeholder="Topik: Kemitraan Media / Rilis Karya / Pertanyaan Teknis" class="w-full rounded border border-[var(--line)] bg-white px-3.5 py-2.5 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--primary)]" />
            </div>

            <div>
              <label class="block text-xs font-semibold text-[var(--ink)] mb-1">Isi Pesan</label>
              <textarea rows="4" required placeholder="Tuliskan pesan atau pertanyaan Anda di sini..." class="w-full rounded border border-[var(--line)] bg-white p-3.5 text-xs text-[var(--ink)] focus:outline-none focus:border-[var(--primary)]"></textarea>
            </div>

            <button type="submit" class="btn">
              Kirim Pesan Sekarang ↗
            </button>
          </form>
        </div>
      )}
    </div>
  )}

  <!-- 🅱️ RENDER AS MAGAZINE ARTICLE -->
  {!isStaticPage && article && (

  <article class="editorial-container max-w-[1080px] py-8">
    <!-- 1. Breadcrumbs -->
    <div class="crumb mb-6">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <!-- 2. Editorial Article Header (Atlas T05) -->
    <header class="mb-8 max-w-[830px]">
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <span class="eyebrow">{article.category_name || 'ARSITEKTUR & HUNIAN'}</span>
        {article.is_sponsored === 1 && (
          <span class="border border-[var(--primary)] px-2 py-0.5 text-[10px] font-bold text-[var(--primary)] uppercase tracking-wider rounded">
            ✦ SPONSORED
          </span>
        )}
      </div>

      <h1 class="font-sans text-3xl sm:text-4xl md:text-[42px] font-bold text-[var(--ink)] leading-[1.15] tracking-tight my-4">
        {article.title}
      </h1>

      {article.description && (
        <p class="text-base sm:text-lg text-[var(--muted)] leading-relaxed max-w-[760px] mb-6">
          {article.description}
        </p>
      )}

      <!-- Author and Metadata Byline (Atlas T05) -->
      <div class="flex flex-wrap items-center justify-between gap-4 py-3.5 border-y border-[var(--line)] text-xs text-[var(--muted)]">
        <div class="flex items-center gap-3">
          <img
            src={article.author_avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=120&auto=format&fit=crop&q=80'}
            alt={article.author_name || 'Redaksi'}
            class="h-9 w-9 rounded-full object-cover border border-[var(--line)]"
          />
          <div>
            <span class="font-bold text-[var(--ink)] block">{article.author_name || 'Dewan Redaksi'}</span>
            <span class="text-[11px] text-[var(--muted)]">{article.author_role || 'Editor Spesifikasi & Desain'}</span>
          </div>
        </div>

        <div class="flex items-center gap-3 sm:gap-4 text-[11px]">
          <span>⏱️ {article.reading_time_minutes || 5} menit baca</span>
          <span>·</span>
          <div>
            Diterbitkan <time itemprop="datePublished" datetime={safeDateIso(article.published_at)}>{safeDateLocal(article.published_at)}</time>
          </div>
          {article.updated_at && article.published_at && (new Date(article.updated_at).getTime() - new Date(article.published_at).getTime() > 60000) && (
            <span class="hidden sm:inline">
              (Diperbarui <time itemprop="dateModified" datetime={safeDateIso(article.updated_at)}>{safeDateLocal(article.updated_at)}</time>)
            </span>
          )}
        </div>
      </div>
    </header>

    <!-- 3. Featured Cover Image (Atlas T05) -->
    {article.featured_image && (
      <figure class="my-8 rounded-lg overflow-hidden border border-[var(--line)] bg-[var(--warm)] max-w-[1000px]">
        {articleCoverAttrs ? (
          <img
            src={articleCoverAttrs.src}
            srcset={articleCoverAttrs.srcset}
            sizes={articleCoverAttrs.sizes}
            alt={articleCoverAttrs.alt}
            width={articleCoverAttrs.width}
            height={articleCoverAttrs.height}
            class="w-full max-h-[520px] object-cover"
            fetchpriority="high"
            loading="eager"
            decoding="async"
            style={articleCoverAttrs.style}
          />
        ) : (
          <img
            src={article.featured_image}
            alt={article.image_alt || article.title}
            class="w-full max-h-[520px] object-cover"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />
        )}
        {(article.image_alt || article.title) && (
          <figcaption class="p-3 text-xs text-[var(--muted)] bg-[var(--warm)] border-t border-[var(--line)] text-center">
            {article.image_alt || article.title}
          </figcaption>
        )}
      </figure>
    )}

    <!-- 4. Main Editorial Layout: Prose + Sticky Aside (Atlas T05) -->
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,740px)_250px] gap-10 justify-center mt-8">
      <!-- Left Column: Core Reading Body -->
      <div class="min-w-0">
        <!-- Key Takeaways Box (if available) -->
        {article.description && (
          <div class="soft-note mb-8">
            <b>Ringkasan Utama:</b>
            <p class="mt-1 text-sm">{article.description}</p>
          </div>
        )}

        <!-- Main Prose Article Body (With In-Article TOC, Dateline, and BACA JUGA) -->
        <div id="article-body" class="prose-magazine text-[var(--ink)]" set:html={processedHtml} />

        <!-- Optional Contextual Editorial FAQ (Zero markup if unapproved/empty) -->
        <EditorialFAQ faqs={articleFaqs} />

        <!-- Plane A Dynamic Support Module -->
        <ArticleSupportModule links={planeALinks} />

        <!-- Social Share Bar -->
        <SocialShareBar title={article.title} siteSettings={siteSettings} />

        <!-- E-E-A-T Author Card -->
        <AuthorCard
          authorName={article.author_name}
          authorAvatar={article.author_avatar}
          authorRole={article.author_role}
        />

      </div>

      <!-- Right Column: Sticky Aside with Table of Contents & Quick Action (Atlas T05) -->
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-6">
          {toc && toc.length >= 2 && (
            <div class="p-5 rounded-lg bg-[var(--warm)] border border-[var(--line)]">
              <strong class="font-serif text-sm text-[var(--ink)] block mb-3 pb-2 border-b border-[var(--line)]">
                Daftar Isi Kajian
              </strong>
              <nav class="space-y-2 text-xs" aria-label="Daftar Isi">
                {toc.map((item) => (
                  <a
                    href={`#${item.id}`}
                    class={`block text-[var(--muted)] hover:text-[var(--primary)] transition-colors ${
                      item.level === 3 ? 'pl-3 text-[11px]' : 'font-medium'
                    }`}
                  >
                    {item.text}
                  </a>
                ))}
              </nav>
            </div>
          )}

          <!-- Quick Action Card -->
          <div class="p-5 rounded-lg bg-white border border-[var(--line)] text-xs text-[var(--muted)] space-y-3 shadow-xs">
            <span class="meta block">SIMPAN & BAGIKAN</span>
            <p class="text-[11px] leading-relaxed">
              Simpan kajian ini untuk referensi saat renovasi atau konsultasi dengan tukang.
            </p>
            <button
              id="article-bookmark-btn"
              type="button"
              class="w-full btn btn-secondary text-center justify-center text-xs"
              data-slug={article.slug}
              data-title={article.title}
              data-image={article.featured_image}
              data-category={article.category_name}
            >
              <span>🔖</span>
              <span id="bookmark-btn-text">Simpan Inspirasi</span>
            </button>
          </div>
        </div>
      </aside>
    </div>
  </article>

  <!-- 8. Full-Width Breakout Related Articles Grid (Organik Only) -->
  {article.is_sponsored !== 1 && relatedArticles.length > 0 && (
    <RelatedArticles articles={relatedArticles} />
  )}

  <!-- 9. Next Action Loop / Decision Conversion CTA (Atlas T05) -->
  <section class="editorial-container my-10 sm:my-14">
    <div class="p-6 sm:p-10 rounded-2xl bg-[var(--wash)] border border-[var(--line)]">
      <span class="meta">PANDUAN KEPUTUSAN</span>
      <h3 class="font-heading text-xl sm:text-2xl font-bold text-[var(--ink)] my-2">
        Ingin Menerapkan Solusi Serupa Pada Rumahmu?
      </h3>
      <p class="text-sm text-[var(--muted)] leading-relaxed mb-5 max-w-2xl">
        Gunakan fitur Problem Solver kami untuk mencocokkan keluhan hunian atau bandingkan spesifikasi materialnya secara presisi.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/solusi" class="btn">
          ✦ Buka Problem Solver →
        </a>
        <a href="/komparasi" class="btn btn-secondary">
          Bandingkan Material
        </a>
        <a href="/explore" class="btn btn-secondary">
          Jelajahi Arsip
        </a>
      </div>
    </div>
  </section>
  )}

  <!-- Reading Progress & Bookmark Script -->
  <script>
    // Reading Progress
    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      const bar = document.getElementById('reading-progress');
      if (bar) bar.style.width = scrolled + '%';
    });

    // Bookmark Toggle Button (Header / Inline / Floating)
    const bookmarkBtn = document.getElementById('article-bookmark-btn');
    const floatBookmarkBtn = document.getElementById('floating-bookmark-btn');

    function triggerBookmark() {
      const slug = bookmarkBtn?.getAttribute('data-slug') || '';
      const title = bookmarkBtn?.getAttribute('data-title') || '';
      const image = bookmarkBtn?.getAttribute('data-image') || '';
      const category = bookmarkBtn?.getAttribute('data-category') || '';

      if (typeof window.toggleSaveBookmark === 'function') {
        const isSaved = window.toggleSaveBookmark({ slug, title, image, category });
        const textSpan = document.getElementById('bookmark-btn-text');
        const floatIcon = document.getElementById('floating-bookmark-icon');
        if (textSpan) textSpan.innerText = isSaved ? 'Tersimpan ✓' : 'Simpan Inspirasi';
        if (floatIcon) floatIcon.innerText = isSaved ? '✅' : '🔖';
      }
    }

    bookmarkBtn?.addEventListener('click', triggerBookmark);
    floatBookmarkBtn?.addEventListener('click', triggerBookmark);

    // Floating Copy Link
    const floatCopyBtn = document.getElementById('floating-copy-btn');
    floatCopyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const icon = document.getElementById('floating-copy-icon');
        if (icon) {
          icon.innerText = '✅';
          setTimeout(() => { icon.innerText = '🔗'; }, 2000);
        }
      } catch (e) {
        prompt('Salin link artikel:', window.location.href);
    });
  </script>

  <!-- Desktop-Only Scroll to Top Component (Bounded to Article Body) -->
  <ScrollToTop />
</BaseLayout>
)}
