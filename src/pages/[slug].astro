---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TableOfContents from '../components/TableOfContents.astro';
import AuthorCard from '../components/AuthorCard.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import SocialShareBar from '../components/SocialShareBar.astro';
import { getDb, getArticleBySlug, getPageBySlug, getRelatedArticles, getAllArticles, getAllCategories, getSiteSettings } from '../lib/db';
import { extractTableOfContents, injectHeadingIds, generateArticleSchema, processArticleContent } from '../lib/seo';

const { slug } = Astro.params;
const db = await getDb(Astro.locals);

const [article, page, categories, siteSettings] = await Promise.all([
  getArticleBySlug(db, slug || ''),
  getPageBySlug(db, slug || ''),
  getAllCategories(db),
  getSiteSettings(db)
]);

if (!article && !page) {
  return Astro.redirect('/404');
}

const isStaticPage = !article && !!page;
const siteUrl = siteSettings.site_url || 'https://rancangloka.com';

// If Article Page
let relatedArticles: any[] = [];
let toc: any[] = [];
let processedHtml = '';
let keyTakeaways: string[] = [];
let jsonLdSchema: any = null;
let breadcrumbItems: any[] = [];

if (article) {
  const [fetchedRelated, allArticles] = await Promise.all([
    getRelatedArticles(db, article.id, article.category_id, 3),
    getAllArticles(db, 'published')
  ]);

  relatedArticles = fetchedRelated;
  toc = extractTableOfContents(article.content_html);
  processedHtml = processArticleContent(
    article.content_html,
    article,
    allArticles,
    relatedArticles[0],
    siteSettings,
    toc
  );

  if (article.key_takeaways) {
    try {
      keyTakeaways = JSON.parse(article.key_takeaways);
    } catch (e) {}
  }

  const authorObj = {
    name: article.author_name,
    avatar: article.author_avatar,
    role: article.author_role,
    slug: article.author_name ? article.author_name.toLowerCase().replace(/\s+/g, '-') : 'redaksi'
  };
  jsonLdSchema = generateArticleSchema(article, siteUrl, authorObj, siteSettings);

  breadcrumbItems = [
    { name: article.category_name || 'Artikel', url: `/category/${article.category_slug || 'all'}` },
    { name: article.title, url: `/${article.slug}` }
  ];
} else if (page) {
  processedHtml = injectHeadingIds(page.content_html);
  breadcrumbItems = [
    { name: 'Beranda', url: '/' },
    { name: page.title, url: `/${page.slug}` }
  ];
}
---

<BaseLayout
  title={article ? article.title : page!.title}
  description={article ? article.description : page!.description}
  ogImage={article ? article.featured_image : page!.featured_image || siteSettings.seo_default_og_image}
  canonicalUrl={`${siteUrl}/${article ? article.slug : page!.slug}`}
  categories={categories}
  siteSettings={siteSettings}
  isArticlePage={!isStaticPage}
  jsonLdSchema={jsonLdSchema}
>
  <!-- Apple-Style Dynamic Reading Progress Bar (Top) -->
  <div id="reading-progress" class="fixed top-0 left-0 h-1 bg-[#0071e3] z-50 transition-all duration-100 ease-out" style="width: 0%;"></div>

  <!-- 🅰️ RENDER AS STATIC PAGE -->
  {isStaticPage && page && (
    <div class="max-w-3xl mx-auto px-4 sm:px-0 py-4">
      <div class="mb-6">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <header class="mb-8 border-b border-black/[0.05] dark:border-white/[0.08] pb-6">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.2]">
          {page.title}
        </h1>
        {page.description && (
          <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
            {page.description}
          </p>
        )}
      </header>

      {page.featured_image && (
        <div class="my-8 overflow-hidden rounded-[2rem] bg-slate-100 dark:bg-slate-800 aspect-[16/10] shadow-[0_10px_30px_rgba(0,0,0,0.06)] border border-black/[0.04] dark:border-white/[0.06]">
          <img src={page.featured_image} alt={page.title} class="h-full w-full object-cover" />
        </div>
      )}

      <!-- Page Content -->
      <div class="prose-magazine text-slate-800 dark:text-slate-200 mt-6" set:html={processedHtml} />

      <!-- Optional Interactive Contact Form for template === 'contact' -->
      {page.template === 'contact' && (
        <div class="mt-10 rounded-3xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-2">
            <span>✉️</span>
            Kirim Pesan ke Redaksi
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-6">Tim redaksi RancangLoka akan merespons pesan Anda dalam 1x24 jam kerja.</p>

          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Nama Lengkap</label>
                <input type="text" required placeholder="Nama Anda" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3.5 py-2.5 text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Alamat Email</label>
                <input type="email" required placeholder="email@domain.com" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3.5 py-2.5 text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Subjek Pesan</label>
              <input type="text" required placeholder="Topik: Kemitraan Media / Rilis Karya / Pertanyaan" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3.5 py-2.5 text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary" />
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Isi Pesan</label>
              <textarea rows="4" required placeholder="Tuliskan pesan atau detail kolaborasi Anda di sini..." class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-3.5 text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
            </div>

            <button type="submit" class="rounded-xl bg-primary px-6 py-2.5 text-xs font-bold text-white hover:bg-primary-hover transition shadow-sm">
              Kirim Pesan Sekarang 🚀
            </button>
          </form>
        </div>
      )}
    </div>
  )}

  <!-- 🅱️ RENDER AS MAGAZINE ARTICLE -->
  {!isStaticPage && article && (

  <article class="max-w-3xl mx-auto px-2 sm:px-0">
    <!-- 1. Breadcrumbs -->
    <div class="mb-4">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <!-- 2. Header Metadata & Headline -->
    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <a
          href={`/category/${article.category_slug || 'all'}`}
          class="rounded-full px-3.5 py-1 text-[11px] font-bold uppercase tracking-wider text-white shadow-2xs"
          style={`background-color: ${article.category_color || '#059669'};`}
        >
          {article.category_name || 'Hunian'}
        </a>

        {article.is_sponsored === 1 && (
          <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 dark:bg-amber-950/70 border border-amber-300 dark:border-amber-700/60 px-3 py-1 text-[10px] font-bold text-amber-800 dark:text-amber-300 uppercase tracking-wider">
            <span>🏷️</span>
            Kemitraan / Advertorial
          </span>
        )}

        <span class="text-xs text-slate-400 font-medium">
          ⏱️ {article.reading_time_minutes} min read
        </span>

        <!-- Save Inspiration Button -->
        <button
          id="article-bookmark-btn"
          type="button"
          class="ml-auto inline-flex items-center gap-1.5 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 px-3.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200 transition shadow-2xs"
          data-slug={article.slug}
          data-title={article.title}
          data-image={article.featured_image}
          data-category={article.category_name}
        >
          <span>🔖</span>
          <span id="bookmark-btn-text">Simpan Inspirasi</span>
        </button>
      </div>

      <h1 class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.18]">
        {article.title}
      </h1>

      <p class="mt-5 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
        {article.description}
      </p>

      <!-- Author and Date Meta Line -->
      <div class="mt-7 flex items-center justify-between border-y border-black/[0.05] py-4 dark:border-white/[0.08] text-xs sm:text-sm text-slate-500 dark:text-slate-400">
        <div class="flex items-center gap-3.5">
          <img
            src={article.author_avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80'}
            alt={article.author_name || 'Redaksi'}
            class="h-11 w-11 rounded-full object-cover ring-2 ring-black/5 dark:ring-white/10"
          />
          <div>
            <span class="font-bold text-slate-900 dark:text-white block text-sm">{article.author_name || 'Redaksi Utama'}</span>
            <span class="text-xs text-slate-400">{article.author_role || 'Senior Editor'}</span>
          </div>
        </div>

        <div class="text-right">
          <time datetime={article.published_at} class="font-medium text-slate-700 dark:text-slate-300">
            {new Date(article.published_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
          <span class="block text-[11px] text-slate-400 mt-0.5">Edisi Digital Terverifikasi</span>
        </div>
      </div>
    </header>

    <!-- 3. Featured Cover Image (Apple Squircle) -->
    <div class="my-8 overflow-hidden rounded-[2rem] bg-slate-100 dark:bg-slate-800 aspect-[16/10] shadow-[0_10px_30px_rgba(0,0,0,0.06)] border border-black/[0.04] dark:border-white/[0.06]">
      <img
        src={article.featured_image}
        alt={article.image_alt || article.title}
        class="article-cover-img h-full w-full object-cover"
        fetchpriority="high"
        loading="eager"
        onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1200&auto=format&fit=crop&q=80'"
      />
    </div>

    <!-- 4. Key Takeaways / AI Summary Box (Apple Frosted Box - Organik Only) -->
    {article.is_sponsored !== 1 && keyTakeaways.length > 0 && (
      <div class="my-8 rounded-3xl border border-blue-100 bg-blue-50/50 dark:border-blue-900/40 dark:bg-blue-950/20 p-6 sm:p-7 shadow-2xs">
        <h3 class="flex items-center gap-2 text-sm sm:text-base font-bold text-slate-900 dark:text-white mb-3">
          <span class="text-[#0071e3]">💡</span>
          Poin Kunci & Ringkasan Cepat (Key Takeaways):
        </h3>
        <ul class="space-y-2 text-xs sm:text-sm text-slate-700 dark:text-slate-300 list-disc list-inside leading-relaxed">
          {keyTakeaways.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    )}

    <!-- 5. Main Prose Article Body (With In-Article TOC, Dateline, and BACA JUGA) -->
    <div class="prose-magazine text-slate-800 dark:text-slate-200 mt-6" set:html={processedHtml} />

    <!-- 6. Social Share Bar -->
    <SocialShareBar title={article.title} siteSettings={siteSettings} />

    <!-- 7. E-E-A-T Author Card -->
    <AuthorCard
      authorName={article.author_name}
      authorAvatar={article.author_avatar}
      authorRole={article.author_role}
    />
  </article>

  <!-- 8. Full-Width Breakout Related Articles Grid (Organik Only) -->
  {article.is_sponsored !== 1 && relatedArticles.length > 0 && (
    <RelatedArticles articles={relatedArticles} />
  )}
  )}

  <!-- Reading Progress & Bookmark Script -->
  <script>
    // Reading Progress
    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      const bar = document.getElementById('reading-progress');
      if (bar) bar.style.width = scrolled + '%';
    });

    // Bookmark Toggle Button
    const bookmarkBtn = document.getElementById('article-bookmark-btn');
    bookmarkBtn?.addEventListener('click', () => {
      const slug = bookmarkBtn.getAttribute('data-slug') || '';
      const title = bookmarkBtn.getAttribute('data-title') || '';
      const image = bookmarkBtn.getAttribute('data-image') || '';
      const category = bookmarkBtn.getAttribute('data-category') || '';

      if (typeof (window as any).toggleSaveBookmark === 'function') {
        const isSaved = (window as any).toggleSaveBookmark({ slug, title, image, category });
        const textSpan = document.getElementById('bookmark-btn-text');
        if (textSpan) textSpan.innerText = isSaved ? 'Tersimpan ✓' : 'Simpan Inspirasi';
      }
    });
  </script>
</BaseLayout>
