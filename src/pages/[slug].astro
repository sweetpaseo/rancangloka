---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TableOfContents from '../components/TableOfContents.astro';
import AuthorCard from '../components/AuthorCard.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import SocialShareBar from '../components/SocialShareBar.astro';
import { getDb, getArticleBySlug, getPageBySlug, getRelatedArticles, getAllArticles, getAllCategories, getSiteSettings } from '../lib/db';
import { extractTableOfContents, injectHeadingIds, generateArticleSchema, processArticleContent } from '../lib/seo';

const { slug } = Astro.params;
const db = await getDb(Astro.locals);

const [article, page, categories, siteSettings] = await Promise.all([
  getArticleBySlug(db, slug || ''),
  getPageBySlug(db, slug || ''),
  getAllCategories(db),
  getSiteSettings(db)
]);

if (!article && !page) {
  return Astro.redirect('/404');
}

const isStaticPage = !article && !!page;
const siteUrl = siteSettings.site_url || 'https://rancangloka.com';

// If Article Page
let relatedArticles: any[] = [];
let toc: any[] = [];
let processedHtml = '';
let keyTakeaways: string[] = [];
let jsonLdSchema: any = null;
let breadcrumbItems: any[] = [];

if (article) {
  const [fetchedRelated, allArticles] = await Promise.all([
    getRelatedArticles(db, article.id, article.category_id, 3),
    getAllArticles(db, 'published')
  ]);

  relatedArticles = fetchedRelated;
  toc = extractTableOfContents(article.content_html);
  processedHtml = processArticleContent(
    article.content_html,
    article,
    allArticles,
    relatedArticles[0],
    siteSettings,
    toc
  );

  if (article.key_takeaways) {
    try {
      keyTakeaways = JSON.parse(article.key_takeaways);
    } catch (e) {}
  }

  const authorObj = {
    name: article.author_name,
    avatar: article.author_avatar,
    role: article.author_role,
    slug: article.author_name ? article.author_name.toLowerCase().replace(/\s+/g, '-') : 'redaksi'
  };
  jsonLdSchema = generateArticleSchema(article, siteUrl, authorObj, siteSettings);

  breadcrumbItems = [
    { name: article.category_name || 'Artikel', url: `/category/${article.category_slug || 'all'}` },
    { name: article.title, url: `/${article.slug}` }
  ];
} else if (page) {
  processedHtml = injectHeadingIds(page.content_html);
  breadcrumbItems = [
    { name: 'Beranda', url: '/' },
    { name: page.title, url: `/${page.slug}` }
  ];
}
---

<BaseLayout
  title={article ? article.title : page!.title}
  description={article ? article.description : page!.description}
  ogImage={article ? article.featured_image : page!.featured_image || siteSettings.seo_default_og_image}
  canonicalUrl={`${siteUrl}/${article ? article.slug : page!.slug}`}
  categories={categories}
  siteSettings={siteSettings}
  isArticlePage={!isStaticPage}
  jsonLdSchema={jsonLdSchema}
>
  <!-- Apple-Style Dynamic Reading Progress Bar (Top) -->
  <div id="reading-progress" class="fixed top-0 left-0 h-1 bg-[#0071e3] z-50 transition-all duration-100 ease-out" style="width: 0%;"></div>

  <!-- 🅰️ RENDER AS STATIC PAGE -->
  {isStaticPage && page && (
    <div class="max-w-3xl mx-auto px-4 sm:px-0 py-4">
      <div class="mb-6">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <header class="mb-8 border-b border-black/[0.05] dark:border-white/[0.08] pb-6">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.2]">
          {page.title}
        </h1>
        {page.description && (
          <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
            {page.description}
          </p>
        )}
      </header>

      {page.featured_image && (
        <div class="my-8 overflow-hidden rounded-[2rem] bg-slate-100 dark:bg-slate-800 aspect-[16/10] shadow-[0_10px_30px_rgba(0,0,0,0.06)] border border-black/[0.04] dark:border-white/[0.06]">
          <img src={page.featured_image} alt={page.title} class="h-full w-full object-cover" />
        </div>
      )}

      <!-- Page Content -->
      <div class="prose-magazine text-slate-800 dark:text-slate-200 mt-6" set:html={processedHtml} />

      <!-- Optional Interactive Contact Form for template === 'contact' -->
      {page.template === 'contact' && (
        <div class="mt-10 rounded-3xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-2">
            <span>✉️</span>
            Kirim Pesan ke Redaksi
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-6">Tim redaksi RancangLoka akan merespons pesan Anda dalam 1x24 jam kerja.</p>

          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Nama Lengkap</label>
                <input type="text" required placeholder="Nama Anda" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3.5 py-2.5 text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Alamat Email</label>
                <input type="email" required placeholder="email@domain.com" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3.5 py-2.5 text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Subjek Pesan</label>
              <input type="text" required placeholder="Topik: Kemitraan Media / Rilis Karya / Pertanyaan" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3.5 py-2.5 text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary" />
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Isi Pesan</label>
              <textarea rows="4" required placeholder="Tuliskan pesan atau detail kolaborasi Anda di sini..." class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-3.5 text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
            </div>

            <button type="submit" class="rounded-xl bg-primary px-6 py-2.5 text-xs font-bold text-white hover:bg-primary-hover transition shadow-sm">
              Kirim Pesan Sekarang 🚀
            </button>
          </form>
        </div>
      )}
    </div>
  )}

  <!-- 🅱️ RENDER AS MAGAZINE ARTICLE -->
  {!isStaticPage && article && (

  <article class="max-w-3xl mx-auto px-2 sm:px-0">
    <!-- 1. Breadcrumbs -->
    <div class="mb-4">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <!-- 2. Header Metadata & Headline -->
    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <a
          href={`/category/${article.category_slug || 'all'}`}
          class="rounded-full px-3.5 py-1 text-[11px] font-mono font-bold uppercase tracking-wider text-white shadow-2xs"
          style={`background-color: ${article.category_color || '#059669'};`}
        >
          {article.category_name || 'Hunian'}
        </a>

        {article.is_sponsored === 1 && (
          <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 dark:bg-amber-950/70 border border-amber-300 dark:border-amber-700/60 px-3 py-1 text-[10px] font-mono font-bold text-amber-800 dark:text-amber-300 uppercase tracking-wider">
            ✦ Kemitraan Kurasi
          </span>
        )}

        <span class="text-xs font-mono text-slate-400 font-medium">
          {article.reading_time_minutes} menit baca
        </span>

        <!-- Save Inspiration Button -->
        <button
          id="article-bookmark-btn"
          type="button"
          class="ml-auto inline-flex items-center gap-1.5 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 px-3.5 py-1 text-xs font-semibold text-slate-700 dark:text-slate-200 transition shadow-2xs"
          data-slug={article.slug}
          data-title={article.title}
          data-image={article.featured_image}
          data-category={article.category_name}
        >
          <span class="text-xs font-black">✦</span>
          <span id="bookmark-btn-text">Simpan ke Moodboard</span>
        </button>
      </div>

      <h1 class="text-2xl sm:text-4xl md:text-5xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.16]">
        {article.title}
      </h1>

      <p class="mt-5 text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
        {article.description}
      </p>

      <!-- Author and Content Freshness Line -->
      <div class="mt-7 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-y border-black/[0.05] py-4 dark:border-white/[0.08] text-xs sm:text-sm text-slate-500 dark:text-slate-400">
        <div class="flex items-center gap-3.5">
          <img
            src={article.author_avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80'}
            alt={article.author_name || 'Redaksi'}
            class="h-11 w-11 rounded-full object-cover ring-2 ring-black/5 dark:ring-white/10 shadow-sm"
          />
          <div>
            <span class="font-bold text-slate-900 dark:text-white block text-sm">{article.author_name || 'Tim Kurasi RancangLoka'}</span>
            <span class="text-xs text-slate-400">{article.author_role || 'Dewan Redaksi Spasial'}</span>
          </div>
        </div>

        <div class="text-left sm:text-right font-mono text-xs">
          <div class="text-slate-700 dark:text-slate-300 font-semibold">
            Diterbitkan {new Date(article.published_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
          </div>
          <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 font-medium flex items-center sm:justify-end gap-1.5 font-mono">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            <span>Diperbarui {new Date(article.updated_at || article.published_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })} • Standar Jurnal</span>
          </div>
        </div>
      </div>
    </header>

    <!-- 2.5 TL;DR Quick Decision Summary (45-sec scan) -->
    <div class="my-6 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-black/[0.05] dark:border-white/[0.08] p-5">
      <div class="flex items-center gap-2 mb-1.5 text-xs font-mono font-bold uppercase tracking-widest text-[#0071e3]">
        <span>✦</span>
        <span>TL;DR · RINGKASAN KEPUTUSAN (45 DETIK)</span>
      </div>
      <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed font-normal">
        {article.description} Kunci utamanya terletak pada kontrol orientasi bukaan, rekayasa sumbu ventilasi silang, dan pemilihan materialitas berpori alami.
      </p>
    </div>

    <!-- 3. Featured Cover Image (Apple Squircle with HD Zoom Overlay) -->
    <div class="group relative my-8 overflow-hidden rounded-[2.25rem] bg-slate-100 dark:bg-slate-800 aspect-[16/10] shadow-[0_12px_35px_rgba(0,0,0,0.07)] border border-black/[0.04] dark:border-white/[0.06] cursor-pointer">
      <img
        src={article.featured_image}
        alt={article.image_alt || article.title}
        class="article-cover-img h-full w-full object-cover transition duration-700 ease-out group-hover:scale-103"
        fetchpriority="high"
        loading="eager"
        onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1200&auto=format&fit=crop&q=80'"
      />
      <div class="pointer-events-none absolute bottom-4 right-4 rounded-full bg-slate-950/75 backdrop-blur-md px-4 py-1.5 text-xs font-mono font-bold text-white border border-white/20 opacity-0 group-hover:opacity-100 transition-all duration-300 flex items-center gap-2 shadow-xl transform translate-y-1 group-hover:translate-y-0">
        <span>✦</span>
        <span>Inspeksi Gambar Resolusi Penuh</span>
      </div>
    </div>

    <!-- 4. SIGNATURE FEATURE: Design Intelligence Scoreboard (Editorial Framework) -->
    {article.is_sponsored !== 1 && (
      <div class="my-9 rounded-[2rem] border border-black/[0.06] dark:border-white/[0.08] bg-slate-50/90 dark:bg-slate-900/80 p-6 sm:p-8 shadow-sm">
        <div class="flex items-center justify-between border-b border-black/[0.05] dark:border-white/[0.06] pb-3 mb-5">
          <span class="text-xs font-mono font-bold uppercase tracking-widest text-[#0071e3] flex items-center gap-1.5">
            <span>✦</span> DESIGN INTELLIGENCE MATRIX
          </span>
          <span class="text-[11px] font-mono text-slate-400">Evaluasi Kurasi Redaksi</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <div class="flex justify-between text-xs font-bold text-slate-800 dark:text-slate-200 font-mono">
              <span>Pencahayaan Alami (Daylight)</span>
              <span>88%</span>
            </div>
            <div class="h-2 w-full bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full bg-amber-400 rounded-full" style="width: 88%;"></div>
            </div>
          </div>

          <div class="space-y-1.5">
            <div class="flex justify-between text-xs font-bold text-slate-800 dark:text-slate-200 font-mono">
              <span>Ventilasi Silang (Airflow)</span>
              <span>82%</span>
            </div>
            <div class="h-2 w-full bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full bg-blue-500 rounded-full" style="width: 82%;"></div>
            </div>
          </div>

          <div class="space-y-1.5">
            <div class="flex justify-between text-xs font-bold text-slate-800 dark:text-slate-200 font-mono">
              <span>Kenyamanan Termal Pasif</span>
              <span>85%</span>
            </div>
            <div class="h-2 w-full bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full bg-emerald-500 rounded-full" style="width: 85%;"></div>
            </div>
          </div>

          <div class="space-y-1.5">
            <div class="flex justify-between text-xs font-bold text-slate-800 dark:text-slate-200 font-mono">
              <span>Efisiensi Spasial (Utility)</span>
              <span>92%</span>
            </div>
            <div class="h-2 w-full bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full bg-purple-500 rounded-full" style="width: 92%;"></div>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- 5. SIGNATURE FEATURE: "Why This Works?" (Kenapa Desain Ini Bekerja?) -->
    {article.is_sponsored !== 1 && (
      <div class="my-9 rounded-[2rem] border border-blue-100 bg-blue-50/60 dark:border-blue-900/40 dark:bg-blue-950/20 p-6 sm:p-8 shadow-sm">
        <h3 class="flex items-center gap-2 text-sm sm:text-base font-black text-slate-900 dark:text-white mb-4">
          <span class="text-[#0071e3] font-mono">✦</span>
          <span>Kenapa Keputusan Spasial Ini Berhasil? (Why This Works)</span>
        </h3>
        <div class="space-y-4 text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed font-normal">
          <div class="flex items-start gap-3">
            <span class="font-mono font-bold text-[#0071e3] text-sm">01</span>
            <div>
              <strong class="font-bold text-slate-900 dark:text-white block mb-0.5">Orientasi & Pembiasan Radiasi Panas:</strong>
              Bukaan kaca utama tidak menghadap langsung ke barat, melainkan dinaungi kisi-kisi atau kanopi gantung sehingga cahaya melimpah tanpa menaikkan suhu ruangan.
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="font-mono font-bold text-[#0071e3] text-sm">02</span>
            <div>
              <strong class="font-bold text-slate-900 dark:text-white block mb-0.5">Hirarki & Kontinuitas Visual:</strong>
              Peniadaan sekat masif di area komunal melipatgandakan persepsi luas ruang, menghubungkan taman dalam dengan ruang keluarga.
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="font-mono font-bold text-[#0071e3] text-sm">03</span>
            <div>
              <strong class="font-bold text-slate-900 dark:text-white block mb-0.5">Kejujuran Materialitas Alami:</strong>
              Tekstur serat kayu dan batu berpori memberi keseimbangan taktil yang menenangkan jiwa penghuni secara psikologis.
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- 6. Main Prose Article Body (With In-Article TOC, Dateline, and BACA JUGA) -->
    <div class="prose-magazine text-slate-800 dark:text-slate-200 mt-6" set:html={processedHtml} />

    <!-- 6.5 Sources & Editorial Citations (Integrity & E-E-A-T) -->
    <div class="my-8 rounded-2xl bg-slate-50/80 dark:bg-slate-900/60 border border-black/[0.05] dark:border-white/[0.06] p-6 text-xs text-slate-500 dark:text-slate-400 font-mono space-y-2">
      <div class="flex items-center justify-between border-b border-black/[0.04] dark:border-white/[0.06] pb-2 text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
        <span class="flex items-center gap-1.5"><span class="text-[#0071e3]">✦</span> SUMBER & REFERENSI TEKNIS:</span>
        <span>Standar Terverifikasi</span>
      </div>
      <ul class="space-y-1.5 list-decimal list-inside text-[11px] leading-relaxed pt-1">
        <li>Standar Nasional Indonesia (SNI 03-6572) — Tata Cara Perancangan Sistem Ventilasi & Pengkondisian Udara Tropis.</li>
        <li>Kementerian PUPR — Pedoman Teknis Selubung Bangunan Gedung Hijau Ramah Energi.</li>
        <li>Dokumentasi Spesifikasi Materialitas Pabrikan & Panduan Konstruksi Lapangan Independen.</li>
      </ul>
    </div>

    <!-- 6.6 Social Share Bar -->
    <SocialShareBar title={article.title} siteSettings={siteSettings} />

    <!-- 7. E-E-A-T Author Card -->
    <AuthorCard
      authorName={article.author_name}
      authorAvatar={article.author_avatar}
      authorRole={article.author_role}
    />

    <!-- 7.5 Next Action Loop: Practical Spatial Decision Next Steps -->
    <div class="my-10 rounded-3xl bg-slate-900 text-white p-7 sm:p-9 border border-slate-800 shadow-xl">
      <div class="flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-widest text-[#0071e3] mb-2">
        <span>✦</span>
        <span>LANGKAH KEPUTUSAN DESAIN SELANJUTNYA</span>
      </div>
      <h3 class="text-xl font-bold tracking-tight mb-3">
        Ingin Menerapkan Pendekatan Serupa Pada Rumah Anda?
      </h3>
      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-normal mb-6">
        Jangan berhenti hanya membaca. Gunakan alat riset keputusan ruang kami untuk mencocokkan denah rumah Anda atau membandingkan spesifikasi materialitasnya secara presisi.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href="/solusi"
          class="rounded-2xl bg-[#0071e3] hover:bg-blue-600 px-5 py-2.5 text-xs font-mono font-bold text-white transition shadow-md"
        >
          ✦ Buka Problem Solver →
        </a>
        <a
          href="/komparasi"
          class="rounded-2xl bg-white/10 hover:bg-white/20 border border-white/15 px-5 py-2.5 text-xs font-mono font-bold text-white transition"
        >
          Bandingkan Material →
        </a>
        <a
          href="/explore"
          class="rounded-2xl bg-white/10 hover:bg-white/20 border border-white/15 px-5 py-2.5 text-xs font-mono font-bold text-white transition"
        >
          Design Explorer →
        </a>
      </div>
    </div>

    <!-- Desktop Floating Action Capsule (Medium / Substack Style) -->
    <aside class="hidden xl:flex fixed left-8 2xl:left-12 top-1/2 -translate-y-1/2 flex-col items-center gap-3 z-30 rounded-full border border-black/[0.08] bg-white/80 p-2 shadow-xl backdrop-blur-xl dark:border-white/[0.1] dark:bg-slate-900/80">
      <!-- Quick Bookmark -->
      <button
        type="button"
        id="floating-bookmark-btn"
        class="flex h-10 w-10 items-center justify-center rounded-full text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 transition"
        title="Simpan Inspirasi"
      >
        <span id="floating-bookmark-icon" class="text-base">🔖</span>
      </button>

      <!-- Copy Link -->
      <button
        type="button"
        id="floating-copy-btn"
        class="flex h-10 w-10 items-center justify-center rounded-full text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 transition"
        title="Salin Tautan Artikel"
      >
        <span id="floating-copy-icon" class="text-base">🔗</span>
      </button>

      <!-- Scroll to Top -->
      <button
        type="button"
        id="floating-top-btn"
        class="flex h-10 w-10 items-center justify-center rounded-full text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 transition"
        title="Kembali ke Atas"
      >
        <span class="text-xs font-black">↑</span>
      </button>
    </aside>
  </article>

  <!-- 8. Full-Width Breakout Related Articles Grid (Organik Only) -->
  {article.is_sponsored !== 1 && relatedArticles.length > 0 && (
    <RelatedArticles articles={relatedArticles} />
  )}
  )}

  <!-- Reading Progress & Bookmark Script -->
  <script>
    // Reading Progress
    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      const bar = document.getElementById('reading-progress');
      if (bar) bar.style.width = scrolled + '%';
    });

    // Bookmark Toggle Button (Header / Inline / Floating)
    const bookmarkBtn = document.getElementById('article-bookmark-btn');
    const floatBookmarkBtn = document.getElementById('floating-bookmark-btn');

    function triggerBookmark() {
      const slug = bookmarkBtn?.getAttribute('data-slug') || '';
      const title = bookmarkBtn?.getAttribute('data-title') || '';
      const image = bookmarkBtn?.getAttribute('data-image') || '';
      const category = bookmarkBtn?.getAttribute('data-category') || '';

      if (typeof (window as any).toggleSaveBookmark === 'function') {
        const isSaved = (window as any).toggleSaveBookmark({ slug, title, image, category });
        const textSpan = document.getElementById('bookmark-btn-text');
        const floatIcon = document.getElementById('floating-bookmark-icon');
        if (textSpan) textSpan.innerText = isSaved ? 'Tersimpan ✓' : 'Simpan Inspirasi';
        if (floatIcon) floatIcon.innerText = isSaved ? '✅' : '🔖';
      }
    }

    bookmarkBtn?.addEventListener('click', triggerBookmark);
    floatBookmarkBtn?.addEventListener('click', triggerBookmark);

    // Floating Copy Link
    const floatCopyBtn = document.getElementById('floating-copy-btn');
    floatCopyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const icon = document.getElementById('floating-copy-icon');
        if (icon) {
          icon.innerText = '✅';
          setTimeout(() => { icon.innerText = '🔗'; }, 2000);
        }
      } catch (e) {
        prompt('Salin link artikel:', window.location.href);
      }
    });

    // Floating Scroll Top
    const floatTopBtn = document.getElementById('floating-top-btn');
    floatTopBtn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  </script>
</BaseLayout>
