---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../lib/db.ts';
import {
  getSyntheticProductDeskProjection,
  getProductionProductDeskProjection,
  PRODUCT_IDENTITY_STATE_CONFIG,
  REVIEW_MODE_CONFIG,
  EDITORIAL_STATUS_CONFIG,
  PRODUCT_MATCH_CONFIG,
  INSPECTION_FRESHNESS_CONFIG,
  EDITORIAL_READINESS_CONFIG,
  SOURCE_FIDELITY_CONFIG,
  SOURCE_TYPE_LABELS,
  validateHandsOnProvenance,
  type ProductDeskProjection
} from '../../lib/product-review/admin-inspector.ts';

// 1. Cache & Privacy Defense-in-Depth (Strictly private admin inspection)
Astro.response.headers.set('Cache-Control', 'no-store, private');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive, nosnippet');

// 2. Parse query parameters for inspection view state
const url = Astro.url;
const productIdParam = url.searchParams.get('product_id') || undefined;
const activeTabParam = url.searchParams.get('tab') || 'overview';
const emptyModeParam = url.searchParams.get('empty') === '1';

// 3. Assemble projection (Safe SSR, zero external network dependency)
// Permanent Invariant: NO_SILENT_PRODUCT_REVIEW_PRODUCTION_FALLBACK
// In production or when connected to D1, an empty database MUST display
// PRODUCTION_D1 empty state rather than falling back to synthetic fixtures.
const db = await getDb(Astro.locals);

let projection: ProductDeskProjection;
if (db || import.meta.env.PROD) {
  projection = await getProductionProductDeskProjection(db, {
    productId: productIdParam,
    activeTab: activeTabParam,
    forceEmpty: emptyModeParam
  });
} else {
  projection = getSyntheticProductDeskProjection({
    productId: productIdParam,
    activeTab: activeTabParam,
    forceEmpty: emptyModeParam
  });
}

const {
  data_source,
  data_source_meta,
  products_list,
  selected_product_id,
  detail,
  is_empty,
  empty_reason,
  active_tab
} = projection;

// Precompute hands-on provenance check for active detail reviews
const handsOnCheckMap: Record<string, { valid: boolean; issues: string[] }> = {};
if (detail) {
  for (const rev of detail.editorial_reviews) {
    if (rev.review_mode === 'HANDS_ON_REVIEW') {
      handsOnCheckMap[rev.review_id] = validateHandsOnProvenance(rev, detail.evidence_sources);
    }
  }
}
---

<AdminLayout title="Product Review Desk & Editorial Inspector">
  <div class="max-w-7xl mx-auto space-y-8">
    <!-- TOP HEADER & STATUS BAR -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-gray-200 dark:border-gray-800 pb-6">
      <div>
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="px-2.5 py-1 text-xs font-bold tracking-wider uppercase rounded-md bg-indigo-100 text-indigo-900 dark:bg-indigo-950/60 dark:text-indigo-200 border border-indigo-200 dark:border-indigo-800">
            EDITORIAL INSPECTOR
          </span>
          <span class={`px-2.5 py-1 text-xs font-semibold rounded-md border ${data_source_meta.badgeClass}`}>
            {data_source_meta.label}
          </span>
          {data_source_meta.isTestOnly && (
            <span class="px-2 py-0.5 text-[11px] font-bold rounded bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-200 border border-rose-300 dark:border-rose-800 uppercase tracking-wide">
              DEVELOPMENT / TEST DATA
            </span>
          )}
        </div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white mt-2.5 flex items-center gap-2">
          Meja Ulasan Produk & Inspektur Editorial
        </h1>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
          Inspeksi independen identitas fisik produk, status pengujian redaksi, bukti empiris, dan penawaran pasar.
        </p>
      </div>

      <!-- Quick mode selector (Safe SSR GET parameters) -->
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <a
          href="/admin/product-review"
          class={`px-3 py-1.5 rounded-lg border font-medium transition ${!emptyModeParam ? 'bg-indigo-600 text-white border-indigo-600 shadow-xs' : 'bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 border-gray-200 dark:border-gray-700 hover:bg-gray-50'}`}
        >
          Katalog Data Uji
        </a>
        <a
          href="/admin/product-review?empty=1"
          class={`px-3 py-1.5 rounded-lg border font-medium transition ${emptyModeParam ? 'bg-indigo-600 text-white border-indigo-600 shadow-xs' : 'bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 border-gray-200 dark:border-gray-700 hover:bg-gray-50'}`}
        >
          Simulasi Empty State
        </a>
      </div>
    </div>

    <!-- EDITORIAL FIREWALL INVARIANT BANNER -->
    <div class="bg-blue-50 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-900/50 rounded-xl p-4 text-sm text-blue-900 dark:text-blue-200 flex items-start gap-3 shadow-xs">
      <div class="p-1 rounded bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 font-bold shrink-0">
        i
      </div>
      <div class="space-y-1">
        <p class="font-bold text-blue-950 dark:text-blue-100">
          Invarian Tetap Redaksi: EDITORIAL_CONCLUSION_MUST_NOT_VISUALLY_APPEAR_COMMERCE_DRIVEN
        </p>
        <p class="text-xs text-blue-800 dark:text-blue-300 leading-relaxed">
          Produk bukan pusat artikel; keputusan arsitektur pembaca lah pusatnya. Penilaian kecocokan teknis dilakukan secara buta terhadap data komersial (<em>commerce-blind</em>). Besaran komisi, penawaran merchant, dan status afiliasi dilarang keras mengubah evaluasi fisik, review mode, maupun skor kesesuaian produk.
        </p>
      </div>
    </div>

    <!-- DATA SOURCE PROVENANCE NOTICE -->
    <div class={`rounded-xl border p-4 text-xs ${data_source_meta.bannerClass}`}>
      <div class="flex items-center justify-between">
        <span class="font-bold uppercase tracking-wider">Sumber Data Aktif: {data_source}</span>
        <span class="font-mono text-[11px]">ADMIN_MUST_KNOW_WHICH_DATA_SOURCE_IS_BEING_INSPECTED</span>
      </div>
      <p class="mt-1 leading-normal opacity-90">
        {data_source_meta.description}
      </p>
    </div>

    <!-- EMPTY STATE DISPLAY -->
    {is_empty ? (
      <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-12 text-center space-y-4 shadow-xs">
        <div class="w-16 h-16 mx-auto rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-3xl">
          📦
        </div>
        <div class="max-w-md mx-auto space-y-2">
          <h2 class="text-xl font-bold text-gray-900 dark:text-white">
            Belum ada produk yang masuk ke Product Review Desk.
          </h2>
          <p class="text-sm text-gray-500 dark:text-gray-400">
            {empty_reason || 'Tabel produk ulasan di database saat ini kosong atau belum menerima data kandidat.'}
          </p>
        </div>
        <div class="pt-2">
          <a
            href="/admin/product-review"
            class="inline-flex items-center px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-xs transition"
          >
            Muat Data Uji Sintesis (Fixture)
          </a>
        </div>
      </div>
    ) : (
      <!-- NORMAL CATALOG VIEW -->
      <div class="space-y-8">
        <!-- 1. PRODUCT LIST (SECTION 5) -->
        <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl shadow-xs overflow-hidden">
          <div class="px-5 py-4 border-b border-gray-100 dark:border-gray-800 flex items-center justify-between">
            <div>
              <h2 class="text-base font-bold text-gray-900 dark:text-white flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-indigo-600"></span>
                Daftar Produk Terdaftar di Meja Ulasan
              </h2>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                Peringkat tidak dipengaruhi komisi atau prioritas toko. Pilih produk untuk memeriksa detail audit.
              </p>
            </div>
            <span class="text-xs font-mono text-gray-500 bg-gray-100 dark:bg-gray-800 px-2.5 py-1 rounded-md">
              Total: {products_list.length} Produk
            </span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-gray-600 dark:text-gray-300">
              <thead class="bg-gray-50 dark:bg-gray-800/60 text-[11px] uppercase tracking-wider text-gray-500 dark:text-gray-400 border-b border-gray-100 dark:border-gray-800">
                <tr>
                  <th scope="col" class="px-5 py-3.5">Produk & Brand</th>
                  <th scope="col" class="px-4 py-3.5">Kelas Solusi PDE</th>
                  <th scope="col" class="px-4 py-3.5">Status Identitas</th>
                  <th scope="col" class="px-4 py-3.5">Mode Ulasan</th>
                  <th scope="col" class="px-4 py-3.5">Kesegaran Spesifikasi</th>
                  <th scope="col" class="px-4 py-3.5">Kecocokan Teknis</th>
                  <th scope="col" class="px-4 py-3.5">Kesiapan Editorial</th>
                  <th scope="col" class="px-5 py-3.5 text-right">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100 dark:divide-gray-800 font-normal">
                {products_list.map((item) => {
                  const isSelected = item.product_id === selected_product_id;
                  const identityConf = PRODUCT_IDENTITY_STATE_CONFIG[item.identity_state];
                  const reviewModeConf = REVIEW_MODE_CONFIG[item.latest_review_mode];
                  const freshnessConf = INSPECTION_FRESHNESS_CONFIG[item.evidence_freshness_status];
                  const matchConf = PRODUCT_MATCH_CONFIG[item.technical_match_status];
                  const readinessConf = EDITORIAL_READINESS_CONFIG[item.readiness_state];

                  return (
                    <tr class={`transition hover:bg-gray-50/70 dark:hover:bg-gray-800/40 ${isSelected ? 'bg-indigo-50/40 dark:bg-indigo-950/20' : ''}`}>
                      <td class="px-5 py-4">
                        <div class="font-bold text-gray-900 dark:text-white text-sm">
                          {item.canonical_name}
                        </div>
                        <div class="text-[11px] text-gray-500 mt-0.5">
                          Brand: <span class="font-medium text-gray-700 dark:text-gray-300">{item.brand}</span> • ID: <span class="font-mono">{item.product_id}</span>
                        </div>
                        <div class="text-[10px] text-gray-400 mt-0.5">
                          {item.variant_count} Varian • {item.editorial_review_count} Ulasan Redaksi
                        </div>
                      </td>
                      <td class="px-4 py-4 font-mono text-[11px]">
                        <span class="px-2 py-0.5 rounded bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200">
                          {item.solution_class_id}
                        </span>
                      </td>
                      <td class="px-4 py-4">
                        <span class={`inline-block px-2 py-0.5 rounded text-[11px] font-medium border ${identityConf.badgeClass}`}>
                          {item.identity_state}
                        </span>
                      </td>
                      <td class="px-4 py-4">
                        <span class={`inline-block px-2 py-0.5 rounded text-[11px] font-medium border ${reviewModeConf.badgeClass}`}>
                          {item.latest_review_mode}
                        </span>
                      </td>
                      <td class="px-4 py-4">
                        <span class={`inline-block px-2 py-0.5 rounded text-[11px] font-medium border ${freshnessConf.badgeClass}`}>
                          {freshnessConf.label}
                        </span>
                      </td>
                      <td class="px-4 py-4">
                        <span class={`inline-block px-2 py-0.5 rounded text-[11px] font-medium border ${matchConf.badgeClass}`}>
                          {matchConf.label}
                        </span>
                      </td>
                      <td class="px-4 py-4">
                        <span class={`inline-block px-2 py-0.5 rounded text-[11px] font-medium border ${readinessConf.badgeClass}`}>
                          {readinessConf.label}
                        </span>
                      </td>
                      <td class="px-5 py-4 text-right">
                        <a
                          href={`/admin/product-review?product_id=${item.product_id}&tab=${active_tab}`}
                          class={`inline-flex items-center px-3 py-1 rounded-md text-xs font-semibold transition ${isSelected ? 'bg-indigo-600 text-white' : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700'}`}
                        >
                          {isSelected ? 'Sedang Diinspeksi' : 'Inspeksi'}
                        </a>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 2. PRODUCT DETAIL INSPECTOR (SECTION 6) -->
        {detail && (
          <div class="space-y-6 pt-2">
            <!-- DETAIL INSPECTOR HEADER -->
            <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 shadow-xs space-y-4">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-gray-100 dark:border-gray-800 pb-4">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
                      Inspektur Detail Produk
                    </span>
                    <span class="text-xs text-gray-400">•</span>
                    <span class="font-mono text-xs text-gray-500">{detail.product.product_id}</span>
                  </div>
                  <h2 class="text-2xl font-bold text-gray-900 dark:text-white mt-1">
                    {detail.product.canonical_name}
                  </h2>
                  <div class="text-xs text-gray-500 mt-1 flex flex-wrap gap-4">
                    <span>Brand: <strong class="text-gray-800 dark:text-gray-200">{detail.product.brand}</strong></span>
                    <span>Kategori: <strong class="text-gray-800 dark:text-gray-200">{detail.product.category_id}</strong></span>
                    <span>Solusi PDE: <strong class="text-indigo-600 dark:text-indigo-400 font-mono">{detail.product.solution_class_id}</strong></span>
                  </div>
                </div>

                <!-- EDITORIAL READINESS SUMMARY BADGE (SECTION 19) -->
                <div class="flex flex-col md:items-end gap-1">
                  <div class="text-xs text-gray-500">Status Kesiapan Redaksi:</div>
                  <div class={`px-3 py-1 rounded-lg border text-xs font-bold ${EDITORIAL_READINESS_CONFIG[detail.readiness.state].badgeClass}`}>
                    {EDITORIAL_READINESS_CONFIG[detail.readiness.state].label}
                  </div>
                  <div class="text-[11px] text-gray-500 max-w-xs text-left md:text-right mt-0.5">
                    {EDITORIAL_READINESS_CONFIG[detail.readiness.state].description}
                  </div>
                </div>
              </div>

              <!-- NAVIGATION TABS -->
              <div class="flex flex-wrap gap-1.5 border-b border-gray-100 dark:border-gray-800 pb-2">
                {[
                  { id: 'overview', label: 'Ringkasan & Kesiapan' },
                  { id: 'identity', label: 'Identitas & Varian' },
                  { id: 'editorial_reviews', label: 'Ulasan Editorial RancangLoka' },
                  { id: 'evidence_specs', label: 'Bukti & Spesifikasi Fisik' },
                  { id: 'technical_match', label: 'Pencocokan Teknis PDE' },
                  { id: 'external_reviews', label: 'Pengalaman Pengguna Eksternal' },
                  { id: 'commerce', label: 'Penawaran Komersial (Offer)' },
                  { id: 'disclosure', label: 'Transparansi & Afiliasi' },
                  { id: 'drift', label: 'Pergeseran Identitas (Drift)' },
                  { id: 'freshness', label: 'Dashboard Kesegaran' }
                ].map((tab) => {
                  const isActive = active_tab === tab.id;
                  return (
                    <a
                      href={`/admin/product-review?product_id=${detail.product.product_id}&tab=${tab.id}`}
                      class={`px-3 py-1.5 rounded-lg text-xs font-semibold transition ${isActive ? 'bg-indigo-600 text-white shadow-xs' : 'bg-gray-50 dark:bg-gray-800/60 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800'}`}
                    >
                      {tab.label}
                    </a>
                  );
                })}
              </div>
            </div>

            <!-- TAB CONTENT 1: OVERVIEW & READINESS -->
            {(active_tab === 'overview') && (
              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Readiness Panel -->
                <div class="md:col-span-2 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl p-5 shadow-xs space-y-4">
                  <h3 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-sm bg-emerald-600"></span>
                    Audit Kesiapan Editorial (Editorial Readiness Audit)
                  </h3>
                  <div class={`p-4 rounded-xl border space-y-2 ${EDITORIAL_READINESS_CONFIG[detail.readiness.state].badgeClass}`}>
                    <div class="font-bold text-sm">
                      Status Evaluasi: {EDITORIAL_READINESS_CONFIG[detail.readiness.state].label}
                    </div>
                    <p class="text-xs leading-relaxed">
                      {EDITORIAL_READINESS_CONFIG[detail.readiness.state].actionHint}
                    </p>
                    <div class="pt-2 border-t border-current/20 text-xs space-y-1">
                      <div class="font-semibold">Temuan Evaluasi:</div>
                      <ul class="list-disc list-inside space-y-0.5">
                        {detail.readiness.reasons.map((r) => (
                          <li>{r}</li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  <div class="grid grid-cols-2 gap-4 text-xs pt-2">
                    <div class="p-3 rounded-lg bg-gray-50 dark:bg-gray-800/50 border border-gray-100 dark:border-gray-800 space-y-1">
                      <div class="text-gray-500">Kecocokan Solusi Arsitektur:</div>
                      <div class="font-bold text-gray-900 dark:text-white">
                        {PRODUCT_MATCH_CONFIG[detail.technical_match.match_status].label}
                      </div>
                      <div class="text-[11px] text-gray-500">{PRODUCT_MATCH_CONFIG[detail.technical_match.match_status].description}</div>
                    </div>
                    <div class="p-3 rounded-lg bg-gray-50 dark:bg-gray-800/50 border border-gray-100 dark:border-gray-800 space-y-1">
                      <div class="text-gray-500">Integritas Identitas Produk:</div>
                      <div class="font-bold text-gray-900 dark:text-white">
                        {PRODUCT_IDENTITY_STATE_CONFIG[detail.product.identity_state].label}
                      </div>
                      <div class="text-[11px] text-gray-500">
                        {detail.product.identity_state === 'CURRENT' ? 'Identitas stabil tanpa pergeseran listing.' : 'Terdeteksi perbedaan listing dengan dokumen terdaftar.'}
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Fast Facts Side Card -->
                <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl p-5 shadow-xs space-y-4">
                  <h3 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider">
                    Ringkasan Entitas
                  </h3>
                  <div class="space-y-2.5 text-xs">
                    <div class="flex justify-between py-1 border-b border-gray-100 dark:border-gray-800">
                      <span class="text-gray-500">Varian SKU:</span>
                      <span class="font-semibold text-gray-900 dark:text-white">{detail.variants.length} Varian</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-gray-100 dark:border-gray-800">
                      <span class="text-gray-500">Ulasan Editorial:</span>
                      <span class="font-semibold text-gray-900 dark:text-white">{detail.editorial_reviews.length} Dokumen</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-gray-100 dark:border-gray-800">
                      <span class="text-gray-500">Sumber Bukti Terverifikasi:</span>
                      <span class="font-semibold text-gray-900 dark:text-white">{detail.evidence_sources.length} Dokumen</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-gray-100 dark:border-gray-800">
                      <span class="text-gray-500">Penawaran Merchant:</span>
                      <span class="font-semibold text-gray-900 dark:text-white">{detail.offers.length} Listing Toko</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-gray-100 dark:border-gray-800">
                      <span class="text-gray-500">Tautan Afiliasi Outbound:</span>
                      <span class="font-semibold text-gray-900 dark:text-white">{detail.affiliate_destinations.length} Tautan Aktif</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-gray-100 dark:border-gray-800">
                      <span class="text-gray-500">Artikel Terikat:</span>
                      <span class="font-semibold text-gray-900 dark:text-white">{detail.article_binding ? `Artikel ID ${detail.article_binding.article_id}` : 'Belum Terikat'}</span>
                    </div>
                  </div>
                </div>
              </div>
            )}

            <!-- TAB CONTENT 2: PRODUCT IDENTITY & VARIANTS (SECTION 7) -->
            {(active_tab === 'identity') && (
              <div class="space-y-6">
                <!-- Pure Product Identity Panel (NO review mode here) -->
                <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl p-6 shadow-xs space-y-4">
                  <div class="flex items-center justify-between border-b border-gray-100 dark:border-gray-800 pb-3">
                    <div>
                      <h3 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-sm bg-indigo-600"></span>
                        Identitas Fisik Produk Murni (Pure Manufactured Identity)
                      </h3>
                      <p class="text-xs text-gray-500 mt-0.5">
                        Menjawab "What product is this?". Tidak memuat review mode atau status pengujian editorial.
                      </p>
                    </div>
                    <span class={`px-2.5 py-1 text-xs font-semibold rounded-md border ${PRODUCT_IDENTITY_STATE_CONFIG[detail.product.identity_state].badgeClass}`}>
                      {PRODUCT_IDENTITY_STATE_CONFIG[detail.product.identity_state].label}
                    </span>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                    <div class="space-y-1">
                      <span class="text-gray-500">Nama Kanonikal Produk:</span>
                      <div class="font-bold text-sm text-gray-900 dark:text-white">{detail.product.canonical_name}</div>
                    </div>
                    <div class="space-y-1">
                      <span class="text-gray-500">Pabrikan / Brand:</span>
                      <div class="font-bold text-sm text-gray-900 dark:text-white">{detail.product.brand}</div>
                    </div>
                    <div class="space-y-1">
                      <span class="text-gray-500">Product ID (Imutabel):</span>
                      <div class="font-mono text-gray-800 dark:text-gray-200 bg-gray-50 dark:bg-gray-800 p-2 rounded border border-gray-200 dark:border-gray-700">
                        {detail.product.product_id}
                      </div>
                    </div>
                    <div class="space-y-1">
                      <span class="text-gray-500">Kategori Katalog:</span>
                      <div class="font-mono text-gray-800 dark:text-gray-200 bg-gray-50 dark:bg-gray-800 p-2 rounded border border-gray-200 dark:border-gray-700">
                        {detail.product.category_id}
                      </div>
                    </div>
                    <div class="space-y-1">
                      <span class="text-gray-500">Kelas Solusi PDE Rujukan:</span>
                      <div class="font-mono text-indigo-600 dark:text-indigo-400 bg-indigo-50/50 dark:bg-indigo-950/30 p-2 rounded border border-indigo-200 dark:border-indigo-900">
                        {detail.product.solution_class_id}
                      </div>
                    </div>
                    <div class="space-y-1">
                      <span class="text-gray-500">Status Siklus Hidup Identitas:</span>
