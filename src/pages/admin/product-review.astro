                  <p class="font-semibold">Prinsip Batas Sinyal Pengguna:</p>
                  <p class="text-[11px] leading-relaxed">
                    Testimoni atau rating bintang marketplace adalah data persepsi eksternal. Sinyal ini <strong>tidak pernah dicampur</strong> dengan status ulasan editorial RancangLoka dan <strong>tidak dimasukkan</strong> ke dalam formula pencocokan teknis produk.
                  </p>
                </div>

                {detail.review_snapshot ? (
                  <div class="space-y-4 text-xs">
                    <div class="p-4 rounded-xl bg-gray-50 dark:bg-gray-800/40 border border-gray-100 dark:border-gray-800 space-y-2">
                      <div class="flex items-center justify-between">
                        <span class="font-bold text-sm text-gray-900 dark:text-white">{detail.review_snapshot.source_label}</span>
                        <span class="font-mono text-gray-500 text-[11px]">Diambil: {detail.review_snapshot.captured_at.split('T')[0]}</span>
                      </div>
                      <div class="flex items-center gap-4 text-xs text-gray-600 dark:text-gray-300 pt-1">
                        <div>
                          Rating Marketplace: <strong class="text-amber-600 font-bold">{detail.review_snapshot.external_rating}</strong> / {detail.review_snapshot.external_rating_max}
                        </div>
                        <div>
                          Jumlah Ulasan: <strong class="text-gray-900 dark:text-white">{detail.review_snapshot.external_review_count} Ulasan</strong>
                        </div>
                      </div>
                    </div>

                    <div class="space-y-2">
                      <div class="font-semibold text-gray-700 dark:text-gray-300 text-xs">Tema Pengalaman Berulang yang Terekam:</div>
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        {detail.review_snapshot.recurring_themes.map((t) => (
                          <div class="p-3 rounded-lg border border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900 text-xs space-y-1">
                            <div class="flex items-center justify-between">
                              <span class="font-bold text-gray-900 dark:text-white">{t.topic}</span>
                              <span class={`px-1.5 py-0.5 rounded text-[10px] font-bold ${t.sentiment === 'POSITIVE' ? 'bg-emerald-100 text-emerald-800' : t.sentiment === 'NEGATIVE' ? 'bg-rose-100 text-rose-800' : 'bg-gray-100 text-gray-700'}`}>
                                {t.sentiment}
                              </span>
                            </div>
                            <p class="text-gray-600 dark:text-gray-300 text-[11px] leading-relaxed">{t.summary}</p>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                ) : (
                  <div class="p-6 text-center text-xs text-gray-500 bg-gray-50 dark:bg-gray-800/40 rounded-xl">
                    Belum ada rekaman sinyal ulasan eksternal yang dihubungkan ke produk ini.
                  </div>
                )}
              </div>
            )}

            <!-- TAB CONTENT 7: COMMERCE PANEL (SECTION 15) -->
            {(active_tab === 'commerce') && (
              <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl p-6 shadow-xs space-y-6">
                <div class="flex items-center justify-between border-b border-gray-100 dark:border-gray-800 pb-3">
                  <div>
                    <h3 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider flex items-center gap-2">
                      <span class="w-2.5 h-2.5 rounded-sm bg-emerald-600"></span>
                      Penawaran Merchant & Harga Pasar (Commerce Layer)
                    </h3>
                    <p class="text-xs text-gray-500 mt-0.5">
                      Data ketersediaan toko dan harga volatil. Terpisah mutlak dari analisis teknis.
                    </p>
                  </div>
                  <span class="px-2.5 py-1 text-xs font-semibold rounded-md bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-300">
                    SEPARATED COMMERCE
                  </span>
                </div>

                <!-- MANDATORY EXPLANATORY COPY (SECTION 15) -->
                <div class="p-4 rounded-xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/50 text-xs text-amber-900 dark:text-amber-200 space-y-1">
                  <div class="font-bold flex items-center gap-1.5">
                    <span>⚠️</span>
                    <span>Pernyataan Independensi Komersial:</span>
                  </div>
                  <p class="text-[11px] leading-relaxed">
                    <strong>"Data komersial tidak memengaruhi penilaian teknis."</strong> Peringkat toko, besaran komisi afiliasi, maupun status sponsor dilarang memengaruhi rekomendasi atau urutan evaluasi.
                  </p>
                </div>

                <div class="space-y-4">
                  <div class="font-semibold text-xs text-gray-700 dark:text-gray-300">Penawaran Merchant Terdaftar ({detail.offers.length} Toko):</div>
                  {detail.offers.length === 0 ? (
                    <div class="p-6 text-center text-xs text-gray-500 bg-gray-50 dark:bg-gray-800/40 rounded-xl">
                      Belum ada penawaran merchant aktif yang terhubung.
                    </div>
                  ) : (
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                      {detail.offers.map((off, idx) => {
                        const price = detail.price_snapshots[idx];
                        return (
                          <div class="p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/30 text-xs space-y-3">
                            <div class="flex items-center justify-between">
                              <span class="font-bold text-gray-900 dark:text-white text-sm">{off.merchant_name}</span>
                              <span class={`px-2 py-0.5 rounded text-[10px] font-bold ${off.current_availability === 'IN_STOCK' ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-100 text-gray-700'}`}>
                                {off.current_availability}
                              </span>
                            </div>

                            <div class="text-[11px] text-gray-600 dark:text-gray-300">
                              Judul Listing: <span class="font-medium text-gray-800 dark:text-gray-200">{off.listing_title}</span>
                            </div>

                            {price && (
                              <div class="p-3 rounded-lg bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 flex items-center justify-between font-mono">
                                <span class="text-gray-500">Harga Teramati:</span>
                                <span class="font-bold text-sm text-emerald-600 dark:text-emerald-400">
                                  {price.currency} {price.observed_price.toLocaleString('id-ID')}
                                </span>
                              </div>
                            )}

                            <div class="text-[10px] text-gray-400 truncate">
                              URL Listing: <span class="font-mono">{off.listing_url}</span>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  )}
                </div>
              </div>
            )}

            <!-- TAB CONTENT 8: DISCLOSURE PANEL (SECTION 16) -->
            {(active_tab === 'disclosure') && (
              <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl p-6 shadow-xs space-y-6">
                <div class="flex items-center justify-between border-b border-gray-100 dark:border-gray-800 pb-3">
                  <div>
                    <h3 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider flex items-center gap-2">
                      <span class="w-2.5 h-2.5 rounded-sm bg-amber-600"></span>
                      Transparansi Hubungan Komersial (Commercial Disclosure)
                    </h3>
                    <p class="text-xs text-gray-500 mt-0.5">
                      Pengungkapan wajib afiliasi dan barang uji demi menjaga kepercayaan pembaca.
                    </p>
                  </div>
                  <span class="px-2 py-0.5 text-xs font-mono text-gray-500 bg-gray-100 dark:bg-gray-800 rounded">
                    SECTION 16
                  </span>
                </div>

                <div class="p-5 rounded-2xl bg-amber-50/50 dark:bg-amber-950/20 border border-amber-200/50 dark:border-amber-900/30 text-xs space-y-4">
                  <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    <div class="p-3 rounded-xl bg-white dark:bg-gray-900 border border-amber-200 dark:border-amber-900/50 space-y-1">
                      <span class="text-gray-500">Hubungan Afiliasi:</span>
                      <div class="font-bold text-gray-900 dark:text-white">
                        {detail.commercial_disclosure.has_affiliate_links ? '✓ Ya (Mengandung Link Afiliasi)' : '✕ Tidak Ada'}
                      </div>
                    </div>
                    <div class="p-3 rounded-xl bg-white dark:bg-gray-900 border border-amber-200 dark:border-amber-900/50 space-y-1">
                      <span class="text-gray-500">Konten Bersponsor:</span>
                      <div class="font-bold text-gray-900 dark:text-white">
                        {detail.commercial_disclosure.is_sponsored_content ? '⚠️ Ya (Sponsored Content)' : '✓ Tidak (Independen)'}
                      </div>
                    </div>
                    <div class="p-3 rounded-xl bg-white dark:bg-gray-900 border border-amber-200 dark:border-amber-900/50 space-y-1">
                      <span class="text-gray-500">Barang Disediakan Brand:</span>
                      <div class="font-bold text-gray-900 dark:text-white">
                        {detail.commercial_disclosure.is_product_supplied_by_brand ? 'Ya (Sampel Pabrikan)' : '✓ Beli Sendiri / Bebas Sampel'}
                      </div>
                    </div>
                  </div>

                  <div class="p-4 rounded-xl bg-white dark:bg-gray-900 border border-amber-200 dark:border-amber-900/50 space-y-1.5">
                    <span class="font-bold text-amber-900 dark:text-amber-200">Pernyataan Pengungkapan Redaksi (Disclosure Statement):</span>
                    <p class="text-gray-700 dark:text-gray-300 leading-relaxed text-[11px]">
                      "{detail.commercial_disclosure.disclosure_statement}"
                    </p>
                  </div>
                </div>

                <!-- AFFILIATE DESTINATIONS (SECTION 15) -->
                <div class="space-y-3 pt-2">
                  <div class="font-semibold text-xs text-gray-700 dark:text-gray-300">Tautan Pelacakan Afiliasi Outbound ({detail.affiliate_destinations.length}):</div>
                  <div class="space-y-2">
                    {detail.affiliate_destinations.map((aff) => (
                      <div class="p-3 rounded-xl bg-gray-50 dark:bg-gray-800/40 border border-gray-100 dark:border-gray-800 text-xs flex flex-col md:flex-row md:items-center justify-between gap-2">
                        <div class="space-y-0.5 truncate">
                          <div class="font-semibold text-gray-900 dark:text-white">Provider: {aff.provider}</div>
                          <div class="font-mono text-[11px] text-gray-500 truncate">{aff.affiliate_destination_url}</div>
                        </div>
                        <span class={`px-2 py-0.5 rounded text-[10px] font-bold ${aff.is_active ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-100 text-gray-700'}`}>
                          {aff.is_active ? 'Aktif' : 'Non-aktif'}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )}

            <!-- TAB CONTENT 9: IDENTITY DRIFT (SECTION 17) -->
            {(active_tab === 'drift') && (
              <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl p-6 shadow-xs space-y-6">
                <div class="flex items-center justify-between border-b border-gray-100 dark:border-gray-800 pb-3">
                  <div>
                    <h3 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider flex items-center gap-2">
                      <span class="w-2.5 h-2.5 rounded-sm bg-rose-600"></span>
                      Inspektur Pergeseran Identitas (Identity Drift Panel)
                    </h3>
                    <p class="text-xs text-gray-500 mt-0.5">
                      Mencegah mutasi identitas kanonikal secara diam-diam akibat perubahan judul/SKU listing toko.
                    </p>
                  </div>
                  <span class={`px-2.5 py-1 text-xs font-bold rounded-md border ${PRODUCT_IDENTITY_STATE_CONFIG[detail.product.identity_state].badgeClass}`}>
                    {PRODUCT_IDENTITY_STATE_CONFIG[detail.product.identity_state].label}
                  </span>
                </div>

                {detail.product.identity_state !== 'CURRENT' ? (
                  <div class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-900 text-xs text-rose-900 dark:text-rose-200 space-y-2">
                    <div class="font-bold flex items-center gap-1.5 text-sm">
                      <span>⚠️</span>
                      <span>Peringatan Pergeseran Identitas Terdeteksi:</span>
                    </div>
                    <p class="text-xs leading-relaxed">
                      {PRODUCT_IDENTITY_STATE_CONFIG[detail.product.identity_state].warning || 'Status produk menyimpang dari identitas kanonikal.'}
                    </p>
                    <p class="text-[11px] opacity-90 pt-1 border-t border-rose-200 dark:border-rose-900">
                      Sistem dilarang menimpa identitas kanonikal secara otomatis. Editor wajib memvalidasi apakah ini revisi produk baru atau ketidakcocokan listing pihak ketiga.
                    </p>
                  </div>
                ) : (
                  <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-900 text-xs text-emerald-900 dark:text-emerald-200 space-y-1">
                    <div class="font-bold text-sm">✓ Identitas Stabil (CURRENT)</div>
                    <p class="text-xs leading-relaxed">
                      Judul produk kanonikal, nomor model SKU, dan spesifikasi inti konsisten antara dokumen pabrikan dan listing yang terdaftar.
                    </p>
                  </div>
                )}

                <div class="space-y-3 pt-2 text-xs">
                  <div class="font-semibold text-gray-700 dark:text-gray-300">Status Siklus Hidup Identitas yang Didukung:</div>
                  <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                    {Object.entries(PRODUCT_IDENTITY_STATE_CONFIG).map(([k, val]) => (
                      <div class="p-3 rounded-lg border border-gray-100 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/30 space-y-1">
                        <span class={`px-1.5 py-0.5 rounded text-[10px] font-bold border ${val.badgeClass}`}>{k}</span>
                        <div class="font-semibold text-gray-900 dark:text-white text-[11px]">{val.label}</div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )}

            <!-- TAB CONTENT 10: FRESHNESS DASHBOARD (SECTION 18) -->
            {(active_tab === 'freshness') && (
              <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl p-6 shadow-xs space-y-6">
                <div class="flex items-center justify-between border-b border-gray-100 dark:border-gray-800 pb-3">
                  <div>
                    <h3 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider flex items-center gap-2">
                      <span class="w-2.5 h-2.5 rounded-sm bg-blue-600"></span>
                      Dashboard Kesegaran Data Independen (Freshness Dashboard)
                    </h3>
                    <p class="text-xs text-gray-500 mt-0.5">
                      Evaluasi kesegaran per entitas secara terpisah berdasarkan kebijakan terpusat. Tidak dilebur menjadi skor tunggal.
                    </p>
                  </div>
                  <span class="px-2 py-0.5 text-xs font-mono text-gray-500 bg-gray-100 dark:bg-gray-800 rounded">
                    SECTION 18
                  </span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
                  <!-- Spec Freshness -->
                  <div class="p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/30 space-y-2">
                    <div class="flex items-center justify-between">
                      <span class="font-bold text-gray-900 dark:text-white">SpecSnapshot</span>
                      <span class={`px-2 py-0.5 rounded text-[10px] font-bold border ${INSPECTION_FRESHNESS_CONFIG[detail.spec_freshness_state].badgeClass}`}>
                        {INSPECTION_FRESHNESS_CONFIG[detail.spec_freshness_state].label}
                      </span>
                    </div>
                    <div class="text-[11px] text-gray-500">
                      Batas Maksimal: 90 Hari
                    </div>
                    <div class="text-[11px] text-gray-700 dark:text-gray-300">
                      Diambil: {detail.spec_snapshot ? detail.spec_snapshot.captured_at.split('T')[0] : 'Tidak ada'}
                    </div>
                  </div>

                  <!-- Review Freshness -->
                  <div class="p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/30 space-y-2">
                    <div class="flex items-center justify-between">
                      <span class="font-bold text-gray-900 dark:text-white">ReviewSnapshot</span>
                      <span class={`px-2 py-0.5 rounded text-[10px] font-bold border ${INSPECTION_FRESHNESS_CONFIG[detail.review_freshness_state].badgeClass}`}>
                        {INSPECTION_FRESHNESS_CONFIG[detail.review_freshness_state].label}
                      </span>
                    </div>
                    <div class="text-[11px] text-gray-500">
                      Batas Maksimal: 30 Hari
                    </div>
                    <div class="text-[11px] text-gray-700 dark:text-gray-300">
                      Diambil: {detail.review_snapshot ? detail.review_snapshot.captured_at.split('T')[0] : 'Tidak ada'}
                    </div>
                  </div>

                  <!-- Price Freshness -->
                  <div class="p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/30 space-y-2">
                    <div class="flex items-center justify-between">
                      <span class="font-bold text-gray-900 dark:text-white">PriceSnapshot</span>
                      <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                        {detail.price_snapshots.length > 0 ? 'Aktif Terpantau' : 'Belum Ada'}
                      </span>
                    </div>
                    <div class="text-[11px] text-gray-500">
                      Batas Maksimal: 48 Jam
                    </div>
                    <div class="text-[11px] text-gray-700 dark:text-gray-300">
                      Snapshot Terakhir: {detail.price_snapshots[0] ? detail.price_snapshots[0].captured_at.split('T')[0] : 'Tidak ada'}
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    )}
  </div>
</AdminLayout>
