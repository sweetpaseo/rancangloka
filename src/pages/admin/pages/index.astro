---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb, getAllPages } from '../../../lib/db';

const db = await getDb(Astro.locals);
const pages = await getAllPages(db);
---

<AdminLayout title="Manajemen Halaman (Pages)">
  <div class="space-y-6 max-w-7xl mx-auto">
    <!-- Top Action Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
      <div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
          <span>📄</span>
          Semua Halaman (Pages)
        </h1>
        <p class="text-xs text-slate-500 mt-0.5">Kelola halaman statis: Tentang Kami, Kontak, Kebijakan Privasi, dan informasi resmi.</p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/pages/new"
          class="rounded-xl bg-primary px-4 py-2.5 text-xs font-bold text-white hover:bg-primary-hover transition shadow-sm flex items-center gap-2"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Tambah Halaman Baru
        </a>
      </div>
    </div>

    <!-- Table of Pages -->
    <div class="rounded-2xl bg-white border border-slate-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 font-bold uppercase tracking-wider">
            <tr>
              <th class="py-3.5 px-4">Judul Halaman</th>
              <th class="py-3.5 px-4">Template</th>
              <th class="py-3.5 px-4">Status</th>
              <th class="py-3.5 px-4">Views</th>
              <th class="py-3.5 px-4">Terakhir Diubah</th>
              <th class="py-3.5 px-4 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
            {pages.map((p) => (
              <tr class="hover:bg-slate-50/80 transition group">
                <td class="py-4 px-4">
                  <div class="flex flex-col">
                    <a href={`/admin/pages/${p.id}`} class="text-sm font-bold text-slate-900 group-hover:text-primary transition line-clamp-1">
                      {p.title}
                    </a>
                    <span class="text-[11px] text-slate-400 font-mono mt-0.5">/{p.slug}</span>
                  </div>
                </td>
                <td class="py-4 px-4">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-semibold bg-slate-100 text-slate-700 capitalize">
                    {p.template === 'contact' ? '📬 Formulir Kontak' : p.template === 'fullwidth' ? '↔️ Full Width' : '📄 Standar'}
                  </span>
                </td>
                <td class="py-4 px-4">
                  <span class={`inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider ${
                    p.status === 'published' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'
                  }`}>
                    {p.status}
                  </span>
                </td>
                <td class="py-4 px-4 text-slate-500">
                  👁️ {p.views || 0}
                </td>
                <td class="py-4 px-4 text-slate-400 text-[11px]">
                  {new Date(p.updated_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}
                </td>
                <td class="py-4 px-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <a
                      href={`/${p.slug}`}
                      target="_blank"
                      class="rounded-lg p-1.5 text-slate-400 hover:text-primary hover:bg-slate-100 transition"
                      title="Lihat Halaman Publik"
                    >
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                    <a
                      href={`/admin/pages/${p.id}`}
                      class="rounded-lg p-1.5 text-slate-400 hover:text-slate-900 hover:bg-slate-100 transition"
                      title="Edit Halaman"
                    >
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                    </a>
                    <button
                      type="button"
                      class="btn-delete-page rounded-lg p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 transition"
                      data-id={p.id}
                      data-title={p.title}
                      title="Hapus Halaman"
                    >
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll('.btn-delete-page').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLElement;
        const id = target.dataset.id;
        const title = target.dataset.title;

        if (confirm(`Apakah Anda yakin ingin menghapus halaman "${title}"?`)) {
          try {
            const res = await fetch(`/api/admin/pages/${id}`, { method: 'DELETE' });
            if (res.ok) {
              alert('Halaman berhasil dihapus.');
              window.location.reload();
            } else {
              alert('Gagal menghapus halaman.');
            }
          } catch (err) {
            alert('Terjadi kesalahan koneksi.');
          }
        }
      });
    });
  </script>
</AdminLayout>
