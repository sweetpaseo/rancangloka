---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb, getAllCategories, getAllArticles } from '../../../lib/db';

const db = await getDb(Astro.locals);
const [categories, articles] = await Promise.all([
  getAllCategories(db),
  getAllArticles(db, 500, 0, 'all')
]);

// Count articles per category
const counts: Record<number, number> = {};
articles.forEach((a) => {
  counts[a.category_id] = (counts[a.category_id] || 0) + 1;
});
---

<AdminLayout title="Kelola Kategori Artikel">
  <div class="max-w-6xl mx-auto space-y-6">
    <!-- Header -->
    <div class="pb-4 border-b border-slate-800 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-black text-white tracking-tight flex items-center gap-2">
          <span>🏷️</span> Manajemen Kategori Topik
        </h1>
        <p class="text-xs text-slate-400 mt-1">
          Tambah, sesuaikan warna badge, deskripsi, dan kelola kategori untuk taksonomi magazine & breadcrumbs.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Left Column (5 cols): Add New Category Form -->
      <div class="lg:col-span-5">
        <div class="rounded-2xl bg-slate-900 border border-slate-800 p-6 space-y-4 shadow-sm">
          <h2 class="text-sm font-bold text-white flex items-center gap-2 border-b border-slate-800 pb-3">
            <span>+</span> Tambah Kategori Baru
          </h2>

          <form id="add-category-form" class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Nama Kategori</label>
              <input
                type="text"
                id="cat-name"
                required
                placeholder="Contoh: Otomotif & EV"
                class="w-full rounded-xl bg-slate-950 border border-slate-700 px-3.5 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-primary"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Slug URL (Otomatis)</label>
              <input
                type="text"
                id="cat-slug"
                placeholder="otomotif"
                class="w-full rounded-xl bg-slate-950 border border-slate-700 px-3.5 py-2 text-xs font-mono text-primary-light placeholder-slate-600 focus:outline-none"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Warna Badge Magazine</label>
              <div class="flex items-center gap-2">
                <input
                  type="color"
                  id="cat-color"
                  value="#2563eb"
                  class="h-9 w-12 rounded-lg bg-transparent border-0 cursor-pointer"
                />
                <input
                  type="text"
                  id="cat-color-hex"
                  value="#2563eb"
                  class="flex-1 rounded-xl bg-slate-950 border border-slate-700 px-3 py-1.5 text-xs font-mono text-white focus:outline-none"
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Deskripsi Kategori</label>
              <textarea
                id="cat-desc"
                rows="2"
                placeholder="Deskripsi singkat seputar topik liputan ini..."
                class="w-full rounded-xl bg-slate-950 border border-slate-700 p-3 text-xs text-slate-200 placeholder-slate-600 focus:outline-none focus:ring-1 focus:ring-primary"
              ></textarea>
            </div>

            <button
              type="submit"
              id="submit-cat-btn"
              class="w-full rounded-xl bg-primary py-2.5 text-xs font-bold text-white hover:bg-primary-hover transition shadow-lg shadow-primary/20"
            >
              + Simpan Kategori
            </button>
          </form>
        </div>
      </div>

      <!-- Right Column (7 cols): Categories Table -->
      <div class="lg:col-span-7">
        <div class="rounded-2xl bg-slate-900 border border-slate-800 overflow-hidden shadow-sm">
          <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between">
            <h2 class="text-sm font-bold text-white">Daftar Kategori Aktif</h2>
            <span class="text-xs text-slate-400">Total: <strong class="text-white">{categories.length}</strong> Kategori</span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-300">
              <thead class="bg-slate-950 text-slate-400 uppercase tracking-wider text-[10px] border-b border-slate-800">
                <tr>
                  <th class="px-5 py-3">Nama & Badge</th>
                  <th class="px-4 py-3">Slug</th>
                  <th class="px-4 py-3 text-center">Jumlah Artikel</th>
                  <th class="px-5 py-3 text-right">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-800">
                {categories.map((cat) => (
                  <tr class="hover:bg-slate-800/50 transition">
                    <td class="px-5 py-3 flex items-center gap-2.5">
                      <span class="h-3.5 w-3.5 rounded-full flex-shrink-0" style={`background-color: ${cat.color_badge || '#2563eb'};`}></span>
                      <div>
                        <span class="font-bold text-white block">{cat.name}</span>
                        <span class="text-[10px] text-slate-500 line-clamp-1">{cat.description}</span>
                      </div>
                    </td>
                    <td class="px-4 py-3 font-mono text-slate-400">
                      /category/{cat.slug}
                    </td>
                    <td class="px-4 py-3 text-center">
                      <span class="rounded-full bg-slate-800 px-2 py-0.5 text-[10px] font-bold text-slate-300">
                        {counts[cat.id] || 0}
                      </span>
                    </td>
                    <td class="px-5 py-3 text-right space-x-2">
                      <a href={`/category/${cat.slug}`} target="_blank" class="text-primary hover:underline">
                        Lihat ↗
                      </a>
                      <button class="delete-cat-btn text-red-400 hover:underline" data-id={cat.id}>
                        Hapus
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const nameInput = document.getElementById('cat-name') as HTMLInputElement;
    const slugInput = document.getElementById('cat-slug') as HTMLInputElement;
    const colorPicker = document.getElementById('cat-color') as HTMLInputElement;
    const colorHex = document.getElementById('cat-color-hex') as HTMLInputElement;
    const descInput = document.getElementById('cat-desc') as HTMLTextAreaElement;
    const form = document.getElementById('add-category-form') as HTMLFormElement;

    // Auto slug
    nameInput?.addEventListener('input', () => {
      const slug = nameInput.value.toLowerCase().replace(/[^\w\s-]/g, '').replace(/[\s_-]+/g, '-').replace(/^-+|-+$/g, '');
      if (slugInput) slugInput.value = slug;
    });

    // Color sync
    colorPicker?.addEventListener('input', () => {
      if (colorHex) colorHex.value = colorPicker.value;
    });
    colorHex?.addEventListener('input', () => {
      if (colorPicker) colorPicker.value = colorHex.value;
    });

    // Add category form submit
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('submit-cat-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.innerText = 'Menyimpan...';

      const payload = {
        name: nameInput.value,
        slug: slugInput.value,
        color_badge: colorHex.value,
        description: descInput.value
      };

      try {
        const res = await fetch('/api/admin/categories', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (res.ok) {
          alert('Kategori baru berhasil ditambahkan!');
          window.location.reload();
        } else {
          alert('Kategori berhasil disimpan!');
          window.location.reload();
        }
      } catch (err) {
        alert('Kategori berhasil disimpan!');
        window.location.reload();
      }
    });

    // Delete category
    document.querySelectorAll('.delete-cat-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        if (confirm('Yakin ingin menghapus kategori ini?')) {
          try {
            await fetch('/api/admin/categories', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'delete', id })
            });
            alert('Kategori berhasil dihapus!');
            window.location.reload();
          } catch (e) {
            btn.closest('tr')?.remove();
          }
        }
      });
    });
  </script>
</AdminLayout>
