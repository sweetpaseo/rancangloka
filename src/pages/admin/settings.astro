---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb, getSiteSettings } from '../../lib/db';
import { getMetaConnectionHealth, getMetaConnection } from '../../lib/social/providers/meta/connection-service.ts';
import { evaluateMetaLiveReadiness } from '../../lib/social/providers/meta/live-readiness.ts';
import { getDiscoveryProviderStatus } from '../../lib/editorial/discovery-settings-vault.ts';

const db = await getDb(Astro.locals);
const settings = await getSiteSettings(db);
const rawEnv = (Astro.locals as any)?.runtime?.env || (globalThis as any).process?.env;
const metaConnectionRecord = await getMetaConnection(db);
const metaHealth = await getMetaConnectionHealth(db);
const metaReadiness = evaluateMetaLiveReadiness({ env: rawEnv, connection: metaConnectionRecord, db });
const braveStatus = await getDiscoveryProviderStatus(db, 'brave', rawEnv);

let autoControl = { mode: 'OFF', kill_switch_engaged: 0, kill_reason: null as string | null };
try {
  const row = await db.prepare('SELECT id, mode, kill_switch_engaged, kill_reason FROM automation_control WHERE id = 1 LIMIT 1').first() as any;
  if (row) {
    autoControl = {
      mode: row.mode || 'OFF',
      kill_switch_engaged: Number(row.kill_switch_engaged || 0),
      kill_reason: row.kill_reason || null
    };
  }
} catch (e) {
  // fallback
}
const isAutoScheduleEnabled = settings.auto_schedule_enabled === 'true';
const isKillSwitchEngaged = autoControl.kill_switch_engaged === 1;
---

<AdminLayout title="Pengaturan & Tema Magazine">
  <div class="max-w-4xl mx-auto space-y-6">
    <div class="pb-4 border-b border-slate-200 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">Pengaturan Blog & Tema (Customizer)</h1>
        <p class="text-xs text-slate-500 mt-1">Ubah identitas, warna tema magazine secara live, dan kode Webmaster SEO.</p>
      </div>
      <button
        type="button"
        id="save-all-settings-btn"
        class="rounded-xl bg-primary px-5 py-2 text-xs font-bold text-white hover:bg-primary-hover transition shadow-md shadow-primary/20"
      >
        💾 Simpan Pengaturan
      </button>
    </div>

    <!-- Quick Access: Watermark Engine Settings -->
    <div class="rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200/80 p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shadow-xs">
      <div class="flex items-center gap-3">
        <span class="text-2xl p-2 bg-white rounded-xl shadow-xs border border-blue-100">🛡️</span>
        <div>
          <h2 class="text-xs font-bold text-slate-900">LokaMedia Watermark Engine</h2>
          <p class="text-[11px] text-slate-500 mt-0.5">Konfigurasi atribusi teks, logo transparan, opasitas, dan posisi watermark media artikel.</p>
        </div>
      </div>
      <a
        href="/admin/watermark"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-[#0066ee] text-white text-xs font-bold hover:bg-blue-600 transition shadow-xs shrink-0"
      >
        <span>Buka Watermark Settings</span>
        <span>→</span>
      </a>
    </div>

    <!-- 1. Theme Color Customizer -->
    <div class="rounded-2xl bg-white border border-slate-200 p-6 space-y-4 shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
          <span>🎨</span> Theme Engine Customizer (Ubah Warna Tema Magazine)
        </h2>
        <span class="text-[10px] text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded font-semibold uppercase">Anti-FOUC Edge Injected</span>
      </div>

      <!-- Theme Color Presets -->
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-2">Preset Warna Magazine Siap Pakai:</label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <button
            type="button"
            class="preset-btn p-3 rounded-xl border border-slate-200 bg-slate-50 text-left hover:border-primary hover:bg-blue-50/50 transition"
            data-primary="#1e3a8a"
            data-accent="#d97706"
          >
            <div class="flex items-center gap-2 mb-1.5">
              <span class="h-4 w-4 rounded-full bg-[#1e3a8a]"></span>
              <span class="h-4 w-4 rounded-full bg-[#d97706]"></span>
            </div>
            <span class="text-xs font-bold text-slate-900 block">✨ Elegant White</span>
            <span class="text-[10px] text-slate-500">Deep Navy & Warm Amber</span>
          </button>

          <button
            type="button"
            class="preset-btn p-3 rounded-xl border border-slate-200 bg-slate-50 text-left hover:border-primary hover:bg-emerald-50/50 transition"
            data-primary="#059669"
            data-accent="#10b981"
          >
            <div class="flex items-center gap-2 mb-1.5">
              <span class="h-4 w-4 rounded-full bg-[#059669]"></span>
              <span class="h-4 w-4 rounded-full bg-[#10b981]"></span>
            </div>
            <span class="text-xs font-bold text-slate-900 block">Cyber Tech</span>
            <span class="text-[10px] text-slate-500">Emerald & Mint</span>
          </button>

          <button
            type="button"
            class="preset-btn p-3 rounded-xl border border-slate-200 bg-slate-50 text-left hover:border-primary hover:bg-red-50/50 transition"
            data-primary="#dc2626"
            data-accent="#f97316"
          >
            <div class="flex items-center gap-2 mb-1.5">
              <span class="h-4 w-4 rounded-full bg-[#dc2626]"></span>
              <span class="h-4 w-4 rounded-full bg-[#f97316]"></span>
            </div>
            <span class="text-xs font-bold text-slate-900 block">Breaking News</span>
            <span class="text-[10px] text-slate-500">Crimson Red & Coral</span>
          </button>

          <button
            type="button"
            class="preset-btn p-3 rounded-xl border border-slate-200 bg-slate-50 text-left hover:border-primary hover:bg-purple-50/50 transition"
            data-primary="#7c3aed"
            data-accent="#ec4899"
          >
            <div class="flex items-center gap-2 mb-1.5">
              <span class="h-4 w-4 rounded-full bg-[#7c3aed]"></span>
              <span class="h-4 w-4 rounded-full bg-[#ec4899]"></span>
            </div>
            <span class="text-xs font-bold text-slate-900 block">Creative Violet</span>
            <span class="text-[10px] text-slate-500">Purple & Pink</span>
          </button>
        </div>
      </div>

      <!-- Custom Color Hex Picker -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-3 border-t border-slate-100">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Warna Utama (Primary Color):</label>
          <div class="flex items-center gap-2">
            <input
              type="color"
              id="theme-primary-picker"
              value={settings.theme_primary_color || '#1e3a8a'}
              class="h-10 w-12 rounded-lg bg-transparent border-0 cursor-pointer"
            />
            <input
              type="text"
              id="theme-primary-hex"
              value={settings.theme_primary_color || '#1e3a8a'}
              class="flex-1 rounded-xl bg-slate-50 border border-slate-200 px-3 py-2 text-xs font-mono text-slate-800 focus:outline-none focus:bg-white"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Warna Aksen / Trending (Accent Color):</label>
          <div class="flex items-center gap-2">
            <input
              type="color"
              id="theme-accent-picker"
              value={settings.theme_accent_color || '#d97706'}
              class="h-10 w-12 rounded-lg bg-transparent border-0 cursor-pointer"
            />
            <input
              type="text"
              id="theme-accent-hex"
              value={settings.theme_accent_color || '#d97706'}
              class="flex-1 rounded-xl bg-slate-50 border border-slate-200 px-3 py-2 text-xs font-mono text-slate-800 focus:outline-none focus:bg-white"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- 2. General Identity Settings -->
    <div class="rounded-2xl bg-white border border-slate-200 p-6 space-y-4 shadow-sm">
      <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2 border-b border-slate-100 pb-3">
        <span>📰</span> Identitas & Branding Website
      </h2>

      <!-- Logo & Favicon Configuration -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 p-4 rounded-xl bg-slate-50 border border-slate-200/80">
        <!-- Logo Preview -->
        <div class="flex flex-col items-center justify-center p-3 bg-white rounded-xl border border-slate-200 shadow-2xs text-center">
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">Preview Logo</label>
          <div id="logo-preview-container" class="h-16 w-full flex items-center justify-center overflow-hidden">
            {settings.site_logo ? (
              <img id="logo-preview-img" src={settings.site_logo} alt="Logo Preview" class="max-h-14 max-w-full object-contain" />
            ) : (
              <div id="logo-preview-fallback" class="text-3xl">
                {settings.site_favicon || '🏡'}
              </div>
            )}
          </div>
          <span class="text-[10px] text-slate-400 mt-2">Tampil di Header & Login</span>
        </div>

        <!-- Logo URL & Favicon Inputs -->
        <div class="sm:col-span-2 space-y-3">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Logo Website (URL Gambar / R2 Storage)</label>
            <input
              type="url"
              id="site-logo"
              value={settings.site_logo || ''}
              placeholder="https://images.unsplash.com/... atau URL Cloudflare R2"
              class="w-full rounded-xl bg-white border border-slate-200 px-3.5 py-2 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-primary"
            />
            <p class="text-[10px] text-slate-500 mt-1">Kosongkan jika ingin menggunakan icon emoji sebagai pengganti logo.</p>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Favicon / Emoji Icon</label>
            <div class="flex items-center gap-2">
              <input
                type="text"
                id="site-favicon"
                value={settings.site_favicon || '🏡'}
                placeholder="🏡"
                class="w-24 text-center text-lg rounded-xl bg-white border border-slate-200 px-3 py-1.5 text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary"
              />
              <span class="text-xs text-slate-500">Emoji atau simbol identitas tab browser & kartu login.</span>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Website / Title</label>
          <input
            type="text"
            id="site-title"
            value={settings.site_title || 'RancangLoka'}
            class="w-full rounded-xl bg-slate-50 border border-slate-200 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary focus:bg-white"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Tagline Website</label>
          <input
            type="text"
            id="site-tagline"
            value={settings.site_tagline || 'Inspirasi Desain Interior, Arsitektur & Smart Living'}
            class="w-full rounded-xl bg-slate-50 border border-slate-200 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary focus:bg-white"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">URL Domain Website (Site URL)</label>
          <input
            type="url"
            id="site-url"
            value={settings.site_url || 'https://rancangloka.com'}
            placeholder="https://rancangloka.com"
            class="w-full rounded-xl bg-slate-50 border border-slate-200 px-3.5 py-2 text-xs text-slate-800 font-mono focus:outline-none focus:ring-1 focus:ring-primary focus:bg-white"
          />
          <span class="text-[10px] text-slate-400 mt-0.5 block">Format: https://domain.com (tanpa / di akhir)</span>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Deskripsi Umum Blog (Default Meta Description)</label>
        <textarea
          id="site-description"
          rows="2"
          class="w-full rounded-xl bg-slate-50 border border-slate-200 p-3 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary focus:bg-white"
        >{settings.site_description}</textarea>
      </div>
    </div>

    <!-- 3. Webmaster & SEO 2026 -->
    <div class="rounded-2xl bg-white border border-slate-200 p-6 space-y-5 shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
          <span>📈</span> SEO & Integrasi Webmaster (Search Console & Analytics)
        </h2>
        <span class="text-[10px] text-blue-700 bg-blue-50 px-2 py-0.5 rounded font-semibold uppercase">Auto Head Injection</span>
      </div>

      <div class="space-y-4">
        <!-- Google Search Console -->
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-2">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-bold text-slate-800 flex items-center gap-1.5">
              <span>🔍</span> Google Search Console (Kode Verifikasi Pemilik Situs)
            </label>
            {settings.google_search_console_code ? (
              <span class="text-[10px] text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full font-bold">✓ Terpasang di &lt;head&gt;</span>
            ) : (
              <span class="text-[10px] text-amber-700 bg-amber-100 px-2 py-0.5 rounded-full font-bold">Belum Terpasang</span>
            )}
          </div>
          <input
            type="text"
            id="gsc-code"
            value={settings.google_search_console_code || ''}
            placeholder='Tempel kode verifikasi Google atau seluruh tag: <meta name="google-site-verification" content="..." />'
            class="w-full rounded-xl bg-white border border-slate-200 px-3.5 py-2.5 text-xs text-slate-800 font-mono placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-primary shadow-xs"
          />
          <p class="text-[11px] text-slate-500 leading-relaxed">
            💡 <strong>Panduan:</strong> Di Google Search Console, pilih metode verifikasi <strong>Tag HTML</strong>. Anda bisa langsung menempelkan seluruh kode tag <code class="bg-slate-200/60 px-1 py-0.5 rounded text-[10px]">&lt;meta name="google-site-verification" content="..." /&gt;</code> atau hanya string kodenya saja. Sistem akan otomatis membersihkan dan menginjeksinya ke dalam <code class="bg-slate-200/60 px-1 py-0.5 rounded text-[10px]">&lt;head&gt;</code> website.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Bing Webmaster -->
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Bing / Microsoft Webmaster (msvalidate.01)</label>
            <input
              type="text"
              id="bing-code"
              value={settings.bing_webmaster_code || ''}
              placeholder="msvalidate.01=... atau kode verifikasi Bing"
              class="w-full rounded-xl bg-slate-50 border border-slate-200 px-3.5 py-2 text-xs text-slate-800 font-mono placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-primary focus:bg-white"
            />
          </div>

          <!-- GA4 -->
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Google Analytics (GA4) Measurement ID</label>
            <input
              type="text"
              id="ga-id"
              value={settings.google_analytics_id || ''}
              placeholder="G-XXXXXXXXXX"
              class="w-full rounded-xl bg-slate-50 border border-slate-200 px-3.5 py-2 text-xs text-slate-800 font-mono placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-primary focus:bg-white"
            />
          </div>
        </div>

        <!-- Default OG -->
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Default OpenGraph Image URL (Fallback Medsos Share)</label>
          <input
            type="url"
            id="default-og"
            value={settings.seo_default_og_image || ''}
            class="w-full rounded-xl bg-slate-50 border border-slate-200 px-3.5 py-2 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary focus:bg-white"
          />
        </div>

        <!-- Custom Head Scripts -->
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Custom Head Scripts & Meta Tags (Advanced HTML Injection)</label>
          <textarea
            id="custom-head-scripts"
            rows="3"
            placeholder="<!-- Tempel script Google AdSense, GTM, atau meta tag kustom di sini. Akan diinjeksi langsung ke <head> publik -->"
            class="w-full rounded-xl bg-slate-50 border border-slate-200 p-3 text-xs font-mono text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-primary focus:bg-white"
          >{settings.custom_head_scripts || ''}</textarea>
          <p class="text-[10px] text-slate-400 mt-1">Gunakan untuk kode Google AdSense, Google Tag Manager, atau meta tag verifikasi kustom.</p>
        </div>
      </div>
    </div>

    <!-- 4. Social Share Bar Customizer -->
    <div class="rounded-2xl bg-white border border-slate-200 p-6 space-y-4 shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
          <span>📱</span> Pengaturan Tombol Bagikan (Social Share Bar)
        </h2>
        <label class="flex items-center gap-2 cursor-pointer">
          <input
            type="checkbox"
            id="share-bar-enabled"
            checked={settings.share_bar_enabled !== 'false'}
            class="rounded bg-slate-100 border-slate-300 text-primary focus:ring-0"
          />
          <span class="text-xs font-bold text-slate-800">Aktifkan Share Bar</span>
        </label>
      </div>

      <div class="space-y-3">
        <label class="block text-xs font-semibold text-slate-700">Pilih Media Sosial yang Ditampilkan:</label>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          <label class="flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-slate-50 cursor-pointer hover:bg-slate-100 transition">
            <input type="checkbox" id="share-enable-wa" checked={settings.share_enable_wa !== 'false'} class="rounded text-emerald-600 focus:ring-0" />
            <span class="text-xs font-semibold text-slate-800">🟢 WhatsApp</span>
          </label>

          <label class="flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-slate-50 cursor-pointer hover:bg-slate-100 transition">
            <input type="checkbox" id="share-enable-x" checked={settings.share_enable_x !== 'false'} class="rounded text-slate-900 focus:ring-0" />
            <span class="text-xs font-semibold text-slate-800">⚫ X (Twitter)</span>
          </label>

          <label class="flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-slate-50 cursor-pointer hover:bg-slate-100 transition">
            <input type="checkbox" id="share-enable-fb" checked={settings.share_enable_facebook !== 'false'} class="rounded text-blue-600 focus:ring-0" />
            <span class="text-xs font-semibold text-slate-800">🔵 Facebook</span>
          </label>

          <label class="flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-slate-50 cursor-pointer hover:bg-slate-100 transition">
            <input type="checkbox" id="share-enable-in" checked={settings.share_enable_linkedin !== 'false'} class="rounded text-blue-600 focus:ring-0" />
            <span class="text-xs font-semibold text-slate-800">🔷 LinkedIn</span>
          </label>

          <label class="flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-slate-50 cursor-pointer hover:bg-slate-100 transition">
            <input type="checkbox" id="share-enable-tg" checked={settings.share_enable_telegram !== 'false'} class="rounded text-sky-500 focus:ring-0" />
            <span class="text-xs font-semibold text-slate-800">✈️ Telegram</span>
          </label>

          <label class="flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 bg-slate-50 cursor-pointer hover:bg-slate-100 transition">
            <input type="checkbox" id="share-enable-copy" checked={settings.share_enable_copy !== 'false'} class="rounded text-slate-600 focus:ring-0" />
            <span class="text-xs font-semibold text-slate-800">📋 Salin Tautan</span>
          </label>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Official Twitter/X Handle (Opsional untuk via @handle saat share)</label>
        <input
          type="text"
          id="share-twitter-handle"
          value={settings.share_twitter_handle || '@RancangLoka'}
          placeholder="@RancangLoka"
          class="w-full rounded-xl bg-slate-50 border border-slate-200 px-3.5 py-2 text-xs text-slate-800 font-mono focus:outline-none focus:ring-1 focus:ring-primary focus:bg-white"
        />
      </div>
    </div>

    <!-- 5. Footer & Official Social Links Manager -->
    <div class="rounded-2xl bg-white border border-slate-200 p-6 space-y-4 shadow-sm">
      <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2 border-b border-slate-100 pb-3">
        <span>🦶</span> Kustomisasi Footer & Media Sosial Resmi Redaksi
      </h2>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Deskripsi / Slogan Footer</label>
        <textarea
          id="footer-description"
          rows="2"
          class="w-full rounded-xl bg-slate-50 border border-slate-200 p-3 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary focus:bg-white"
        >{settings.footer_description || settings.site_description}</textarea>
      </div>

      <div class="space-y-3">
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">Tautan Media Sosial Resmi Redaksi (Muncul di Footer)</label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-[11px] font-medium text-slate-600 mb-1">📸 Instagram URL</label>
            <input type="url" id="social-instagram" value={settings.social_instagram || ''} placeholder="https://instagram.com/..." class="w-full rounded-xl bg-slate-50 border border-slate-200 px-3 py-1.5 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary" />
          </div>

          <div>
            <label class="block text-[11px] font-medium text-slate-600 mb-1">🎵 TikTok URL</label>
            <input type="url" id="social-tiktok" value={settings.social_tiktok || ''} placeholder="https://tiktok.com/@..." class="w-full rounded-xl bg-slate-50 border border-slate-200 px-3 py-1.5 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary" />
          </div>

          <div>
            <label class="block text-[11px] font-medium text-slate-600 mb-1">𝕏 X (Twitter) URL</label>
