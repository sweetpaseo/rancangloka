  <script>
    const primaryPicker = document.getElementById('theme-primary-picker') as HTMLInputElement;
    const primaryHex = document.getElementById('theme-primary-hex') as HTMLInputElement;
    const accentPicker = document.getElementById('theme-accent-picker') as HTMLInputElement;
    const accentHex = document.getElementById('theme-accent-hex') as HTMLInputElement;

    const siteLogoInput = document.getElementById('site-logo') as HTMLInputElement;
    const siteFaviconInput = document.getElementById('site-favicon') as HTMLInputElement;
    const siteTitleInput = document.getElementById('site-title') as HTMLInputElement;
    const siteTaglineInput = document.getElementById('site-tagline') as HTMLInputElement;
    const siteUrlInput = document.getElementById('site-url') as HTMLInputElement;
    const siteDescInput = document.getElementById('site-description') as HTMLTextAreaElement;
    const gscInput = document.getElementById('gsc-code') as HTMLInputElement;
    const bingInput = document.getElementById('bing-code') as HTMLInputElement;
    const gaInput = document.getElementById('ga-id') as HTMLInputElement;
    const ogInput = document.getElementById('default-og') as HTMLInputElement;
    const customHeadInput = document.getElementById('custom-head-scripts') as HTMLTextAreaElement;
    const previewContainer = document.getElementById('logo-preview-container') as HTMLElement;

    // Live Logo & Favicon Preview
    function updateLogoPreview() {
      if (!previewContainer) return;
      const logoUrl = siteLogoInput?.value?.trim();
      const favicon = siteFaviconInput?.value?.trim() || '🏡';

      if (logoUrl) {
        previewContainer.innerHTML = `<img id="logo-preview-img" src="${logoUrl}" alt="Logo Preview" class="max-h-14 max-w-full object-contain" onerror="this.parentElement.innerHTML='<span class=\\'text-xs text-red-500 font-medium\\'>URL gambar tidak valid</span>'" />`;
      } else {
        previewContainer.innerHTML = `<div id="logo-preview-fallback" class="text-3xl">${favicon}</div>`;
      }
    }

    siteLogoInput?.addEventListener('input', updateLogoPreview);
    siteFaviconInput?.addEventListener('input', updateLogoPreview);

    // Sync color pickers
    primaryPicker?.addEventListener('input', () => {
      if (primaryHex) primaryHex.value = primaryPicker.value;
      document.documentElement.style.setProperty('--color-primary', primaryPicker.value);
    });
    primaryHex?.addEventListener('input', () => {
      if (primaryPicker) primaryPicker.value = primaryHex.value;
      document.documentElement.style.setProperty('--color-primary', primaryHex.value);
    });

    accentPicker?.addEventListener('input', () => {
      if (accentHex) accentHex.value = accentPicker.value;
      document.documentElement.style.setProperty('--color-accent', accentPicker.value);
    });
    accentHex?.addEventListener('input', () => {
      if (accentPicker) accentPicker.value = accentHex.value;
      document.documentElement.style.setProperty('--color-accent', accentHex.value);
    });

    // Preset buttons
    document.querySelectorAll('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const p = btn.getAttribute('data-primary') || '#1e3a8a';
        const a = btn.getAttribute('data-accent') || '#d97706';
        if (primaryPicker) primaryPicker.value = p;
        if (primaryHex) primaryHex.value = p;
        if (accentPicker) accentPicker.value = a;
        if (accentHex) accentHex.value = a;
        document.documentElement.style.setProperty('--color-primary', p);
        document.documentElement.style.setProperty('--color-accent', a);
      });
    });

    // Save All Settings via API
    const saveBtn = document.getElementById('save-all-settings-btn') as HTMLButtonElement;
    saveBtn?.addEventListener('click', async () => {
      saveBtn.disabled = true;
      saveBtn.innerText = 'Menyimpan...';

      const payload = {
        site_logo: siteLogoInput?.value?.trim() || '',
        site_favicon: siteFaviconInput?.value?.trim() || '🏡',
        site_title: siteTitleInput?.value?.trim() || 'RancangLoka',
        site_tagline: siteTaglineInput?.value?.trim() || '',
        site_url: siteUrlInput?.value?.trim() || 'https://rancangloka.com',
        site_description: siteDescInput?.value?.trim() || '',
        theme_primary_color: primaryHex?.value || '#1e3a8a',
        theme_accent_color: accentHex?.value || '#d97706',
        google_search_console_code: gscInput?.value?.trim() || '',
        bing_webmaster_code: bingInput?.value?.trim() || '',
        google_analytics_id: gaInput?.value?.trim() || '',
        seo_default_og_image: ogInput?.value?.trim() || '',
        custom_head_scripts: customHeadInput?.value || '',
        // Social Share Bar Toggles
        share_bar_enabled: (document.getElementById('share-bar-enabled') as HTMLInputElement)?.checked ? 'true' : 'false',
        share_enable_wa: (document.getElementById('share-enable-wa') as HTMLInputElement)?.checked ? 'true' : 'false',
        share_enable_x: (document.getElementById('share-enable-x') as HTMLInputElement)?.checked ? 'true' : 'false',
        share_enable_facebook: (document.getElementById('share-enable-fb') as HTMLInputElement)?.checked ? 'true' : 'false',
        share_enable_linkedin: (document.getElementById('share-enable-in') as HTMLInputElement)?.checked ? 'true' : 'false',
        share_enable_telegram: (document.getElementById('share-enable-tg') as HTMLInputElement)?.checked ? 'true' : 'false',
        share_enable_copy: (document.getElementById('share-enable-copy') as HTMLInputElement)?.checked ? 'true' : 'false',
        share_twitter_handle: (document.getElementById('share-twitter-handle') as HTMLInputElement)?.value?.trim() || '@RancangLoka',
        // Footer & Social Links
        footer_description: (document.getElementById('footer-description') as HTMLTextAreaElement)?.value?.trim() || '',
        social_instagram: (document.getElementById('social-instagram') as HTMLInputElement)?.value?.trim() || '',
        social_tiktok: (document.getElementById('social-tiktok') as HTMLInputElement)?.value?.trim() || '',
        social_x: (document.getElementById('social-x') as HTMLInputElement)?.value?.trim() || '',
        social_youtube: (document.getElementById('social-youtube') as HTMLInputElement)?.value?.trim() || '',
        social_pinterest: (document.getElementById('social-pinterest') as HTMLInputElement)?.value?.trim() || '',
        social_linkedin: (document.getElementById('social-linkedin') as HTMLInputElement)?.value?.trim() || '',
        footer_copyright: (document.getElementById('footer-copyright') as HTMLInputElement)?.value?.trim() || ''
      };

      try {
        const res = await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.status !== 'error') {
          alert('Pengaturan identitas website, tema, tombol share, dan footer berhasil disimpan!');
        } else {
          alert(`Gagal menyimpan pengaturan: ${data.message || 'Server menolak perubahan.'}`);
        }
      } catch (err: any) {
        alert(`Gagal menyimpan pengaturan: ${err.message || 'Koneksi bermasalah.'}`);
      } finally {
        saveBtn.disabled = false;
        saveBtn.innerText = '💾 Simpan Pengaturan';
      }
    });

    // Toggle Global Auto-Schedule (Phase 5L4)
    const toggleAutoScheduleBtn = document.getElementById('btn-toggle-auto-schedule') as HTMLButtonElement;
    const autoScheduleFeedback = document.getElementById('auto-schedule-feedback') as HTMLElement;

    toggleAutoScheduleBtn?.addEventListener('click', async () => {
      const current = toggleAutoScheduleBtn.getAttribute('data-current-enabled') === 'true';
      const nextState = !current;
      const actionLabel = nextState ? 'MENGAKTIFKAN' : 'MENONAKTIFKAN';

      const confirmed = window.confirm(
        `Apakah Anda yakin ingin ${actionLabel} Global Auto-Schedule?\n\n` +
        (nextState
          ? 'Sistem auto-policy akan diizinkan mengevaluasi dan merencanakan publikasi secara otomatis.'
          : 'Sistem TIDAK AKAN membuat jadwal auto-policy baru. Jadwal yang sudah ada tidak dibatalkan.')
      );
      if (!confirmed) return;

      const reason = window.prompt(`Alasan perubahan status auto-schedule (opsional):`, `Operator switch to ${nextState ? 'ON' : 'OFF'}`);
      if (reason === null) return;

      toggleAutoScheduleBtn.disabled = true;
      toggleAutoScheduleBtn.innerText = 'Memproses...';

      try {
        const res = await fetch('/api/admin/publication/operator-control', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'toggle_auto_schedule',
            enabled: nextState,
            reason: reason || undefined
          })
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.message || 'Gagal mengubah status auto-schedule');

        if (autoScheduleFeedback) {
          autoScheduleFeedback.className = 'text-[11px] font-medium block text-emerald-600';
          autoScheduleFeedback.textContent = `✓ Global Auto-Schedule berhasil diubah menjadi ${nextState ? 'ON' : 'OFF'}. Memuat ulang...`;
        }
        setTimeout(() => window.location.reload(), 1000);
      } catch (err: any) {
        if (autoScheduleFeedback) {
          autoScheduleFeedback.className = 'text-[11px] font-medium block text-rose-600';
          autoScheduleFeedback.textContent = `Error: ${err.message || 'Terjadi kesalahan sistem'}`;
        }
        toggleAutoScheduleBtn.disabled = false;
        toggleAutoScheduleBtn.innerText = current ? 'Matikan Auto-Schedule (Turn OFF)' : 'Aktifkan Auto-Schedule (Turn ON)';
      }
    });

    // --- Brave Search API Client Script (ADMIN-BRAVE-SEARCH-SETTINGS-1) ---
    const braveToggle = document.getElementById('brave-enable-toggle') as HTMLInputElement | null;
    const braveApiKeyInput = document.getElementById('brave-api-key-input') as HTMLInputElement | null;
    const braveSaveKeyBtn = document.getElementById('brave-save-key-btn') as HTMLButtonElement | null;
    const braveRemoveKeyBtn = document.getElementById('brave-remove-key-btn') as HTMLButtonElement | null;
    const braveTestConnBtn = document.getElementById('brave-test-connection-btn') as HTMLButtonElement | null;
    const braveFeedback = document.getElementById('brave-feedback-banner');
    const braveStatusBadge = document.getElementById('brave-status-badge');

    function showBraveFeedback(msg: string, isError: boolean = false) {
      if (!braveFeedback) return;
      braveFeedback.className = isError
        ? 'p-3 rounded-xl text-xs font-medium block bg-rose-50 text-rose-700 border border-rose-200'
        : 'p-3 rounded-xl text-xs font-medium block bg-emerald-50 text-emerald-700 border border-emerald-200';
      braveFeedback.textContent = msg;
    }

    if (braveToggle) {
      braveToggle.addEventListener('change', async () => {
        const wantEnabled = braveToggle.checked;
        try {
          const res = await fetch('/api/admin/discovery-settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'toggle',
              provider: 'brave',
              enabled: wantEnabled
            })
          });
          const json = await res.json().catch(() => ({}));
          if (!res.ok) {
            braveToggle.checked = !wantEnabled; // revert toggle
            throw new Error(json.message || 'Gagal mengubah status Brave Search');
          }

          const newStatus = json.data?.status || (wantEnabled ? 'ACTIVE' : 'READY');
          if (braveStatusBadge) {
            braveStatusBadge.textContent = newStatus;
            braveStatusBadge.className = `text-[10px] px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider ${
              newStatus === 'ACTIVE'
                ? 'bg-emerald-100 text-emerald-800'
                : 'bg-blue-100 text-blue-800'
            }`;
          }
          showBraveFeedback(wantEnabled ? 'Brave Search berhasil diaktifkan (ACTIVE).' : 'Brave Search dinonaktifkan (OFF).', false);
        } catch (err: any) {
          showBraveFeedback(err.message || 'Terjadi kesalahan sistem', true);
        }
      });
    }

    if (braveSaveKeyBtn && braveApiKeyInput) {
      braveSaveKeyBtn.addEventListener('click', async () => {
        const key = braveApiKeyInput.value.trim();
        if (!key) {
          showBraveFeedback('API key tidak boleh kosong', true);
          return;
        }

        braveSaveKeyBtn.disabled = true;
        braveSaveKeyBtn.innerText = 'Menyimpan...';

        try {
          const res = await fetch('/api/admin/discovery-settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'save_key',
              provider: 'brave',
              apiKey: key
            })
          });
          const json = await res.json().catch(() => ({}));
          if (!res.ok) {
            throw new Error(json.message || 'Gagal menyimpan API Key');
          }

          showBraveFeedback('API Key berhasil disimpan dengan enkripsi AES-256-GCM.', false);
          braveApiKeyInput.value = '';
          braveApiKeyInput.placeholder = '••••••••••••';
          setTimeout(() => window.location.reload(), 800);
        } catch (err: any) {
          showBraveFeedback(err.message || 'Terjadi kesalahan sistem', true);
          braveSaveKeyBtn.disabled = false;
          braveSaveKeyBtn.innerText = 'Simpan Key';
        }
      });
    }

    if (braveRemoveKeyBtn) {
      braveRemoveKeyBtn.addEventListener('click', async () => {
        const confirmed = window.confirm('Hapus Brave Search API Key? Status akan dinonaktifkan (OFF).');
        if (!confirmed) return;

        braveRemoveKeyBtn.disabled = true;
        braveRemoveKeyBtn.innerText = 'Menghapus...';

        try {
          const res = await fetch('/api/admin/discovery-settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'remove_key',
              provider: 'brave'
            })
          });
          const json = await res.json().catch(() => ({}));
          if (!res.ok) {
            throw new Error(json.message || 'Gagal menghapus API Key');
          }

          showBraveFeedback('API Key berhasil dihapus. Brave Search dinonaktifkan.', false);
          setTimeout(() => window.location.reload(), 800);
        } catch (err: any) {
          showBraveFeedback(err.message || 'Terjadi kesalahan sistem', true);
          braveRemoveKeyBtn.disabled = false;
          braveRemoveKeyBtn.innerText = 'Hapus Key';
        }
      });
    }

    if (braveTestConnBtn) {
      braveTestConnBtn.addEventListener('click', async () => {
        braveTestConnBtn.disabled = true;
        braveTestConnBtn.innerText = 'Menguji...';

        try {
          const res = await fetch('/api/admin/discovery-settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'test_connection',
              provider: 'brave'
            })
          });
          const json = await res.json().catch(() => ({}));
          const testData = json.data;

          if (testData?.success) {
            showBraveFeedback('✓ ' + (testData.message || 'Koneksi berhasil'), false);
          } else {
            showBraveFeedback('✕ ' + (testData?.message || json.message || 'Koneksi gagal'), true);
          }
        } catch (err: any) {
          showBraveFeedback('✕ Kesalahan jaringan saat menguji koneksi', true);
        } finally {
          braveTestConnBtn.disabled = false;
          braveTestConnBtn.innerText = '⚡ Tes Koneksi';
        }
      });
    }
  </script>
</AdminLayout>
