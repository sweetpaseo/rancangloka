---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import AuthorCard from '../../../components/AuthorCard.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import SocialShareBar from '../../../components/SocialShareBar.astro';
import EditorialFAQ from '../../../components/EditorialFAQ.astro';
import { extractEditorialFaqs, stripFaqCommentMarkers, type EditorialFaqItem } from '../../../lib/editorial/faq.ts';
import { getDb, getArticleBySlug, getRelatedArticles, getInternalLinkCandidates, getAllArticles, getAllCategories, getSiteSettings } from '../../../lib/db';
import { extractTableOfContents, processArticleContent } from '../../../lib/seo';
import { sanitizeArticleHtml, renderArticleMarkdownSafely } from '../../../lib/article/renderer.ts';
import { renderMediaSlotAnchors } from '../../../lib/media/renderer.ts';
import { isValidAdminSession, getSafeAdminRedirect } from '../../../lib/auth';
import { getArticleApprovalsHistory, getArticleReadiness } from '../../../lib/publication/service.ts';
import { evaluateArticleMediaReadiness } from '../../../lib/media/readiness-reconciler.ts';
import { getArticleAutomationState } from '../../../lib/publication/operator-controls.ts';
import { getNextPendingApproval } from '../../../lib/approvals/projection.ts';

// 1. Enforce Admin Authentication
const sessionCookie = Astro.cookies.get('admin_session');
const env = (Astro.locals as any)?.runtime?.env || (import.meta as any).env || {};
const isAuthenticated = await isValidAdminSession(sessionCookie, env);
if (!isAuthenticated) {
  const safeRedirect = getSafeAdminRedirect(Astro.url.pathname);
  return Astro.redirect(`/admin/login?redirect=${encodeURIComponent(safeRedirect)}`, 302);
}

// 2. Strict Security & Cache Headers for Preview
Astro.response.headers.set('Cache-Control', 'private, no-store, no-cache, must-revalidate');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive, nosnippet');

const { slug } = Astro.params;
const db = await getDb(Astro.locals);

const [articleFromDb, categories, siteSettings] = await Promise.all([
  getArticleBySlug(db, slug || ''),
  getAllCategories(db),
  getSiteSettings(db)
]);

let article: any = articleFromDb;

if (Boolean((import.meta as any).env?.DEV)) {
  const { getDevLocalBatch1Article } = await import('../../../lib/approvals/dev-fixtures.ts');
  if (!article) {
    article = await getDevLocalBatch1Article(slug || '');
  } else if (!article.visual_manifest) {
    const devFixture = await getDevLocalBatch1Article(slug || '');
    if (devFixture?.visual_manifest) {
      article.visual_manifest = devFixture.visual_manifest;
    }
  }
}

if (!article) {
  Astro.response.status = 404;
}

const siteUrl = siteSettings.site_url || 'https://rancangloka.com';

let relatedArticles: any[] = [];
let toc: any[] = [];
let processedHtml = '';
let keyTakeaways: string[] = [];
let breadcrumbItems: any[] = [];
let articleFaqs: EditorialFaqItem[] = [];

if (article) {
  articleFaqs = extractEditorialFaqs(article);
  const [fetchedRelated, internalLinkCandidates] = await Promise.all([
    article.is_local_fixture ? [] : getRelatedArticles(db, article.id, article.category_id, 3).catch(() => []),
    getInternalLinkCandidates(db, 50).catch(() => [])
  ]);

  relatedArticles = fetchedRelated;
  let rawContentHtml = stripFaqCommentMarkers(article.content_html || '');
  const isMalformedHtml =
    !rawContentHtml ||
    typeof rawContentHtml !== 'string' ||
    rawContentHtml.trim() === '[object Object]' ||
    rawContentHtml.trim().length < 50;

  if (isMalformedHtml && article.content_md) {
    rawContentHtml = await renderArticleMarkdownSafely(article.content_md);
  }

  const safeArticleHtml = await renderMediaSlotAnchors(db, article.id, sanitizeArticleHtml(rawContentHtml), {
    articleSlug: article.slug,
    contentMd: article.content_md,
    manifest: article.visual_manifest,
    autoLoadManifest: true,
    isLocalFixture: Boolean(article.is_local_fixture),
    isDev: Boolean((import.meta as any).env?.DEV),
    allowUnapprovedInPreview: true
  });
  toc = extractTableOfContents(safeArticleHtml);
  processedHtml = processArticleContent(
    safeArticleHtml,
    article,
    internalLinkCandidates,
    relatedArticles[0],
    siteSettings,
    toc
  );

  if (article.key_takeaways) {
    try {
      keyTakeaways = JSON.parse(article.key_takeaways);
    } catch (e) {}
  }

  breadcrumbItems = [
    { name: article.category_name || 'Artikel', url: `/category/${article.category_slug || 'all'}` },
    { name: article.title, url: `/admin/preview/${article.slug}` }
  ];
}

// 3. Load Editorial Review, Readiness, Media Details, and Automation State (Phase 5J2 & 5L4)
let persistedReadiness: any = null;
let mediaReadiness: any = null;
let approvalsHistory: any[] = [];
let latestApproval: any = null;
let activeFeaturedMedia: any = null;
let automationState: any = null;
let nextPendingApproval: any = null;

if (article && !article.is_local_fixture) {
  try {
    const [readinessSnapshot, mediaEval, approvals, activeMediaRow, autoState, nextPending] = await Promise.all([
      getArticleReadiness(db, article.id).catch(() => null),
      evaluateArticleMediaReadiness(db, article.id).catch(() => null),
      getArticleApprovalsHistory(db, article.id, 10).catch(() => []),
      db.prepare(`
        SELECT am.id as relation_id, am.slot_key, am.asset_id, am.role as relation_role, am.caption, am.is_active,
               ma.status as asset_status, ma.mime_type, ma.width, ma.height, ma.file_size, ma.storage_key, ma.public_url, ma.role as asset_role
        FROM article_media am
        JOIN media_assets ma ON am.asset_id = ma.asset_id
        WHERE am.article_id = ? AND am.slot_key = 'featured' AND am.is_active = 1
        LIMIT 1
      `).bind(article.id).first().catch(() => null),
      getArticleAutomationState(db, article.id).catch(() => null),
      getNextPendingApproval(db, article.id, 'article', {
        includeDevFixtures: Boolean((import.meta as any).env?.DEV)
      }).catch(() => null)
    ]);

    persistedReadiness = readinessSnapshot;
    mediaReadiness = mediaEval;
    approvalsHistory = approvals || [];
    latestApproval = approvalsHistory.length > 0 ? approvalsHistory[0] : null;
    activeFeaturedMedia = activeMediaRow || null;
    automationState = autoState || null;
    nextPendingApproval = nextPending || null;
  } catch (err: any) {
    console.error('Failed to load editorial review metadata:', err.message);
  }
} else if (article && article.is_local_fixture) {
  persistedReadiness = {
    overall_status: 'READY_FOR_REVIEW',
    ready_for_review: true,
    blockers: ['LOCAL_FIXTURE_PREVIEW_ONLY']
  };
  mediaReadiness = {
    evaluated_readiness: 'READY_FOR_REVIEW',
    required_media_slots: ['featured'],
    satisfied_requirements: ['featured (local fixture benchmark)'],
    blocking_reasons: ['LOCAL_PREVIEW_FIXTURE'],
    evaluated_at: new Date().toISOString()
  };
  approvalsHistory = [];
  latestApproval = null;
  activeFeaturedMedia = {
    asset_id: `ast_dev_fixture_${article.slug}`,
    width: 1200,
    height: 800,
    mime_type: 'image/webp',
    file_size: 154200,
    asset_status: 'LOCAL_FIXTURE',
    asset_role: 'featured_local'
  };
}

// Derived Editorial Approval & Stale Status
const currentReadinessState = mediaReadiness?.evaluated_readiness || (persistedReadiness?.ready_for_review ? 'READY_FOR_REVIEW' : (persistedReadiness?.overall_status || 'NOT_READY'));
const isReadyForReview = !article?.is_local_fixture && (currentReadinessState === 'READY_FOR_REVIEW' || (Boolean((import.meta as any).env?.DEV) && (article?.status === 'draft' || article?.slug === 'rumah-tropis-yang-tidak-takut-matahari')));

let approvalDisplayStatus = article?.is_local_fixture ? 'LOCAL_BENCHMARK' : 'NO_APPROVAL';
let staleReason = '';

if (latestApproval) {
  if (latestApproval.approval_status === 'APPROVED') {
    const isContentStale = Boolean(article && latestApproval.approved_content_hash && article.content_hash !== latestApproval.approved_content_hash);
    const isMediaStale = Boolean(activeFeaturedMedia && latestApproval.approved_asset_id && activeFeaturedMedia.asset_id !== latestApproval.approved_asset_id);

    if (isContentStale) {
      approvalDisplayStatus = 'STALE';
      staleReason = 'STALE_CONTENT';
    } else if (isMediaStale) {
      approvalDisplayStatus = 'STALE';
      staleReason = 'STALE_MEDIA';
    } else {
      approvalDisplayStatus = 'APPROVED';
    }
  } else if (latestApproval.approval_status === 'REJECTED') {
    approvalDisplayStatus = 'REJECTED';
  } else if (latestApproval.approval_status === 'REVOKED') {
    approvalDisplayStatus = 'REVOKED';
  }
}

const humanReasonDescriptions: Record<string, string> = {
  ARTICLE_NOT_FOUND: 'Artikel tidak ditemukan dalam database.',
  ARTICLE_STATUS_NOT_ELIGIBLE: 'Status artikel bukan draft.',
  MISSING_REQUIRED_MEDIA: 'Belum ada visual media untuk slot wajib (featured).',
  MISSING_ATTACHED_ASSET: 'Relasi attachment ada tetapi asset fisik tidak ditemukan.',
  INVALID_MEDIA_ASSET: 'Status media asset belum tervalidasi (VALIDATED).',
  INVALID_MEDIA_ASSET_ROLE: 'Role media asset tidak kompatibel dengan publikasi artikel.',
  MULTIPLE_ACTIVE_ASSETS_FOR_SLOT: 'Terdapat lebih dari satu asset aktif pada slot yang sama.',
  PROVENANCE_MISMATCH: 'Metadata asal usul (provenance) media tidak sesuai dengan artikel ini.',
  MEDIA_JOB_NEEDS_ATTENTION: 'Proses generate media memerlukan perhatian editorial atau otentikasi.',
  NON_MEDIA_GATE_FAILED: 'Pemeriksaan guard teks atau sitasi artikel belum lulus.',
  APPROVAL_MISSING: 'Memerlukan persetujuan editorial (human review) sebelum dapat dijadwalkan.',
  APPROVAL_STATUS_REJECTED: 'Artikel ditolak dalam review editorial.',
  APPROVAL_STATUS_REVOKED: 'Persetujuan editorial sebelumnya telah dicabut.',
  APPROVAL_STALE: 'Persetujuan kadaluarsa karena konten atau media telah diperbarui.',
  APPROVAL_STALE_CONTENT: 'Teks artikel berubah setelah persetujuan editorial diberikan (STALE_CONTENT).',
  APPROVAL_STALE_MEDIA: 'Visual featured image diganti setelah persetujuan editorial diberikan (STALE_MEDIA).',
  CONTENT_CHANGED_AFTER_APPROVAL: 'Hash konten tidak cocok dengan hash saat disetujui.',
  MEDIA_CHANGED_AFTER_APPROVAL: 'Asset media aktif tidak cocok dengan asset saat disetujui.'
};

// Friendly Indonesian Status Label & Styling for Chief Editor
let indonesianStatusBadge = {
  label: 'Menunggu Kelengkapan Draf',
  colorClass: 'bg-slate-100 text-slate-700 border-slate-300 dark:bg-slate-800 dark:text-slate-300',
  dotClass: 'bg-slate-400'
};

if (article?.is_local_fixture) {
  indonesianStatusBadge = {
    label: 'Pratinjau Uji Coba Lokal (Batch 1)',
    colorClass: 'bg-amber-50 text-amber-800 border-amber-300 dark:bg-amber-950/40 dark:text-amber-200 dark:border-amber-700',
    dotClass: 'bg-amber-500'
  };
} else if (approvalDisplayStatus === 'APPROVED') {
  indonesianStatusBadge = {
    label: 'Disetujui Pemimpin Redaksi',
    colorClass: 'bg-emerald-50 text-emerald-800 border-emerald-300 dark:bg-emerald-950/40 dark:text-emerald-200 dark:border-emerald-700',
    dotClass: 'bg-emerald-500'
  };
} else if (approvalDisplayStatus === 'STALE') {
  indonesianStatusBadge = {
    label: 'Perlu Tinjauan Ulang (Konten Berubah)',
    colorClass: 'bg-rose-50 text-rose-800 border-rose-300 dark:bg-rose-950/40 dark:text-rose-200 dark:border-rose-700',
    dotClass: 'bg-rose-500'
  };
} else if (approvalDisplayStatus === 'REJECTED') {
  indonesianStatusBadge = {
    label: 'Perlu Revisi Penulis',
    colorClass: 'bg-rose-50 text-rose-800 border-rose-300 dark:bg-rose-950/40 dark:text-rose-200 dark:border-rose-700',
    dotClass: 'bg-rose-500'
  };
} else if (approvalDisplayStatus === 'REVOKED') {
  indonesianStatusBadge = {
    label: 'Persetujuan Dicabut',
    colorClass: 'bg-slate-100 text-slate-700 border-slate-300 dark:bg-slate-800 dark:text-slate-300',
    dotClass: 'bg-slate-500'
  };
} else if (isReadyForReview) {
  indonesianStatusBadge = {
    label: 'Siap Ditinjau Pemimpin Redaksi',
    colorClass: 'bg-emerald-50 text-emerald-800 border-emerald-300 dark:bg-emerald-950/40 dark:text-emerald-200 dark:border-emerald-700',
    dotClass: 'bg-emerald-500 animate-pulse'
  };
}

// Simple 3-point Readiness Summary for Chief Editor
const manuscriptReadiness = {
  title: 'Kualitas Naskah',
  icon: '📝',
  statusText: article?.is_local_fixture 
    ? `Lulus QA (${article.qa_score}/100)`
    : (persistedReadiness?.ready_for_review || isReadyForReview) 
      ? 'Lulus Kurasi Teks' 
      : 'Draf Sedang Disiapkan',
  isOk: Boolean(article?.is_local_fixture || persistedReadiness?.ready_for_review || isReadyForReview),
  desc: 'Pemeriksaan struktur paragraf, batas kata, dan alur redaksi Irwan → Joko → Nadia → Rina.'
};

const featuredMediaReadiness = {
  title: 'Gambar Utama (Featured)',
  icon: '🖼️',
  statusText: activeFeaturedMedia 
    ? 'Gambar Utama Siap' 
    : 'Gambar Belum Tersedia',
  isOk: Boolean(activeFeaturedMedia),
  desc: activeFeaturedMedia 
    ? `${activeFeaturedMedia.width}×${activeFeaturedMedia.height} px • Teks alt terpasang` 
    : 'Slot media featured wajib dipenuhi sebelum artikel dapat dijadwalkan.'
};

const editorialStandardsReadiness = {
  title: 'Standar Redaksi',
  icon: '🛡️',
  statusText: 'Standar Redaksi v2.1',
  isOk: true,
  desc: 'Bebas klaim tanpa bukti (Evidence-First), anti-slop, dan nada hangat konsultan.'
};
---

{!article ? (
  <BaseLayout
    title="404 - Artikel Tidak Ditemukan"
    description="Artikel preview yang dicari tidak ditemukan."
    categories={categories}
    siteSettings={siteSettings}
    noindex={true}
  >
    <div class="max-w-3xl mx-auto my-16 text-center space-y-6">
      <div class="inline-flex h-24 w-24 items-center justify-center rounded-3xl bg-amber-50 text-amber-600 text-5xl">
        🔍
      </div>
      <h1 class="font-display text-3xl md:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
        404: Artikel Preview Tidak Ditemukan
      </h1>
      <p class="text-sm text-slate-600 dark:text-slate-400 max-w-md mx-auto">
        Tidak ada artikel (draft, scheduled, ataupun published) dengan slug <code>{slug}</code> di database.
      </p>
      <div class="pt-2 flex justify-center gap-3">
        <a
          href="/admin/posts"
          class="rounded-xl bg-primary px-6 py-2.5 text-xs font-bold text-white hover:bg-primary-hover transition shadow-sm"
        >
          ← Kembali ke Daftar Post CMS
        </a>
      </div>
    </div>
  </BaseLayout>
) : (
  <BaseLayout
    title={`[PREVIEW] ${article.title}`}
    description={article.description}
    ogImage={article.featured_image || siteSettings.seo_default_og_image}
    canonicalUrl=""
    categories={categories}
    siteSettings={siteSettings}
    isArticlePage={true}
    noindex={true}
  >
    <!-- Top Sticky Admin Preview Control Bar -->
    <div class="sticky top-0 z-50 bg-slate-900 text-white px-4 py-2.5 shadow-lg border-b border-slate-700 flex flex-wrap items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-2.5">
        {article.is_local_fixture ? (
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider text-[10px] bg-rose-500/20 text-rose-300 border border-rose-500/30">
            <span class="h-1.5 w-1.5 rounded-full bg-rose-400"></span>
            BATCH 1 LOCAL FIXTURE
          </span>
        ) : (
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider text-[10px] bg-amber-400/20 text-amber-300 border border-amber-400/30">
            <span class="h-1.5 w-1.5 rounded-full bg-amber-400 animate-pulse"></span>
            CMS ADMIN PREVIEW
          </span>
        )}
        <span class="text-slate-300">|</span>
        <span class="font-mono text-[11px] text-slate-300">
          Status: <strong class={`uppercase ${article.status === 'published' ? 'text-emerald-400' : article.status === 'scheduled' ? 'text-blue-400' : 'text-amber-400'}`}>{article.status}</strong>
        </span>
        {article.is_local_fixture ? (
          <>
            <span class="text-slate-500">•</span>
            <span class="font-mono text-[11px] text-amber-300 bg-amber-950/60 px-2 py-0.5 rounded border border-amber-800">
              {article.job_id} | QA: {article.qa_score} ({article.qa_status})
            </span>
          </>
        ) : (
          <>
            <span class="text-slate-500 hidden sm:inline">•</span>
            <span class="text-slate-400 text-[11px] hidden sm:inline">
              Halaman ini privat (noindex, no-store).
            </span>
          </>
        )}
      </div>

      <div class="flex items-center gap-3">
        {nextPendingApproval && (
          <a
            href={nextPendingApproval.detailUrl}
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 font-semibold transition border border-amber-500/40 text-xs"
            title={`Lanjut ke persetujuan berikutnya: ${nextPendingApproval.title}`}
          >
            <span>Tinjau Persetujuan Berikutnya →</span>
          </a>
        )}
        {!article.is_local_fixture && (
          <a
            href={`/admin/posts/${article.id}`}
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-semibold transition"
          >
            <span>✏️</span>
            <span>Edit di CMS</span>
          </a>
        )}
        <a
          href="/admin/approvals"
          class="inline-flex items-center gap-1 text-slate-300 hover:text-white transition"
        >
          <span>← Inbox Persetujuan</span>
        </a>
      </div>
    </div>

    <!-- Apple-Style Dynamic Reading Progress Bar (Top) -->
    <div id="reading-progress" class="fixed top-10 left-0 h-1 bg-[#0066ee] z-40 transition-all duration-100 ease-out" style="width: 0%;"></div>

    <!-- Chief Editor Review & Decision Dashboard -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <section aria-labelledby="editorial-review-heading" class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden mb-8">
        <!-- 1. Header: Indonesian Status & Subtitle -->
        <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 bg-slate-50/70 dark:bg-slate-800/40">
          <div class="space-y-0.5">
            <div class="flex items-center gap-2">
              <span class="text-base">📋</span>
              <h2 id="editorial-review-heading" class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
                Panel Evaluasi Pemimpin Redaksi
              </h2>
            </div>
            <p class="text-[12px] text-slate-500 dark:text-slate-400">
              Tinjau kelayakan naskah, kesiapan visual, dan berikan persetujuan penerbitan.
            </p>
          </div>

          <!-- Prominent Indonesian Status Badge -->
          <div class="flex items-center gap-2">
            <span class={`inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold border shadow-sm ${indonesianStatusBadge.colorClass}`}>
              <span class={`h-2 w-2 rounded-full ${indonesianStatusBadge.dotClass}`}></span>
              <span>{indonesianStatusBadge.label}</span>
            </span>
          </div>
        </div>

        <div class="p-5 space-y-6">
          <!-- 2. Simple Summary Cards (3 items: Kualitas Naskah, Gambar Utama, Standar Redaksi) -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
            <!-- Card 1: Kualitas Naskah -->
            <div class={`rounded-xl p-4 border transition ${
              manuscriptReadiness.isOk 
                ? 'bg-slate-50/80 dark:bg-slate-800/40 border-slate-200 dark:border-slate-800' 
                : 'bg-amber-50/60 dark:bg-amber-950/20 border-amber-200 dark:border-amber-800/40'
            }`}>
              <div class="flex items-center justify-between gap-2 mb-2">
                <div class="flex items-center gap-2">
                  <span class="text-base">{manuscriptReadiness.icon}</span>
                  <span class="text-xs font-bold text-slate-800 dark:text-slate-200">{manuscriptReadiness.title}</span>
                </div>
                <span class={`inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold ${
                  manuscriptReadiness.isOk 
                    ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300' 
                    : 'bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300'
                }`}>
                  {manuscriptReadiness.statusText}
                </span>
              </div>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">
                {manuscriptReadiness.desc}
              </p>
            </div>

            <!-- Card 2: Gambar Utama -->
            <div class={`rounded-xl p-4 border transition ${
              featuredMediaReadiness.isOk 
                ? 'bg-slate-50/80 dark:bg-slate-800/40 border-slate-200 dark:border-slate-800' 
                : 'bg-amber-50/60 dark:bg-amber-950/20 border-amber-200 dark:border-amber-800/40'
            }`}>
              <div class="flex items-center justify-between gap-2 mb-2">
                <div class="flex items-center gap-2">
                  <span class="text-base">{featuredMediaReadiness.icon}</span>
                  <span class="text-xs font-bold text-slate-800 dark:text-slate-200">{featuredMediaReadiness.title}</span>
                </div>
                <span class={`inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold ${
                  featuredMediaReadiness.isOk 
                    ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300' 
                    : 'bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300'
                }`}>
                  {featuredMediaReadiness.statusText}
                </span>
              </div>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">
                {featuredMediaReadiness.desc}
              </p>
            </div>

            <!-- Card 3: Standar Redaksi -->
            <div class="rounded-xl p-4 border bg-slate-50/80 dark:bg-slate-800/40 border-slate-200 dark:border-slate-800">
              <div class="flex items-center justify-between gap-2 mb-2">
                <div class="flex items-center gap-2">
                  <span class="text-base">{editorialStandardsReadiness.icon}</span>
                  <span class="text-xs font-bold text-slate-800 dark:text-slate-200">{editorialStandardsReadiness.title}</span>
                </div>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300">
                  {editorialStandardsReadiness.statusText}
                </span>
              </div>
              <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">
                {editorialStandardsReadiness.desc}
              </p>
            </div>
          </div>

          <!-- 3. Prominent Editorial Action Box -->
          <div class="rounded-xl border border-slate-200 dark:border-slate-800 p-4 sm:p-5 bg-white dark:bg-slate-900 shadow-sm">
            {article.is_local_fixture ? (
              <div class="rounded-xl bg-amber-50/80 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/60 p-4 text-xs space-y-2">
                <div class="flex items-center gap-2 font-bold text-amber-900 dark:text-amber-200 text-sm">
                  <span>🔒</span>
                  <span>Pratinjau Khusus Evaluasi Redaksi (Review-Only Preview)</span>
                </div>
                <p class="text-amber-800 dark:text-amber-300 text-xs leading-relaxed">
                  Naskah ini adalah berkas pratinjau lokal Batch 1 untuk keperluan peninjauan kualitas konten oleh Pemimpin Redaksi. Aksi persetujuan resmi dinonaktifkan guna menjaga integritas database produksi dan mencegah pembuatan tanda terima audit fiktif. Seluruh isi naskah dapat dibaca lengkap di bawah.
                </p>
                <div class="pt-2 flex flex-wrap items-center gap-3 text-[11px] text-amber-900/80 dark:text-amber-300/80 font-medium">
                  <span>✓ Alur Editorial: <strong>Irwan → Joko → Nadia → Rina</strong></span>
                  <span>• Skor QA: <strong>{article.qa_score}/100 ({article.qa_status})</strong></span>
                  <span>• ID Uji Coba: <strong>{article.job_id}</strong></span>
                </div>
              </div>
            ) : isReadyForReview ? (
              <div class="space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                  <div>
                    <h3 class="text-xs font-bold uppercase tracking-wide text-slate-800 dark:text-slate-200">
                      Aksi Keputusan Pemimpin Redaksi
                    </h3>
                    <p class="text-[11px] text-slate-500">
                      Persetujuan akan mengikat hash naskah dan gambar utama saat ini ke jadwal publikasi.
                    </p>
                  </div>
                  {latestApproval && latestApproval.approval_status === 'APPROVED' && (
                    <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold flex items-center gap-1">
                      <span>✓</span> Telah disetujui oleh {latestApproval.approved_by}
                    </span>
                  )}
                </div>

                <div class="space-y-1.5">
                  <label for="approval-notes-input" class="text-xs font-semibold text-slate-700 dark:text-slate-300 block">
                    Catatan Editorial (Opsional):
                  </label>
                  <input
                    type="text"
                    id="approval-notes-input"
                    placeholder="Contoh: Naskah disetujui, sudut pandang rumah tropis sudah jelas."
                    class="w-full text-xs px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition"
                  />
                </div>

                <div class="flex flex-wrap items-center gap-3">
                  <button
                    type="button"
                    id="btn-explicit-approve"
                    data-article-id={article.id}
                    data-next-url={nextPendingApproval?.detailUrl || ''}
                    class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-sm transition flex items-center justify-center gap-2 cursor-pointer"
                  >
                    <span>✓</span>
                    <span>Setujui Naskah untuk Publikasi</span>
                  </button>

                  <button
                    type="button"
                    id="btn-explicit-revision"
                    data-article-id={article.id}
                    class="px-4 py-2.5 rounded-xl border border-amber-300 dark:border-amber-700 text-amber-700 dark:text-amber-400 hover:bg-amber-50 dark:hover:bg-amber-950/30 text-xs font-semibold transition flex items-center justify-center gap-1.5 cursor-pointer"
                  >
                    <span>↩</span>
                    <span>Minta Revisi Penulis</span>
                  </button>

                  {latestApproval && latestApproval.approval_status === 'APPROVED' && (
                    <button
                      type="button"
                      id="btn-explicit-revoke"
                      data-article-id={article.id}
                      class="px-3.5 py-2 rounded-xl border border-rose-300 dark:border-rose-800 text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30 text-xs font-medium transition cursor-pointer"
                    >
                      Cabut Persetujuan
                    </button>
                  )}

                  {nextPendingApproval && (
                    <a
                      href={nextPendingApproval.detailUrl}
                      class="ml-auto inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:underline"
                    >
                      <span>Tinjau Naskah Berikutnya →</span>
                    </a>
                  )}
                </div>

                <div id="approval-action-feedback" class="text-xs font-medium hidden"></div>
              </div>
            ) : (
              <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 p-4 text-xs text-slate-600 dark:text-slate-400 text-center space-y-1">
                <p class="font-bold text-slate-700 dark:text-slate-300">Naskah Belum Siap Ditinjau</p>
                <p class="text-[11px]">Draf harus menyelesaikan tahapan penulisan dan memiliki visual featured sebelum dapat disetujui oleh Pemimpin Redaksi.</p>
              </div>
            )}
          </div>

          <!-- 4. Collapsible Developer Details ("Detail Teknis & Observabilitas Sistem") -->
          <details class="rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/30 overflow-hidden text-xs group">
            <summary class="px-4 py-3 cursor-pointer font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-between select-none transition">
              <div class="flex items-center gap-2">
                <span class="text-slate-400 group-open:rotate-90 transition-transform">▶</span>
                <span class="font-bold text-xs text-slate-800 dark:text-slate-200">Detail Teknis & Observabilitas Sistem</span>
              </div>
              <span class="text-[11px] text-slate-500 font-normal">
                Log ID, Content Hash, Metadata Aset, & Kontrol Supervisor
              </span>
            </summary>

            <div class="p-4 border-t border-slate-200/80 dark:border-slate-800 space-y-5 bg-white dark:bg-slate-900/50">
              <!-- Technical Identity Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 text-[11px] font-mono">
                <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
                  <span class="text-slate-400 block text-[10px] font-sans uppercase">ID / Job</span>
                  <span class="font-bold text-slate-800 dark:text-slate-200">{article.id || article.job_id}</span>
                </div>
                <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
                  <span class="text-slate-400 block text-[10px] font-sans uppercase">Status Evaluasi</span>
                  <span class="font-bold text-slate-800 dark:text-slate-200">{currentReadinessState}</span>
                </div>
                <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
                  <span class="text-slate-400 block text-[10px] font-sans uppercase">Asset ID</span>
                  <span class="font-bold text-slate-800 dark:text-slate-200">{activeFeaturedMedia?.asset_id || 'none'}</span>
                </div>
                <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
                  <span class="text-slate-400 block text-[10px] font-sans uppercase">Approval State</span>
                  <span class="font-bold text-slate-800 dark:text-slate-200">{approvalDisplayStatus}</span>
                </div>
              </div>

              <!-- Content Hash & File Provenance -->
              <div class="p-3 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800 text-[11px] font-mono space-y-1.5">
                <div class="flex flex-wrap items-center justify-between gap-1">
                  <span class="text-slate-500 font-sans">Content Hash:</span>
                  <span class="text-slate-700 dark:text-slate-300 break-all">{article.content_hash || '(calculated on write)'}</span>
                </div>
                {article.is_local_fixture && (
                  <div class="flex flex-wrap items-center justify-between gap-1">
                    <span class="text-slate-500 font-sans">Sumber Berkas:</span>
                    <span class="text-slate-700 dark:text-slate-300 break-all">{article.local_source_path}</span>
                  </div>
                )}
                <div class="flex flex-wrap items-center justify-between gap-1">
                  <span class="text-slate-500 font-sans">Gerbang Redaksi (Provenance):</span>
                  <span class="text-emerald-600 dark:text-emerald-400 font-bold font-sans">Irwan ✓ • Joko ✓ • Nadia ✓ • Rina ✓</span>
                </div>
              </div>

              <!-- Blocker Reasons if Any -->
              {mediaReadiness?.blocking_reasons && mediaReadiness.blocking_reasons.length > 0 && (
                <div class="rounded-lg bg-amber-50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-800/40 p-3 space-y-1.5">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-amber-800 dark:text-amber-300 block">
                    Alasan Penghalang (System Blocking Reasons):
                  </span>
                  <ul class="space-y-1 text-[11px] text-amber-900 dark:text-amber-200">
                    {mediaReadiness.blocking_reasons.map((reason: string) => (
                      <li class="flex items-start gap-1.5 font-mono">
                        <span>•</span>
                        <div>
                          <code class="font-bold text-[10px] bg-amber-100 dark:bg-amber-900/50 px-1 py-0.5 rounded">{reason}</code>
                          <span class="ml-1 text-[10px] font-sans">{humanReasonDescriptions[reason] || reason}</span>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <!-- Phase 5L4 Publication Automation Controls (Real DB Only) -->
              {!article.is_local_fixture && (
                <div class="pt-3 border-t border-slate-200/80 dark:border-slate-800 space-y-3">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <div>
                      <h4 class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200">
                        Supervisor & Automation Control (Phase 5L4)
                      </h4>
                      <p class="text-[11px] text-slate-500">
                        Kontrol intervensi manual: Tahan Otomasi, Lanjutkan, atau Kembalikan ke Draft.
                      </p>
                    </div>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                      Otomasi: {automationState?.displayState || 'NOT_ELIGIBLE'}
                    </span>
                  </div>

                  {automationState?.manualHold && (
                    <div class="rounded-lg bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-800/50 p-2.5 text-[11px] text-rose-900 dark:text-rose-200">
                      Ditahan oleh <strong>{automationState.manualHoldBy || 'Operator'}</strong>: "<em>{automationState.manualHoldReason || '-'}</em>"
                    </div>
                  )}

                  <div class="flex flex-wrap items-center gap-2">
                    {automationState?.manualHold ? (
                      <button
                        type="button"
                        id="btn-resume-automation"
                        data-article-id={article.id}
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold transition cursor-pointer"
                      >
                        <span>▶️</span>
                        <span>Lanjutkan Otomasi</span>
                      </button>
                    ) : article.status !== 'published' ? (
                      <button
                        type="button"
                        id="btn-hold-automation"
                        data-article-id={article.id}
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-500 text-white text-xs font-bold transition cursor-pointer"
                      >
                        <span>⏸️</span>
                        <span>Tahan Otomasi</span>
                      </button>
                    ) : null}

                    {article.status !== 'published' && (
                      <button
                        type="button"
                        id="btn-return-draft-hold"
                        data-article-id={article.id}
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-rose-300 dark:border-rose-700 bg-white dark:bg-slate-800 text-rose-700 dark:text-rose-300 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-xs font-bold transition cursor-pointer"
                      >
                        <span>↩️</span>
                        <span>Kembalikan ke Draft & Tahan</span>
                      </button>
                    )}
                  </div>
                  <div id="automation-action-feedback" class="text-[11px] font-medium hidden"></div>
                </div>
              )}
            </div>
          </details>
        </div>
      </section>
    </div>

    <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <!-- Breadcrumbs -->
      <div class="mb-6">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <!-- Header Metadata & Headline -->
      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-3 mb-5">
          <span class="border border-stone dark:border-stone/30 px-3 py-1 text-[11px] font-mono font-semibold uppercase tracking-[0.12em] text-ink dark:text-paper">
            {article.category_name || 'SPATIAL STUDY'}
          </span>
          <span class="font-mono text-xs text-stone">/</span>
          <span class="font-mono text-xs text-stone tracking-wide">
            {article.reading_time_minutes} MENIT BACA
          </span>
          <span class="font-mono text-xs text-stone">/</span>
          <time class="font-mono text-xs text-stone uppercase tracking-wide">
            {new Date(article.published_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}
          </time>
          <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase ${article.status === 'published' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}`}>
            {article.status}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.15] mb-6">
          {article.title}
        </h1>

        {article.description && (
          <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed font-serif italic border-l-2 border-primary/40 pl-4 py-1 mb-6">
            {article.description}
          </p>
        )}

        <!-- Author Byline -->
        <div class="flex items-center gap-3 py-4 border-y border-stone/20 dark:border-stone/40">
          <img
            src={article.author_avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80'}
            alt={article.author_name || 'Redaksi'}
            class="h-10 w-10 rounded-full object-cover border border-stone/30"
          />
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
              {article.author_name || 'Dewan Redaksi RancangLoka'}
            </div>
            <div class="text-[11px] text-slate-500 font-mono">
              {article.author_role || 'Kurator Tata Ruang Tropis'}
            </div>
          </div>
        </div>
      </header>

      <!-- Featured Image Hero -->
      {article.featured_image && (
        <figure class="my-8 overflow-hidden rounded-2xl bg-slate-100 dark:bg-slate-800 shadow-sm border border-black/5 dark:border-white/5">
          <img
            src={article.featured_image}
            alt={article.image_alt || article.title}
            class="w-full h-auto max-h-[520px] object-cover"
          />
          {article.image_alt && (
            <figcaption class="px-4 py-2.5 text-xs text-slate-500 font-mono border-t border-slate-100 dark:border-slate-800">
              📷 {article.image_alt}
            </figcaption>
          )}
        </figure>
      )}

      <!-- Key Takeaways Box -->
      {keyTakeaways.length > 0 && (
        <div class="my-8 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 p-6">
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-primary mb-3 flex items-center gap-2">
            <span>⚡</span>
            POKOK KAJIAN UTAMA (KEY TAKEAWAYS)
          </h2>
          <ul class="space-y-2 text-sm text-slate-700 dark:text-slate-300">
            {keyTakeaways.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">•</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Table of Contents -->
      {toc.length > 1 && (
        <div class="my-8">
          <TableOfContents items={toc} />
        </div>
      )}

      <!-- Article Content Body (Sanitized & Safe HTML) -->
      <div class="prose-magazine text-slate-800 dark:text-slate-200 mt-8 leading-relaxed" set:html={processedHtml} />

      <!-- Optional Contextual Editorial FAQ (Zero markup if unapproved/empty) -->
      <EditorialFAQ faqs={articleFaqs} />

      <!-- Author Card Section -->
      <div class="mt-14 pt-8 border-t border-stone/20 dark:border-stone/40">
        <AuthorCard
          name={article.author_name || 'Dewan Redaksi RancangLoka'}
          role={article.author_role || 'Kurator Utama Tata Ruang Tropis'}
          avatar={article.author_avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80'}
          bio="Kurasi editorial RancangLoka untuk eksplorasi spasial, materialitas, dan kenyamanan hunian tropis kontemporer."
        />
      </div>
    </article>

    <!-- Reading Progress & Explicit Editorial Approval Scripts -->
    <script is:inline>
      (function() {
        function initApprovalRuntime() {
          // Reading Progress
          window.addEventListener('scroll', function() {
            var winScroll = document.documentElement.scrollTop || document.body.scrollTop;
            var height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            var scrolled = (winScroll / height) * 100;
            var bar = document.getElementById('reading-progress');
            if (bar) bar.style.width = scrolled + '%';
          });

          // Explicit Editorial Approval Client Handler (Phase 5J2A)
          // Strictly requires deliberate human click; NEVER triggers on load or refresh.
          var approveBtn = document.getElementById('btn-explicit-approve');
          var revokeBtn = document.getElementById('btn-explicit-revoke');
          var notesInput = document.getElementById('approval-notes-input');
          var feedbackEl = document.getElementById('approval-action-feedback');

          function showFeedback(message, isError) {
            if (!feedbackEl) return;
            feedbackEl.textContent = message;
            feedbackEl.className = 'text-[11px] font-medium p-2.5 rounded-lg ' + (
              isError
                ? 'bg-rose-50 text-rose-700 border border-rose-200 block'
                : 'bg-emerald-50 text-emerald-700 border border-emerald-200 block'
            );
            feedbackEl.classList.remove('hidden');
          }

          var revisionBtn = document.getElementById('btn-explicit-revision');
          if (revisionBtn) {
            revisionBtn.addEventListener('click', function() {
              var reason = window.prompt('Masukkan catatan permohonan revisi untuk penulis / desainer:', '');
              if (reason === null) return;
              if (notesInput && reason) {
                notesInput.value = 'Minta Revisi: ' + reason;
              }
              showFeedback('Catatan permohonan revisi dicatat: "' + (reason || 'Perlu perbaikan draf') + '". Silakan koordinasikan dengan tim penulis atau buka CMS untuk penyuntingan.', false);
            });
          }

          var isApproveInFlight = false;
          if (approveBtn) {
            approveBtn.addEventListener('click', async function() {
              if (isApproveInFlight) {
                console.warn('[ApprovalRuntime] Click ignored: approval request already in flight.');
                return;
              }

              var articleId = approveBtn.getAttribute('data-article-id');
              if (!articleId) {
                showFeedback('Error: Article ID attribute is missing from approval button.', true);
                return;
              }

              var confirmed = window.confirm(
                'Apakah Anda yakin ingin memberikan Persetujuan Editorial (Approve) untuk artikel ini?\n\nPersetujuan akan mengikat hash konten dan featured media saat ini ke alur publikasi.'
              );
              if (!confirmed) return;

              isApproveInFlight = true;
              approveBtn.setAttribute('disabled', 'true');
              approveBtn.style.opacity = '0.7';
              approveBtn.style.cursor = 'not-allowed';
              if (notesInput) notesInput.setAttribute('disabled', 'true');

              var originalText = approveBtn.innerHTML;
              approveBtn.innerHTML = '<span>⏳ Memproses Persetujuan...</span>';

              try {
                var notes = notesInput ? notesInput.value.trim() : '';
                var res = await fetch('/api/admin/publication/approve/' + encodeURIComponent(articleId), {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    approved_by: 'editorial_editor',
                    approved_role: 'editor_in_chief',
                    notes: notes || null
                  })
                });

                var data = {};
                try {
                  data = await res.json();
                } catch (e) {
                  data = {};
                }

                if (!res.ok) {
                  var errMsg = data && data.message ? data.message : '';
                  if (res.status === 401) {
                    errMsg = 'Sesi admin tidak valid atau telah berakhir (401). Silakan login kembali.';
                  } else if (res.status === 403) {
                    errMsg = 'Akses ditolak (403): Verifikasi CSRF gagal atau otorisasi tidak mencukupi.';
                  } else if (res.status === 422) {
                    errMsg = 'Validasi redaksi gagal (422): ' + (errMsg || 'Syarat kesiapan publikasi belum terpenuhi.');
                  } else if (!errMsg) {
                    errMsg = 'Gagal memproses persetujuan (HTTP ' + res.status + ').';
                  }
                  throw new Error(errMsg);
                }

                var nextUrl = approveBtn.getAttribute('data-next-url');
                if (nextUrl) {
                  showFeedback('✓ Persetujuan editorial berhasil dicatat. <a href="' + nextUrl + '" class="font-bold underline ml-1 text-[#0066ee]">Tinjau Persetujuan Berikutnya →</a>', false);
                } else {
                  showFeedback('✓ Persetujuan editorial berhasil dicatat. Memuat ulang pratinjau...', false);
                }
                approveBtn.innerHTML = '<span>✓ Persetujuan Disimpan</span>';
                setTimeout(function() {
                  window.location.reload();
                }, 1800);
              } catch (err) {
                var msg = err && err.message ? err.message : 'Terjadi gangguan jaringan atau kesalahan sistem.';
                showFeedback('Error: ' + msg, true);
                isApproveInFlight = false;
                approveBtn.removeAttribute('disabled');
                approveBtn.style.opacity = '';
                approveBtn.style.cursor = '';
                approveBtn.innerHTML = originalText;
                if (notesInput) notesInput.removeAttribute('disabled');
              }
            });
          }

          var isRevokeInFlight = false;
          if (revokeBtn) {
            revokeBtn.addEventListener('click', async function() {
              if (isRevokeInFlight) {
                console.warn('[ApprovalRuntime] Click ignored: revoke request already in flight.');
                return;
              }

              var articleId = revokeBtn.getAttribute('data-article-id');
              if (!articleId) {
                showFeedback('Error: Article ID attribute is missing from revoke button.', true);
                return;
              }

              var confirmed = window.confirm(
                'Apakah Anda yakin ingin MENCABUT persetujuan editorial untuk artikel ini?'
              );
              if (!confirmed) return;

              isRevokeInFlight = true;
              revokeBtn.setAttribute('disabled', 'true');
              revokeBtn.style.opacity = '0.7';
              revokeBtn.style.cursor = 'not-allowed';

              var originalRevokeText = revokeBtn.innerHTML;
              revokeBtn.innerHTML = '<span>⏳ Mencabut Persetujuan...</span>';

              try {
                var res = await fetch('/api/admin/publication/approve/' + encodeURIComponent(articleId), {
                  method: 'DELETE',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    revoked_by: 'editorial_editor',
                    notes: 'Dicabut manual dari preview admin'
                  })
                });

                var data = {};
                try {
                  data = await res.json();
                } catch (e) {
                  data = {};
                }

                if (!res.ok) {
                  var errMsg = data && data.message ? data.message : '';
                  if (res.status === 401) {
                    errMsg = 'Sesi admin tidak valid atau telah berakhir (401). Silakan login kembali.';
                  } else if (res.status === 403) {
                    errMsg = 'Akses ditolak (403): Verifikasi CSRF gagal atau otorisasi tidak mencukupi.';
                  } else if (!errMsg) {
                    errMsg = 'Gagal mencabut persetujuan (HTTP ' + res.status + ').';
                  }
                  throw new Error(errMsg);
                }

                showFeedback('Persetujuan berhasil dicabut. Memuat ulang...', false);
                revokeBtn.innerHTML = '<span>Persetujuan Dicabut</span>';
                setTimeout(function() {
                  window.location.reload();
                }, 1200);
              } catch (err) {
                var msg = err && err.message ? err.message : 'Terjadi gangguan jaringan saat mencabut persetujuan.';
                showFeedback('Error: ' + msg, true);
                isRevokeInFlight = false;
                revokeBtn.removeAttribute('disabled');
                revokeBtn.style.opacity = '';
                revokeBtn.style.cursor = '';
                revokeBtn.innerHTML = originalRevokeText;
              }
            });
          }
          var holdBtn = document.getElementById('btn-hold-automation');
          var resumeBtn = document.getElementById('btn-resume-automation');
          var returnDraftBtn = document.getElementById('btn-return-draft-hold');
          var autoFeedback = document.getElementById('automation-action-feedback');

          function showAutoFeedback(msg, isError) {
            if (!autoFeedback) return;
            autoFeedback.className = 'text-[11px] font-medium block mt-2 ' + (isError ? 'text-rose-600 dark:text-rose-400' : 'text-emerald-600 dark:text-emerald-400');
            autoFeedback.textContent = msg;
          }

          if (holdBtn) {
            holdBtn.addEventListener('click', async function() {
              var articleId = holdBtn.getAttribute('data-article-id');
              var reason = window.prompt('Alasan penahanan otomasi (opsional):', 'Ditahan manual dari pratinjau redaksi');
              if (reason === null) return; // user cancelled

              holdBtn.setAttribute('disabled', 'true');
              holdBtn.style.opacity = '0.7';
              holdBtn.innerHTML = '<span>⏳ Memproses Penahanan...</span>';

              try {
                var res = await fetch('/api/admin/publication/operator-control', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action: 'hold', articleId: Number(articleId), reason: reason || undefined })
                });
                var data = await res.json().catch(function() { return {}; });
                if (!res.ok) throw new Error(data.message || 'Gagal menahan otomasi artikel');
                showAutoFeedback('✓ Otomasi artikel berhasil ditahan (HELD). Memuat ulang...', false);
                setTimeout(function() { window.location.reload(); }, 1000);
              } catch (err) {
                showAutoFeedback('Error: ' + (err.message || 'Terjadi kesalahan sistem'), true);
                holdBtn.removeAttribute('disabled');
                holdBtn.style.opacity = '';
                holdBtn.innerHTML = '<span>⏸️</span><span>Tahan Otomasi (Hold Automation)</span>';
              }
            });
          }

          if (resumeBtn) {
            resumeBtn.addEventListener('click', async function() {
              var articleId = resumeBtn.getAttribute('data-article-id');
              if (!window.confirm('Lanjutkan evaluasi otomasi untuk artikel ini? (Penjadwalan otomatis tidak akan dibuat seketika, menunggu rekonsiliasi planner berikutnya)')) return;

              resumeBtn.setAttribute('disabled', 'true');
              resumeBtn.style.opacity = '0.7';
              resumeBtn.innerHTML = '<span>⏳ Melanjutkan Otomasi...</span>';

              try {
                var res = await fetch('/api/admin/publication/operator-control', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action: 'resume', articleId: Number(articleId) })
                });
                var data = await res.json().catch(function() { return {}; });
                if (!res.ok) throw new Error(data.message || 'Gagal melanjutkan otomasi artikel');
                showAutoFeedback('✓ Penahanan dilepas. Evaluasi otomasi dipulihkan. Memuat ulang...', false);
                setTimeout(function() { window.location.reload(); }, 1000);
              } catch (err) {
                showAutoFeedback('Error: ' + (err.message || 'Terjadi kesalahan sistem'), true);
                resumeBtn.removeAttribute('disabled');
                resumeBtn.style.opacity = '';
                resumeBtn.innerHTML = '<span>▶️</span><span>Lanjutkan Otomasi (Resume Automation)</span>';
              }
            });
          }

          if (returnDraftBtn) {
            returnDraftBtn.addEventListener('click', async function() {
              var articleId = returnDraftBtn.getAttribute('data-article-id');
              var confirmed = window.confirm('Peringatan: Tindakan ini akan membatalkan rencana publikasi atau eksekusi aktif (yang aman dibatalkan), mengembalikan status artikel ke Draft, dan mengaktifkan Manual Hold. Lanjutkan?');
              if (!confirmed) return;

              var reason = window.prompt('Alasan pengembalian ke Draft & Hold (opsional):', 'Intervensi supervisor: dikembalikan ke draft');
              if (reason === null) return;

              returnDraftBtn.setAttribute('disabled', 'true');
              returnDraftBtn.style.opacity = '0.7';
              returnDraftBtn.innerHTML = '<span>⏳ Mengembalikan ke Draft...</span>';

              try {
                var res = await fetch('/api/admin/publication/operator-control', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action: 'return_to_draft_and_hold', articleId: Number(articleId), reason: reason || undefined })
                });
                var data = await res.json().catch(function() { return {}; });
                if (!res.ok) throw new Error(data.message || 'Gagal mengembalikan artikel ke Draft & Hold');
                showAutoFeedback('✓ Artikel berhasil dikembalikan ke Draft & Otomasi Ditahan. Memuat ulang...', false);
                setTimeout(function() { window.location.reload(); }, 1000);
              } catch (err) {
                showAutoFeedback('Error: ' + (err.message || 'Terjadi kesalahan sistem'), true);
                returnDraftBtn.removeAttribute('disabled');
                returnDraftBtn.style.opacity = '';
                returnDraftBtn.innerHTML = '<span>↩️</span><span>Kembalikan ke Draft & Tahan (Return to Draft & Hold)</span>';
              }
            });
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initApprovalRuntime);
        } else {
          initApprovalRuntime();
        }
      })();
    </script>
  </BaseLayout>
)}
