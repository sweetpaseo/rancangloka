---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import AuthorCard from '../../../components/AuthorCard.astro';
import RelatedArticles from '../../../components/RelatedArticles.astro';
import SocialShareBar from '../../../components/SocialShareBar.astro';
import { getDb, getArticleBySlug, getRelatedArticles, getAllArticles, getAllCategories, getSiteSettings } from '../../../lib/db';
import { extractTableOfContents, processArticleContent } from '../../../lib/seo';
import { sanitizeArticleHtml } from '../../../lib/article/renderer.ts';
import { isValidAdminSession, getSafeAdminRedirect } from '../../../lib/auth';
import { getArticleApprovalsHistory, getArticleReadiness } from '../../../lib/publication/service.ts';
import { evaluateArticleMediaReadiness } from '../../../lib/media/readiness-reconciler.ts';
import { getArticleAutomationState } from '../../../lib/publication/operator-controls.ts';

// 1. Enforce Admin Authentication
const sessionCookie = Astro.cookies.get('admin_session');
const env = (Astro.locals as any)?.runtime?.env || (import.meta as any).env || {};
const isAuthenticated = await isValidAdminSession(sessionCookie, env);
if (!isAuthenticated) {
  const safeRedirect = getSafeAdminRedirect(Astro.url.pathname);
  return Astro.redirect(`/admin/login?redirect=${encodeURIComponent(safeRedirect)}`, 302);
}

// 2. Strict Security & Cache Headers for Preview
Astro.response.headers.set('Cache-Control', 'private, no-store, no-cache, must-revalidate');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive, nosnippet');

const { slug } = Astro.params;
const db = await getDb(Astro.locals);

const [article, categories, siteSettings] = await Promise.all([
  getArticleBySlug(db, slug || ''),
  getAllCategories(db),
  getSiteSettings(db)
]);

if (!article) {
  Astro.response.status = 404;
}

const siteUrl = siteSettings.site_url || 'https://rancangloka.com';

let relatedArticles: any[] = [];
let toc: any[] = [];
let processedHtml = '';
let keyTakeaways: string[] = [];
let breadcrumbItems: any[] = [];

if (article) {
  const [fetchedRelated, allArticles] = await Promise.all([
    getRelatedArticles(db, article.id, article.category_id, 3),
    getAllArticles(db, 50, 0, 'published')
  ]);

  relatedArticles = fetchedRelated;
  const safeArticleHtml = sanitizeArticleHtml(article.content_html);
  toc = extractTableOfContents(safeArticleHtml);
  processedHtml = processArticleContent(
    safeArticleHtml,
    article,
    allArticles,
    relatedArticles[0],
    siteSettings,
    toc
  );

  if (article.key_takeaways) {
    try {
      keyTakeaways = JSON.parse(article.key_takeaways);
    } catch (e) {}
  }

  breadcrumbItems = [
    { name: article.category_name || 'Artikel', url: `/category/${article.category_slug || 'all'}` },
    { name: article.title, url: `/admin/preview/${article.slug}` }
  ];
}

// 3. Load Editorial Review, Readiness, Media Details, and Automation State (Phase 5J2 & 5L4)
let persistedReadiness: any = null;
let mediaReadiness: any = null;
let approvalsHistory: any[] = [];
let latestApproval: any = null;
let activeFeaturedMedia: any = null;
let automationState: any = null;

if (article) {
  try {
    const [readinessSnapshot, mediaEval, approvals, activeMediaRow, autoState] = await Promise.all([
      getArticleReadiness(db, article.id).catch(() => null),
      evaluateArticleMediaReadiness(db, article.id).catch(() => null),
      getArticleApprovalsHistory(db, article.id, 10).catch(() => []),
      db.prepare(`
        SELECT am.id as relation_id, am.slot_key, am.asset_id, am.role as relation_role, am.caption, am.is_active,
               ma.status as asset_status, ma.mime_type, ma.width, ma.height, ma.file_size, ma.storage_key, ma.public_url, ma.role as asset_role
        FROM article_media am
        JOIN media_assets ma ON am.asset_id = ma.asset_id
        WHERE am.article_id = ? AND am.slot_key = 'featured' AND am.is_active = 1
        LIMIT 1
      `).bind(article.id).first().catch(() => null),
      getArticleAutomationState(db, article.id).catch(() => null)
    ]);

    persistedReadiness = readinessSnapshot;
    mediaReadiness = mediaEval;
    approvalsHistory = approvals || [];
    latestApproval = approvalsHistory.length > 0 ? approvalsHistory[0] : null;
    activeFeaturedMedia = activeMediaRow || null;
    automationState = autoState || null;
  } catch (err: any) {
    console.error('Failed to load editorial review metadata:', err.message);
  }
}

// Derived Editorial Approval & Stale Status
const currentReadinessState = mediaReadiness?.evaluated_readiness || (persistedReadiness?.ready_for_review ? 'READY_FOR_REVIEW' : (persistedReadiness?.overall_status || 'NOT_READY'));
const isReadyForReview = currentReadinessState === 'READY_FOR_REVIEW';

let approvalDisplayStatus = 'NO_APPROVAL';
let staleReason = '';

if (latestApproval) {
  if (latestApproval.approval_status === 'APPROVED') {
    const isContentStale = Boolean(article && latestApproval.approved_content_hash && article.content_hash !== latestApproval.approved_content_hash);
    const isMediaStale = Boolean(activeFeaturedMedia && latestApproval.approved_asset_id && activeFeaturedMedia.asset_id !== latestApproval.approved_asset_id);

    if (isContentStale) {
      approvalDisplayStatus = 'STALE';
      staleReason = 'STALE_CONTENT';
    } else if (isMediaStale) {
      approvalDisplayStatus = 'STALE';
      staleReason = 'STALE_MEDIA';
    } else {
      approvalDisplayStatus = 'APPROVED';
    }
  } else if (latestApproval.approval_status === 'REJECTED') {
    approvalDisplayStatus = 'REJECTED';
  } else if (latestApproval.approval_status === 'REVOKED') {
    approvalDisplayStatus = 'REVOKED';
  }
}

const humanReasonDescriptions: Record<string, string> = {
  ARTICLE_NOT_FOUND: 'Artikel tidak ditemukan dalam database.',
  ARTICLE_STATUS_NOT_ELIGIBLE: 'Status artikel bukan draft.',
  MISSING_REQUIRED_MEDIA: 'Belum ada visual media untuk slot wajib (featured).',
  MISSING_ATTACHED_ASSET: 'Relasi attachment ada tetapi asset fisik tidak ditemukan.',
  INVALID_MEDIA_ASSET: 'Status media asset belum tervalidasi (VALIDATED).',
  INVALID_MEDIA_ASSET_ROLE: 'Role media asset tidak kompatibel dengan publikasi artikel.',
  MULTIPLE_ACTIVE_ASSETS_FOR_SLOT: 'Terdapat lebih dari satu asset aktif pada slot yang sama.',
  PROVENANCE_MISMATCH: 'Metadata asal usul (provenance) media tidak sesuai dengan artikel ini.',
  MEDIA_JOB_NEEDS_ATTENTION: 'Proses generate media memerlukan perhatian editorial atau otentikasi.',
  NON_MEDIA_GATE_FAILED: 'Pemeriksaan guard teks atau sitasi artikel belum lulus.',
  APPROVAL_MISSING: 'Memerlukan persetujuan editorial (human review) sebelum dapat dijadwalkan.',
  APPROVAL_STATUS_REJECTED: 'Artikel ditolak dalam review editorial.',
  APPROVAL_STATUS_REVOKED: 'Persetujuan editorial sebelumnya telah dicabut.',
  APPROVAL_STALE: 'Persetujuan kadaluarsa karena konten atau media telah diperbarui.',
  APPROVAL_STALE_CONTENT: 'Teks artikel berubah setelah persetujuan editorial diberikan (STALE_CONTENT).',
  APPROVAL_STALE_MEDIA: 'Visual featured image diganti setelah persetujuan editorial diberikan (STALE_MEDIA).',
  CONTENT_CHANGED_AFTER_APPROVAL: 'Hash konten tidak cocok dengan hash saat disetujui.',
  MEDIA_CHANGED_AFTER_APPROVAL: 'Asset media aktif tidak cocok dengan asset saat disetujui.'
};
---

{!article ? (
  <BaseLayout
    title="404 - Artikel Tidak Ditemukan"
    description="Artikel preview yang dicari tidak ditemukan."
    categories={categories}
    siteSettings={siteSettings}
    noindex={true}
  >
    <div class="max-w-3xl mx-auto my-16 text-center space-y-6">
      <div class="inline-flex h-24 w-24 items-center justify-center rounded-3xl bg-amber-50 text-amber-600 text-5xl">
        🔍
      </div>
      <h1 class="font-display text-3xl md:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
        404: Artikel Preview Tidak Ditemukan
      </h1>
      <p class="text-sm text-slate-600 dark:text-slate-400 max-w-md mx-auto">
        Tidak ada artikel (draft, scheduled, ataupun published) dengan slug <code>{slug}</code> di database.
      </p>
      <div class="pt-2 flex justify-center gap-3">
        <a
          href="/admin/posts"
          class="rounded-xl bg-primary px-6 py-2.5 text-xs font-bold text-white hover:bg-primary-hover transition shadow-sm"
        >
          ← Kembali ke Daftar Post CMS
        </a>
      </div>
    </div>
  </BaseLayout>
) : (
  <BaseLayout
    title={`[PREVIEW] ${article.title}`}
    description={article.description}
    ogImage={article.featured_image || siteSettings.seo_default_og_image}
    canonicalUrl=""
    categories={categories}
    siteSettings={siteSettings}
    isArticlePage={true}
    noindex={true}
  >
    <!-- Top Sticky Admin Preview Control Bar -->
    <div class="sticky top-0 z-50 bg-slate-900 text-white px-4 py-2.5 shadow-lg border-b border-slate-700 flex flex-wrap items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-2.5">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider text-[10px] bg-amber-400/20 text-amber-300 border border-amber-400/30">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          CMS ADMIN PREVIEW
        </span>
        <span class="text-slate-300">|</span>
        <span class="font-mono text-[11px] text-slate-300">
          Status: <strong class={`uppercase ${article.status === 'published' ? 'text-emerald-400' : article.status === 'scheduled' ? 'text-blue-400' : 'text-amber-400'}`}>{article.status}</strong>
        </span>
        <span class="text-slate-500 hidden sm:inline">•</span>
        <span class="text-slate-400 text-[11px] hidden sm:inline">
          Halaman ini privat (noindex, no-store).
        </span>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={`/admin/posts/${article.id}`}
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-semibold transition"
        >
          <span>✏️</span>
          <span>Edit di CMS</span>
        </a>
        <a
          href="/admin/posts"
          class="inline-flex items-center gap-1 text-slate-300 hover:text-white transition"
        >
          <span>← Semua Post</span>
        </a>
      </div>
    </div>

    <!-- Apple-Style Dynamic Reading Progress Bar (Top) -->
    <div id="reading-progress" class="fixed top-10 left-0 h-1 bg-[#0066ee] z-40 transition-all duration-100 ease-out" style="width: 0%;"></div>

    <!-- Phase 5J2 Editorial Review & Readiness Dashboard Panel -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <section aria-labelledby="editorial-review-heading" class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden mb-8">
        <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 bg-slate-50/50 dark:bg-slate-800/30">
          <div class="flex items-center gap-2.5">
            <span class="text-base">📋</span>
            <div>
              <h2 id="editorial-review-heading" class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
                Editorial Review & Publication Readiness Gate
              </h2>
              <p class="text-[11px] text-slate-500">
                Pemeriksaan kesiapan visual, metadata, dan persetujuan redaksi sebelum penjadwalan publikasi.
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <!-- Readiness Badge -->
            <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border ${
              isReadyForReview
                ? 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-800'
                : 'bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-800'
            }`}>
              <span class={`h-2 w-2 rounded-full ${isReadyForReview ? 'bg-emerald-500 animate-pulse' : 'bg-amber-500'}`}></span>
              <span>{currentReadinessState}</span>
            </span>

            <!-- Approval Badge -->
            <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border ${
              approvalDisplayStatus === 'APPROVED'
                ? 'bg-emerald-100 text-emerald-800 border-emerald-300 dark:bg-emerald-900/40 dark:text-emerald-200'
                : approvalDisplayStatus === 'STALE'
                ? 'bg-rose-50 text-rose-700 border-rose-200 dark:bg-rose-950/40 dark:text-rose-300'
                : approvalDisplayStatus === 'REJECTED'
                ? 'bg-rose-100 text-rose-800 border-rose-300'
                : 'bg-slate-100 text-slate-700 border-slate-300 dark:bg-slate-800 dark:text-slate-300'
            }`}>
              <span>{approvalDisplayStatus === 'APPROVED' ? '✓ APPROVED' : approvalDisplayStatus === 'STALE' ? '⚠️ STALE' : approvalDisplayStatus}</span>
            </span>
          </div>
        </div>

        <div class="p-5 grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
          <!-- 1. Readiness Panel -->
          <div class="space-y-3">
            <h3 class="font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wide text-[11px] flex items-center gap-1.5">
              <span>📊</span>
              <span>Status Kesiapan (Readiness)</span>
            </h3>

            <div class="rounded-xl bg-slate-50 dark:bg-slate-800/50 p-3.5 border border-slate-100 dark:border-slate-800 space-y-2">
              <div class="flex justify-between items-center text-[11px]">
                <span class="text-slate-500">Evaluasi State:</span>
                <span class="font-mono font-bold text-slate-800 dark:text-slate-200">{currentReadinessState}</span>
              </div>
              <div class="flex justify-between items-center text-[11px]">
                <span class="text-slate-500">Slot Wajib:</span>
                <span class="font-mono text-slate-700 dark:text-slate-300">
                  {mediaReadiness?.required_media_slots?.length ? mediaReadiness.required_media_slots.join(', ') : 'featured'}
                </span>
              </div>
              <div class="flex justify-between items-center text-[11px]">
                <span class="text-slate-500">Slot Terpenuhi:</span>
                <span class="font-mono text-emerald-600 dark:text-emerald-400 font-bold">
                  {mediaReadiness?.satisfied_requirements?.length ? mediaReadiness.satisfied_requirements.join(', ') : 'none'}
                </span>
              </div>
              <div class="flex justify-between items-center text-[11px]">
                <span class="text-slate-500">Waktu Evaluasi:</span>
                <span class="font-mono text-[10px] text-slate-500">
                  {mediaReadiness?.evaluated_at ? new Date(mediaReadiness.evaluated_at).toLocaleString('id-ID') : 'Belum dievaluasi'}
                </span>
              </div>
            </div>

            <!-- Blocker Reasons Display -->
            {mediaReadiness?.blocking_reasons && mediaReadiness.blocking_reasons.length > 0 ? (
              <div class="rounded-xl bg-amber-50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-800/40 p-3 space-y-1.5">
                <span class="text-[10px] font-bold uppercase tracking-wider text-amber-800 dark:text-amber-300 block">
                  Alasan Penghalang (Blockers):
                </span>
                <ul class="space-y-1 text-[11px] text-amber-900 dark:text-amber-200">
                  {mediaReadiness.blocking_reasons.map((reason: string) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-amber-600 dark:text-amber-400 font-mono">•</span>
                      <div>
                        <code class="font-bold text-[10px] bg-amber-100 dark:bg-amber-900/50 px-1 py-0.5 rounded">{reason}</code>
                        <span class="ml-1 text-[10px]">{humanReasonDescriptions[reason] || reason}</span>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <div class="rounded-xl bg-emerald-50 dark:bg-emerald-950/20 border border-emerald-200 dark:border-emerald-800/40 p-2.5 text-[11px] text-emerald-800 dark:text-emerald-300 flex items-center gap-1.5">
                <span>✓</span>
                <span>Semua prasyarat otomatis visual & editorial terpenuhi.</span>
              </div>
            )}
          </div>

          <!-- 2. Featured Media Review Panel -->
          <div class="space-y-3">
            <h3 class="font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wide text-[11px] flex items-center gap-1.5">
              <span>🖼️</span>
              <span>Featured Media Review</span>
            </h3>

            {activeFeaturedMedia ? (
              <div class="rounded-xl bg-slate-50 dark:bg-slate-800/50 p-3.5 border border-slate-100 dark:border-slate-800 space-y-2">
                <div class="flex justify-between items-center text-[11px]">
                  <span class="text-slate-500">Asset ID:</span>
                  <span class="font-mono font-bold text-slate-800 dark:text-slate-200">{activeFeaturedMedia.asset_id}</span>
                </div>
                <div class="flex justify-between items-center text-[11px]">
                  <span class="text-slate-500">Dimensi & Tipe:</span>
                  <span class="font-mono text-slate-700 dark:text-slate-300">
                    {activeFeaturedMedia.width}×{activeFeaturedMedia.height} ({activeFeaturedMedia.mime_type})
                  </span>
                </div>
                <div class="flex justify-between items-center text-[11px]">
                  <span class="text-slate-500">Ukuran File:</span>
                  <span class="font-mono text-slate-700 dark:text-slate-300">
                    {Math.round((activeFeaturedMedia.file_size || 0) / 1024)} KB
                  </span>
                </div>
                <div class="flex justify-between items-center text-[11px]">
                  <span class="text-slate-500">Status Asset:</span>
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300">
                    {activeFeaturedMedia.asset_status}
                  </span>
                </div>
                <div class="flex justify-between items-center text-[11px]">
                  <span class="text-slate-500">Role Resolusi:</span>
                  <span class="font-mono text-[10px] text-slate-600 dark:text-slate-400">
                    {activeFeaturedMedia.asset_role || activeFeaturedMedia.relation_role}
                  </span>
                </div>
              </div>
            ) : (
              <div class="rounded-xl bg-amber-50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-800/40 p-3 text-[11px] text-amber-800 dark:text-amber-300">
                ⚠️ Belum ada active attachment pada slot 'featured' di article_media.
              </div>
            )}
          </div>

          <!-- 3. Current Approval Status & Human Action Panel -->
          <div class="space-y-3">
            <h3 class="font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wide text-[11px] flex items-center gap-1.5">
              <span>✍️</span>
              <span>Persetujuan Redaksi (Editorial Approval)</span>
            </h3>

            <div class="rounded-xl bg-slate-50 dark:bg-slate-800/50 p-3.5 border border-slate-100 dark:border-slate-800 space-y-2">
              <div class="flex justify-between items-center text-[11px]">
                <span class="text-slate-500">Status:</span>
                <span class="font-bold uppercase text-slate-800 dark:text-slate-200">{approvalDisplayStatus}</span>
              </div>
              {staleReason && (
                <div class="flex justify-between items-center text-[11px]">
                  <span class="text-rose-500 font-semibold">Stale Reason:</span>
                  <span class="font-mono font-bold text-rose-600 dark:text-rose-400">{staleReason}</span>
                </div>
              )}
              {latestApproval && (
                <>
                  <div class="flex justify-between items-center text-[11px]">
                    <span class="text-slate-500">Oleh:</span>
                    <span class="font-medium text-slate-700 dark:text-slate-300">
                      {latestApproval.approved_by} ({latestApproval.approved_role})
                    </span>
                  </div>
                  <div class="flex justify-between items-center text-[11px]">
                    <span class="text-slate-500">Tanggal:</span>
                    <span class="font-mono text-[10px] text-slate-500">
                      {new Date(latestApproval.created_at).toLocaleString('id-ID')}
                    </span>
                  </div>
                  {latestApproval.notes && (
                    <div class="text-[11px] pt-1 border-t border-slate-200/50 dark:border-slate-700/50 text-slate-600 dark:text-slate-400 italic">
                      "{latestApproval.notes}"
                    </div>
                  )}
                </>
              )}
            </div>

            <!-- Explicit Human Action Form -->
            <div class="pt-1">
              {isReadyForReview ? (
                <div class="space-y-2.5">
                  <div class="space-y-1">
                    <label for="approval-notes-input" class="text-[10px] font-bold uppercase tracking-wider text-slate-500 block">
                      Catatan Editorial (Opsional):
                    </label>
                    <input
                      type="text"
                      id="approval-notes-input"
                      placeholder="Contoh: Disetujui untuk kurasi akhir arsitektur tropis"
                      class="w-full text-xs px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-primary"
                    />
                  </div>

                  <div class="flex flex-col gap-2">
                    <button
                      type="button"
                      id="btn-explicit-approve"
                      data-article-id={article.id}
                      class="w-full py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow transition flex items-center justify-center gap-1.5"
                    >
                      <span>✓</span>
                      <span>Setujui untuk Alur Publikasi (Approve)</span>
                    </button>

                    {latestApproval && latestApproval.approval_status === 'APPROVED' && (
                      <button
                        type="button"
                        id="btn-explicit-revoke"
                        data-article-id={article.id}
                        class="w-full py-2 px-3 rounded-lg border border-rose-300 dark:border-rose-800 text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30 text-[11px] font-semibold transition"
                      >
                        Cabut Persetujuan (Revoke)
                      </button>
                    )}
                  </div>
                  <div id="approval-action-feedback" class="text-[11px] font-medium hidden"></div>
                </div>
              ) : (
                <div class="rounded-xl bg-slate-100 dark:bg-slate-800/80 p-3 text-[11px] text-slate-500 text-center space-y-1">
                  <p class="font-bold text-slate-700 dark:text-slate-300">Kontrol Persetujuan Dinonaktifkan</p>
                  <p>Artikel harus mencapai status <code>READY_FOR_REVIEW</code> sebelum dapat disetujui oleh editor.</p>
                </div>
              )}
            </div>
          </div>
        </div>

        <!-- Phase 5L4: Publication Automation & Supervisor Control Surface -->
        <div class="border-t border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40 p-5 space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2">
              <span class="text-sm">🤖</span>
              <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
                  Automation & Hands-Off Supervisor Controls (Phase 5L4)
                </h3>
                <p class="text-[11px] text-slate-500">
                  Kontrol intervensi manual redaksi: Tahan Otomasi, Lanjutkan, atau Kembalikan ke Draft.
                </p>
              </div>
            </div>

            <!-- Auto Schedule Status Badge -->
            <div class="flex items-center gap-2">
              <span class="text-[11px] font-semibold text-slate-500">Status Otomasi:</span>
              <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border ${
                automationState?.displayState === 'HELD'
                  ? 'bg-rose-100 text-rose-800 border-rose-300 dark:bg-rose-950/40 dark:text-rose-200'
                  : automationState?.displayState === 'PUBLISHED'
                  ? 'bg-emerald-100 text-emerald-800 border-emerald-300'
                  : automationState?.displayState === 'SCHEDULED'
                  ? 'bg-indigo-100 text-indigo-800 border-indigo-300'
                  : automationState?.displayState === 'PLANNED'
                  ? 'bg-blue-100 text-blue-800 border-blue-300'
                  : automationState?.displayState === 'GLOBAL_AUTO_SCHEDULE_OFF'
                  ? 'bg-amber-100 text-amber-800 border-amber-300'
                  : 'bg-slate-100 text-slate-800 border-slate-300'
              }`}>
                <span>{automationState?.displayState || 'NOT_ELIGIBLE'}</span>
              </span>
            </div>
          </div>

          <!-- Metadata info banner if held -->
          {automationState?.manualHold && (
            <div class="rounded-xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-800/50 p-3.5 text-xs text-rose-900 dark:text-rose-200 space-y-1">
              <div class="font-bold flex items-center gap-1.5">
                <span>⏸️</span>
                <span>Artikel Ditahan Manual (HELD) — Penjadwalan otomatis diblokir sepenuhnya.</span>
              </div>
              <div class="text-[11px] text-rose-700 dark:text-rose-300">
                Ditahan oleh <strong>{automationState.manualHoldBy || 'Operator'}</strong> pada {automationState.manualHoldAt ? new Date(automationState.manualHoldAt).toLocaleString('id-ID') : '-'}.
                {automationState.manualHoldReason && <span> Alasan: "<em>{automationState.manualHoldReason}</em>"</span>}
              </div>
            </div>
          )}

          <!-- Action Buttons Bar -->
          <div class="flex flex-wrap items-center gap-3 pt-1">
            {automationState?.manualHold ? (
              <button
                type="button"
                id="btn-resume-automation"
                data-article-id={article.id}
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold shadow-sm transition"
              >
                <span>▶️</span>
                <span>Lanjutkan Otomasi (Resume Automation)</span>
              </button>
            ) : article.status !== 'published' ? (
              <button
                type="button"
                id="btn-hold-automation"
                data-article-id={article.id}
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-amber-600 hover:bg-amber-500 text-white text-xs font-bold shadow-sm transition"
              >
                <span>⏸️</span>
                <span>Tahan Otomasi (Hold Automation)</span>
              </button>
            ) : null}

            {article.status !== 'published' && (
              <button
                type="button"
                id="btn-return-draft-hold"
                data-article-id={article.id}
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-rose-300 dark:border-rose-700 bg-white dark:bg-slate-800 text-rose-700 dark:text-rose-300 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-xs font-bold shadow-sm transition"
              >
                <span>↩️</span>
                <span>Kembalikan ke Draft & Tahan (Return to Draft & Hold)</span>
              </button>
            )}
          </div>
          <div id="automation-action-feedback" class="text-[11px] font-medium hidden"></div>
        </div>
      </section>
    </div>

    <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <!-- Breadcrumbs -->
      <div class="mb-6">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <!-- Header Metadata & Headline -->
      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-3 mb-5">
          <span class="border border-stone dark:border-stone/30 px-3 py-1 text-[11px] font-mono font-semibold uppercase tracking-[0.12em] text-ink dark:text-paper">
            {article.category_name || 'SPATIAL STUDY'}
          </span>
          <span class="font-mono text-xs text-stone">/</span>
          <span class="font-mono text-xs text-stone tracking-wide">
            {article.reading_time_minutes} MENIT BACA
          </span>
          <span class="font-mono text-xs text-stone">/</span>
          <time class="font-mono text-xs text-stone uppercase tracking-wide">
            {new Date(article.published_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}
          </time>
          <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase ${article.status === 'published' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}`}>
            {article.status}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.15] mb-6">
          {article.title}
        </h1>

        {article.description && (
          <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed font-serif italic border-l-2 border-primary/40 pl-4 py-1 mb-6">
            {article.description}
          </p>
        )}

        <!-- Author Byline -->
        <div class="flex items-center gap-3 py-4 border-y border-stone/20 dark:border-stone/40">
          <img
            src={article.author_avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80'}
            alt={article.author_name || 'Redaksi'}
            class="h-10 w-10 rounded-full object-cover border border-stone/30"
          />
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
              {article.author_name || 'Dewan Redaksi RancangLoka'}
            </div>
            <div class="text-[11px] text-slate-500 font-mono">
              {article.author_role || 'Kurator Tata Ruang Tropis'}
            </div>
          </div>
        </div>
      </header>

      <!-- Featured Image Hero -->
      {article.featured_image && (
        <figure class="my-8 overflow-hidden rounded-2xl bg-slate-100 dark:bg-slate-800 shadow-sm border border-black/5 dark:border-white/5">
          <img
            src={article.featured_image}
            alt={article.image_alt || article.title}
            class="w-full h-auto max-h-[520px] object-cover"
          />
          {article.image_alt && (
            <figcaption class="px-4 py-2.5 text-xs text-slate-500 font-mono border-t border-slate-100 dark:border-slate-800">
              📷 {article.image_alt}
            </figcaption>
          )}
        </figure>
      )}

      <!-- Key Takeaways Box -->
      {keyTakeaways.length > 0 && (
        <div class="my-8 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 p-6">
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-primary mb-3 flex items-center gap-2">
            <span>⚡</span>
            POKOK KAJIAN UTAMA (KEY TAKEAWAYS)
          </h2>
          <ul class="space-y-2 text-sm text-slate-700 dark:text-slate-300">
            {keyTakeaways.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-primary font-bold">•</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Table of Contents -->
      {toc.length > 1 && (
        <div class="my-8">
          <TableOfContents items={toc} />
        </div>
      )}

      <!-- Article Content Body (Sanitized & Safe HTML) -->
      <div class="prose-magazine text-slate-800 dark:text-slate-200 mt-8 leading-relaxed" set:html={processedHtml} />

      <!-- Author Card Section -->
      <div class="mt-14 pt-8 border-t border-stone/20 dark:border-stone/40">
        <AuthorCard
          name={article.author_name || 'Dewan Redaksi RancangLoka'}
          role={article.author_role || 'Kurator Utama Tata Ruang Tropis'}
          avatar={article.author_avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80'}
          bio="Kurasi editorial RancangLoka untuk eksplorasi spasial, materialitas, dan kenyamanan hunian tropis kontemporer."
        />
      </div>
    </article>

    <!-- Reading Progress & Explicit Editorial Approval Scripts -->
    <script is:inline>
      (function() {
        function initApprovalRuntime() {
          // Reading Progress
          window.addEventListener('scroll', function() {
            var winScroll = document.documentElement.scrollTop || document.body.scrollTop;
            var height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            var scrolled = (winScroll / height) * 100;
            var bar = document.getElementById('reading-progress');
            if (bar) bar.style.width = scrolled + '%';
          });

          // Explicit Editorial Approval Client Handler (Phase 5J2A)
          // Strictly requires deliberate human click; NEVER triggers on load or refresh.
          var approveBtn = document.getElementById('btn-explicit-approve');
          var revokeBtn = document.getElementById('btn-explicit-revoke');
          var notesInput = document.getElementById('approval-notes-input');
          var feedbackEl = document.getElementById('approval-action-feedback');

          function showFeedback(message, isError) {
            if (!feedbackEl) return;
            feedbackEl.textContent = message;
            feedbackEl.className = 'text-[11px] font-medium p-2.5 rounded-lg ' + (
              isError
                ? 'bg-rose-50 text-rose-700 border border-rose-200 block'
                : 'bg-emerald-50 text-emerald-700 border border-emerald-200 block'
            );
            feedbackEl.classList.remove('hidden');
          }

          var isApproveInFlight = false;
          if (approveBtn) {
            approveBtn.addEventListener('click', async function() {
              if (isApproveInFlight) {
                console.warn('[ApprovalRuntime] Click ignored: approval request already in flight.');
                return;
              }

              var articleId = approveBtn.getAttribute('data-article-id');
              if (!articleId) {
                showFeedback('Error: Article ID attribute is missing from approval button.', true);
                return;
              }

              var confirmed = window.confirm(
                'Apakah Anda yakin ingin memberikan Persetujuan Editorial (Approve) untuk artikel ini?\n\nPersetujuan akan mengikat hash konten dan featured media saat ini ke alur publikasi.'
              );
              if (!confirmed) return;

              isApproveInFlight = true;
              approveBtn.setAttribute('disabled', 'true');
              approveBtn.style.opacity = '0.7';
              approveBtn.style.cursor = 'not-allowed';
              if (notesInput) notesInput.setAttribute('disabled', 'true');

              var originalText = approveBtn.innerHTML;
              approveBtn.innerHTML = '<span>⏳ Memproses Persetujuan...</span>';

              try {
                var notes = notesInput ? notesInput.value.trim() : '';
                var res = await fetch('/api/admin/publication/approve/' + encodeURIComponent(articleId), {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    approved_by: 'editorial_editor',
                    approved_role: 'editor_in_chief',
                    notes: notes || null
                  })
                });

                var data = {};
                try {
                  data = await res.json();
                } catch (e) {
                  data = {};
                }

                if (!res.ok) {
                  var errMsg = data && data.message ? data.message : '';
                  if (res.status === 401) {
                    errMsg = 'Sesi admin tidak valid atau telah berakhir (401). Silakan login kembali.';
                  } else if (res.status === 403) {
                    errMsg = 'Akses ditolak (403): Verifikasi CSRF gagal atau otorisasi tidak mencukupi.';
                  } else if (res.status === 422) {
                    errMsg = 'Validasi redaksi gagal (422): ' + (errMsg || 'Syarat kesiapan publikasi belum terpenuhi.');
                  } else if (!errMsg) {
                    errMsg = 'Gagal memproses persetujuan (HTTP ' + res.status + ').';
                  }
                  throw new Error(errMsg);
                }

                showFeedback('✓ Persetujuan editorial berhasil dicatat. Memuat ulang pratinjau...', false);
                approveBtn.innerHTML = '<span>✓ Persetujuan Disimpan</span>';
                setTimeout(function() {
                  window.location.reload();
                }, 1200);
              } catch (err) {
                var msg = err && err.message ? err.message : 'Terjadi gangguan jaringan atau kesalahan sistem.';
                showFeedback('Error: ' + msg, true);
                isApproveInFlight = false;
                approveBtn.removeAttribute('disabled');
                approveBtn.style.opacity = '';
                approveBtn.style.cursor = '';
                approveBtn.innerHTML = originalText;
                if (notesInput) notesInput.removeAttribute('disabled');
              }
            });
          }

          var isRevokeInFlight = false;
          if (revokeBtn) {
            revokeBtn.addEventListener('click', async function() {
              if (isRevokeInFlight) {
                console.warn('[ApprovalRuntime] Click ignored: revoke request already in flight.');
                return;
              }

              var articleId = revokeBtn.getAttribute('data-article-id');
              if (!articleId) {
                showFeedback('Error: Article ID attribute is missing from revoke button.', true);
                return;
              }

              var confirmed = window.confirm(
                'Apakah Anda yakin ingin MENCABUT persetujuan editorial untuk artikel ini?'
              );
              if (!confirmed) return;

              isRevokeInFlight = true;
              revokeBtn.setAttribute('disabled', 'true');
              revokeBtn.style.opacity = '0.7';
              revokeBtn.style.cursor = 'not-allowed';

              var originalRevokeText = revokeBtn.innerHTML;
              revokeBtn.innerHTML = '<span>⏳ Mencabut Persetujuan...</span>';

              try {
                var res = await fetch('/api/admin/publication/approve/' + encodeURIComponent(articleId), {
                  method: 'DELETE',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    revoked_by: 'editorial_editor',
                    notes: 'Dicabut manual dari preview admin'
                  })
                });

                var data = {};
                try {
                  data = await res.json();
                } catch (e) {
                  data = {};
                }

                if (!res.ok) {
                  var errMsg = data && data.message ? data.message : '';
                  if (res.status === 401) {
                    errMsg = 'Sesi admin tidak valid atau telah berakhir (401). Silakan login kembali.';
                  } else if (res.status === 403) {
                    errMsg = 'Akses ditolak (403): Verifikasi CSRF gagal atau otorisasi tidak mencukupi.';
                  } else if (!errMsg) {
                    errMsg = 'Gagal mencabut persetujuan (HTTP ' + res.status + ').';
                  }
                  throw new Error(errMsg);
                }

                showFeedback('Persetujuan berhasil dicabut. Memuat ulang...', false);
                revokeBtn.innerHTML = '<span>Persetujuan Dicabut</span>';
                setTimeout(function() {
                  window.location.reload();
                }, 1200);
              } catch (err) {
                var msg = err && err.message ? err.message : 'Terjadi gangguan jaringan saat mencabut persetujuan.';
                showFeedback('Error: ' + msg, true);
                isRevokeInFlight = false;
                revokeBtn.removeAttribute('disabled');
                revokeBtn.style.opacity = '';
                revokeBtn.style.cursor = '';
                revokeBtn.innerHTML = originalRevokeText;
              }
            });
          }
          var holdBtn = document.getElementById('btn-hold-automation');
          var resumeBtn = document.getElementById('btn-resume-automation');
          var returnDraftBtn = document.getElementById('btn-return-draft-hold');
          var autoFeedback = document.getElementById('automation-action-feedback');

          function showAutoFeedback(msg, isError) {
            if (!autoFeedback) return;
            autoFeedback.className = 'text-[11px] font-medium block mt-2 ' + (isError ? 'text-rose-600 dark:text-rose-400' : 'text-emerald-600 dark:text-emerald-400');
            autoFeedback.textContent = msg;
          }

          if (holdBtn) {
            holdBtn.addEventListener('click', async function() {
              var articleId = holdBtn.getAttribute('data-article-id');
              var reason = window.prompt('Alasan penahanan otomasi (opsional):', 'Ditahan manual dari pratinjau redaksi');
              if (reason === null) return; // user cancelled

              holdBtn.setAttribute('disabled', 'true');
              holdBtn.style.opacity = '0.7';
              holdBtn.innerHTML = '<span>⏳ Memproses Penahanan...</span>';

              try {
                var res = await fetch('/api/admin/publication/operator-control', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action: 'hold', articleId: Number(articleId), reason: reason || undefined })
                });
                var data = await res.json().catch(function() { return {}; });
                if (!res.ok) throw new Error(data.message || 'Gagal menahan otomasi artikel');
                showAutoFeedback('✓ Otomasi artikel berhasil ditahan (HELD). Memuat ulang...', false);
                setTimeout(function() { window.location.reload(); }, 1000);
              } catch (err) {
                showAutoFeedback('Error: ' + (err.message || 'Terjadi kesalahan sistem'), true);
                holdBtn.removeAttribute('disabled');
                holdBtn.style.opacity = '';
                holdBtn.innerHTML = '<span>⏸️</span><span>Tahan Otomasi (Hold Automation)</span>';
              }
            });
          }

          if (resumeBtn) {
            resumeBtn.addEventListener('click', async function() {
              var articleId = resumeBtn.getAttribute('data-article-id');
              if (!window.confirm('Lanjutkan evaluasi otomasi untuk artikel ini? (Penjadwalan otomatis tidak akan dibuat seketika, menunggu rekonsiliasi planner berikutnya)')) return;

              resumeBtn.setAttribute('disabled', 'true');
              resumeBtn.style.opacity = '0.7';
              resumeBtn.innerHTML = '<span>⏳ Melanjutkan Otomasi...</span>';

              try {
                var res = await fetch('/api/admin/publication/operator-control', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action: 'resume', articleId: Number(articleId) })
                });
                var data = await res.json().catch(function() { return {}; });
                if (!res.ok) throw new Error(data.message || 'Gagal melanjutkan otomasi artikel');
                showAutoFeedback('✓ Penahanan dilepas. Evaluasi otomasi dipulihkan. Memuat ulang...', false);
                setTimeout(function() { window.location.reload(); }, 1000);
              } catch (err) {
                showAutoFeedback('Error: ' + (err.message || 'Terjadi kesalahan sistem'), true);
                resumeBtn.removeAttribute('disabled');
                resumeBtn.style.opacity = '';
                resumeBtn.innerHTML = '<span>▶️</span><span>Lanjutkan Otomasi (Resume Automation)</span>';
              }
            });
          }

          if (returnDraftBtn) {
            returnDraftBtn.addEventListener('click', async function() {
              var articleId = returnDraftBtn.getAttribute('data-article-id');
              var confirmed = window.confirm('Peringatan: Tindakan ini akan membatalkan rencana publikasi atau eksekusi aktif (yang aman dibatalkan), mengembalikan status artikel ke Draft, dan mengaktifkan Manual Hold. Lanjutkan?');
              if (!confirmed) return;

              var reason = window.prompt('Alasan pengembalian ke Draft & Hold (opsional):', 'Intervensi supervisor: dikembalikan ke draft');
              if (reason === null) return;

              returnDraftBtn.setAttribute('disabled', 'true');
              returnDraftBtn.style.opacity = '0.7';
              returnDraftBtn.innerHTML = '<span>⏳ Mengembalikan ke Draft...</span>';

              try {
                var res = await fetch('/api/admin/publication/operator-control', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action: 'return_to_draft_and_hold', articleId: Number(articleId), reason: reason || undefined })
                });
                var data = await res.json().catch(function() { return {}; });
                if (!res.ok) throw new Error(data.message || 'Gagal mengembalikan artikel ke Draft & Hold');
                showAutoFeedback('✓ Artikel berhasil dikembalikan ke Draft & Otomasi Ditahan. Memuat ulang...', false);
                setTimeout(function() { window.location.reload(); }, 1000);
              } catch (err) {
                showAutoFeedback('Error: ' + (err.message || 'Terjadi kesalahan sistem'), true);
                returnDraftBtn.removeAttribute('disabled');
                returnDraftBtn.style.opacity = '';
                returnDraftBtn.innerHTML = '<span>↩️</span><span>Kembalikan ke Draft & Tahan (Return to Draft & Hold)</span>';
              }
            });
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initApprovalRuntime);
        } else {
          initApprovalRuntime();
        }
      })();
    </script>
  </BaseLayout>
)}
