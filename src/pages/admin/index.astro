---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb, getAllArticles, getAllCategories, getSiteSettings, getSubscribers } from '../../lib/db';

const db = await getDb(Astro.locals);
const [articles, categories, siteSettings, subscribers] = await Promise.all([
  getAllArticles(db, 100, 0, 'all'),
  getAllCategories(db),
  getSiteSettings(db),
  getSubscribers(db)
]);

const totalArticles = articles.length;
const publishedCount = articles.filter((a) => a.status === 'published').length;
const totalViews = articles.reduce((sum, a) => sum + (a.views || 0), 0);
const totalSubscribers = subscribers.length;
const recentArticles = articles.slice(0, 6);

// Calculate Content Health / SEO Readiness Percentage
let readySeoCount = 0;
for (const art of articles) {
  const words = (art.content_md || '').trim().split(/\s+/).filter(Boolean).length;
  const hasCover = Boolean(art.featured_image);
  const hasDesc = (art.description || '').length >= 60;
  if (words >= 300 && hasCover && hasDesc) {
    readySeoCount++;
  }
}
const seoHealthPercent = totalArticles > 0 ? Math.round((readySeoCount / totalArticles) * 100) : 100;
---

<AdminLayout title="Ringkasan Dashboard">
  <div class="max-w-6xl mx-auto space-y-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight">Dashboard Ringkasan</h1>
        <p class="text-xs md:text-sm text-slate-500 mt-1">
          Selamat datang di panel kontrol RancangLoka. Seluruh data tersimpan terdistribusi di Cloudflare D1 & R2.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/import"
          class="rounded-xl bg-white border border-slate-200 px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 transition shadow-sm flex items-center gap-2"
        >
          <span>📥 Import Markdown</span>
        </a>
        <a
          href="/admin/posts/new"
          class="rounded-xl bg-primary px-4 py-2.5 text-xs font-bold text-white hover:bg-primary-hover transition flex items-center gap-2 shadow-md shadow-primary/20"
        >
          <span>✍️ Tulis Artikel</span>
        </a>
      </div>
    </div>

    <!-- Quick Action Launchpad -->
    <div class="rounded-2xl bg-white border border-slate-200/90 p-4 shadow-sm flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#0071e3]/10 text-[#0071e3] text-xs font-bold">⚡</span>
        <span class="text-xs font-bold text-slate-800">Aksi Cepat Redaksi:</span>
      </div>
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <a href="/admin/posts/new" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-[#0071e3] hover:text-white transition font-semibold text-slate-700">
          ✍️ Tulis Baru
        </a>
        <a href="/admin/media" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-[#0071e3] hover:text-white transition font-semibold text-slate-700">
          📁 Media R2
        </a>
        <a href="/admin/seo-audit" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-[#0071e3] hover:text-white transition font-semibold text-slate-700">
          📊 Audit SEO
        </a>
        <a href="/admin/subscribers" class="px-3 py-1.5 rounded-xl bg-emerald-50 text-emerald-800 hover:bg-emerald-600 hover:text-white transition font-bold border border-emerald-200/60">
          👥 {totalSubscribers} Subscribers (CSV)
        </a>
      </div>
    </div>

    <!-- Stats Cards Grid (5 Cards) -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
      <!-- 1. Total Posts -->
      <div class="rounded-2xl bg-white border border-slate-200 p-5 shadow-sm">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Total Artikel</span>
        <p class="text-3xl font-black text-slate-900 mt-2">{totalArticles}</p>
        <span class="text-[11px] text-emerald-600 font-semibold mt-1 block">Live di Edge D1</span>
      </div>

      <!-- 2. Published -->
      <div class="rounded-2xl bg-white border border-slate-200 p-5 shadow-sm">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Published</span>
        <p class="text-3xl font-black text-emerald-600 mt-2">{publishedCount}</p>
        <span class="text-[11px] text-slate-400 mt-1 block">Terindeks di Google</span>
      </div>

      <!-- 3. Subscribers -->
      <div class="rounded-2xl bg-white border border-slate-200 p-5 shadow-sm">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Newsletter</span>
        <p class="text-3xl font-black text-[#0071e3] mt-2">{totalSubscribers}</p>
        <a href="/admin/subscribers" class="text-[11px] text-[#0071e3] font-semibold mt-1 hover:underline block">Kelola Kontak →</a>
      </div>

      <!-- 4. SEO Health Gauge -->
      <div class="rounded-2xl bg-white border border-slate-200 p-5 shadow-sm">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Kesehatan SEO</span>
        <p class="text-3xl font-black text-purple-600 mt-2">{seoHealthPercent}%</p>
        <a href="/admin/seo-audit" class="text-[11px] text-purple-600 font-semibold mt-1 hover:underline block">Lihat Audit →</a>
      </div>

      <!-- 5. Total Views -->
      <div class="rounded-2xl bg-white border border-slate-200 p-5 shadow-sm col-span-2 md:col-span-1">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Total Pembaca</span>
        <p class="text-3xl font-black text-amber-600 mt-2">{totalViews.toLocaleString('id-ID')}</p>
        <span class="text-[11px] text-slate-400 mt-1 block">Est. Pageviews</span>
      </div>
    </div>

    <!-- Quick Info Banner -->
    <div class="rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-100 p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-sm">
      <div class="space-y-1">
        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
          <span>🚀</span> Status Cloudflare Edge Infrastructure
        </h2>
        <p class="text-xs text-slate-600">
          Database D1: <strong>5 GB Kuota SQL</strong> | Storage R2: <strong>10 GB Media (Rp 0 Egress)</strong> | CDN Bandwidth: <strong>Unlimited</strong> | SEO Scorecard: <strong>2026 Engine Aktif</strong>
        </p>
      </div>
      <div class="flex items-center gap-2">
        <a
          href="/admin/seo-audit"
          class="rounded-xl bg-white border border-blue-200 px-3.5 py-2 text-xs font-bold text-primary hover:bg-blue-50 transition flex-shrink-0 shadow-sm"
        >
          Audit SEO Lengkap →
        </a>
      </div>
    </div>

    <!-- Recent Articles Table -->
    <div class="rounded-2xl bg-white border border-slate-200 overflow-hidden shadow-sm">
      <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
        <h2 class="text-base font-bold text-slate-900">Artikel Terbaru</h2>
        <a href="/admin/posts" class="text-xs text-primary hover:underline font-semibold">
          Lihat Semua Artikel ({totalArticles}) →
        </a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-600">
          <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider text-[10px] border-b border-slate-200">
            <tr>
              <th class="px-6 py-3.5">Cover & Judul</th>
              <th class="px-4 py-3.5">Kategori</th>
              <th class="px-4 py-3.5">Status</th>
              <th class="px-4 py-3.5">Tanggal</th>
              <th class="px-6 py-3.5 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {recentArticles.map((article) => (
              <tr class="hover:bg-slate-50/80 transition">
                <td class="px-6 py-3.5 flex items-center gap-3">
                  <img
                    src={article.featured_image}
                    alt={article.title}
                    class="h-10 w-14 rounded-lg object-cover flex-shrink-0 bg-slate-100 border border-slate-200"
                  />
                  <div class="min-w-0">
                    <a href={`/${article.slug}`} target="_blank" class="font-semibold text-slate-900 hover:text-primary transition line-clamp-1">
                      {article.title}
                    </a>
                    <span class="text-[10px] text-slate-400 font-mono">/{article.slug}</span>
                  </div>
                </td>
                <td class="px-4 py-3.5 whitespace-nowrap">
                  <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[10px] font-semibold text-slate-700">
                    {article.category_name || 'Artikel'}
                  </span>
                </td>
                <td class="px-4 py-3.5 whitespace-nowrap">
                  <span class="rounded-full bg-emerald-100 text-emerald-800 px-2.5 py-0.5 text-[10px] font-bold uppercase">
                    {article.status}
                  </span>
                </td>
                <td class="px-4 py-3.5 whitespace-nowrap text-slate-500">
                  {new Date(article.published_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}
                </td>
                <td class="px-6 py-3.5 whitespace-nowrap text-right space-x-2">
                  <a href={`/admin/posts/${article.id}`} class="text-primary hover:underline font-semibold">
                    Edit
                  </a>
                  <a href={`/${article.slug}`} target="_blank" class="text-slate-400 hover:text-slate-700">
                    Preview ↗
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
