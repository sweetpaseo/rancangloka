---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb, getAllArticles, getAllCategories, getSiteSettings } from '../../lib/db';

const db = await getDb(Astro.locals);
const [articles, categories, siteSettings] = await Promise.all([
  getAllArticles(db, 100, 0, 'all'),
  getAllCategories(db),
  getSiteSettings(db)
]);

const totalArticles = articles.length;
const publishedCount = articles.filter((a) => a.status === 'published').length;
const draftCount = articles.filter((a) => a.status === 'draft').length;
const totalViews = articles.reduce((sum, a) => sum + (a.views || 0), 0);
const recentArticles = articles.slice(0, 5);
---

<AdminLayout title="Ringkasan Dashboard">
  <div class="max-w-6xl mx-auto space-y-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl md:text-3xl font-black text-white tracking-tight">Dashboard Ringkasan</h1>
        <p class="text-xs md:text-sm text-slate-400 mt-1">
          Selamat datang di panel kontrol Metro Magazine. Seluruh data tersimpan di Cloudflare D1 & R2.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/import"
          class="rounded-xl bg-slate-800 border border-slate-700 px-4 py-2.5 text-xs font-semibold text-amber-300 hover:bg-slate-700 transition flex items-center gap-2"
        >
          <span>📥 Import Markdown</span>
        </a>
        <a
          href="/admin/posts/new"
          class="rounded-xl bg-primary px-4 py-2.5 text-xs font-bold text-white hover:bg-primary-hover transition flex items-center gap-2 shadow-lg shadow-primary/20"
        >
          <span>✍️ Tulis Artikel</span>
        </a>
      </div>
    </div>

    <!-- Stats Cards Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <!-- 1. Total Posts -->
      <div class="rounded-2xl bg-slate-900 border border-slate-800 p-5">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Artikel</span>
        <p class="text-3xl font-black text-white mt-2">{totalArticles}</p>
        <span class="text-[11px] text-emerald-400 font-medium mt-1 block">Live di Edge D1</span>
      </div>

      <!-- 2. Published -->
      <div class="rounded-2xl bg-slate-900 border border-slate-800 p-5">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Published</span>
        <p class="text-3xl font-black text-emerald-400 mt-2">{publishedCount}</p>
        <span class="text-[11px] text-slate-500 mt-1 block">Terindeks di Google</span>
      </div>

      <!-- 3. Total Kategori -->
      <div class="rounded-2xl bg-slate-900 border border-slate-800 p-5">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Kategori Topik</span>
        <p class="text-3xl font-black text-primary-light mt-2">{categories.length}</p>
        <span class="text-[11px] text-slate-500 mt-1 block">Taxonomy Magazine</span>
      </div>

      <!-- 4. Total Views -->
      <div class="rounded-2xl bg-slate-900 border border-slate-800 p-5">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Pembaca</span>
        <p class="text-3xl font-black text-amber-400 mt-2">{totalViews.toLocaleString('id-ID')}</p>
        <span class="text-[11px] text-slate-500 mt-1 block">Est. Pageviews</span>
      </div>
    </div>

    <!-- Quick Info Banner -->
    <div class="rounded-2xl bg-gradient-to-r from-blue-900/40 via-indigo-900/40 to-slate-900 border border-blue-800/40 p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div class="space-y-1">
        <h2 class="text-base font-bold text-white flex items-center gap-2">
          <span>🚀</span> Status Cloudflare Edge Free Tier
        </h2>
        <p class="text-xs text-slate-300">
          Database D1: <strong>5 GB Kuota SQL</strong> | Storage R2: <strong>10 GB Media (Rp 0 Egress)</strong> | CDN Bandwidth: <strong>Unlimited</strong>
        </p>
      </div>
      <a
        href="/admin/settings"
        class="rounded-xl bg-white/10 px-3.5 py-2 text-xs font-semibold text-white hover:bg-white/20 transition flex-shrink-0"
      >
        Kelola Warna & Tema →
      </a>
    </div>

    <!-- Recent Articles Table -->
    <div class="rounded-2xl bg-slate-900 border border-slate-800 overflow-hidden shadow-sm">
      <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between">
        <h2 class="text-base font-bold text-white">Artikel Terbaru</h2>
        <a href="/admin/posts" class="text-xs text-primary hover:underline font-semibold">
          Lihat Semua Artikel →
        </a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-300">
          <thead class="bg-slate-950 text-slate-400 uppercase tracking-wider text-[10px] border-b border-slate-800">
            <tr>
              <th class="px-6 py-3">Cover & Judul</th>
              <th class="px-4 py-3">Kategori</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3">Tanggal</th>
              <th class="px-6 py-3 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800">
            {recentArticles.map((article) => (
              <tr class="hover:bg-slate-800/50 transition">
                <td class="px-6 py-3 flex items-center gap-3">
                  <img
                    src={article.featured_image}
                    alt={article.title}
                    class="h-10 w-14 rounded object-cover flex-shrink-0 bg-slate-800"
                  />
                  <div class="min-w-0">
                    <a href={`/${article.slug}`} target="_blank" class="font-semibold text-white hover:text-primary transition line-clamp-1">
                      {article.title}
                    </a>
                    <span class="text-[10px] text-slate-500 font-mono">/{article.slug}</span>
                  </div>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <span class="rounded-full bg-slate-800 px-2.5 py-0.5 text-[10px] font-semibold text-slate-300">
                    {article.category_name || 'Artikel'}
                  </span>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <span class="rounded-full bg-emerald-500/20 px-2.5 py-0.5 text-[10px] font-bold text-emerald-400 uppercase">
                    {article.status}
                  </span>
                </td>
                <td class="px-4 py-3 whitespace-nowrap text-slate-400">
                  {new Date(article.published_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}
                </td>
                <td class="px-6 py-3 whitespace-nowrap text-right space-x-2">
                  <a href={`/admin/posts/${article.id}`} class="text-primary hover:underline font-semibold">
                    Edit
                  </a>
                  <a href={`/${article.slug}`} target="_blank" class="text-slate-400 hover:text-white">
                    Preview ↗
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
