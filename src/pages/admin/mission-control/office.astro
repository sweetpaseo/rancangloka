      function openJobTrace(taskId, fixtureTrace) {
        if (!jobTraceModal) return;
        if (fixtureTrace) {
          renderJobTraceData(fixtureTrace);
          return;
        }

        if (traceTimelineContainer) {
          traceTimelineContainer.innerHTML = `
            <div class="py-12 text-center text-slate-400 flex flex-col items-center gap-2">
              <div class="w-6 h-6 border-2 border-indigo-600 border-t-transparent rounded-full animate-spin"></div>
              <span>Mengambil bukti trace kanonikal untuk ${taskId}...</span>
            </div>
          `;
        }
        jobTraceModal.classList.remove('hidden');

        fetch('/api/admin/mission-control/job-trace?task_id=' + encodeURIComponent(taskId))
          .then(function (res) {
            if (!res.ok) throw new Error('Status ' + res.status);
            return res.json();
          })
          .then(function (trace) {
            renderJobTraceData(trace);
          })
          .catch(function (err) {
            if (traceTimelineContainer) {
              traceTimelineContainer.innerHTML = `
                <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-mono space-y-1">
                  <div class="font-bold">Gagal memuat job trace</div>
                  <div class="text-[11px]">${err.message || 'Koneksi API gagal'}</div>
                </div>
              `;
            }
          });
      }

      // Delegate click for all [data-open-job-trace] elements
      document.addEventListener('click', function (e) {
        const btn = e.target.closest('[data-open-job-trace]');
        if (btn) {
          const tid = btn.getAttribute('data-open-job-trace');
          if (tid) {
            openJobTrace(tid);
          }
        }
      });

      // Manual refresh button handler
      const refreshBtn = document.getElementById('btn-refresh-office');
      if (refreshBtn) {
        refreshBtn.addEventListener('click', function () {
          window.location.reload();
        });
      }

      // Safe 30s auto-refresh polling (client-side only, no heavy game loop)
      let refreshTimeout = setTimeout(function poll() {
        fetch('/api/admin/mission-control/office')
          .then(function (res) { return res.json(); })
          .then(function (data) {
            if (data && data.generated_at) {
              const timeDisplay = document.getElementById('live-time-display');
              if (timeDisplay) {
                timeDisplay.textContent = new Date(data.generated_at).toLocaleTimeString('id-ID', { hour12: false }) + ' WIB';
              }
            }
            if (data && Array.isArray(data.sprites)) {
              data.sprites.forEach(function (newSpr) {
                const oldSpr = (officeData.sprites || []).find(function (s) {
                  return s.agent_id === newSpr.agent_id;
                });
                if (oldSpr && newSpr.position_key && oldSpr.position_key !== newSpr.position_key) {
                  // Real canonical state transition observed!
                  startStaffJourney(newSpr.agent_id, oldSpr.position_key, newSpr.position_key, 'TELEMETRY_REFRESH');
                }
              });
            }
            // Check for new canonical handoffs
            if (data && Array.isArray(data.recent_handoffs)) {
              data.recent_handoffs.forEach(function (h) {
                if (consumedHandoffIds.has(h.handoff_id)) return;
                markHandoffConsumed(h.handoff_id);
                executeCanonicalHandoff(h);
              });
            }
            officeData = data;
          })
          .catch(function (err) {
            console.warn('Auto-refresh poll skipped', err);
          })
          .finally(function () {
            refreshTimeout = setTimeout(poll, 30000);
          });
      }, 30000);
    })();
