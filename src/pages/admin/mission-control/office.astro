---
/**
 * RancangLoka Hermes Mission Control — Pixel Office (2D Workplace Simulator V2)
 * Milestone: HERMES-MC-4 & HERMES-MC-9 (V2 Polish: Real Office Management Game Style)
 * Route: /admin/mission-control/office
 * 
 * Strict Invariants:
 * 1. Read-only spatial visualization layer. Zero execution authority.
 * 2. Visualizes REAL Mission Control state — zero simulated or fabricated activity.
 * 3. Media Worker DISABLED is visually distinct (Worker Disabled, dimmed, NO red emergency beacon).
 * 4. IDLE staff appear in Lounge; WORKING staff appear at department workstation.
 * 5. REVIEWING has deterministic review desk placement (e.g. editorial_review_desk).
 * 6. BLOCKED staff remain in department with critical warning markers.
 * 7. Social room (Zone S) is physically present as an unpowered future bay with lock marker.
 * 8. Zero random movement, zero continuous rAF simulation, lightweight CSS/SVG primitives.
 * 9. Reduced motion supported; mobile responsive with scrollable floor plan canvas.
 * 10. NO OS-rendered Unicode emoji used as physical office furniture.
 * 11. NO dashboard card wrappers around personnel or workstations inside the game world.
 */

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db.ts';
import {
  getMissionControlSnapshot,
  getPixelOfficeState,
  JOB_ANIMATION_REGISTRY,
  OFFICE_ROUTE_NODES,
  OFFICE_ROUTE_EDGES
} from '../../../lib/mission-control/index.ts';
import type { OfficeStaffSprite, OfficeRoom } from '../../../lib/mission-control/pixel-office.ts';

const env = (Astro.locals as any)?.runtime?.env || (globalThis as any).process?.env || {};
const isDev = Boolean((import.meta as any).env?.DEV || env.ENVIRONMENT === 'development');
const db = (await getDb(Astro.locals)) || env.DB || (Astro.locals as any)?.db;

const snapshot = await getMissionControlSnapshot(db, env);
const office = getPixelOfficeState(snapshot);
const { rooms, sprites, summary, recent_activity, recent_handoffs = [] } = office;

// Room mapping lookup
const getRoom = (key: string) => rooms.find((r) => r.room_key === key) || null;
const editorialRoom = getRoom('editorial_room');
const researchRoom = getRoom('research_lab');
const mediaRoom = getRoom('media_room');
const operationsRoom = getRoom('operations_room');
const publicationRoom = getRoom('publication_room');
const loungeRoom = getRoom('lounge');
const socialRoom = getRoom('social_room');
const managementRoom = getRoom('management_room');

// Staff sprite lookup by position
const getSpriteAtPos = (posKey: string) => sprites.find((s) => s.position_key === posKey) || null;

// Staff sprite lookup by ID
const getSpriteById = (agentId: string) => sprites.find((s) => s.agent_id === agentId) || null;
---

<AdminLayout title="Hermes Mission Control — Pixel Office">
  <div class="space-y-4 pb-16 font-sans">
    
    <!-- 1. COMPACT OPERATIONAL HUD (Outside the Game World) -->
    <div class="bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs space-y-3.5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-200 flex items-center justify-center text-blue-600 shadow-2xs">
            <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
              <path d="M9 22v-4h6v4"></path>
              <path d="M8 6h.01"></path>
              <path d="M16 6h.01"></path>
              <path d="M12 6h.01"></path>
              <path d="M12 10h.01"></path>
              <path d="M12 14h.01"></path>
              <path d="M16 10h.01"></path>
              <path d="M16 14h.01"></path>
              <path d="M8 10h.01"></path>
              <path d="M8 14h.01"></path>
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider font-bold bg-blue-100 text-blue-800 border border-blue-200">
                HERMES MISSION CONTROL
              </span>
              <span class="text-slate-400">•</span>
              <span class="text-xs font-mono text-slate-500 font-semibold">2D Office Simulator</span>
              <span class="text-slate-400">•</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                READ-ONLY
              </span>
            </div>
            <h1 class="text-xl sm:text-2xl font-outfit font-black text-slate-900 tracking-tight mt-0.5">
              RancangLoka Pixel Office
            </h1>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="text-right hidden sm:block">
            <div class="text-[10px] font-mono uppercase text-slate-400 font-bold">Evaluasi Telemetri</div>
            <div class="text-xs font-mono font-bold text-slate-700" id="live-time-display">
              {new Date(office.generated_at).toLocaleTimeString('id-ID', { hour12: false })} WIB
            </div>
          </div>
          <button
            type="button"
            id="btn-refresh-office"
            class="rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 px-3.5 py-2 text-xs font-outfit font-bold transition flex items-center gap-2 shadow-2xs cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500/30"
          >
            <svg class="w-3.5 h-3.5 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
              <path d="M3 3v5h5"></path>
              <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path>
              <path d="M16 21h5v-5"></path>
            </svg>
            <span>Segarkan</span>
          </button>
        </div>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2 pt-1 border-t border-slate-100 text-xs font-mono">
        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-2.5">
          <div class="text-[10px] text-slate-500 uppercase font-bold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Bekerja</span>
          </div>
          <div class="text-lg font-black text-slate-900 font-outfit mt-0.5">{summary.working}</div>
        </div>
        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-2.5">
          <div class="text-[10px] text-slate-500 uppercase font-bold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
            <span>Review</span>
          </div>
          <div class="text-lg font-black text-slate-900 font-outfit mt-0.5">{summary.reviewing}</div>
        </div>
        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-2.5">
          <div class="text-[10px] text-slate-500 uppercase font-bold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            <span>Lounge</span>
          </div>
          <div class="text-lg font-black text-slate-900 font-outfit mt-0.5">{summary.idle}</div>
        </div>
        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-2.5">
          <div class="text-[10px] text-slate-500 uppercase font-bold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            <span>Terblokir</span>
          </div>
          <div class="text-lg font-black text-slate-900 font-outfit mt-0.5">{summary.blocked}</div>
        </div>
        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-2.5">
          <div class="text-[10px] text-slate-500 uppercase font-bold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-zinc-400"></span>
            <span>Offline</span>
          </div>
          <div class="text-lg font-black text-slate-900 font-outfit mt-0.5">{summary.offline}</div>
        </div>
        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-2.5">
          <div class="text-[10px] text-slate-500 uppercase font-bold">Automation</div>
          <div class="mt-1">
            <span class={`px-1.5 py-0.5 rounded text-[10px] font-bold ${summary.automation_mode === 'OFF' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800'}`}>
              {summary.automation_mode}
            </span>
          </div>
        </div>
        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-2.5">
          <div class="text-[10px] text-slate-500 uppercase font-bold">Media Worker</div>
          <div class="mt-1">
            <span class={`px-1.5 py-0.5 rounded text-[10px] font-bold ${summary.media_worker === 'DISABLED' ? 'bg-slate-200 text-slate-700' : 'bg-emerald-100 text-emerald-800'}`}>
              {summary.media_worker}
            </span>
          </div>
        </div>
        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-2.5">
          <div class="text-[10px] text-slate-500 uppercase font-bold">JEV Mode</div>
          <div class="mt-1">
            <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-purple-100 text-purple-800">
              {summary.jev_mode}
            </span>
          </div>
        </div>
      </div>

      <!-- Navigation Sub-Tabs -->
      <div class="flex items-center gap-2 border-t border-slate-100 pt-3 text-xs font-outfit font-bold overflow-x-auto pb-0.5">
        <a href="/admin/mission-control" class="px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition flex items-center gap-1.5 whitespace-nowrap">
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="2"></circle>
            <path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"></path>
          </svg>
          <span>Cockpit Operasional</span>
        </a>
        <a href="/admin/mission-control/staff" class="px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition flex items-center gap-1.5 whitespace-nowrap">
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          <span>Staff Registry</span>
          <span class="px-1.5 py-0.2 rounded-full bg-slate-200 text-[10px] font-mono text-slate-600">7 Staf</span>
        </a>
        <a href="/admin/mission-control/departments" class="px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition flex items-center gap-1.5 whitespace-nowrap">
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
            <path d="M9 22v-4h6v4"></path>
            <line x1="8" y1="6" x2="8.01" y2="6"></line>
            <line x1="16" y1="6" x2="16.01" y2="6"></line>
            <line x1="12" y1="6" x2="12.01" y2="6"></line>
            <line x1="12" y1="10" x2="12.01" y2="10"></line>
            <line x1="12" y1="14" x2="12.01" y2="14"></line>
          </svg>
          <span>Departemen</span>
          <span class="px-1.5 py-0.2 rounded-full bg-slate-200 text-[10px] font-mono text-slate-600">7 Divisi</span>
        </a>
        <a href="/admin/mission-control/office" class="px-3.5 py-1.5 rounded-lg bg-blue-600 text-white shadow-2xs flex items-center gap-1.5 whitespace-nowrap">
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="6" width="20" height="12" rx="2"></rect>
            <path d="M6 12h4m-2-2v4m9-3h.01m3 2h.01"></path>
          </svg>
          <span>Pixel Office</span>
          <span class="px-1.5 py-0.2 rounded-full bg-blue-700 text-[10px] font-mono">2D Simulator</span>
        </a>
        <a href="/admin/mission-control/alerts" class="px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition flex items-center gap-1.5 whitespace-nowrap">
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span>Alert Center</span>
        </a>
      </div>
    </div>

    <!-- 2. MAIN 2D OFFICE SIMULATOR (THE GAME WORLD CANVAS) -->
    <div class="bg-[#e2e8f0] border-2 border-slate-300 rounded-3xl p-3 sm:p-5 shadow-lg relative overflow-hidden">
      
      <!-- Subtle Board Map Texture -->
      <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(#94a3b8_1px,transparent_1px)] [background-size:24px_24px] opacity-40"></div>

      <!-- Compact Architectural Header Strip -->
      <div class="relative z-10 flex flex-wrap items-center justify-between gap-3 bg-white/90 backdrop-blur-xs border border-slate-300/80 px-4 py-2 rounded-xl mb-4 shadow-2xs">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-xs font-mono font-black uppercase text-slate-800 tracking-wider">
            RANCANGLOKA HEADQUARTERS • FLOOR PLAN 1
          </span>
          <span class="text-[10px] font-mono text-slate-400">|</span>
          <span class="text-[11px] font-mono text-slate-500">Interaksi Klik untuk Inspeksi Ruang & Staf</span>
        </div>
        <div class="flex items-center gap-3 text-[10px] font-mono text-slate-500">
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> Bekerja</span>
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-indigo-500"></span> Review</span>
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-500"></span> Lounge</span>
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-rose-500"></span> Terblokir</span>
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-zinc-400"></span> Standby</span>
        </div>
      </div>

      <!-- DEV VISUAL SCENARIO TEST HARNESS (Local Development Only — Zero D1 / Production Mutation) -->
      {isDev && (
        <div id="dev-scenario-harness" class="relative z-10 mb-4 bg-amber-50/95 border border-amber-300 rounded-xl p-3 text-xs font-mono shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded bg-amber-200 text-amber-900 font-bold uppercase text-[10px]">DEV HARNESS</span>
              <span class="text-amber-900 font-bold">Uji Visual Perpindahan Staf (Zero D1 Mutation)</span>
            </div>
            <div class="flex flex-wrap items-center gap-1.5">
              <button type="button" class="px-2.5 py-1 bg-white hover:bg-amber-100 border border-amber-300 rounded text-[11px] font-bold text-amber-950 transition cursor-pointer shadow-2xs" data-dev-scenario="scenario-a">
                A: Joko (Lounge → Editorial)
              </button>
              <button type="button" class="px-2.5 py-1 bg-white hover:bg-amber-100 border border-amber-300 rounded text-[11px] font-bold text-amber-950 transition cursor-pointer shadow-2xs" data-dev-scenario="scenario-b">
                B: Sari (Lounge → Pub → Lounge)
              </button>
              <button type="button" class="px-2.5 py-1 bg-white hover:bg-amber-100 border border-amber-300 rounded text-[11px] font-bold text-amber-950 transition cursor-pointer shadow-2xs" data-dev-scenario="scenario-c">
                C: Rina Review Handoff
              </button>
              <button type="button" class="px-2.5 py-1 bg-white hover:bg-amber-100 border border-amber-300 rounded text-[11px] font-bold text-amber-950 transition cursor-pointer shadow-2xs" data-dev-scenario="scenario-d">
                D: Multi-Staff Serentak
              </button>
              <button type="button" class="px-2.5 py-1 bg-white hover:bg-amber-100 border border-amber-300 rounded text-[11px] font-bold text-amber-950 transition cursor-pointer shadow-2xs" data-dev-scenario="scenario-e">
                E: Reroute Mid-Transit
              </button>
              <button type="button" class="px-2.5 py-1 bg-amber-200 hover:bg-amber-300 border border-amber-400 rounded text-[11px] font-bold text-amber-950 transition cursor-pointer shadow-2xs" data-dev-scenario="reset">
                Reset Posisi
              </button>
            </div>
          </div>
        </div>
      )}

      <!-- FLOOR PLAN BLUEPRINT CONTAINER -->
      <div class="relative z-10 overflow-x-auto pb-4">
        
        <!-- THE PHYSICAL BUILDING SHELL (THICK ARCHITECTURAL WALLS) -->
        <div class="min-w-[1020px] max-w-[1240px] mx-auto bg-slate-800 p-2.5 rounded-xl shadow-2xl">
          <!-- BUILDING INTERIOR WITH SHARED PARTITION WALLS & CENTRAL CIRCULATION SPINE -->
          <div id="building-floor-plan" class="relative bg-slate-700 p-1.5 rounded-lg space-y-1.5">
            <!-- REAL-TIME DETERMINISTIC STAFF TRANSIT LAYER -->
            <div id="staff-transit-layer" class="absolute inset-0 pointer-events-none z-30 overflow-hidden" aria-hidden="true"></div>
            
            <!-- NORTHERN ANNEX: EXECUTIVE MANAGEMENT CHAMBER (CONNECTED TO CENTRAL HALL NORTH TERMINUS) -->
            {managementRoom && (
              <div
                class="bg-[#f5f3ff] p-3.5 relative flex flex-col justify-between rounded-xs select-none border-b-2 border-slate-600 shadow-inner"
                id="room-card-management_room"
              >
                <!-- Plaque & Badges -->
                <div class="relative z-10 flex items-center justify-between">
                  <button
                    type="button"
                    class="flex items-center gap-1.5 px-2.5 py-1 rounded bg-purple-100 border border-purple-300 text-[10px] font-mono font-black text-purple-950 tracking-wider hover:bg-purple-200 transition cursor-pointer shadow-2xs"
                    data-room-inspect="management_room"
                    title="Klik untuk inspeksi Executive Management Chamber"
                  >
                    <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-purple-800" fill="none" stroke="currentColor" stroke-width="2">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                    <span>EXECUTIVE MANAGEMENT • ZONE X</span>
                  </button>
                  <div class="flex items-center gap-2">
                    <span class="text-[9px] font-mono px-2 py-0.5 rounded bg-purple-200 text-purple-900 font-bold border border-purple-300 shadow-2xs">
                      SHADOW MODE
                    </span>
                    <span class="text-[9px] font-mono px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold border border-emerald-300 shadow-2xs">
                      0 EXEC AUTHORITY
                    </span>
                  </div>
                </div>

                <!-- Interior: Jefry Decision Console + Advisory Screen -->
                <div class="relative z-10 py-2 flex items-center justify-around">
                  <div class="flex items-center gap-6">
                    <!-- Advisory Display Board -->
                    <div class="w-32 h-14 bg-slate-900 rounded-xs border-2 border-purple-900/70 p-1.5 flex flex-col justify-between shadow-md" title="Panel Advisory JEV">
                      <div class="flex items-center justify-between">
                        <span class="text-[7px] font-mono text-purple-300 font-bold">TYPESAFE JEV</span>
                        <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
                      </div>
                      <div class="text-[8px] font-mono text-cyan-300 font-bold">SHADOW ADVISORY</div>
                      <div class="text-[6px] font-mono text-slate-400">Zero Execution Invariant</div>
                    </div>

                    <!-- Jefry Decision Console & Sprite -->
                    <div class="flex flex-col items-center justify-center">
                      <div class="relative flex flex-col items-center">
                        <div class="relative z-10 flex items-center justify-center gap-1.5 mb-[-7px]">
                          <div class="w-16 h-7 bg-slate-900 rounded-xs border-2 border-purple-900 shadow-md flex items-center justify-center text-[7px] text-purple-300 font-mono font-bold tracking-wider">
                            CONSOLE
                          </div>
                          <div class="w-3.5 h-5 bg-slate-800 rounded-2xs border border-purple-700 shadow-2xs"></div>
                        </div>
                        <div class="w-38 h-12 bg-purple-100 border-2 border-purple-400 rounded-xs shadow-[0_4px_6px_rgba(0,0,0,0.12)] flex items-center justify-between px-2 relative z-0">
                          <div class="w-16 h-3 bg-slate-300 rounded-2xs border border-slate-400"></div>
                          <div class="flex gap-0.5">
                            <span class="w-2 h-3.5 bg-purple-500 rounded-2xs"></span>
                            <span class="w-2 h-3.5 bg-indigo-500 rounded-2xs"></span>
                          </div>
                        </div>
                        <div class="relative z-10 mt-[-12px] flex flex-col items-center">
                          {(() => {
                            const jefry = getSpriteAtPos('management_decision_console');
                            if (jefry) {
                              return (
                                <button
                                  type="button"
                                  class="flex flex-col items-center group cursor-pointer focus:outline-none transition-opacity duration-200"
                                  data-staff-inspect={jefry.agent_id}
                                  data-staff-station={jefry.agent_id}
                                  title={`${jefry.display_name} • ${jefry.role} (${jefry.badge_text})`}
                                >
                                  <div class="relative">
                                    <div class="absolute -top-1.5 -inset-x-2 h-11 bg-slate-800 rounded-t-lg -z-10 shadow-sm border border-slate-900"></div>
                                    <div class={`w-12 h-12 flex items-center justify-center pixel-avatar-box ${jefry.work_visual_state?.is_actively_working ? (JOB_ANIMATION_REGISTRY[jefry.animation_key]?.css_animation_class || '') : ''}`}>
                                      <svg viewBox="0 0 32 32" class="w-11 h-11 pixelated drop-shadow-sm" shape-rendering="crispEdges">
                                        <rect x="8" y="4" width="16" height="6" fill="#4c1d95" />
                                        <rect x="9" y="10" width="14" height="8" fill="#e2e8f0" />
