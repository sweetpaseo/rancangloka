                              data-staff-inspect={spr.agent_id}
                              title={`Klik untuk melihat detail ${spr.display_name}`}
                            >
                              <!-- Pixel Avatar Character -->
                              <div class="relative flex-shrink-0">
                                <div class="w-10 h-10 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center overflow-hidden pixel-avatar-box">
