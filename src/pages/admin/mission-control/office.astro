      <!-- Idle -->
      <div class="bg-white border border-slate-200 rounded-xl p-3 shadow-2xs">
        <div class="text-[10px] text-slate-500 uppercase font-bold flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-slate-400"></span>
          <span>Lounge</span>
        </div>
        <div class="text-xl font-black text-slate-900 font-outfit mt-0.5">{summary.idle}</div>
      </div>
      <!-- Blocked -->
      <div class="bg-white border border-slate-200 rounded-xl p-3 shadow-2xs">
        <div class="text-[10px] text-slate-500 uppercase font-bold flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-rose-500"></span>
          <span>Terblokir</span>
        </div>
        <div class="text-xl font-black text-slate-900 font-outfit mt-0.5">{summary.blocked}</div>
      </div>
      <!-- Offline -->
      <div class="bg-white border border-slate-200 rounded-xl p-3 shadow-2xs">
        <div class="text-[10px] text-slate-500 uppercase font-bold flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-zinc-400"></span>
          <span>Offline</span>
        </div>
        <div class="text-xl font-black text-slate-900 font-outfit mt-0.5">{summary.offline}</div>
      </div>
      <!-- Automation -->
      <div class="bg-white border border-slate-200 rounded-xl p-3 shadow-2xs">
        <div class="text-[10px] text-slate-500 uppercase font-bold">Automation</div>
        <div class="text-sm font-bold text-slate-800 font-outfit mt-1">
          <span class={`px-2 py-0.5 rounded text-[10px] font-bold ${summary.automation_mode === 'OFF' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800'}`}>
            {summary.automation_mode}
          </span>
        </div>
      </div>
      <!-- Media Worker -->
      <div class="bg-white border border-slate-200 rounded-xl p-3 shadow-2xs">
        <div class="text-[10px] text-slate-500 uppercase font-bold">Media Worker</div>
        <div class="text-sm font-bold text-slate-800 font-outfit mt-1">
          <span class={`px-2 py-0.5 rounded text-[10px] font-bold ${summary.media_worker === 'DISABLED' ? 'bg-slate-100 text-slate-700' : 'bg-emerald-100 text-emerald-800'}`}>
            {summary.media_worker}
