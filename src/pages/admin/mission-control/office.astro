            ` : `
              <div class="text-slate-500 italic py-1">
                Tidak ada tugas pipeline aktif yang diemban. Personel siaga di Lounge untuk mencegah beban kerja fiktif (Zero fake workload).
              </div>
            `}
          </div>

          <!-- 3. Specialized Persona Invariants & Deep Links -->
          ${agentId === 'management_advisor_jefry' ? `
            <div class="bg-purple-50 p-3.5 rounded-2xl border-2 border-purple-200 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-mono font-bold uppercase text-purple-900 tracking-wider flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-purple-600 animate-pulse"></span>
