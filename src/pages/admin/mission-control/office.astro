        </div>
      </div>
      <!-- Jev Mode -->
      <div class="bg-white border border-slate-200 rounded-xl p-3 shadow-2xs">
        <div class="text-[10px] text-slate-500 uppercase font-bold">JEV Mode</div>
        <div class="text-sm font-bold text-slate-800 font-outfit mt-1">
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-purple-100 text-purple-800">
            {summary.jev_mode}
          </span>
        </div>
      </div>
    </div>

    <!-- 3. MAIN PIXEL OFFICE 2D FLOOR PLAN -->
    <div class="bg-[#14161f] border-2 border-slate-800/90 rounded-3xl p-4 sm:p-6 shadow-2xl relative overflow-hidden">
      <!-- Retro Scanline / Pixel Grid Overlay (Subtle) -->
      <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(#2d3348_1px,transparent_1px)] [background-size:16px_16px] opacity-25"></div>

      <!-- Floor Header -->
      <div class="relative z-10 flex items-center justify-between border-b border-slate-800/80 pb-4 mb-6">
        <div class="flex items-center gap-3">
          <div class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></div>
          <div>
            <h2 class="text-base font-outfit font-black text-slate-100 tracking-wide uppercase flex items-center gap-2">
              <span>Denah Kantor Operasional RancangLoka</span>
              <span class="text-[10px] font-mono px-2 py-0.5 bg-slate-800 text-slate-400 rounded">Floor Plan 2D</span>
            </h2>
            <p class="text-[11px] font-mono text-slate-400">
              Klik pada karakter staf atau ruangan untuk melihat telemetri mendalam tanpa kontrol mutasi.
            </p>
          </div>
        </div>

        <div class="hidden sm:flex items-center gap-3 text-[11px] font-mono text-slate-400">
          <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> Kerja</span>
          <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-indigo-500"></span> Review</span>
          <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-slate-400"></span> Lounge</span>
          <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-rose-500"></span> Terblokir</span>
        </div>
      </div>

      <!-- 2D OFFICE GRID ROOMS -->
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 relative z-10">
        {rooms.map((room) => {
          const healthBadge = getRoomHealthBadge(room.health);
          const isSocial = room.room_key === 'social_room';
          const isLounge = room.room_key === 'lounge';

          return (
            <div
              class={`rounded-2xl border transition relative overflow-hidden flex flex-col justify-between ${
                isSocial
                  ? 'bg-slate-900/40 border-slate-800/60 border-dashed min-h-[220px]'
                  : isLounge
                    ? 'bg-amber-950/20 border-amber-900/40 hover:border-amber-800/60 min-h-[260px]'
                    : 'bg-slate-900/90 border-slate-800 hover:border-slate-700 min-h-[260px]'
              }`}
              id={`room-card-${room.room_key}`}
            >
              <!-- Room Header Bar -->
              <button
                type="button"
                class="w-full text-left p-3.5 bg-slate-950/60 border-b border-slate-800/80 flex items-center justify-between gap-2 hover:bg-slate-900/80 transition cursor-pointer"
                data-room-inspect={room.room_key}
                title="Klik untuk inspeksi ruangan"
              >
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-sm font-outfit font-bold text-slate-100">{room.title}</span>
                    <span class={`text-[9px] font-mono px-2 py-0.5 rounded font-bold uppercase border ${healthBadge.bg}`}>
                      {healthBadge.text}
                    </span>
                  </div>
                  <div class="text-[10px] font-mono text-slate-400 mt-0.5">{room.subtitle}</div>
                </div>

                <div class="text-right">
                  <span class="text-[10px] font-mono px-2 py-1 rounded bg-slate-800 text-slate-300 border border-slate-700">
                    {room.occupants.length} Staf
                  </span>
                </div>
              </button>

              <!-- Room Interior (Floor & Furniture) -->
              <div class="p-4 flex-1 flex flex-col justify-center relative">
                {isSocial ? (
                  <!-- Unstaffed Social Bay -->
                  <div class="flex flex-col items-center justify-center py-6 text-center space-y-2">
                    <div class="w-12 h-12 rounded-xl bg-slate-800/60 border border-slate-700/60 flex items-center justify-center text-xl text-slate-500">
                      🔒
                    </div>
                    <div class="text-xs font-mono font-bold text-slate-400 uppercase tracking-wider">
                      RUANG DISTRIBUSI SOSIAL
                    </div>
                    <div class="px-2.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-[10px] font-mono font-bold">
                      COMING LATER • NOT AVAILABLE
                    </div>
                    <p class="text-[10px] font-mono text-slate-500 max-w-[200px]">
                      Ruang kapasitas masa depan. Dilarang diisi staf persona fiktif.
                    </p>
                  </div>
                ) : (
                  <!-- Active Room Floor with Workstations & Sprites -->
                  <div class="space-y-3">
                    {room.occupants.length === 0 ? (
                      <div class="py-6 text-center text-[11px] font-mono text-slate-500 italic">
                        Tidak ada staf di ruangan ini (semua staf sedang di Lounge atau pos lain).
                      </div>
                    ) : (
                      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        {room.occupants.map((spr) => {
                          const badgeStyle = getStateBadgeStyle(spr);
                          const isDimmed = spr.visual_mode === 'DIMMED';
                          const isBlocked = spr.visual_mode === 'BLOCKED';

                          return (
                            <button
                              type="button"
                              class={`group relative p-2.5 rounded-xl border text-left transition cursor-pointer flex items-center gap-3 focus:outline-none focus:ring-2 focus:ring-blue-500/40 ${
                                isBlocked
                                  ? 'bg-rose-950/30 border-rose-800/80 hover:border-rose-600'
                                  : isDimmed
                                    ? 'bg-slate-950/40 border-slate-800/60 opacity-60 hover:opacity-100 hover:border-slate-700'
                                    : 'bg-slate-950/70 border-slate-800/90 hover:border-blue-500/50 hover:bg-slate-900'
