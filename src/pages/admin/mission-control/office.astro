    @keyframes checklistCheck {
      0%, 100% { opacity: 0.9; }
      50% { opacity: 1; filter: drop-shadow(0 0 3px #10b981); }
    }
    .animate-checklist-check {
      animation: checklistCheck 1.4s infinite ease-in-out;
    }

    @keyframes mediaRender {
      0%, 100% { filter: drop-shadow(0 0 1px #f97316); }
      50% { filter: drop-shadow(0 0 4px #ea580c); }
    }
    .animate-media-render {
      animation: mediaRender 2s infinite ease-in-out;
    }

    @keyframes mediaInspect {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.02); }
    }
    .animate-media-inspect {
      animation: mediaInspect 2.2s infinite ease-in-out;
    }

    @keyframes schedulePulse {
      0%, 100% { opacity: 0.85; }
      50% { opacity: 1; filter: drop-shadow(0 0 2px #10b981); }
    }
    .animate-schedule-pulse {
      animation: schedulePulse 1.5s infinite ease-in-out;
    }

    @keyframes dispatchPulse {
      0%, 100% { transform: scale(1); filter: brightness(1); }
      50% { transform: scale(1.04); filter: brightness(1.2); }
    }
    .animate-dispatch-pulse {
      animation: dispatchPulse 1s infinite ease-in-out;
    }

    @keyframes telemetryWave {
      0%, 100% { filter: drop-shadow(0 0 1px #818cf8); }
      50% { filter: drop-shadow(0 0 4px #6366f1); }
    }
    .animate-telemetry-wave {
      animation: telemetryWave 1.6s infinite ease-in-out;
    }

    @keyframes jevRadar {
      0%, 100% { filter: drop-shadow(0 0 1px #c084fc); }
      50% { filter: drop-shadow(0 0 5px #a855f7); }
    }
    .animate-jev-radar {
      animation: jevRadar 1.8s infinite ease-in-out;
    }

    @keyframes idleBreathing {
      0%, 100% { transform: translateY(0); opacity: 0.95; }
      50% { transform: translateY(-0.8px); opacity: 1; }
    }
    .animate-idle-breathing {
      animation: idleBreathing 3s infinite ease-in-out;
    }

    /* Accessibility: Respect Reduced Motion */
    @media (prefers-reduced-motion: reduce) {
      *,
      ::before,
      ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
        transform: none !important;
        filter: none !important;
      }
    }
  </style>

  <script is:inline>
    (function () {
      const payloadEl = document.getElementById('office-data-payload');
      if (!payloadEl) return;

      let officeData;
      try {
        officeData = JSON.parse(payloadEl.textContent || '{}');
      } catch (e) {
        console.error('Failed to parse office telemetry payload', e);
        return;
      }

      const modal = document.getElementById('inspect-modal');
      const modalTag = document.getElementById('modal-tag');
      const modalTitle = document.getElementById('modal-title');
      const modalSubtitle = document.getElementById('modal-subtitle');
      const modalBody = document.getElementById('modal-body');
      const modalCloseBtn = document.getElementById('modal-close-btn');
      const modalOkBtn = document.getElementById('modal-ok-btn');
      const modalStaffLink = document.getElementById('modal-staff-link');
      const modalChatLink = document.getElementById('modal-chat-link');

      function closeModal() {
        if (modal) modal.classList.add('hidden');
      }

      if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
      if (modalOkBtn) modalOkBtn.addEventListener('click', closeModal);
      if (modal) {
        modal.addEventListener('click', function (e) {
          if (e.target === modal) closeModal();
        });
      }

      // Handle staff inspection
      document.querySelectorAll('[data-staff-inspect]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const agentId = btn.getAttribute('data-staff-inspect');
          const sprite = (officeData.sprites || []).find(function (s) {
            return s.agent_id === agentId;
          });
          if (!sprite || !modal) return;

          modalTag.textContent = 'STAFF INSPECTOR';
          modalTag.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-blue-100 text-blue-800 font-bold uppercase border border-blue-200';
          modalTitle.textContent = sprite.display_name;
          modalSubtitle.textContent = sprite.role + ' • ' + sprite.agent_id;

          if (modalChatLink) {
            modalChatLink.href = '/admin/mission-control/staff/' + encodeURIComponent(sprite.agent_id) + '/chat';
            modalChatLink.innerHTML = `
              <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 inline-block mr-1" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
              <span>Chat dengan ${sprite.display_name}</span>
            `;
            modalChatLink.classList.remove('hidden');
          }

          if (modalStaffLink) {
            modalStaffLink.href = '/admin/mission-control/staff?staff=' + encodeURIComponent(sprite.agent_id);
            modalStaffLink.textContent = 'Lihat di Staff Registry →';
            modalStaffLink.classList.remove('hidden');
          }

          modalBody.innerHTML = `
            <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Status Operasional:</span>
                <span class="px-2 py-0.5 rounded font-bold uppercase text-[10px] ${
                  sprite.visual_mode === 'ACTIVE'
                    ? 'bg-emerald-100 text-emerald-800 border border-emerald-300'
                    : sprite.visual_mode === 'BLOCKED'
                    ? 'bg-rose-100 text-rose-800 border border-rose-300'
                    : 'bg-slate-200 text-slate-800 border border-slate-300'
                }">${sprite.badge_text}</span>
              </div>
              <div class="flex items-start justify-between gap-2">
                <span class="text-slate-500 font-medium">Animasi Kerja:</span>
                <span class="text-emerald-700 font-mono font-bold text-[11px]">${sprite.animation_key || 'IDLE_STANDBY'}</span>
              </div>
              <div class="flex items-start justify-between gap-2">
                <span class="text-slate-500 font-medium">Detail Visual:</span>
                <span class="text-slate-900 text-right font-medium max-w-[280px]">${(sprite.work_visual_state && sprite.work_visual_state.visual_detail) || sprite.state_reason.summary}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Ruangan Spasial:</span>
                <span class="text-slate-900 font-bold">${sprite.room_key}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Posisi Kerja:</span>
                <span class="text-slate-700">${sprite.position_key}</span>
              </div>
            </div>

            <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-bold">Tugas Berjalan:</span>
                <span class="text-[10px] text-slate-400 font-mono">Task ID: ${(sprite.work_visual_state && sprite.work_visual_state.task_id) || '-'}</span>
              </div>
              <div class="text-slate-900 font-medium">${sprite.task_label || sprite.current_task_title || 'Tidak ada tugas aktif (Siaga di Lounge)'}</div>
              <div class="text-[10px] text-slate-500 font-mono flex items-center justify-between border-t border-slate-200 pt-1.5">
                <span>Tahap: <strong class="text-blue-700">${sprite.current_task_status || '-'}</strong></span>
                <span>Kesegaran: <strong class="text-slate-700">${(sprite.work_visual_state && sprite.work_visual_state.freshness) || 'RECENT'}</strong></span>
              </div>
            </div>

            <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 space-y-1.5">
              <div class="text-slate-500 font-bold">Kapabilitas Mesin:</div>
              <div class="flex flex-wrap gap-1 mt-1">
                ${(sprite.capabilities || []).map(function (c) {
                  return `<span class="px-1.5 py-0.5 bg-slate-200 text-slate-700 border border-slate-300 rounded text-[9px] font-bold">${c}</span>`;
                }).join('')}
              </div>
            </div>

            <div class="text-[10px] font-mono text-slate-500 text-center pt-1 border-t border-slate-200">
              ⚡ Visualisasi berdasarkan telemetry nyata • Zero synthetic animation
            </div>
          `;

          modal.classList.remove('hidden');
        });
      });

      // Handle room inspection
      document.querySelectorAll('[data-room-inspect]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const roomKey = btn.getAttribute('data-room-inspect');
          const room = (officeData.rooms || []).find(function (r) {
            return r.room_key === roomKey;
          });
          if (!room || !modal) return;

          modalTag.textContent = 'ROOM INSPECTOR';
          modalTag.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-amber-100 text-amber-800 font-bold uppercase border border-amber-300';
          modalTitle.textContent = room.title;
          modalSubtitle.textContent = room.zone;

          if (modalChatLink) {
            modalChatLink.classList.add('hidden');
          }

          if (modalStaffLink) {
            if (room.department_id && room.department_id !== 'lounge' && room.department_id !== 'social') {
              modalStaffLink.href = '/admin/mission-control/departments/' + encodeURIComponent(room.department_id);
              modalStaffLink.textContent = 'Buka Detail Departemen →';
              modalStaffLink.classList.remove('hidden');
            } else {
              modalStaffLink.classList.add('hidden');
            }
          }

          modalBody.innerHTML = `
            <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Kesehatan Ruangan:</span>
                <span class="px-2 py-0.5 rounded font-bold uppercase text-[10px] bg-slate-200 text-slate-800 border border-slate-300">${room.health}</span>
              </div>
              <div class="flex items-start justify-between gap-2">
                <span class="text-slate-500 font-medium">Bukti Evaluasi:</span>
                <span class="text-slate-900 text-right font-medium max-w-[280px]">${room.health_evidence}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Jumlah Penghuni:</span>
                <span class="text-slate-900 font-bold">${room.occupants.length} Staf</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Tugas Aktif:</span>
                <span class="text-slate-800">${room.active_tasks_count}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Penghambat (Blockers):</span>
                <span class="text-slate-900 font-bold ${room.blockers_count > 0 ? 'text-rose-600' : 'text-slate-800'}">${room.blockers_count}</span>
              </div>
            </div>

            <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 space-y-1.5">
              <div class="text-slate-500 font-bold">Staf di Ruangan:</div>
              <div class="space-y-1 mt-1">
                ${room.occupants.length === 0
                  ? '<div class="text-slate-400 italic">Ruangan kosong (staf sedang di Lounge atau pos lain)</div>'
                  : room.occupants.map(function (o) {
                      return `<div class="flex items-center justify-between py-0.5 border-b border-slate-100 last:border-0">
                        <span class="text-slate-800 font-medium">${o.display_name} (${o.role})</span>
                        <span class="text-[10px] font-mono text-slate-500 font-bold">${o.badge_text}</span>
                      </div>`;
                    }).join('')}
              </div>
            </div>
          `;

          modal.classList.remove('hidden');
        });
      });

      // Manual refresh button handler
      const refreshBtn = document.getElementById('btn-refresh-office');
      if (refreshBtn) {
        refreshBtn.addEventListener('click', function () {
          window.location.reload();
        });
      }

      // Safe 30s auto-refresh polling (client-side only, no heavy game loop)
      let refreshTimeout = setTimeout(function poll() {
        fetch('/api/admin/mission-control/office')
          .then(function (res) { return res.json(); })
          .then(function (data) {
            if (data && data.generated_at) {
              const timeDisplay = document.getElementById('live-time-display');
              if (timeDisplay) {
                timeDisplay.textContent = new Date(data.generated_at).toLocaleTimeString('id-ID', { hour12: false }) + ' WIB';
              }
            }
          })
          .catch(function (err) {
            console.warn('Auto-refresh poll skipped', err);
          })
          .finally(function () {
            refreshTimeout = setTimeout(poll, 30000);
          });
      }, 30000);
    })();
  </script>
</AdminLayout>
