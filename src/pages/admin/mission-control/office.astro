    /* Role-Specific Work Animations (Subtle & Non-distracting) */
    @keyframes typingPulse {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-1.5px); }
    }
    .animate-typing-loop {
      animation: typingPulse 0.9s infinite ease-in-out;
    }

    @keyframes rewritePulse {
      0%, 100% { opacity: 0.9; }
      50% { opacity: 1; filter: drop-shadow(0 0 2px #38bdf8); }
    }
    .animate-rewrite-pulse {
      animation: rewritePulse 1.2s infinite ease-in-out;
    }

    @keyframes researchScan {
      0%, 100% { filter: brightness(1); }
      50% { filter: brightness(1.2); }
    }
    .animate-research-scan {
      animation: researchScan 1.6s infinite ease-in-out;
    }

    @keyframes evidenceFlip {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.03); }
    }
    .animate-evidence-flip {
      animation: evidenceFlip 1.8s infinite ease-in-out;
    }

    @keyframes qaReview {
      0%, 100% { transform: rotate(0deg); }
      25% { transform: rotate(-1.5deg); }
      75% { transform: rotate(1.5deg); }
    }
    .animate-qa-review {
      animation: qaReview 2s infinite ease-in-out;
    }

    @keyframes checklistCheck {
      0%, 100% { opacity: 0.9; }
      50% { opacity: 1; filter: drop-shadow(0 0 3px #10b981); }
    }
    .animate-checklist-check {
      animation: checklistCheck 1.4s infinite ease-in-out;
    }

    @keyframes mediaRender {
      0%, 100% { filter: drop-shadow(0 0 1px #f97316); }
      50% { filter: drop-shadow(0 0 4px #ea580c); }
    }
    .animate-media-render {
      animation: mediaRender 2s infinite ease-in-out;
    }

    @keyframes mediaInspect {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.02); }
    }
    .animate-media-inspect {
      animation: mediaInspect 2.2s infinite ease-in-out;
    }

    @keyframes schedulePulse {
      0%, 100% { opacity: 0.85; }
      50% { opacity: 1; filter: drop-shadow(0 0 2px #10b981); }
    }
    .animate-schedule-pulse {
      animation: schedulePulse 1.5s infinite ease-in-out;
    }

    @keyframes dispatchPulse {
      0%, 100% { transform: scale(1); filter: brightness(1); }
      50% { transform: scale(1.04); filter: brightness(1.2); }
    }
    .animate-dispatch-pulse {
      animation: dispatchPulse 1s infinite ease-in-out;
    }

    @keyframes telemetryWave {
      0%, 100% { filter: drop-shadow(0 0 1px #818cf8); }
      50% { filter: drop-shadow(0 0 4px #6366f1); }
    }
    .animate-telemetry-wave {
      animation: telemetryWave 1.6s infinite ease-in-out;
    }

    @keyframes jevRadar {
      0%, 100% { filter: drop-shadow(0 0 1px #c084fc); }
      50% { filter: drop-shadow(0 0 5px #a855f7); }
    }
    .animate-jev-radar {
      animation: jevRadar 1.8s infinite ease-in-out;
    }

    @keyframes idleBreathing {
      0%, 100% { transform: translateY(0); opacity: 0.95; }
      50% { transform: translateY(-0.8px); opacity: 1; }
    }
    .animate-idle-breathing {
      animation: idleBreathing 3s infinite ease-in-out;
    }

    /* Staff In-Transit Walking Animations & Transit Layer (V2.3) */
    .staff-transit-sprite {
      position: absolute;
      width: 44px;
      height: 48px;
      margin-left: -22px;
      margin-top: -24px;
      transition: left 450ms linear, top 450ms linear;
      pointer-events: auto;
      cursor: pointer;
      z-index: 35;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .staff-walking-bob {
      animation: staffBob 0.35s infinite ease-in-out alternate;
    }
    @keyframes staffBob {
      0% { transform: translateY(0); }
      100% { transform: translateY(-3px); }
    }
    .flip-horizontal {
      transform: scaleX(-1);
    }

    /* Accessibility: Respect Reduced Motion */
    @media (prefers-reduced-motion: reduce) {
      *,
      ::before,
      ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
        transform: none !important;
        filter: none !important;
      }
      .staff-transit-sprite {
        transition: none !important;
      }
      .staff-walking-bob {
        animation: none !important;
      }
    }
  </style>

  <script is:inline>
    (function () {
      const payloadEl = document.getElementById('office-data-payload');
      if (!payloadEl) return;

      let officeData = {};
      try {
        officeData = JSON.parse(payloadEl.textContent || '{}');
      } catch (e) {
        console.error('Failed to parse office telemetry payload', e);
        return;
      }

      const routePayloadEl = document.getElementById('office-route-payload');
      let routeData = { nodes: {}, edges: [] };
      try {
        if (routePayloadEl) routeData = JSON.parse(routePayloadEl.textContent || '{}');
      } catch (e) {
        console.error('Failed to parse route graph payload', e);
      }
      const routeNodes = routeData.nodes || {};
      const routeEdges = routeData.edges || [];

      // Pre-calculated adjacency for fast deterministic BFS
      const adj = {};
      (routeEdges || []).forEach(function (e) {
        if (!adj[e.from]) adj[e.from] = [];
        if (!adj[e.to]) adj[e.to] = [];
        adj[e.from].push(e.to);
        adj[e.to].push(e.from);
      });
      for (const k in adj) {
        adj[k].sort(); // Lexicographical deterministic tie-breaking
      }

      function findDeterministicPath(startNodeId, targetNodeId) {
        if (startNodeId === targetNodeId) return [startNodeId];
        if (!routeNodes[startNodeId] || !routeNodes[targetNodeId]) return [];

        const queue = [startNodeId];
        const visited = new Set([startNodeId]);
        const parent = {};

        while (queue.length > 0) {
          const curr = queue.shift();
          if (curr === targetNodeId) break;

          const neighbors = adj[curr] || [];
          for (let i = 0; i < neighbors.length; i++) {
            const next = neighbors[i];
            if (!visited.has(next)) {
              visited.add(next);
              parent[next] = curr;
              queue.push(next);
            }
          }
        }

        if (!parent[targetNodeId] && startNodeId !== targetNodeId) return [];

        const path = [];
        let curr = targetNodeId;
        while (curr) {
          path.unshift(curr);
          curr = parent[curr];
        }
        return path;
      }

      const activeMovements = {};
      const STAFF_ORDER = ['joko', 'rina', 'irwan', 'budi', 'dimas', 'sari', 'jefry', 'maya'];

      function normalizeAgentKey(agentId) {
        if (!agentId) return null;
        const lower = String(agentId).toLowerCase();
        if (lower.includes('joko') || lower === 'content_writer_primary') return 'joko';
        if (lower.includes('rina') || lower === 'editorial_qa_primary') return 'rina';
        if (lower.includes('irwan') || lower === 'evidence_researcher_lead') return 'irwan';
        if (lower.includes('sari') || lower === 'publication_dispatcher_core') return 'sari';
        if (lower.includes('dimas') || lower === 'telemetry_observer_jev') return 'dimas';
        if (lower.includes('budi') || lower === 'lokamedia_worker_primary') return 'budi';
        if (lower.includes('jefry') || lower === 'management_advisor_jefry') return 'jefry';
        if (lower.includes('maya') || lower === 'social_distribution_operator') return 'maya';
        return lower;
      }

      const STAFF_STATIONS = {
        joko: { workstation: 'editorial_writer_desk', idle: 'lounge_seat_1' },
        rina: { workstation: 'editorial_review_desk', idle: 'lounge_seat_3' },
        irwan: { workstation: 'research_main_desk', idle: 'lounge_seat_4' },
        dimas: { workstation: 'operations_console', idle: 'lounge_seat_2' },
        sari: { workstation: 'publication_console', idle: 'lounge_seat_5' },
        budi: { workstation: 'media_console', idle: 'media_console' },
        jefry: { workstation: 'management_decision_console', idle: 'management_decision_console' },
        maya: { workstation: 'social_workstation', idle: 'social_bay_empty' }
      };

      // Invariant: Initial load & refresh are idempotent (zero replay of historical handoffs)
      const consumedHandoffIds = new Set();
      (officeData.recent_handoffs || []).forEach(function (h) {
        if (h && h.handoff_id) consumedHandoffIds.add(h.handoff_id);
      });
      try {
        const stored = sessionStorage.getItem('hermes_consumed_handoff_ids');
        if (stored) {
          const parsed = JSON.parse(stored);
          if (Array.isArray(parsed)) {
            parsed.forEach(function (id) {
              if (id) consumedHandoffIds.add(id);
            });
          }
        }
      } catch (e) {}

      function markHandoffConsumed(id) {
        if (!id) return;
        consumedHandoffIds.add(id);
        try {
          const arr = Array.from(consumedHandoffIds).slice(-100);
          sessionStorage.setItem('hermes_consumed_handoff_ids', JSON.stringify(arr));
        } catch (e) {}
      }

      function showHandoffToast(h) {
        const toast = document.getElementById('handoff-token-indicator');
        if (!toast) return;
        const titleEl = document.getElementById('handoff-token-title');
        const routeEl = document.getElementById('handoff-token-route');
        const statusEl = document.getElementById('handoff-token-status');
        const noteEl = document.getElementById('handoff-token-note');
        
        if (titleEl) titleEl.textContent = h.task_title || h.task_id;
        if (routeEl) {
          const fromLabel = h.from_agent_id || h.from_department_id || 'Initial';
          const toLabel = h.to_agent_id || h.to_department_id || 'Pending';
          routeEl.innerHTML = '<span>' + fromLabel + ' (' + h.from_stage + ')</span> <span class="text-slate-500">→</span> <span class="text-indigo-300 font-bold">' + toLabel + ' (' + h.to_stage + ')</span>';
        }
        if (statusEl) {
          statusEl.textContent = h.handoff_state;
          statusEl.className = 'text-[9px] font-mono font-bold px-1.5 py-0.2 rounded border ' + (
            h.handoff_state === 'RUNNING' ? 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40' :
            h.handoff_state === 'QUEUED' ? 'bg-amber-500/20 text-amber-300 border-amber-500/40' :
            'bg-rose-500/20 text-rose-300 border-rose-500/40'
          );
        }
        if (noteEl) {
          if (h.handoff_state === 'QUEUED') {
            noteEl.textContent = 'Tahap berikutnya dialihkan ke Antrean (Staf siaga di Lounge).';
          } else if (h.handoff_state === 'BLOCKED') {
            noteEl.textContent = 'Tahap berikutnya TERBLOKIR. Zero aktivitas kerja semu.';
          } else {
            noteEl.textContent = 'Staf penerima bergerak menuju meja kerja melalui Koridor Utama...';
          }
        }

        toast.classList.remove('translate-y-16', 'opacity-0', 'pointer-events-none');
        setTimeout(function () {
          toast.classList.add('translate-y-16', 'opacity-0', 'pointer-events-none');
        }, 4500);
      }

      function executeCanonicalHandoff(h) {
        if (!h) return;
        showHandoffToast(h);

        const fromKey = normalizeAgentKey(h.from_agent_id);
        const toKey = normalizeAgentKey(h.to_agent_id);

        // 1. Staff A: Stops work / returns to Lounge if their canonical state becomes idle
        if (fromKey && fromKey !== toKey && STAFF_STATIONS[fromKey]) {
          const station = STAFF_STATIONS[fromKey];
          startStaffJourney(fromKey, station.workstation, station.idle, 'HANDOFF_COMPLETED_RETURN');
        }

        // 2. Staff B: If RUNNING, moves from Lounge to workstation!
        if (h.requires_movement && toKey && STAFF_STATIONS[toKey]) {
          const station = STAFF_STATIONS[toKey];
          startStaffJourney(toKey, station.idle, station.workstation, 'HANDOFF_ASSIGNMENT_RUNNING');
        }
      }

      function getNodeVisualCoordinate(nodeId, staffIndex, isSouthbound) {
        const node = routeNodes[nodeId];
        if (!node) return { x: 50, y: 50 };
        let x = node.x;
        let y = node.y;
        if (node.room_key === 'central_hall') {
          const laneOffset = isSouthbound ? 2.5 : -2.5;
          const staggerOffset = ((staffIndex % 3) - 1) * 0.8;
          x = Math.max(42, Math.min(58, x + laneOffset + staggerOffset));
        }
        return { x: x, y: y };
      }

      function startStaffJourney(agentId, fromNodeId, targetNodeId, movementReason) {
        if (!fromNodeId || !targetNodeId || fromNodeId === targetNodeId) return;

        // Invariant: Maya / Zone S remains holding & Jefry remains at advisory console
        if (agentId === 'maya' || agentId === 'jefry' || targetNodeId === 'social_workstation') return;

        // Invariant: Budi / Media Worker disabled
        if (agentId === 'budi' && (!officeData.sprites || officeData.sprites.find(function (s) { return s.agent_id === 'budi'; })?.visual_mode === 'DIMMED')) {
          return;
        }

        const staffIndex = Math.max(0, STAFF_ORDER.indexOf(agentId));
        const path = findDeterministicPath(fromNodeId, targetNodeId);
        if (!path || path.length < 2) return;

        const transitLayer = document.getElementById('staff-transit-layer');
        if (!transitLayer) return;

        // Cancel previous active movement if already moving (rapid rerouting)
        if (activeMovements[agentId]) {
          clearInterval(activeMovements[agentId].timer);
          if (activeMovements[agentId].el && activeMovements[agentId].el.parentNode) {
            activeMovements[agentId].el.parentNode.removeChild(activeMovements[agentId].el);
          }
          delete activeMovements[agentId];
        }

        // Hide docked station sprite
        document.querySelectorAll('[data-staff-station="' + agentId + '"]').forEach(function (el) {
          el.classList.add('invisible');
        });

        const sprite = (officeData.sprites || []).find(function (s) { return s.agent_id === agentId; }) || {
          agent_id: agentId,
          display_name: agentId.toUpperCase(),
          badge_text: 'ACTIVE'
        };

        const fromNode = routeNodes[fromNodeId];
        const targetNode = routeNodes[targetNodeId];
        const isSouthbound = Boolean(targetNode && fromNode && targetNode.y > fromNode.y);

        // Build transit sprite element
        const spriteEl = document.createElement('div');
        spriteEl.className = 'staff-transit-sprite';
        spriteEl.setAttribute('data-staff-inspect', agentId);
        spriteEl.setAttribute('title', sprite.display_name + ' • Sedang Berjalan ke ' + (targetNode?.label || targetNodeId));

        // Initial position
        const startCoord = getNodeVisualCoordinate(path[0], staffIndex, isSouthbound);
        spriteEl.style.left = startCoord.x + '%';
        spriteEl.style.top = startCoord.y + '%';

        // Get inner SVG avatar
        let avatarSvgHtml = '';
        const existingStationBtn = document.querySelector('[data-staff-station="' + agentId + '"]');
        if (existingStationBtn) {
          const svgEl = existingStationBtn.querySelector('svg.pixelated');
          if (svgEl) avatarSvgHtml = svgEl.outerHTML;
        }
        if (!avatarSvgHtml) {
          avatarSvgHtml = `<svg viewBox="0 0 32 32" class="w-10 h-10 pixelated drop-shadow-sm" shape-rendering="crispEdges">
            <rect x="10" y="4" width="12" height="6" fill="#3e2723" />
            <rect x="8" y="10" width="16" height="8" fill="#ffd1a4" />
            <rect x="8" y="18" width="16" height="10" fill="#0284c7" />
          </svg>`;
        }

        spriteEl.innerHTML = `
          <div class="relative flex flex-col items-center">
            <div class="w-10 h-10 flex items-center justify-center pixel-avatar-box staff-walking-bob">
              ${avatarSvgHtml}
            </div>
            <span class="text-[8px] font-outfit font-black text-slate-800 bg-white/95 px-1 py-0.2 rounded shadow-xs border border-slate-300 mt-[-2px]">
              ${sprite.display_name} 🚶
            </span>
          </div>
        `;

        // Click handler on transit sprite for inspector
        spriteEl.addEventListener('click', function (e) {
          e.stopPropagation();
          openStaffInspector(agentId);
        });

        transitLayer.appendChild(spriteEl);

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const stepTime = prefersReducedMotion ? 20 : 450;

        let currentIndex = 0;
        let prevCoord = startCoord;

        const movementRecord = {
          agentId: agentId,
          sprite: sprite,
          fromNodeId: fromNodeId,
          targetNodeId: targetNodeId,
          path: path,
          currentIndex: 0,
          isSouthbound: isSouthbound,
          el: spriteEl,
          movementReason: movementReason || 'TRANSITION'
        };
        activeMovements[agentId] = movementRecord;

        const timer = setInterval(function () {
          currentIndex++;
          movementRecord.currentIndex = currentIndex;

          if (currentIndex < path.length) {
            const nextNodeId = path[currentIndex];
            const coord = getNodeVisualCoordinate(nextNodeId, staffIndex, isSouthbound);
            spriteEl.style.left = coord.x + '%';
            spriteEl.style.top = coord.y + '%';

            // Flip facing
            if (coord.x < prevCoord.x - 0.5) {
              spriteEl.classList.add('flip-horizontal');
            } else if (coord.x > prevCoord.x + 0.5) {
              spriteEl.classList.remove('flip-horizontal');
            }
            prevCoord = coord;
          } else {
            // ARRIVAL!
            clearInterval(timer);
            if (spriteEl.parentNode) spriteEl.parentNode.removeChild(spriteEl);
            delete activeMovements[agentId];

            // Re-show docked station
            document.querySelectorAll('[data-staff-station="' + agentId + '"]').forEach(function (el) {
              el.classList.remove('invisible');
            });
          }
        }, stepTime);

        movementRecord.timer = timer;
      }

      const modal = document.getElementById('inspect-modal');
      const modalTag = document.getElementById('modal-tag');
      const modalTitle = document.getElementById('modal-title');
      const modalSubtitle = document.getElementById('modal-subtitle');
      const modalBody = document.getElementById('modal-body');
      const modalCloseBtn = document.getElementById('modal-close-btn');
      const modalOkBtn = document.getElementById('modal-ok-btn');
      const modalStaffLink = document.getElementById('modal-staff-link');
      const modalChatLink = document.getElementById('modal-chat-link');

      function closeModal() {
        if (modal) modal.classList.add('hidden');
      }

      if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
      if (modalOkBtn) modalOkBtn.addEventListener('click', closeModal);
      if (modal) {
        modal.addEventListener('click', function (e) {
          if (e.target === modal) closeModal();
        });
      }

      function openStaffInspector(agentId) {
        const sprite = (officeData.sprites || []).find(function (s) {
          return s.agent_id === agentId;
        }) || { agent_id: agentId, display_name: agentId, role: 'Personnel' };
        if (!modal) return;

        const movement = activeMovements[agentId];

        modalTag.textContent = movement ? 'STAFF IN-TRANSIT' : 'STAFF INSPECTOR';
        modalTag.className = movement
          ? 'text-[10px] font-mono px-2 py-0.5 rounded bg-amber-100 text-amber-900 font-bold uppercase border border-amber-300'
          : 'text-[10px] font-mono px-2 py-0.5 rounded bg-blue-100 text-blue-800 font-bold uppercase border border-blue-200';
        modalTitle.textContent = sprite.display_name;
        modalSubtitle.textContent = sprite.role + ' • ' + sprite.agent_id;

        if (modalChatLink) {
          modalChatLink.href = '/admin/mission-control/staff/' + encodeURIComponent(sprite.agent_id) + '/chat';
          modalChatLink.innerHTML = `
            <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 inline-block mr-1" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <span>Chat dengan ${sprite.display_name}</span>
          `;
          modalChatLink.classList.remove('hidden');
        }

        if (modalStaffLink) {
          modalStaffLink.href = '/admin/mission-control/staff?staff=' + encodeURIComponent(sprite.agent_id);
          modalStaffLink.textContent = 'Lihat di Staff Registry →';
          modalStaffLink.classList.remove('hidden');
        }

        if (movement) {
          const currNodeId = movement.path[movement.currentIndex] || movement.fromNodeId;
          const currNode = routeNodes[currNodeId];
          const destNode = routeNodes[movement.targetNodeId];
          modalBody.innerHTML = `
            <div class="bg-amber-50 p-3.5 rounded-xl border border-amber-200 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-amber-800 font-medium">Status Visual:</span>
                <span class="px-2 py-0.5 rounded font-bold uppercase text-[10px] bg-amber-200 text-amber-900 border border-amber-300 animate-pulse">
                  SEDANG BERJALAN (${movement.isSouthbound ? 'Selatan' : 'Utara / Ruangan'})
                </span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-amber-800 font-medium">Lokasi Koridor Saat Ini:</span>
                <span class="text-slate-900 font-bold">${currNode ? currNode.label : currNodeId}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-amber-800 font-medium">Destinasi Akhir:</span>
                <span class="text-blue-900 font-bold">${destNode ? destNode.label : movement.targetNodeId}</span>
              </div>
              <div class="flex items-center justify-between border-t border-amber-200 pt-1.5">
                <span class="text-amber-800 font-medium">Langkah Rute:</span>
                <span class="text-slate-700 font-mono text-[11px]">${movement.currentIndex + 1} / ${movement.path.length} node</span>
              </div>
            </div>

            <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-bold">Status Operasional Nyata:</span>
                <span class="px-2 py-0.5 rounded font-bold uppercase text-[10px] ${
                  sprite.visual_mode === 'ACTIVE'
                    ? 'bg-emerald-100 text-emerald-800 border border-emerald-300'
                    : 'bg-slate-200 text-slate-800 border border-slate-300'
                }">${sprite.badge_text || 'ACTIVE'}</span>
              </div>
              <div class="text-slate-900 font-medium">${sprite.task_label || sprite.current_task_title || 'Transisi operasional aktif'}</div>
              <div class="text-[10px] text-slate-500 font-mono">
                Catatan: Gerakan visual ini mencerminkan perubahan status riil Mission Control. Koridor bukan status bisnis.
              </div>
            </div>
          `;
        } else {
        const liveOps = (officeData.live_operations && officeData.live_operations.staff_operations) || {};
        const staffOp = liveOps[agentId] || null;

        const effectiveStatus = staffOp ? staffOp.live_status : (sprite.badge_text || 'IDLE');
        const effectiveOpState = staffOp ? staffOp.operational_state : (sprite.visual_mode || 'IDLE');
        const taskProv = staffOp ? staffOp.current_task : null;
        const anomaly = staffOp ? staffOp.active_anomaly : null;
        const handoff = staffOp ? staffOp.active_handoff : null;

        modalBody.innerHTML = `
          <!-- 1. Live Operational Status Header Box -->
          <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-slate-500 font-medium">Status Operasional Nyata:</span>
              <span class="px-2 py-0.5 rounded font-bold uppercase text-[10px] ${
                effectiveOpState === 'WORKING'
                  ? 'bg-emerald-100 text-emerald-800 border border-emerald-300'
                  : effectiveOpState === 'REVIEWING'
                  ? 'bg-teal-100 text-teal-800 border border-teal-300'
                  : effectiveOpState === 'BLOCKED' || effectiveStatus === 'BLOCKED'
                  ? 'bg-rose-100 text-rose-800 border border-rose-300'
                  : effectiveStatus === 'OFFLINE'
                  ? 'bg-slate-200 text-slate-800 border border-slate-400'
                  : 'bg-amber-100 text-amber-900 border border-amber-300'
              }">${staffOp ? (staffOp.live_status + ' (' + staffOp.operational_state + ')') : sprite.badge_text}</span>
            </div>

            <div class="flex items-start justify-between gap-2">
              <span class="text-slate-500 font-medium">Animasi Kerja:</span>
              <span class="text-emerald-700 font-mono font-bold text-[11px]">${(staffOp && staffOp.animation && staffOp.animation.animation_key) || sprite.animation_key || 'IDLE_STANDBY'}</span>
            </div>

            <div class="flex items-start justify-between gap-2">
              <span class="text-slate-500 font-medium">Bukti Keadaan:</span>
              <span class="text-slate-900 text-right font-medium max-w-[280px]">${(staffOp && staffOp.state_evidence) || (sprite.work_visual_state && sprite.work_visual_state.visual_detail) || (sprite.state_reason && sprite.state_reason.summary) || 'Siaga di Lounge'}</span>
            </div>

            <div class="flex items-center justify-between border-t border-slate-200 pt-1.5">
              <span class="text-slate-500 font-medium">Lokasi Ruangan / Posisi:</span>
              <span class="text-slate-800 font-bold">${(staffOp && staffOp.location && staffOp.location.room_key) || sprite.room_key} • ${(staffOp && staffOp.location && staffOp.location.position_key) || sprite.position_key}</span>
            </div>
          </div>

          <!-- 2. Backing Task & Provenance Section -->
          <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200 space-y-2.5">
            <div class="flex items-center justify-between">
              <span class="text-slate-600 font-bold uppercase text-[10px] tracking-wider flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full ${taskProv ? 'bg-emerald-500' : 'bg-slate-400'}"></span>
                Tugas Backing Riil
              </span>
              <span class="text-[10px] text-slate-400 font-mono">${taskProv ? ('ID: ' + taskProv.task_id) : 'TIDAK ADA TUGAS AKTIF'}</span>
            </div>

            ${taskProv ? `
              <div class="space-y-1.5">
                <div class="text-slate-900 font-bold text-xs">${taskProv.task_title}</div>
                <div class="grid grid-cols-2 gap-2 text-[11px] font-mono text-slate-600 bg-white p-2.5 rounded-xl border border-slate-200">
                  <div>Tahap: <strong class="text-blue-700 uppercase">${taskProv.stage}</strong></div>
                  <div>Status: <strong class="text-slate-800">${taskProv.status}</strong></div>
                  <div>Dimulai: <span class="text-slate-700">${taskProv.started_at ? new Date(taskProv.started_at).toLocaleTimeString('id-ID', { hour12: false }) + ' WIB' : 'Tersedia'}</span></div>
                  <div>Kapabilitas: <span class="text-slate-700">${taskProv.capability_id || '-'}</span></div>
                </div>

                <div class="text-[10px] font-mono text-slate-500 flex items-center justify-between pt-1">
                  <span>Sumber Bukti: <strong>${taskProv.evidence_source}</strong></span>
                  <span>Ref: ${taskProv.evidence_id}</span>
                </div>

                ${taskProv.blocking_condition ? `
                  <div class="p-2.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-[11px] font-mono font-bold flex items-center gap-1.5">
                    <span>⚠️ Penghambat:</span>
                    <span>${taskProv.blocking_condition}</span>
                  </div>
                ` : ''}

                <!-- Safe Read-Only Deep Links -->
                <div class="pt-2 border-t border-slate-200 flex flex-wrap gap-1.5">
                  ${taskProv.related_article_id ? `
                    <a
                      href="/admin/posts/${encodeURIComponent(taskProv.related_article_id)}"
                      class="px-2.5 py-1 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-700 font-bold border border-blue-200 transition text-[10px] flex items-center gap-1"
                    >
                      <svg viewBox="0 0 24 24" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
