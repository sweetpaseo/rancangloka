---
/**
 * RancangLoka Hermes Mission Control — Pixel Office (2D Spatial Visualization)
 * Milestone: HERMES-MC-4 & HERMES-MC-9 (Visual Redesign: 2D Workplace Simulator)
 * Route: /admin/mission-control/office
 * 
 * Strict Invariants:
 * 1. Read-only spatial visualization layer. Zero execution authority.
 * 2. Visualizes REAL Mission Control state — zero simulated or fabricated activity.
 * 3. Media Worker DISABLED is visually distinct (Worker Disabled, dimmed, NO red emergency beacon).
 * 4. IDLE staff appear in Lounge; WORKING staff appear at department workstation.
 * 5. REVIEWING has deterministic review desk placement (e.g. editorial_review_desk).
 * 6. BLOCKED staff remain in department with critical warning markers.
 * 7. Social room (Zone S) is physically present as an unpowered future bay with lock marker.
 * 8. Zero random movement, zero continuous rAF simulation, lightweight CSS/SVG primitives.
 * 9. Reduced motion supported; mobile responsive with scrollable floor plan canvas.
 * 10. NO OS-rendered Unicode emoji used as physical office furniture.
 */

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db.ts';
import {
  getMissionControlSnapshot,
  getPixelOfficeState,
  JOB_ANIMATION_REGISTRY
} from '../../../lib/mission-control/index.ts';
import type { OfficeStaffSprite, OfficeRoom } from '../../../lib/mission-control/pixel-office.ts';

const env = (Astro.locals as any)?.runtime?.env || (globalThis as any).process?.env || {};
const db = (await getDb(Astro.locals)) || env.DB || (Astro.locals as any)?.db;

const snapshot = await getMissionControlSnapshot(db, env);
const office = getPixelOfficeState(snapshot);
const { rooms, sprites, summary, recent_activity } = office;

// Room mapping lookup
const getRoom = (key: string) => rooms.find((r) => r.room_key === key) || null;
const editorialRoom = getRoom('editorial_room');
const researchRoom = getRoom('research_lab');
const mediaRoom = getRoom('media_room');
const operationsRoom = getRoom('operations_room');
const publicationRoom = getRoom('publication_room');
const loungeRoom = getRoom('lounge');
const socialRoom = getRoom('social_room');

// Staff sprite lookup by position
const getSpriteAtPos = (posKey: string) => sprites.find((s) => s.position_key === posKey) || null;

// State badge styling helper
const getStateBadgeStyle = (sprite: OfficeStaffSprite) => {
  switch (sprite.visual_mode) {
    case 'ACTIVE':
      return 'bg-emerald-50 text-emerald-700 border-emerald-300';
    case 'REVIEWING':
      return 'bg-indigo-50 text-indigo-700 border-indigo-300';
    case 'IDLE':
      return 'bg-slate-100 text-slate-700 border-slate-300';
    case 'BLOCKED':
      return 'bg-rose-100 text-rose-700 border-rose-300 animate-pulse';
    case 'DIMMED':
      if (sprite.state_reason.category === 'INTENTIONAL_DISABLED') {
        return 'bg-amber-50 text-amber-700 border-amber-300';
      }
      return 'bg-zinc-100 text-zinc-600 border-zinc-300';
    default:
      return 'bg-slate-100 text-slate-600 border-slate-200';
  }
};

const getRoomHealthBadge = (health: string) => {
  switch (health) {
    case 'HEALTHY':
      return { text: 'HEALTHY', bg: 'bg-emerald-50 text-emerald-700 border-emerald-200' };
    case 'ACTIVE':
      return { text: 'ACTIVE', bg: 'bg-blue-50 text-blue-700 border-blue-200' };
    case 'STANDBY':
      return { text: 'STANDBY', bg: 'bg-slate-100 text-slate-700 border-slate-200' };
    case 'DEGRADED':
      return { text: 'DEGRADED', bg: 'bg-amber-50 text-amber-700 border-amber-200' };
    case 'BLOCKED':
      return { text: 'BLOCKED', bg: 'bg-rose-50 text-rose-700 border-rose-200' };
    case 'UNSTAFFED':
      return { text: 'TERKUNCI', bg: 'bg-zinc-100 text-zinc-500 border-zinc-300' };
    default:
      return { text: health, bg: 'bg-slate-100 text-slate-600 border-slate-200' };
  }
};
---

<AdminLayout title="Hermes Mission Control — Pixel Office">
  <div class="space-y-4 pb-16 font-sans">
    
    <!-- 1. COMPACT OPERATIONAL HUD (Separated from the Floor Plan) -->
    <div class="bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs space-y-3.5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-200 flex items-center justify-center text-blue-600 shadow-2xs">
            <!-- Building HUD SVG -->
            <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
              <path d="M9 22v-4h6v4"></path>
              <path d="M8 6h.01"></path>
              <path d="M16 6h.01"></path>
              <path d="M12 6h.01"></path>
              <path d="M12 10h.01"></path>
              <path d="M12 14h.01"></path>
              <path d="M16 10h.01"></path>
              <path d="M16 14h.01"></path>
              <path d="M8 10h.01"></path>
              <path d="M8 14h.01"></path>
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider font-bold bg-blue-100 text-blue-800 border border-blue-200">
                HERMES MISSION CONTROL
              </span>
              <span class="text-slate-400">•</span>
              <span class="text-xs font-mono text-slate-500 font-semibold">2D Office Simulator</span>
              <span class="text-slate-400">•</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                READ-ONLY
              </span>
            </div>
            <h1 class="text-xl sm:text-2xl font-outfit font-black text-slate-900 tracking-tight mt-0.5">
              RancangLoka Pixel Office
            </h1>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="text-right hidden sm:block">
            <div class="text-[10px] font-mono uppercase text-slate-400 font-bold">Evaluasi Telemetri</div>
            <div class="text-xs font-mono font-bold text-slate-700" id="live-time-display">
              {new Date(office.generated_at).toLocaleTimeString('id-ID', { hour12: false })} WIB
            </div>
          </div>
          <button
            type="button"
            id="btn-refresh-office"
            class="rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 px-3.5 py-2 text-xs font-outfit font-bold transition flex items-center gap-2 shadow-2xs cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500/30"
          >
            <svg class="w-3.5 h-3.5 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
              <path d="M3 3v5h5"></path>
              <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path>
              <path d="M16 21h5v-5"></path>
            </svg>
            <span>Segarkan</span>
          </button>
        </div>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2 pt-1 border-t border-slate-100 text-xs font-mono">
        <!-- Working -->
        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-2.5">
          <div class="text-[10px] text-slate-500 uppercase font-bold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Bekerja</span>
          </div>
          <div class="text-lg font-black text-slate-900 font-outfit mt-0.5">{summary.working}</div>
        </div>
        <!-- Reviewing -->
        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-2.5">
          <div class="text-[10px] text-slate-500 uppercase font-bold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
            <span>Review</span>
          </div>
          <div class="text-lg font-black text-slate-900 font-outfit mt-0.5">{summary.reviewing}</div>
        </div>
        <!-- Idle (Lounge) -->
        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-2.5">
          <div class="text-[10px] text-slate-500 uppercase font-bold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            <span>Lounge</span>
          </div>
          <div class="text-lg font-black text-slate-900 font-outfit mt-0.5">{summary.idle}</div>
        </div>
        <!-- Blocked -->
        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-2.5">
          <div class="text-[10px] text-slate-500 uppercase font-bold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            <span>Terblokir</span>
          </div>
          <div class="text-lg font-black text-slate-900 font-outfit mt-0.5">{summary.blocked}</div>
        </div>
        <!-- Offline -->
        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-2.5">
          <div class="text-[10px] text-slate-500 uppercase font-bold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-zinc-400"></span>
            <span>Offline</span>
          </div>
          <div class="text-lg font-black text-slate-900 font-outfit mt-0.5">{summary.offline}</div>
        </div>
        <!-- Automation -->
        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-2.5">
          <div class="text-[10px] text-slate-500 uppercase font-bold">Automation</div>
          <div class="mt-1">
            <span class={`px-1.5 py-0.5 rounded text-[10px] font-bold ${summary.automation_mode === 'OFF' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800'}`}>
              {summary.automation_mode}
            </span>
          </div>
        </div>
        <!-- Media Worker -->
        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-2.5">
          <div class="text-[10px] text-slate-500 uppercase font-bold">Media Worker</div>
          <div class="mt-1">
            <span class={`px-1.5 py-0.5 rounded text-[10px] font-bold ${summary.media_worker === 'DISABLED' ? 'bg-slate-200 text-slate-700' : 'bg-emerald-100 text-emerald-800'}`}>
              {summary.media_worker}
            </span>
          </div>
        </div>
        <!-- Jev Mode -->
        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-2.5">
          <div class="text-[10px] text-slate-500 uppercase font-bold">JEV Mode</div>
          <div class="mt-1">
            <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-purple-100 text-purple-800">
              {summary.jev_mode}
            </span>
          </div>
        </div>
      </div>

      <!-- Navigation Sub-Tabs -->
      <div class="flex items-center gap-2 border-t border-slate-100 pt-3 text-xs font-outfit font-bold overflow-x-auto pb-0.5">
        <a
          href="/admin/mission-control"
          class="px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition flex items-center gap-1.5 whitespace-nowrap"
        >
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="2"></circle>
            <path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"></path>
          </svg>
          <span>Cockpit Operasional</span>
        </a>
        <a
          href="/admin/mission-control/staff"
          class="px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition flex items-center gap-1.5 whitespace-nowrap"
        >
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          <span>Staff Registry</span>
          <span class="px-1.5 py-0.2 rounded-full bg-slate-200 text-[10px] font-mono text-slate-600">6 Staf</span>
        </a>
        <a
          href="/admin/mission-control/departments"
          class="px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition flex items-center gap-1.5 whitespace-nowrap"
        >
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
            <path d="M9 22v-4h6v4"></path>
            <line x1="8" y1="6" x2="8.01" y2="6"></line>
            <line x1="16" y1="6" x2="16.01" y2="6"></line>
            <line x1="12" y1="6" x2="12.01" y2="6"></line>
            <line x1="12" y1="10" x2="12.01" y2="10"></line>
            <line x1="12" y1="14" x2="12.01" y2="14"></line>
          </svg>
          <span>Departemen</span>
          <span class="px-1.5 py-0.2 rounded-full bg-slate-200 text-[10px] font-mono text-slate-600">6 Divisi</span>
        </a>
        <a
          href="/admin/mission-control/office"
          class="px-3.5 py-1.5 rounded-lg bg-blue-600 text-white shadow-2xs flex items-center gap-1.5 whitespace-nowrap"
        >
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="6" width="20" height="12" rx="2"></rect>
            <path d="M6 12h4m-2-2v4m9-3h.01m3 2h.01"></path>
          </svg>
          <span>Pixel Office</span>
          <span class="px-1.5 py-0.2 rounded-full bg-blue-700 text-[10px] font-mono">2D Simulator</span>
        </a>
        <a
          href="/admin/mission-control/alerts"
          class="px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition flex items-center gap-1.5 whitespace-nowrap"
        >
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span>Alert Center</span>
        </a>
      </div>
    </div>

    <!-- 2. MAIN 2D OFFICE SIMULATOR (CONNECTED ARCHITECTURAL FLOOR PLAN) -->
    <div class="bg-[#f1f5f9] border-2 border-slate-300 rounded-3xl p-3 sm:p-5 shadow-md relative overflow-hidden">
      <!-- Office Grid Floor Pattern -->
      <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(#cbd5e1_1.5px,transparent_1.5px)] [background-size:24px_24px] opacity-70"></div>

      <!-- Floor Plan Blueprint Header Bar -->
      <div class="relative z-10 flex flex-wrap items-center justify-between gap-3 bg-white/95 backdrop-blur-xs border border-slate-200 px-4 py-3 rounded-2xl mb-4 shadow-2xs">
        <div class="flex items-center gap-2.5">
          <div class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></div>
          <div>
            <h2 class="text-sm font-outfit font-black text-slate-900 tracking-wide uppercase flex items-center gap-2">
              <span>Denah Arsitektural Kantor RancangLoka</span>
              <span class="text-[10px] font-mono px-2 py-0.5 bg-blue-50 text-blue-700 border border-blue-200 rounded font-bold">Top-Down Floor Plan</span>
            </h2>
            <p class="text-[11px] font-mono text-slate-500">
              Karakter staf berada di meja kerja saat bertugas atau berkumpul di Executive Lounge saat siaga/istirahat.
            </p>
          </div>
        </div>

        <div class="flex items-center gap-3 text-[11px] font-mono text-slate-600 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-200">
          <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Bekerja</span>
          <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span> Review</span>
          <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Lounge</span>
          <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> Terblokir</span>
          <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-zinc-400"></span> Standby/Offline</span>
        </div>
      </div>

      <!-- FLOOR PLAN CONTAINER WITH SCROLL/CANVAS STABILITY -->
      <div class="relative z-10 overflow-x-auto pb-4">
        <!-- Building Outer Perimeter Wall (Architectural Shell) -->
        <div class="min-w-[1020px] max-w-[1280px] mx-auto bg-slate-300 rounded-2xl border-4 border-slate-600 shadow-xl overflow-hidden">
          
          <!-- TOP WING: EDITORIAL (LEFT) & RESEARCH (RIGHT) -->
          <div class="grid grid-cols-12 border-b-4 border-slate-500">
            
            <!-- ROOM 1: EDITORIAL ROOM (Col 1-7) -->
            {editorialRoom && (
              <div
                class="col-span-7 bg-[#fffdf5] border-r-4 border-slate-500 p-4 relative flex flex-col justify-between min-h-[300px]"
                id="room-card-editorial_room"
              >
                <!-- Room Label Strip -->
                <div class="flex items-center justify-between border-b border-amber-200/80 pb-2.5 mb-3">
                  <button
                    type="button"
                    class="text-left flex items-center gap-2 group cursor-pointer"
                    data-room-inspect="editorial_room"
                  >
                    <div class="w-7 h-7 rounded-lg bg-amber-100 border border-amber-300 flex items-center justify-center text-amber-800">
                      <!-- Quill/Pen SVG -->
                      <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
                        <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
                        <path d="M2 2l7.586 7.586"></path>
                        <circle cx="11" cy="11" r="2"></circle>
                      </svg>
                    </div>
                    <div>
                      <div class="text-sm font-outfit font-black text-amber-950 group-hover:text-blue-700 transition">
                        {editorialRoom.title}
                      </div>
                      <div class="text-[10px] font-mono text-amber-800/80">Zone E • Editorial & QA Suite</div>
                    </div>
                  </button>
                  <div class="flex items-center gap-2">
                    <span class={`text-[9px] font-mono px-2 py-0.5 rounded font-bold uppercase border ${getRoomHealthBadge(editorialRoom.health).bg}`}>
                      {getRoomHealthBadge(editorialRoom.health).text}
                    </span>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-100 text-amber-900 border border-amber-300 font-bold">
                      {editorialRoom.occupants.length} Staf di Ruangan
                    </span>
                  </div>
                </div>

                <!-- Room Floor & Furniture Layout -->
                <div class="flex-1 grid grid-cols-12 gap-3 items-center py-2 relative">
                  
                  <!-- Left Furniture: Bookshelf & Archive -->
                  <div class="col-span-2 flex flex-col items-center justify-center space-y-2">
                    <div class="w-14 h-24 bg-[#b45309] rounded border-2 border-[#78350f] p-1 flex flex-col justify-between shadow-xs" title="Rak Arsip & Buku Redaksi">
                      <div class="border-b border-[#78350f] h-6 flex items-center justify-center gap-0.5">
                        <span class="w-2 h-4 bg-red-400 rounded-2xs inline-block"></span>
                        <span class="w-2 h-4 bg-blue-400 rounded-2xs inline-block"></span>
                        <span class="w-2 h-4 bg-emerald-400 rounded-2xs inline-block"></span>
                      </div>
                      <div class="border-b border-[#78350f] h-6 flex items-center justify-center gap-0.5">
                        <span class="w-2.5 h-4 bg-amber-200 rounded-2xs inline-block"></span>
                        <span class="w-2 h-4 bg-purple-400 rounded-2xs inline-block"></span>
                      </div>
                      <div class="h-6 flex items-center justify-center gap-0.5">
                        <span class="w-2 h-4 bg-slate-200 rounded-2xs inline-block"></span>
                        <span class="w-3 h-4 bg-orange-400 rounded-2xs inline-block"></span>
                      </div>
                    </div>
                    <span class="text-[9px] font-mono font-bold text-amber-900">Arsip Naskah</span>
                  </div>

                  <!-- Middle Workstation: Joko (Writer Desk) -->
                  <div class="col-span-5 flex flex-col items-center">
                    <div class="text-[10px] font-mono font-bold text-amber-900 mb-1 flex items-center gap-1">
                      <span>Meja Tulis</span>
                      <span class="text-slate-400">• Joko</span>
                    </div>

                    <!-- Workstation Box -->
                    <div class="w-44 bg-[#fef3c7] border-2 border-amber-300 rounded-xl p-2.5 flex flex-col items-center shadow-xs relative">
                      <!-- Monitor & Setup -->
                      <div class="flex items-center justify-center gap-2 mb-1.5">
                        <div class="w-12 h-8 bg-slate-800 rounded border border-slate-600 flex items-center justify-center text-[8px] text-cyan-300 font-mono shadow-inner" title="Monitor Penulisan">
                          TXT
                        </div>
                        <div class="w-4 h-5 bg-[#d97706] rounded-2xs border border-[#b45309]" title="Lampu Meja Redaksi"></div>
                      </div>
                      <div class="w-16 h-2 bg-slate-300 rounded-xs mb-2 border border-slate-400" title="Keyboard & Notebook"></div>

                      <!-- Staff Sprite Slot -->
                      {(() => {
                        const joko = getSpriteAtPos('editorial_writer_desk');
                        if (joko) {
                          const badge = getStateBadgeStyle(joko);
                          return (
                            <button
                              type="button"
                              class="flex flex-col items-center group cursor-pointer focus:outline-none"
                              data-staff-inspect={joko.agent_id}
                              title={`Klik inspeksi ${joko.display_name}`}
                            >
                              <div class="relative">
                                <div class={`w-12 h-12 rounded-xl bg-white border-2 border-amber-400 flex items-center justify-center shadow-sm pixel-avatar-box ${joko.work_visual_state?.is_actively_working ? (JOB_ANIMATION_REGISTRY[joko.animation_key]?.css_animation_class || '') : ''}`}>
