              <div class="text-xs text-orange-950">
                LokaMedia Studio Worker dinonaktifkan oleh kebijakan operator. Budi berstatus OFFLINE tanpa aktivitas generasi visual semu.
              </div>
            </div>
          ` : ''}

          ${agentId === 'publication_dispatcher_core' ? `
            <div class="bg-emerald-50 p-3.5 rounded-2xl border border-emerald-200 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-mono font-bold uppercase text-emerald-900">PUBLICATION SAFETY GATE</span>
                <span class="text-[9px] font-mono font-bold px-1.5 py-0.2 rounded bg-emerald-200 text-emerald-950 border border-emerald-300">
                  AUTO_PUBLISH = OFF
                </span>
              </div>
              <div class="text-xs text-emerald-950">
                Semua artikel terjadwal memerlukan persetujuan operator manusia. Sari siaga tanpa mengeksekusi publikasi otonom.
              </div>
              <div class="pt-1">
                <a
                  href="/admin/publication/operations"
                  class="px-2.5 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-[10px] inline-flex items-center gap-1 transition"
                >
                  <span>Buka Panel Operasi Publikasi →</span>
                </a>
              </div>
            </div>
          ` : ''}

          <!-- 4. Active Anomaly Callout -->
          ${anomaly ? `
            <div class="bg-rose-50 p-3.5 rounded-2xl border-2 border-rose-300 space-y-1.5">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-mono font-bold uppercase text-rose-900 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-rose-600 animate-ping"></span>
                  ANOMALI SISTEM AKTIF
                </span>
                <span class="text-[9px] font-mono font-bold px-1.5 py-0.2 rounded bg-rose-200 text-rose-900 uppercase">
                  ${anomaly.severity}
                </span>
              </div>
              <div class="text-xs font-bold text-rose-950">${anomaly.title}</div>
              <div class="text-[11px] font-mono text-rose-800">
                Penyebab Terhambat: ${anomaly.blocking_condition || 'Kegagalan subsystem terdeteksi'}
              </div>
              <div class="pt-1 flex items-center justify-between border-t border-rose-200">
                <span class="text-[10px] text-rose-700 font-mono">ID: ${anomaly.anomaly_id}</span>
                <a
                  href="/admin/mission-control/alerts"
                  class="px-2 py-0.5 rounded bg-rose-600 hover:bg-rose-500 text-white font-bold text-[10px] transition"
                >
                  Buka Alert Center →
                </a>
              </div>
            </div>
          ` : ''}

          <!-- 5. Observed Workflow Transition / Handoff -->
          ${handoff ? `
            <div class="bg-indigo-50/80 p-3 rounded-2xl border border-indigo-200 space-y-1.5 text-xs">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-mono font-bold uppercase text-indigo-900 flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-indigo-600"></span>
                  Observed Workflow Transition
                </span>
                <span class="text-[9px] font-mono font-bold px-1.5 py-0.2 rounded border ${
                  handoff.handoff_state === 'RUNNING' ? 'bg-emerald-100 text-emerald-800 border-emerald-300' :
                  handoff.handoff_state === 'QUEUED' ? 'bg-amber-100 text-amber-800 border-amber-300' :
                  'bg-rose-100 text-rose-800 border-rose-300'
                }">${handoff.handoff_state}</span>
              </div>
              <div class="font-bold text-slate-800">${handoff.task_title || handoff.task_id}</div>
              <div class="text-[11px] font-mono text-slate-600 flex items-center justify-between">
                <span>Tahap: <strong>${handoff.from_stage} → ${handoff.to_stage}</strong></span>
                <span>${new Date(handoff.transition_timestamp).toLocaleTimeString('id-ID', { hour12: false })} WIB</span>
              </div>
              <div class="text-[10px] font-mono text-indigo-700 border-t border-indigo-100 pt-1 flex items-center justify-between">
                <span>Bukti: ${handoff.evidence_source} (${handoff.evidence_id})</span>
                <button
                  type="button"
                  data-open-job-trace="${handoff.task_id}"
                  class="px-2 py-0.5 rounded bg-indigo-600 hover:bg-indigo-500 text-white font-bold transition text-[10px] cursor-pointer"
                >
                  Buka Trace →
                </button>
              </div>
            </div>
          ` : ''}

          <!-- 6. Capabilities Strip -->
          <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 space-y-1">
            <div class="text-slate-500 font-bold text-[10px] uppercase">Kapabilitas Mesin:</div>
            <div class="flex flex-wrap gap-1 mt-1">
              ${(sprite.capabilities || []).map(function (c) {
                return `<span class="px-1.5 py-0.5 bg-slate-200 text-slate-700 border border-slate-300 rounded text-[9px] font-bold">${c}</span>`;
              }).join('')}
            </div>
          </div>

          <div class="text-[10px] font-mono text-slate-400 text-center pt-1 border-t border-slate-200">
            ⚡ Visualisasi telemetri operasional nyata • Zero synthetic animation • Read-only
          </div>
        `;
        }

        modal.classList.remove('hidden');
      }

      // Handle staff inspection on stationary buttons
      document.querySelectorAll('[data-staff-inspect]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const agentId = btn.getAttribute('data-staff-inspect');
          openStaffInspector(agentId);
        });
      });

      // Handle room inspection
      document.querySelectorAll('[data-room-inspect]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const roomKey = btn.getAttribute('data-room-inspect');
          const room = (officeData.rooms || []).find(function (r) {
            return r.room_key === roomKey;
          });
          if (!room || !modal) return;

          modalTag.textContent = 'ROOM INSPECTOR';
          modalTag.className = 'text-[10px] font-mono px-2 py-0.5 rounded bg-amber-100 text-amber-800 font-bold uppercase border border-amber-300';
          modalTitle.textContent = room.title;
          modalSubtitle.textContent = room.zone;

          if (modalChatLink) {
            modalChatLink.classList.add('hidden');
          }

          if (modalStaffLink) {
            if (room.department_id && room.department_id !== 'lounge' && room.department_id !== 'social') {
              modalStaffLink.href = '/admin/mission-control/departments/' + encodeURIComponent(room.department_id);
              modalStaffLink.textContent = 'Buka Detail Departemen →';
              modalStaffLink.classList.remove('hidden');
            } else {
              modalStaffLink.classList.add('hidden');
            }
          }

          modalBody.innerHTML = `
            <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Kesehatan Ruangan:</span>
                <span class="px-2 py-0.5 rounded font-bold uppercase text-[10px] bg-slate-200 text-slate-800 border border-slate-300">${room.health}</span>
              </div>
              <div class="flex items-start justify-between gap-2">
                <span class="text-slate-500 font-medium">Bukti Evaluasi:</span>
                <span class="text-slate-900 text-right font-medium max-w-[280px]">${room.health_evidence}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Jumlah Penghuni:</span>
                <span class="text-slate-900 font-bold">${room.occupants.length} Staf</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Tugas Aktif:</span>
                <span class="text-slate-800">${room.active_tasks_count}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-500 font-medium">Penghambat (Blockers):</span>
                <span class="text-slate-900 font-bold ${room.blockers_count > 0 ? 'text-rose-600' : 'text-slate-800'}">${room.blockers_count}</span>
              </div>
            </div>

            <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 space-y-1.5">
              <div class="text-slate-500 font-bold">Staf di Ruangan:</div>
              <div class="space-y-1 mt-1">
                ${room.occupants.length === 0
                  ? '<div class="text-slate-400 italic">Ruangan kosong (staf sedang di Lounge atau pos lain)</div>'
                  : room.occupants.map(function (o) {
                      return `<div class="flex items-center justify-between py-0.5 border-b border-slate-100 last:border-0">
                        <span class="text-slate-800 font-medium">${o.display_name} (${o.role})</span>
                        <span class="text-[10px] font-mono text-slate-500 font-bold">${o.badge_text}</span>
                      </div>`;
                    }).join('')}
              </div>
            </div>
          `;

          modal.classList.remove('hidden');
        });
      });

      // In local development mode only, expose harness bridge if dev container element exists
      if (document.getElementById('dev-scenario-harness')) {
        window.__hermesDevOffice = {
          startStaffJourney: startStaffJourney,
          activeMovements: activeMovements,
          executeCanonicalHandoff: executeCanonicalHandoff,
          openJobTrace: function (taskId, fixtureTrace) {
            openJobTrace(taskId, fixtureTrace);
          }
        };
      }

      // ======================================================================
      // V2.5 Canonical Job Trace & Activity Timeline Client Controller
      // ======================================================================
      const jobTraceModal = document.getElementById('job-trace-modal');
      const traceWorkflowIdEl = document.getElementById('trace-workflow-id');
      const traceOpBadgeEl = document.getElementById('trace-operational-badge');
      const traceTitleEl = document.getElementById('job-trace-title');
      const traceSubtitleEl = document.getElementById('job-trace-subtitle');
      const traceSummaryStripEl = document.getElementById('trace-summary-strip');
      const traceTimelineContainer = document.getElementById('trace-timeline-container');
      const jobTraceCloseBtn = document.getElementById('job-trace-close-btn');
      const jobTraceDoneBtn = document.getElementById('job-trace-done-btn');

      function closeJobTrace() {
        if (jobTraceModal) {
          jobTraceModal.classList.add('hidden');
        }
      }

      if (jobTraceCloseBtn) jobTraceCloseBtn.addEventListener('click', closeJobTrace);
      if (jobTraceDoneBtn) jobTraceDoneBtn.addEventListener('click', closeJobTrace);

      window.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          closeJobTrace();
        }
      });

      function renderJobTraceData(trace) {
        if (!jobTraceModal || !trace) return;

        if (traceWorkflowIdEl) traceWorkflowIdEl.textContent = trace.workflow_id || trace.task_id;
        if (traceTitleEl) traceTitleEl.textContent = trace.summary?.artifact_title || trace.task_id;
        if (traceSubtitleEl) {
          traceSubtitleEl.textContent = `Kronologi bukti kanonikal (${trace.summary?.canonical_event_count || trace.events?.length || 0} peristiwa, ${trace.summary?.handoff_count || 0} handoff)`;
        }

        const opState = trace.summary?.current_operational_state || 'STANDBY';
        if (traceOpBadgeEl) {
          traceOpBadgeEl.textContent = opState;
          traceOpBadgeEl.className = 'text-[10px] font-mono px-2 py-0.5 rounded font-bold uppercase border ' + (
            opState === 'RUNNING' ? 'bg-emerald-100 text-emerald-800 border-emerald-300' :
            opState === 'QUEUED' ? 'bg-amber-100 text-amber-800 border-amber-300' :
            opState === 'BLOCKED' || opState === 'FAILED' ? 'bg-rose-100 text-rose-800 border-rose-300' :
            opState === 'PUBLISHED' ? 'bg-blue-100 text-blue-800 border-blue-300' :
            'bg-slate-200 text-slate-800 border-slate-300'
          );
        }

        // Summary Strip
        if (traceSummaryStripEl) {
          const startedTime = trace.summary?.started_at ? new Date(trace.summary.started_at).toLocaleTimeString('id-ID', { hour12: false }) + ' WIB' : '-';
          const lastTime = trace.summary?.last_transition_at ? new Date(trace.summary.last_transition_at).toLocaleTimeString('id-ID', { hour12: false }) + ' WIB' : '-';

          traceSummaryStripEl.innerHTML = `
            <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-200 space-y-0.5">
              <div class="text-[10px] font-mono uppercase text-slate-400 font-bold">Tahap Saat Ini</div>
              <div class="text-xs font-outfit font-black text-slate-900 capitalize truncate">${trace.summary?.current_stage || '-'}</div>
            </div>
            <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-200 space-y-0.5">
              <div class="text-[10px] font-mono uppercase text-slate-400 font-bold">Pelaksana Aktif</div>
              <div class="text-xs font-outfit font-black text-slate-900 truncate">${trace.summary?.current_agent_name || 'Unassigned'}</div>
            </div>
            <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-200 space-y-0.5">
              <div class="text-[10px] font-mono uppercase text-slate-400 font-bold">Waktu Mulai</div>
              <div class="text-xs font-mono font-bold text-slate-800">${startedTime}</div>
            </div>
            <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-200 space-y-0.5">
              <div class="text-[10px] font-mono uppercase text-slate-400 font-bold">Transisi Terakhir</div>
              <div class="text-xs font-mono font-bold text-slate-800">${lastTime}</div>
            </div>
          `;
        }

        // Timeline Items
        if (traceTimelineContainer) {
          let html = '';

          if (trace.summary?.blocking_condition) {
            html += `
              <div class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-mono font-bold flex items-center gap-2">
                <span class="text-rose-600 text-base">⚠️</span>
                <span>Kondisi Penghambat: ${trace.summary.blocking_condition}</span>
              </div>
            `;
          }

          html += '<div class="space-y-0 relative">';

          const events = trace.events || [];
          if (events.length === 0) {
            html += `
              <div class="py-8 text-center text-slate-400 text-xs font-mono italic">
                Belum ada bukti peristiwa kanonikal tercatat untuk tugas ini.
              </div>
            `;
          } else {
            events.forEach(function (ev) {
              if (ev.event_type === 'EVIDENCE_GAP') {
                html += `
                  <div class="relative pl-6 pb-6 border-l-2 border-dashed border-amber-300">
                    <div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-amber-100 border-2 border-amber-500 flex items-center justify-center text-[10px] text-amber-700 font-bold">!</div>
                    <div class="bg-amber-50/70 p-3 rounded-xl border border-amber-200/90 space-y-1">
                      <div class="text-[10px] font-mono uppercase text-amber-700 font-bold tracking-wide">EVIDENCE GAP DETECTED</div>
                      <div class="text-xs font-medium text-amber-900">${ev.note || 'Ketiadaan bukti transisi'}</div>
                      <div class="text-[10px] font-mono text-slate-500">Tidak ada bukti rekaman transisi antara tahap ini. Menghindari rekonstruksi riwayat fiktif.</div>
                    </div>
                  </div>
                `;
                return;
              }

              let badgeColor = 'bg-slate-200 text-slate-800 border-slate-300';
              let nodeBorder = 'border-slate-400';
              let nodeBg = 'bg-slate-500';

              if (ev.event_type === 'TASK_CREATED') {
                badgeColor = 'bg-blue-100 text-blue-800 border-blue-300';
                nodeBorder = 'border-blue-500';
                nodeBg = 'bg-blue-500';
              } else if (ev.event_type === 'STAGE_ENTERED' || ev.event_type === 'RUNNING') {
                badgeColor = 'bg-emerald-100 text-emerald-800 border-emerald-300';
                nodeBorder = 'border-emerald-500';
                nodeBg = 'bg-emerald-500';
              } else if (ev.event_type === 'HANDOFF') {
                badgeColor = 'bg-indigo-100 text-indigo-800 border-indigo-300';
                nodeBorder = 'border-indigo-500';
                nodeBg = 'bg-indigo-500';
              } else if (ev.event_type === 'APPROVED') {
                badgeColor = 'bg-teal-100 text-teal-800 border-teal-300';
                nodeBorder = 'border-teal-500';
                nodeBg = 'bg-teal-500';
              } else if (ev.event_type === 'QUEUED') {
                badgeColor = 'bg-amber-100 text-amber-800 border-amber-300';
                nodeBorder = 'border-amber-500';
                nodeBg = 'bg-amber-500';
              } else if (ev.event_type === 'PUBLISHED') {
                badgeColor = 'bg-blue-100 text-blue-800 border-blue-300';
                nodeBorder = 'border-blue-600';
                nodeBg = 'bg-blue-600';
              } else if (ev.event_type === 'BLOCKED' || ev.event_type === 'FAILED') {
                badgeColor = 'bg-rose-100 text-rose-800 border-rose-300';
                nodeBorder = 'border-rose-500';
                nodeBg = 'bg-rose-500';
              } else if (ev.event_type === 'ANOMALY') {
                badgeColor = 'bg-orange-100 text-orange-800 border-orange-300';
                nodeBorder = 'border-orange-500';
                nodeBg = 'bg-orange-500';
              } else if (ev.event_type === 'RECOVERED') {
                badgeColor = 'bg-emerald-100 text-emerald-800 border-emerald-300';
                nodeBorder = 'border-emerald-500';
                nodeBg = 'bg-emerald-500';
              }

              const timeStr = new Date(ev.canonical_timestamp).toLocaleTimeString('id-ID', { hour12: false }) + ' WIB';

              html += `
                <div class="relative pl-6 pb-6 border-l-2 border-slate-200">
                  <div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-white border-2 ${nodeBorder} flex items-center justify-center">
                    <div class="w-1.5 h-1.5 rounded-full ${nodeBg}"></div>
                  </div>
                  <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200/90 space-y-1.5">
                    <div class="flex items-center justify-between gap-2 flex-wrap">
                      <div class="flex items-center gap-1.5">
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold font-mono uppercase border ${badgeColor}">${ev.event_type}</span>
                        ${ev.stage ? `<span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-slate-200 text-slate-700">${ev.stage}</span>` : ''}
                      </div>
                      <div class="text-[10px] font-mono text-slate-500 font-bold">${timeStr}</div>
                    </div>
                    <div class="text-slate-900 text-xs font-bold font-outfit">${ev.note || ev.event_type}</div>
                    <div class="text-[11px] font-mono text-slate-500 flex items-center justify-between gap-2 flex-wrap">
                      <span>Pelaksana: <strong class="text-slate-700">${ev.agent_id || 'System'}</strong> (${ev.department_id})</span>
                      ${ev.duration_label ? `<span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-bold border border-emerald-200">⏱ ${ev.duration_label}</span>` : ''}
                    </div>
                    <details class="text-[10px] font-mono text-slate-500 pt-1.5 border-t border-slate-200">
                      <summary class="hover:text-slate-700 select-none cursor-pointer">Bukti Kanonikal (${ev.confidence}) ▾</summary>
                      <div class="mt-1.5 p-2 rounded-lg bg-white border border-slate-200 space-y-0.5 text-[10px]">
                        <div>Sumber: <strong>${ev.evidence_source}</strong></div>
                        <div>ID Bukti: <span class="font-mono text-slate-700">${ev.evidence_id}</span></div>
                        <div>Waktu UTC: <span class="font-mono text-slate-500">${ev.canonical_timestamp}</span></div>
                        ${ev.handoff_id ? `<div>Handoff ID: <span class="font-mono text-indigo-600">${ev.handoff_id}</span></div>` : ''}
                        ${ev.anomaly_id ? `<div>Anomaly ID: <span class="font-mono text-rose-600">${ev.anomaly_id}</span></div>` : ''}
                      </div>
                    </details>
                  </div>
                </div>
              `;
            });
          }

          // Active Current State Card at Bottom
          const curTime = trace.summary?.last_transition_at ? new Date(trace.summary.last_transition_at).toLocaleTimeString('id-ID', { hour12: false }) + ' WIB' : '-';
          html += `
            <div class="relative pl-6 pt-1">
