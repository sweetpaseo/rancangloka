---
/**
 * RancangLoka Hermes Mission Control — Pixel Office (2D Spatial Visualization)
 * Milestone: HERMES-MC-4
 * Route: /admin/mission-control/office
 * 
 * Strict Invariants:
 * 1. Read-only spatial visualization layer.
 * 2. Visualizes REAL Mission Control state — zero simulated or fabricated activity.
 * 3. Media Worker DISABLED is visually distinct (Worker Disabled, dimmed, NO red emergency beacon).
 * 4. IDLE staff appear in Lounge; WORKING staff appear at department workstation.
 * 5. REVIEWING has deterministic review desk placement.
 * 6. BLOCKED staff remain in department with critical warning markers.
 * 7. Social room is strictly unstaffed and labeled COMING LATER / NOT AVAILABLE.
 * 8. Zero command/chat execution authority (no chat, no retry, no dispatch).
 * 9. Reduced motion supported; mobile responsive with scrollable floor plan.
 */

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db.ts';
import { getMissionControlSnapshot, getPixelOfficeState } from '../../../lib/mission-control/index.ts';
import type { OfficeStaffSprite, OfficeRoom } from '../../../lib/mission-control/pixel-office.ts';

const env = (Astro.locals as any)?.runtime?.env || (globalThis as any).process?.env || {};
const db = (await getDb(Astro.locals)) || env.DB || (Astro.locals as any)?.db;

const snapshot = await getMissionControlSnapshot(db, env);
const office = getPixelOfficeState(snapshot);
const { rooms, sprites, summary, recent_activity } = office;

// State badge styling helper
const getStateBadgeStyle = (sprite: OfficeStaffSprite) => {
  switch (sprite.visual_mode) {
    case 'ACTIVE':
      return 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40';
    case 'REVIEWING':
      return 'bg-indigo-500/20 text-indigo-300 border-indigo-500/40';
    case 'IDLE':
      return 'bg-slate-700 text-slate-300 border-slate-600';
    case 'BLOCKED':
      return 'bg-rose-500/30 text-rose-300 border-rose-500/50 animate-pulse';
    case 'DIMMED':
      if (sprite.state_reason.category === 'INTENTIONAL_DISABLED') {
        return 'bg-amber-500/20 text-amber-300 border-amber-500/30';
      }
      return 'bg-zinc-800 text-zinc-400 border-zinc-700';
    default:
      return 'bg-slate-800 text-slate-400 border-slate-700';
  }
};

const getRoomHealthBadge = (health: string) => {
  switch (health) {
    case 'HEALTHY':
      return { text: 'HEALTHY', bg: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' };
    case 'ACTIVE':
      return { text: 'ACTIVE', bg: 'bg-blue-500/10 text-blue-400 border-blue-500/20' };
    case 'STANDBY':
      return { text: 'STANDBY', bg: 'bg-slate-700/50 text-slate-300 border-slate-600/50' };
    case 'DEGRADED':
      return { text: 'DEGRADED', bg: 'bg-amber-500/10 text-amber-400 border-amber-500/20' };
    case 'BLOCKED':
      return { text: 'BLOCKED', bg: 'bg-rose-500/20 text-rose-400 border-rose-500/40' };
    case 'UNSTAFFED':
      return { text: 'TIDAK TERSEDIA', bg: 'bg-zinc-800 text-zinc-500 border-zinc-700' };
    default:
      return { text: health, bg: 'bg-slate-800 text-slate-400 border-slate-700' };
  }
};
---

<AdminLayout title="Hermes Mission Control — Pixel Office">
  <div class="space-y-5 pb-16 font-sans">
    <!-- 1. Header Banner -->
    <div class="bg-slate-950 border border-slate-800 rounded-3xl p-5 sm:p-7 shadow-xl space-y-4">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono uppercase tracking-wider font-bold bg-blue-500/10 text-blue-400 border border-blue-500/20">
              HERMES MISSION CONTROL
            </span>
            <span class="text-slate-600">•</span>
            <span class="text-xs font-mono text-slate-400">2D Pixel Office • Spatial Operations</span>
            <span class="text-slate-600">•</span>
            <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
              READ-ONLY
            </span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-outfit font-black text-white tracking-tight mt-1.5 flex items-center gap-2.5">
            <span>👾</span>
            <span>RancangLoka Pixel Office</span>
          </h1>
          <p class="text-xs text-slate-400 mt-1 max-w-3xl font-mono">
            Visualisasi spasial operasional 2D retro berbasis telemetri riil Mission Control. Staf ditempatkan secara deterministik berdasarkan status kerja: meja penulisan, meja review, lab riset, konsol dispatch, hingga sofa siaga di Lounge.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <div class="text-right hidden sm:block">
            <div class="text-[10px] font-mono uppercase text-slate-500">Evaluasi Telemetri</div>
            <div class="text-xs font-mono text-slate-300" id="live-time-display">
              {new Date(office.generated_at).toLocaleTimeString('id-ID', { hour12: false })} WIB
            </div>
          </div>
          <button
            type="button"
            id="btn-refresh-office"
            class="rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-4 py-2 text-xs font-outfit font-bold transition flex items-center gap-2 shadow-xs cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500/40"
          >
            <svg class="w-3.5 h-3.5 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
              <path d="M3 3v5h5"></path>
              <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path>
              <path d="M16 21h5v-5"></path>
            </svg>
            <span>Segarkan</span>
          </button>
        </div>
      </div>

      <!-- Navigation Sub-Tabs -->
      <div class="flex items-center gap-2 border-t border-slate-800/80 pt-4 text-xs font-outfit font-bold overflow-x-auto pb-1">
        <a
          href="/admin/mission-control"
          class="px-4 py-2 rounded-xl text-slate-400 hover:text-slate-200 hover:bg-slate-800/80 transition flex items-center gap-2 whitespace-nowrap"
        >
          <span>🛰️</span>
          <span>Cockpit Operasional</span>
        </a>
        <a
          href="/admin/mission-control/staff"
          class="px-4 py-2 rounded-xl text-slate-400 hover:text-slate-200 hover:bg-slate-800/80 transition flex items-center gap-2 whitespace-nowrap"
        >
          <span>👥</span>
          <span>Staff Registry</span>
          <span class="px-1.5 py-0.2 rounded-full bg-slate-800 text-[10px] font-mono text-slate-400">6 Staf</span>
        </a>
        <a
          href="/admin/mission-control/departments"
          class="px-4 py-2 rounded-xl text-slate-400 hover:text-slate-200 hover:bg-slate-800/80 transition flex items-center gap-2 whitespace-nowrap"
        >
          <span>🏢</span>
          <span>Departemen</span>
          <span class="px-1.5 py-0.2 rounded-full bg-slate-800 text-[10px] font-mono text-slate-400">6 Divisi</span>
        </a>
        <a
          href="/admin/mission-control/office"
          class="px-4 py-2 rounded-xl bg-blue-600 text-white shadow-xs flex items-center gap-2 whitespace-nowrap"
        >
          <span>👾</span>
          <span>Pixel Office</span>
