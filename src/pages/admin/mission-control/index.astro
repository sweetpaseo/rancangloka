---
/**
 * RancangLoka Hermes Mission Control Core
 * Milestone: HERMES-MC-1
 * Route: /admin/mission-control
 * 
 * Strict Invariants:
 * 1. Read-only operational cockpit.
 * 2. Real operational state — zero fabricated activity.
 * 3. Protected by admin_session middleware.
 */

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db.ts';
import { getMissionControlSnapshot } from '../../../lib/mission-control/index.ts';

const env = (Astro.locals as any)?.runtime?.env || (globalThis as any).process?.env || {};
const db = (await getDb(Astro.locals)) || env.DB || (Astro.locals as any)?.db;

const snapshot = await getMissionControlSnapshot(db, env);
const { health, pipeline, activity, scheduler, outbox, articles, media, jev } = snapshot;

// Visual helper functions
const getModeBadgeClass = (mode: string) => {
  switch (mode) {
    case 'OFF':
      return 'bg-slate-100 text-slate-700 border-slate-300';
    case 'OBSERVE_ONLY':
      return 'bg-blue-50 text-blue-700 border-blue-200';
    case 'PLAN_ONLY':
      return 'bg-indigo-50 text-indigo-700 border-indigo-200';
    case 'CONTROLLED':
      return 'bg-emerald-50 text-emerald-700 border-emerald-200';
    case 'UNATTENDED':
      return 'bg-purple-50 text-purple-700 border-purple-200';
    default:
      return 'bg-slate-100 text-slate-600 border-slate-200';
  }
};

const getBreakerDotClass = (state: string) => {
  switch (state) {
    case 'CLOSED':
      return 'bg-emerald-500 shadow-emerald-500/40';
    case 'OPEN':
      return 'bg-rose-500 shadow-rose-500/40 animate-pulse';
    case 'HALF_OPEN':
      return 'bg-amber-500 shadow-amber-500/40';
    default:
      return 'bg-slate-400';
  }
};

const getStageBadgeClass = (stage: string) => {
  switch (stage) {
    case 'draft':
      return 'bg-slate-100 text-slate-700 border-slate-200';
    case 'waiting_media':
      return 'bg-amber-50 text-amber-700 border-amber-200';
    case 'editorial_qa':
      return 'bg-indigo-50 text-indigo-700 border-indigo-200';
    case 'ready_for_review':
      return 'bg-blue-50 text-blue-700 border-blue-200';
    case 'scheduled':
      return 'bg-teal-50 text-teal-700 border-teal-200';
    case 'published':
      return 'bg-emerald-50 text-emerald-700 border-emerald-200';
    case 'failed':
      return 'bg-rose-50 text-rose-700 border-rose-200';
    default:
      return 'bg-slate-100 text-slate-600 border-slate-200';
  }
};

const getSeverityClass = (sev: string) => {
  switch (sev) {
    case 'CRITICAL':
      return 'text-rose-600 bg-rose-50 border-rose-200 font-bold';
    case 'WARNING':
      return 'text-amber-600 bg-amber-50 border-amber-200 font-medium';
    case 'SUCCESS':
      return 'text-emerald-600 bg-emerald-50 border-emerald-200 font-medium';
    default:
      return 'text-slate-600 bg-slate-50 border-slate-200 font-medium';
  }
};

const formatTimeAgo = (isoString?: string | null) => {
  if (!isoString) return 'Tidak tersedia';
  try {
    const diff = Math.floor((Date.now() - new Date(isoString).getTime()) / 1000);
    if (diff < 5) return 'Baru saja';
    if (diff < 60) return `${diff}d yang lalu`;
    if (diff < 3600) return `${Math.floor(diff / 60)}m yang lalu`;
    if (diff < 86400) return `${Math.floor(diff / 3600)}j yang lalu`;
    return `${Math.floor(diff / 86400)}h yang lalu`;
  } catch {
    return isoString;
  }
};
---

<AdminLayout title="Hermes Mission Control">
  <div class="max-w-[1600px] mx-auto space-y-6 pb-12">
    <!-- 1. Top Cockpit Header -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-slate-900 text-white rounded-2xl p-6 shadow-sm border border-slate-800">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="px-2.5 py-0.5 rounded-md bg-blue-500/20 text-blue-400 font-mono text-[11px] font-bold uppercase tracking-wider border border-blue-500/30">
            HERMES-MC-1
          </span>
          <span class="text-slate-600">•</span>
          <span class="text-xs font-mono text-slate-400">Supervisory Read-Only Cockpit</span>
          <span class="text-slate-600">•</span>
          <span id="freshness-badge" class="px-2 py-0.5 rounded text-[10px] font-mono uppercase font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
            {snapshot.freshness}
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-outfit font-black text-white tracking-tight mt-1.5 flex items-center gap-2.5">
          <span>🛰️</span>
          <span>Hermes Mission Control</span>
        </h1>
        <p class="text-xs text-slate-400 mt-1 max-w-2xl font-mono">
          Observabilitas terpadu real-time: status otomatisasi, gerbang pekerja media, observasi bayangan Jev, dan siklus pipeline artikel.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <div class="text-right hidden sm:block">
          <div class="text-[10px] font-mono uppercase text-slate-500">Waktu Snapshot</div>
          <div id="snapshot-timestamp" class="text-xs font-mono text-slate-300">
            {new Date(snapshot.generatedAt).toLocaleTimeString('id-ID', { hour12: false })} WIB
          </div>
        </div>
        <button
          id="refresh-btn"
          type="button"
          class="rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-4 py-2 text-xs font-outfit font-bold transition flex items-center gap-2 shadow-xs cursor-pointer"
        >
          <svg id="refresh-spinner" class="w-3.5 h-3.5 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
            <path d="M3 3v5h5"></path>
            <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path>
            <path d="M16 21h5v-5"></path>
          </svg>
          <span>Segarkan</span>
        </button>
      </div>
    </div>

    <!-- Sub-Navigation Bar -->
    <div class="flex items-center gap-2 bg-slate-900 border border-slate-800 p-2 rounded-xl text-xs font-outfit font-bold">
      <a
        href="/admin/mission-control"
        class="px-4 py-2 rounded-lg bg-blue-600 text-white shadow-xs flex items-center gap-2"
      >
        <span>🛰️</span>
        <span>Cockpit Operasional</span>
      </a>
      <a
        href="/admin/mission-control/staff"
        class="px-4 py-2 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800 transition flex items-center gap-2"
      >
        <span>👥</span>
        <span>Staff Registry</span>
        <span class="px-1.5 py-0.2 rounded-full bg-slate-800 text-[10px] font-mono text-slate-400">6 Staf</span>
      </a>
    </div>

    <!-- 2. System Health Strip -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      <!-- A. Publication Automation -->
      <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-2xs space-y-2">
        <div class="flex items-center justify-between text-xs text-slate-500">
          <span class="font-bold text-[11px] uppercase tracking-wider text-slate-600">Publikasi Otomatis</span>
          <span class="text-[10px] font-mono text-slate-400">D1 Control</span>
        </div>
        <div class="flex items-center gap-2">
          <span class={`px-2.5 py-1 rounded-lg text-xs font-mono font-bold border uppercase ${getModeBadgeClass(health.automation.mode)}`}>
            {health.automation.mode}
          </span>
        </div>
        <p class="text-[11px] text-slate-500 font-mono">
          {health.automation.mode === 'OFF' ? 'Nonaktif permanen (Draft-only)' : `Mode aktif: ${health.automation.mode}`}
        </p>
      </div>

      <!-- B. Emergency Kill Switch -->
      <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-2xs space-y-2">
        <div class="flex items-center justify-between text-xs text-slate-500">
          <span class="font-bold text-[11px] uppercase tracking-wider text-slate-600">Emergency Kill Switch</span>
          <span class="text-[10px] font-mono text-slate-400">Global Lock</span>
        </div>
        <div class="flex items-center gap-2">
          {health.automation.killSwitchEngaged ? (
            <span class="px-2.5 py-1 rounded-lg text-xs font-mono font-bold bg-rose-100 text-rose-700 border border-rose-300 animate-pulse flex items-center gap-1.5">
              <span>⛔</span>
              <span>ENGAGED</span>
            </span>
          ) : (
            <span class="px-2.5 py-1 rounded-lg text-xs font-mono font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center gap-1.5">
              <span>🛡️</span>
              <span>NORMAL</span>
            </span>
          )}
        </div>
        <p class="text-[11px] text-slate-500 font-mono truncate">
          {health.automation.killSwitchEngaged ? (health.automation.killReason || 'Saklar darurat aktif') : 'Tidak ada pemutusan darurat'}
        </p>
      </div>

      <!-- C. Media Worker Gate -->
      <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-2xs space-y-2">
        <div class="flex items-center justify-between text-xs text-slate-500">
          <span class="font-bold text-[11px] uppercase tracking-wider text-slate-600">Media Worker Gate</span>
          <span class="text-[10px] font-mono text-slate-400">Dual-Gate</span>
        </div>
        <div class="flex items-center gap-2">
          <span class={`px-2.5 py-1 rounded-lg text-xs font-mono font-bold border ${health.mediaWorker.effectiveState === 'DISABLED' ? 'bg-slate-100 text-slate-700 border-slate-300' : 'bg-emerald-50 text-emerald-700 border-emerald-200'}`}>
            {health.mediaWorker.effectiveState}
          </span>
          <span class="text-[11px] font-mono text-slate-400">
            ({health.mediaWorker.activeDevicesCount} dev)
          </span>
        </div>
        <p class="text-[11px] text-slate-500 font-mono truncate">
          {health.mediaWorker.reason}
        </p>
      </div>

      <!-- D. TypeSafe JEV -->
      <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-2xs space-y-2">
        <div class="flex items-center justify-between text-xs text-slate-500">
          <span class="font-bold text-[11px] uppercase tracking-wider text-slate-600">TypeSafe JEV</span>
          <span class="text-[10px] font-mono text-blue-600 font-bold">SHADOW ONLY</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-1 rounded-lg text-xs font-mono font-bold bg-blue-50 text-blue-700 border border-blue-200">
            SHADOW
          </span>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-slate-100 text-slate-600">
            0 AUTHORITY
          </span>
        </div>
        <p class="text-[11px] text-slate-500 font-mono truncate">
          Provider: <strong class="text-slate-700">{health.jev.providerStatus}</strong> {health.jev.latestLatencyMs ? `(${health.jev.latestLatencyMs}ms)` : ''}
        </p>
      </div>

      <!-- E. Circuit Breakers -->
      <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-2xs space-y-2">
        <div class="flex items-center justify-between text-xs text-slate-500">
          <span class="font-bold text-[11px] uppercase tracking-wider text-slate-600">Circuit Breakers</span>
          <span class="text-[10px] font-mono text-slate-400">{health.circuitBreakers.length} aktif</span>
        </div>
        <div class="space-y-1">
          {health.circuitBreakers.map((cb) => (
            <div class="flex items-center justify-between text-[11px] font-mono">
              <span class="text-slate-600 truncate max-w-[120px]">{cb.id}</span>
              <div class="flex items-center gap-1.5">
                <span class={`w-2 h-2 rounded-full ${getBreakerDotClass(cb.state)}`}></span>
                <span class="font-bold text-slate-800 text-[10px]">{cb.state}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- 3. Main Dashboard Grid (Left: Pipeline / Right: Telemetry & Summaries) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- LEFT: Pipeline & Task Execution Board (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        <div class="bg-white border border-slate-200/90 rounded-2xl p-5 shadow-2xs space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-3">
            <div>
              <h2 class="text-base font-outfit font-bold text-slate-900 flex items-center gap-2">
                <span>📋</span>
                <span>Pipeline / Task Execution Board</span>
              </h2>
              <p class="text-xs text-slate-500 font-mono">
                {pipeline.totalActiveTasks} tugas aktif • Refleksi data riil D1 articles & media jobs
              </p>
            </div>
            
            <!-- Stage Count Pills -->
            <div class="flex flex-wrap gap-1.5 text-[11px] font-mono">
              <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 font-bold">
                Draft: {pipeline.stageCounts.draft}
              </span>
              <span class="px-2 py-0.5 rounded-md bg-amber-50 text-amber-700 font-bold">
                Wait Media: {pipeline.stageCounts.waiting_media}
              </span>
              <span class="px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 font-bold">
                Review: {pipeline.stageCounts.ready_for_review}
              </span>
              <span class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 font-bold">
                Published: {pipeline.stageCounts.published}
              </span>
            </div>
          </div>

          <!-- Task Cards List -->
          <div class="space-y-2.5 max-h-[520px] overflow-y-auto pr-1">
            {pipeline.tasks.length === 0 ? (
              <div class="py-12 text-center text-slate-400 font-mono text-xs border border-dashed border-slate-200 rounded-xl">
                Tidak ada tugas aktif dalam pipeline.
              </div>
            ) : (
              pipeline.tasks.map((task) => (
                <div class="border border-slate-200/80 hover:border-slate-300 rounded-xl p-3.5 transition bg-white hover:bg-slate-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                  <div class="space-y-1 min-w-0">
                    <div class="flex items-center gap-2">
                      <span class="font-mono text-[10px] font-bold text-slate-500 uppercase px-1.5 py-0.5 bg-slate-100 rounded">
                        {task.taskId}
                      </span>
                      <span class={`text-[10px] font-mono font-bold uppercase px-2 py-0.5 rounded-md border ${getStageBadgeClass(task.stage)}`}>
                        {task.stage.replace('_', ' ')}
                      </span>
                      {task.retryCount > 0 && (
                        <span class="text-[10px] font-mono bg-amber-100 text-amber-800 px-1.5 py-0.5 rounded font-bold">
                          Retry: {task.retryCount}
                        </span>
                      )}
                    </div>
                    <div class="text-xs font-outfit font-bold text-slate-900 truncate">
                      {task.title}
                    </div>
                    {task.blockerOrError && (
                      <div class="text-[11px] font-mono text-rose-600 font-medium">
                        ⚠️ {task.blockerOrError}
                      </div>
                    )}
                  </div>

                  <div class="text-right sm:shrink-0 flex sm:flex-col items-center sm:items-end justify-between text-[11px] font-mono text-slate-400">
                    <span class="capitalize text-slate-500">{task.subsystem}</span>
                    <span>{formatTimeAgo(task.lastUpdate)}</span>
                  </div>
                </div>
              ))
            )}
          </div>
        </div>

        <!-- JEV Observability Panel -->
        <div class="bg-white border border-slate-200/90 rounded-2xl p-5 shadow-2xs space-y-3">
          <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
            <div>
              <h3 class="text-sm font-outfit font-bold text-slate-900 flex items-center gap-2">
                <span>🤖</span>
                <span>TypeSafe JEV Telemetry & Disagreement</span>
              </h3>
              <p class="text-[11px] text-slate-500 font-mono">
                Total observasi shadow: <strong class="text-slate-700">{jev.totalObservationsCount}</strong>
                {jev.agreementRatePercent !== null ? ` • Tingkat Kesepakatan: ${jev.agreementRatePercent}%` : ''}
              </p>
            </div>
            <span class="px-2 py-0.5 bg-blue-50 text-blue-700 text-[10px] font-mono font-bold rounded border border-blue-200">
              NON-BLOCKING
            </span>
          </div>

          {jev.recentObservations.length === 0 ? (
            <div class="py-4 text-center text-slate-400 font-mono text-xs">
              Belum ada observasi keputusan JEV yang terekam.
            </div>
          ) : (
            <div class="space-y-2">
              {jev.recentObservations.slice(0, 3).map((obs) => (
                <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl font-mono text-xs border border-slate-200/60">
                  <div class="space-y-0.5">
                    <div class="text-[11px] font-bold text-slate-800 flex items-center gap-2">
                      <span>{obs.decisionPoint}</span>
                      <span class="text-slate-400 text-[10px]">({obs.observationId})</span>
                    </div>
                    <div class="text-[10px] text-slate-500">
                      Otoritatif: <strong class="text-slate-700">{obs.authoritativeDecision}</strong> • JEV: <strong class="text-blue-700">{obs.jevDecision || 'N/A'}</strong>
                    </div>
                  </div>
                  <div class="text-right text-[10px]">
                    <span class={`px-1.5 py-0.5 rounded font-bold ${obs.disagreementClassification.startsWith('AGREE') ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}`}>
                      {obs.disagreementClassification}
                    </span>
                    <div class="text-slate-400 mt-1">{obs.latencyMs}ms</div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      <!-- RIGHT: Scheduler, Outbox, and Operations (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        <!-- A. Scheduler & Heartbeat -->
        <div class="bg-white border border-slate-200/90 rounded-2xl p-5 shadow-2xs space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="text-sm font-outfit font-bold text-slate-900 flex items-center gap-2">
              <span>⏱️</span>
              <span>Scheduler & Heartbeat</span>
            </h3>
            <span class="text-[10px] font-mono text-slate-400">Threshold: 300s/600s</span>
          </div>

          <!-- Hermes Container Scheduler Daemon -->
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-800 font-outfit">Hermes Container Daemon</span>
              <div class="flex items-center gap-1.5">
                <span class={`w-2 h-2 rounded-full ${scheduler.hermes.status === 'healthy' ? 'bg-emerald-500' : scheduler.hermes.status === 'stale' ? 'bg-amber-500' : scheduler.hermes.status === 'offline' ? 'bg-rose-500' : 'bg-slate-400'}`}></span>
                <span class="text-[10px] font-mono font-bold uppercase text-slate-700">{scheduler.hermes.status}</span>
              </div>
            </div>
            <p class="text-[11px] text-slate-500 font-mono">
              {scheduler.hermes.note}
            </p>
            {scheduler.hermes.recordedAt && (
              <div class="text-[10px] font-mono text-slate-400">
                Terakhir: {formatTimeAgo(scheduler.hermes.recordedAt)}
              </div>
            )}
          </div>

          <!-- Cloudflare Cron Runs -->
          <div class="space-y-2">
            <div class="text-[11px] font-mono uppercase font-bold text-slate-500">Cloudflare Cron Executions</div>
            {scheduler.cloudflareCron.length === 0 ? (
              <div class="text-[11px] font-mono text-slate-400 italic py-1">
                Belum ada catatan cron Cloudflare di database D1.
              </div>
            ) : (
              <div class="space-y-1.5">
                {scheduler.cloudflareCron.map((cron) => (
                  <div class="flex items-center justify-between text-xs font-mono p-2 bg-slate-50 rounded-lg border border-slate-200/50">
                    <span class="text-slate-700 font-medium truncate max-w-[140px]">{cron.jobName}</span>
                    <div class="flex items-center gap-2">
                      <span class={`px-1.5 py-0.5 rounded text-[10px] font-bold ${cron.status === 'SUCCEEDED' ? 'bg-emerald-100 text-emerald-800' : cron.status === 'BLOCKED' ? 'bg-amber-100 text-amber-800' : 'bg-rose-100 text-rose-800'}`}>
                        {cron.status}
                      </span>
                      <span class="text-[10px] text-slate-400">{formatTimeAgo(cron.startedAt)}</span>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>

        <!-- B. Hermes Outbox Status -->
        <div class="bg-white border border-slate-200/90 rounded-2xl p-5 shadow-2xs space-y-3">
          <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
            <h3 class="text-sm font-outfit font-bold text-slate-900 flex items-center gap-2">
              <span>📤</span>
              <span>Hermes Outbox Queue</span>
            </h3>
            <span class="text-[10px] font-mono text-slate-400">Source: {outbox.source}</span>
          </div>

          <div class="grid grid-cols-4 gap-2 text-center font-mono">
            <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200/70">
              <div class="text-[10px] text-slate-500 uppercase">Queued</div>
              <div class="text-base font-bold text-slate-800 mt-0.5">{outbox.queued}</div>
            </div>
            <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200/70">
              <div class="text-[10px] text-slate-500 uppercase">Sending</div>
              <div class="text-base font-bold text-blue-600 mt-0.5">{outbox.sending}</div>
            </div>
            <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200/70">
              <div class="text-[10px] text-slate-500 uppercase">Ack'd</div>
              <div class="text-base font-bold text-emerald-600 mt-0.5">{outbox.acknowledged}</div>
            </div>
            <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200/70">
              <div class="text-[10px] text-slate-500 uppercase">Dead</div>
              <div class="text-base font-bold text-slate-400 mt-0.5">{outbox.deadLetter}</div>
            </div>
          </div>
          {outbox.lastIngestAt && (
            <p class="text-[10px] font-mono text-slate-400 text-right">
              Ingest terakhir: {formatTimeAgo(outbox.lastIngestAt)}
            </p>
          )}
        </div>

        <!-- C. Operations Summary (Articles & Media) -->
        <div class="bg-white border border-slate-200/90 rounded-2xl p-5 shadow-2xs space-y-4">
          <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
            <h3 class="text-sm font-outfit font-bold text-slate-900 flex items-center gap-2">
              <span>📊</span>
              <span>Subsystem Operational Totals</span>
            </h3>
            <span class="text-[10px] font-mono text-slate-400">D1 Canonical</span>
          </div>

          <div class="grid grid-cols-2 gap-3 text-xs font-mono">
            <div class="p-3 bg-slate-50 rounded-xl border border-slate-200/60 space-y-1">
              <div class="text-[10px] font-bold text-slate-500 uppercase">Artikel</div>
              <div class="text-slate-700">Diterbitkan: <strong class="text-slate-900">{articles.publishedCount}</strong></div>
              <div class="text-slate-700">Draf aktif: <strong class="text-slate-900">{articles.draftCount}</strong></div>
              <div class="text-slate-700">Disetujui: <strong class="text-slate-900">{articles.approvedCount}</strong></div>
            </div>

            <div class="p-3 bg-slate-50 rounded-xl border border-slate-200/60 space-y-1">
              <div class="text-[10px] font-bold text-slate-500 uppercase">Media & Aset</div>
              <div class="text-slate-700">Pekerjaan Media: <strong class="text-slate-900">{media.pendingJobsCount + media.inProgressJobsCount + media.attachedJobsCount}</strong></div>
              <div class="text-slate-700">Aset R2: <strong class="text-slate-900">{media.totalAssetsCount}</strong></div>
              <div class="text-slate-700">Perangkat: <strong class="text-slate-900">{media.activeDevicesCount}</strong></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 4. Chronological Activity / Audit Stream (Full Width) -->
    <div class="bg-white border border-slate-200/90 rounded-2xl p-5 shadow-2xs space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div>
          <h2 class="text-base font-outfit font-bold text-slate-900 flex items-center gap-2">
            <span>📜</span>
            <span>Unified Activity & Audit Stream</span>
          </h2>
          <p class="text-xs text-slate-500 font-mono">
            Umpan kronologis nyata dari audit kontrol, transisi circuit breaker, dan riwayat pekerjaan.
          </p>
        </div>
        <span class="text-xs font-mono text-slate-400">
          Menampilkan {activity.length} peristiwa
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left font-mono text-xs">
          <thead>
            <tr class="border-b border-slate-200 text-slate-400 text-[10px] uppercase">
              <th class="py-2.5 px-3">Waktu</th>
              <th class="py-2.5 px-3">Subsystem</th>
              <th class="py-2.5 px-3">Peristiwa</th>
              <th class="py-2.5 px-3">Status</th>
              <th class="py-2.5 px-3">Keterangan</th>
              <th class="py-2.5 px-3">Referensi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-700">
            {activity.length === 0 ? (
              <tr>
                <td colspan="6" class="py-8 text-center text-slate-400 italic">
                  Belum ada log audit atau peristiwa tercatat.
                </td>
              </tr>
            ) : (
              activity.map((ev) => (
                <tr class="hover:bg-slate-50/70 transition">
                  <td class="py-2 px-3 whitespace-nowrap text-slate-500 text-[11px]">
                    {formatTimeAgo(ev.timestamp)}
                  </td>
                  <td class="py-2 px-3 whitespace-nowrap">
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-slate-100 text-slate-700">
                      {ev.subsystem}
                    </span>
                  </td>
                  <td class="py-2 px-3 font-semibold text-slate-800 text-[11px] whitespace-nowrap">
                    {ev.eventType}
                  </td>
                  <td class="py-2 px-3 whitespace-nowrap">
                    <span class={`px-2 py-0.5 rounded text-[10px] border ${getSeverityClass(ev.statusOrSeverity)}`}>
                      {ev.statusOrSeverity}
                    </span>
                  </td>
                  <td class="py-2 px-3 text-slate-600 max-w-md truncate">
                    {ev.summary}
                  </td>
                  <td class="py-2 px-3 text-slate-400 text-[11px] whitespace-nowrap">
                    {ev.entityReference || '-'}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Client-side Polling Script (Progressive Enhancement) -->
  <script is:inline>
    const refreshBtn = document.getElementById('refresh-btn');
    const refreshSpinner = document.getElementById('refresh-spinner');
    const snapshotTimestamp = document.getElementById('snapshot-timestamp');

    async function refreshTelemetry() {
      if (!refreshSpinner) return;
      refreshSpinner.classList.add('animate-spin');

      try {
        const res = await fetch('/api/admin/mission-control/state', {
          headers: { 'Accept': 'application/json' }
        });
        if (res.ok) {
          const data = await res.json();
          if (snapshotTimestamp && data.generatedAt) {
            snapshotTimestamp.textContent = new Date(data.generatedAt).toLocaleTimeString('id-ID', { hour12: false }) + ' WIB';
          }
          // If fresh data received, trigger a soft page update or state sync
        }
      } catch (err) {
        console.warn('Mission Control state polling failed:', err);
      } finally {
        setTimeout(() => {
          refreshSpinner.classList.remove('animate-spin');
        }, 500);
      }
    }

    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        window.location.reload();
      });
    }

    // Auto-refresh interval: 30 seconds for safe Cloudflare/D1 load
    setInterval(refreshTelemetry, 30000);
  </script>
</AdminLayout>
