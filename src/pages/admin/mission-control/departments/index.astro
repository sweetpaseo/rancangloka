---
/**
 * RancangLoka Hermes Mission Control — Department Operations Overview
 * Milestone: HERMES-MC-3
 * Route: /admin/mission-control/departments
 * 
 * Strict Invariants:
 * 1. Read-only organizational overview.
 * 2. Real derived health & workload — zero fabricated states or fake tasks.
 * 3. Machine IDs remain authoritative.
 * 4. Protected by admin_session middleware.
 */

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb } from '../../../../lib/db.ts';
import { getMissionControlSnapshot, getOrganizationSnapshot } from '../../../../lib/mission-control/index.ts';

const env = (Astro.locals as any)?.runtime?.env || (globalThis as any).process?.env || {};
const db = (await getDb(Astro.locals)) || env.DB || (Astro.locals as any)?.db;

const snapshot = await getMissionControlSnapshot(db, env);
const org = getOrganizationSnapshot(snapshot);
const { summary, departments, handoffs } = org;

const getHealthBadgeClass = (health: string) => {
  switch (health) {
    case 'ACTIVE':
      return 'bg-emerald-50 text-emerald-700 border-emerald-300';
    case 'HEALTHY':
      return 'bg-blue-50 text-blue-700 border-blue-200';
    case 'DEGRADED':
      return 'bg-amber-50 text-amber-700 border-amber-200';
    case 'BLOCKED':
      return 'bg-rose-50 text-rose-700 border-rose-300 animate-pulse';
    case 'OFFLINE':
      return 'bg-zinc-100 text-zinc-600 border-zinc-300';
    case 'NOT_AVAILABLE':
      return 'bg-slate-100 text-slate-400 border-slate-200';
    default:
      return 'bg-slate-100 text-slate-500 border-slate-200';
  }
};

const getHealthDotClass = (health: string) => {
  switch (health) {
    case 'ACTIVE':
      return 'bg-emerald-500 shadow-emerald-500/50';
    case 'HEALTHY':
      return 'bg-blue-500';
    case 'DEGRADED':
      return 'bg-amber-500';
    case 'BLOCKED':
      return 'bg-rose-500 shadow-rose-500/50 animate-ping';
    case 'OFFLINE':
      return 'bg-zinc-400';
    case 'NOT_AVAILABLE':
      return 'bg-slate-300';
    default:
      return 'bg-slate-300';
  }
};

const formatTimeAgo = (isoString?: string | null) => {
  if (!isoString) return 'Tidak tersedia';
  try {
    const diff = Math.floor((Date.now() - new Date(isoString).getTime()) / 1000);
    if (diff < 5) return 'Baru saja';
    if (diff < 60) return `${diff}d yang lalu`;
    if (diff < 3600) return `${Math.floor(diff / 60)}m yang lalu`;
    if (diff < 86400) return `${Math.floor(diff / 3600)}j yang lalu`;
    return `${Math.floor(diff / 86400)}h yang lalu`;
  } catch {
    return isoString;
  }
};
---

<AdminLayout title="Hermes Mission Control — Departemen">
  <div class="max-w-[1600px] mx-auto space-y-6 pb-12">
    <!-- 1. Top Cockpit Header & Navigation Tabs -->
    <div class="bg-slate-900 text-white rounded-2xl p-6 shadow-sm border border-slate-800 space-y-5">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2.5">
            <span class="px-2.5 py-0.5 rounded-md bg-blue-500/20 text-blue-400 font-mono text-[11px] font-bold uppercase tracking-wider border border-blue-500/30">
              HERMES-MC-3
            </span>
            <span class="text-slate-600">•</span>
            <span class="text-xs font-mono text-slate-400">Department Operations & Organization</span>
            <span class="text-slate-600">•</span>
            <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
              READ-ONLY
            </span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-outfit font-black text-white tracking-tight mt-1.5 flex items-center gap-2.5">
            <span>🏢</span>
            <span>Department Operations & Organization</span>
          </h1>
          <p class="text-xs text-slate-400 mt-1 max-w-3xl font-mono">
            Struktur organisasi kanonikal RancangLoka: kesehatan departemen, keanggotaan staf, beban kerja, pemantauan handoff lintas divisi, dan isolasi hambatan operasional.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <div class="text-right hidden sm:block">
            <div class="text-[10px] font-mono uppercase text-slate-500">Waktu Evaluasi</div>
            <div class="text-xs font-mono text-slate-300">
              {new Date(org.generated_at).toLocaleTimeString('id-ID', { hour12: false })} WIB
            </div>
          </div>
          <a
            href="/admin/mission-control/departments"
            class="rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-4 py-2 text-xs font-outfit font-bold transition flex items-center gap-2 shadow-xs cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
              <path d="M3 3v5h5"></path>
              <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path>
              <path d="M16 21h5v-5"></path>
            </svg>
            <span>Segarkan</span>
          </a>
        </div>
      </div>

      <!-- Navigation Sub-Tabs -->
      <div class="flex items-center gap-2 border-t border-slate-800 pt-4 text-xs font-outfit font-bold">
        <a
          href="/admin/mission-control"
          class="px-4 py-2 rounded-xl text-slate-400 hover:text-slate-200 hover:bg-slate-800/80 transition flex items-center gap-2"
        >
          <span>🛰️</span>
          <span>Cockpit Operasional</span>
        </a>
        <a
          href="/admin/mission-control/staff"
          class="px-4 py-2 rounded-xl text-slate-400 hover:text-slate-200 hover:bg-slate-800/80 transition flex items-center gap-2"
        >
          <span>👥</span>
          <span>Staff Registry</span>
          <span class="px-1.5 py-0.2 rounded-full bg-slate-800 text-[10px] font-mono text-slate-400">6 Staf</span>
        </a>
        <a
          href="/admin/mission-control/departments"
          class="px-4 py-2 rounded-xl bg-blue-600 text-white shadow-xs flex items-center gap-2"
        >
          <span>🏢</span>
          <span>Departemen</span>
          <span class="px-1.5 py-0.2 rounded-full bg-blue-700 text-[10px] font-mono">{departments.length} Divisi</span>
        </a>
        <a
          href="/admin/mission-control/office"
          class="px-4 py-2 rounded-xl text-slate-400 hover:text-slate-200 hover:bg-slate-800/80 transition flex items-center gap-2"
        >
          <span>👾</span>
          <span>Pixel Office</span>
          <span class="px-1.5 py-0.2 rounded-full bg-amber-500/20 text-amber-300 text-[10px] font-mono">2D</span>
        </a>
      </div>
    </div>

    <!-- 2. Organization Summary Strip -->
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3">
      <!-- Total Departments -->
      <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-2xs space-y-1">
        <div class="text-[10px] font-mono uppercase font-bold text-slate-500">Total Divisi</div>
        <div class="text-2xl font-outfit font-black text-slate-900">{summary.total_departments}</div>
        <div class="text-[10px] font-mono text-slate-400">5 Aktif • 1 Cadangan</div>
      </div>

      <!-- Active Departments -->
      <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-2xs space-y-1">
        <div class="text-[10px] font-mono uppercase font-bold text-emerald-600 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Active</span>
        </div>
        <div class="text-2xl font-outfit font-black text-emerald-700">{summary.active_departments}</div>
        <div class="text-[10px] font-mono text-slate-400">Proses pekerjaan riil</div>
      </div>

      <!-- Healthy Departments -->
      <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-2xs space-y-1">
        <div class="text-[10px] font-mono uppercase font-bold text-blue-600 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-blue-500"></span>
          <span>Healthy</span>
        </div>
        <div class="text-2xl font-outfit font-black text-blue-700">{summary.healthy_departments}</div>
        <div class="text-[10px] font-mono text-slate-400">Siaga operasional</div>
      </div>

      <!-- Degraded Departments -->
      <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-2xs space-y-1">
        <div class="text-[10px] font-mono uppercase font-bold text-amber-600 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          <span>Degraded</span>
        </div>
        <div class="text-2xl font-outfit font-black text-amber-700">{summary.degraded_departments}</div>
        <div class="text-[10px] font-mono text-slate-400">Peringatan / retry</div>
      </div>

      <!-- Blocked Departments -->
      <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-2xs space-y-1">
        <div class="text-[10px] font-mono uppercase font-bold text-rose-600 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-rose-500"></span>
          <span>Blocked</span>
        </div>
        <div class="text-2xl font-outfit font-black text-rose-700">{summary.blocked_departments}</div>
        <div class="text-[10px] font-mono text-slate-400">Pemutus / kegagalan</div>
      </div>

      <!-- Offline Departments -->
      <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-2xs space-y-1">
        <div class="text-[10px] font-mono uppercase font-bold text-zinc-600 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-zinc-400"></span>
          <span>Offline</span>
        </div>
        <div class="text-2xl font-outfit font-black text-zinc-700">{summary.offline_departments}</div>
        <div class="text-[10px] font-mono text-slate-400">Pekerja nonaktif</div>
      </div>

      <!-- Unavailable -->
      <div class="bg-white border border-slate-200/90 rounded-2xl p-4 shadow-2xs space-y-1">
        <div class="text-[10px] font-mono uppercase font-bold text-slate-400 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-slate-300"></span>
          <span>Unavailable</span>
        </div>
        <div class="text-2xl font-outfit font-black text-slate-500">{summary.unavailable_departments}</div>
        <div class="text-[10px] font-mono text-slate-400">Social (unstaffed)</div>
      </div>
    </div>

    <!-- 3. Workflow Stream & Department Cards Grid -->
    <div class="space-y-6">
      <!-- Canonical Workflow Sequence Flowchart -->
      <div class="bg-white border border-slate-200/90 rounded-2xl p-5 shadow-2xs space-y-3">
        <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
          <div>
            <h2 class="text-sm font-outfit font-bold text-slate-900 flex items-center gap-2">
              <span>🔄</span>
              <span>Alur Kerja Organisasi (Canonical Editorial Workflow)</span>
            </h2>
            <p class="text-[11px] text-slate-500 font-mono">
              Pipeline penyerahan antar-departemen: Riset Bukti → Penulisan & QA → Operasi Media → Publikasi.
            </p>
          </div>
          <span class="text-[10px] font-mono text-slate-400 font-bold">
            {handoffs.length} Transisi Terpantau
          </span>
        </div>

        <!-- Workflow Visual Strip -->
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 text-xs font-mono">
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/70 space-y-1">
            <div class="text-[10px] font-bold text-slate-500 uppercase">1. Riset & Bukti</div>
            <div class="text-slate-800 font-bold">Research & Evidence</div>
            <div class="text-[10px] text-slate-500">Kompilasi SNI & Evidence Pack</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/70 space-y-1">
            <div class="text-[10px] font-bold text-slate-500 uppercase">2. Penulisan & QA</div>
            <div class="text-slate-800 font-bold">Editorial</div>
            <div class="text-[10px] text-slate-500">Drafting & First Article Gate</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/70 space-y-1">
            <div class="text-[10px] font-bold text-slate-500 uppercase">3. Produksi Media</div>
            <div class="text-slate-800 font-bold">Media Operations</div>
            <div class="text-[10px] text-slate-500">Generasi Visual & Aset R2</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/70 space-y-1">
            <div class="text-[10px] font-bold text-slate-500 uppercase">4. Dispatch Publikasi</div>
            <div class="text-slate-800 font-bold">Publication Operations</div>
            <div class="text-[10px] text-slate-500">Approval & Atomic Ingest</div>
          </div>
        </div>
      </div>

      <!-- Department Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {departments.map((dept) => (
          <div class="bg-white border border-slate-200/90 rounded-2xl p-5 shadow-2xs flex flex-col justify-between space-y-4 hover:border-slate-300 transition">
            <!-- Card Header -->
            <div class="space-y-2.5">
              <div class="flex items-start justify-between gap-2">
                <div class="space-y-0.5">
                  <div class="flex items-center gap-2">
                    <h3 class="text-base font-outfit font-black text-slate-900">
                      {dept.display_name}
                    </h3>
                  </div>
                  <div class="text-[10px] font-mono text-slate-400 uppercase">
                    ID: {dept.department_id}
                  </div>
                </div>

                <!-- Health Badge -->
                <span class={`px-2.5 py-1 rounded-lg text-xs font-mono font-bold uppercase border flex items-center gap-1.5 shrink-0 ${getHealthBadgeClass(dept.health)}`}>
                  <span class={`w-2 h-2 rounded-full ${getHealthDotClass(dept.health)}`}></span>
                  <span>{dept.health}</span>
                </span>
              </div>

              <p class="text-xs text-slate-600 font-sans line-clamp-2">
                {dept.description}
              </p>
            </div>

            <!-- Health Evidence Snippet -->
            <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200/60 font-mono text-[11px] text-slate-700">
              <div class="text-[9px] uppercase font-bold text-slate-400 mb-0.5">Bukti Kesehatan:</div>
              <p class="font-sans line-clamp-2 text-slate-600">{dept.health_evidence}</p>
            </div>

            <!-- Workload & Staff Metrics -->
            <div class="grid grid-cols-3 gap-2 text-center font-mono text-xs pt-1 border-t border-slate-100">
              <div class="p-2 bg-slate-50 rounded-xl border border-slate-200/60">
                <div class="text-[10px] text-slate-400 uppercase">Staf</div>
                <div class="text-base font-bold text-slate-800 mt-0.5">{dept.staff_count}</div>
              </div>
              <div class="p-2 bg-slate-50 rounded-xl border border-slate-200/60">
                <div class="text-[10px] text-slate-400 uppercase">Aktif</div>
                <div class="text-base font-bold text-blue-600 mt-0.5">{dept.active_task_count}</div>
              </div>
              <div class="p-2 bg-slate-50 rounded-xl border border-slate-200/60">
                <div class="text-[10px] text-slate-400 uppercase">Hambatan</div>
                <div class={`text-base font-bold mt-0.5 ${dept.blocked_task_count > 0 ? 'text-rose-600 font-black' : 'text-slate-500'}`}>
                  {dept.blocked_task_count}
                </div>
              </div>
            </div>

            <!-- Staff Members Snippet -->
            <div class="space-y-1.5 pt-1">
              <div class="text-[10px] font-mono font-bold uppercase text-slate-400">Anggota Staf:</div>
              {dept.staff.length === 0 ? (
                <div class="text-[11px] font-mono text-slate-400 italic">
                  Belum ada staf (unstaffed)
                </div>
              ) : (
                <div class="flex flex-wrap gap-1.5">
                  {dept.staff.map((s) => (
                    <span class="px-2 py-0.5 rounded-lg bg-slate-100 text-slate-800 font-mono text-[11px] font-bold flex items-center gap-1.5 border border-slate-200">
                      <span class={`w-1.5 h-1.5 rounded-full ${s.state === 'WORKING' ? 'bg-emerald-500' : s.state === 'OFFLINE' ? 'bg-zinc-400' : 'bg-slate-400'}`}></span>
                      <span>{s.display_name}</span>
                    </span>
                  ))}
                </div>
              )}
            </div>

            <!-- Capabilities & Pixel Office Metadata -->
            <div class="space-y-2 pt-1 border-t border-slate-100">
              <div class="flex flex-wrap gap-1">
                {dept.capabilities.slice(0, 3).map((cap) => (
                  <span class="px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 text-[9px] font-mono font-bold border border-blue-100">
                    {cap}
                  </span>
                ))}
                {dept.capabilities.length > 3 && (
                  <span class="px-1 py-0.5 rounded bg-slate-100 text-slate-500 text-[9px] font-mono">
                    +{dept.capabilities.length - 3}
                  </span>
                )}
              </div>

              <!-- Pixel Office Room Tag -->
              <div class="flex items-center justify-between text-[10px] font-mono text-slate-400 pt-1">
                <span class="truncate">Room: <span class="text-purple-700 font-bold bg-purple-50 px-1.5 py-0.5 rounded border border-purple-100">{dept.room_key}</span></span>
                <span>{dept.latest_activity_at ? formatTimeAgo(dept.latest_activity_at) : '-'}</span>
              </div>
            </div>

            <!-- Detail Action Link -->
            <div class="pt-2">
              <a
                href={`/admin/mission-control/departments/${dept.department_id}`}
                class="w-full text-center block rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-outfit font-bold text-xs py-2 transition shadow-xs"
              >
                Lihat Detail Divisi ➔
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</AdminLayout>
