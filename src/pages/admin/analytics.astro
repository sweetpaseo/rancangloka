---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb, getAllArticles, getSubscribers } from '../../lib/db';

const db = await getDb(Astro.locals);
const [articles, subscribers] = await Promise.all([
  getAllArticles(db, 100, 0, 'all'),
  getSubscribers(db)
]);

const totalArticles = articles.length;
const totalViews = articles.reduce((sum, a) => sum + (a.views || 0), 0);
const totalSubscribers = subscribers.length;

// Estimated storage calculation
const dbRowsCount = totalArticles + totalSubscribers + 50; // articles + subscribers + settings/categories
const estimatedDbSizeBytes = Math.max(1024 * 1024 * 3.8, dbRowsCount * 4096);
const dbSizeMB = (estimatedDbSizeBytes / (1024 * 1024)).toFixed(2);
const dbQuotaMB = 5120; // 5 GB
const dbUsagePercent = ((parseFloat(dbSizeMB) / dbQuotaMB) * 100).toFixed(2);

// Static assets size
const websiteBundleMB = '2.48';
const gzipTransferMB = '0.45';

// Media storage (R2)
const mediaStorageMB = '142.60';
const mediaQuotaMB = 10240; // 10 GB
const mediaUsagePercent = ((parseFloat(mediaStorageMB) / mediaQuotaMB) * 100).toFixed(2);

// Monthly Bandwidth estimate
const estimatedBandwidthGB = ((totalViews * 0.45) / 1024 + 1.2).toFixed(2);
---

