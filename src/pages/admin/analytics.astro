        pvLine: 'M 0 160 Q 100 120, 200 80 T 400 40 T 600 70 T 800 20',
        uvLine: 'M 0 180 Q 100 150, 200 120 T 400 90 T 600 110 T 800 60'
      },
      '7d': {
