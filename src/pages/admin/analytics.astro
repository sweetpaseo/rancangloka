  <!-- Client-side Interactive Filter Switching Logic -->
  <script is:inline>
    const periodData = {
      '24h': {
        badge: '24 Jam Terakhir',
        pv: '4,820',
        pvGrowth: '+18.4% vs hari kemarin',
