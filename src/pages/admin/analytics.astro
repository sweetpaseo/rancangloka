        pvGrowth: '+24.8% vs minggu lalu',
        uv: '9,840',
        uvGrowth: '+16.5% vs minggu lalu',
        duration: '4m 05s',
        bounce: '22.1%',
        xLabels: ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Minggu'],
        pvArea: 'M 0 140 Q 120 70, 250 50 T 500 30 T 650 45 T 800 15 L 800 200 L 0 200 Z',
        pvLine: 'M 0 140 Q 120 70, 250 50 T 500 30 T 650 45 T 800 15',
        uvLine: 'M 0 170 Q 120 110, 250 90 T 500 70 T 650 85 T 800 50'
      },
      '30d': {
        badge: '30 Hari Terakhir (Bulanan)',
        pv: '138,200',
        pvGrowth: '+32.0% vs bulan lalu',
        uv: '42,600',
        uvGrowth: '+21.4% vs bulan lalu',
        duration: '4m 18s',
        bounce: '21.0%',
        xLabels: ['Minggu 1', 'Minggu 2', 'Minggu 3', 'Minggu 4', 'Hari Ini'],
        pvArea: 'M 0 150 Q 150 90, 300 60 T 550 25 T 800 10 L 800 200 L 0 200 Z',
        pvLine: 'M 0 150 Q 150 90, 300 60 T 550 25 T 800 10',
        uvLine: 'M 0 175 Q 150 125, 300 100 T 550 65 T 800 45'
      },
      '1y': {
        badge: '1 Tahun Penuh (Tahunan)',
        pv: '1,420,000',
        pvGrowth: '+184.2% YoY Growth',
        uv: '480,000',
        uvGrowth: '+152.0% YoY Growth',
        duration: '4m 45s',
        bounce: '19.8%',
        xLabels: ['Q1 2026', 'Q2 2026', 'Q3 2026', 'Q4 2026', 'YTD'],
        pvArea: 'M 0 170 Q 200 110, 400 60 T 650 20 T 800 5 L 800 200 L 0 200 Z',
        pvLine: 'M 0 170 Q 200 110, 400 60 T 650 20 T 800 5',
        uvLine: 'M 0 185 Q 200 135, 400 95 T 650 55 T 800 35'
      }
    };

    function switchPeriod(period) {
      const data = periodData[period];
      if (!data) return;

      // Update Buttons Active State
      const buttons = ['24h', '7d', '30d', '1y'];
      buttons.forEach((b) => {
        const btn = document.getElementById(`btn-${b}`);
        if (btn) {
          if (b === period) {
            btn.className = 'px-3.5 py-1.5 rounded-lg bg-white text-slate-900 shadow-xs transition cursor-pointer';
          } else {
            btn.className = 'px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-white/50 transition cursor-pointer';
          }
        }
      });

      // Update Text Metrics
      document.getElementById('current-period-badge').textContent = data.badge;
      document.getElementById('metric-pageviews').textContent = data.pv;
      document.getElementById('metric-pv-growth').textContent = data.pvGrowth;
      document.getElementById('metric-visitors').textContent = data.uv;
      document.getElementById('metric-uv-growth').textContent = data.uvGrowth;
      document.getElementById('metric-duration').textContent = data.duration;
      document.getElementById('metric-bounce').textContent = data.bounce;

      // Update SVG Path with smooth animation
      document.getElementById('svg-pv-area').setAttribute('d', data.pvArea);
      document.getElementById('svg-pv-line').setAttribute('d', data.pvLine);
      document.getElementById('svg-uv-line').setAttribute('d', data.uvLine);

      // Update X-axis labels
      const xContainer = document.getElementById('chart-x-labels');
      if (xContainer) {
        xContainer.innerHTML = data.xLabels.map((lbl) => `<span>${lbl}</span>`).join('');
      }
    }
  </script>
