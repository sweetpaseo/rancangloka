---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb, getAllArticles, getAllCategories, getAllAuthors } from '../../../lib/db';

const { id } = Astro.params;
const db = await getDb(Astro.locals);
const [allArticles, categories, authors] = await Promise.all([
  getAllArticles(db, 200, 0, 'all'),
  getAllCategories(db),
  getAllAuthors(db)
]);

const articleId = parseInt(id || '1', 10);
const article = allArticles.find((a) => a.id === articleId) || allArticles[0];

if (!article) {
  return Astro.redirect('/admin/posts');
}

let keyTakeawaysList: string[] = [];
if (article.key_takeaways) {
  try {
    keyTakeawaysList = JSON.parse(article.key_takeaways);
  } catch (e) {}
}
---

<AdminLayout title={`Edit Artikel: ${article.title}`}>
  <form id="post-editor-form" class="max-w-6xl mx-auto space-y-6">
    <!-- Top Action Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
      <div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">Edit Artikel</h1>
        <p class="text-xs text-slate-500 mt-0.5">Memperbarui data di Cloudflare D1.</p>
      </div>

      <div class="flex items-center gap-3">
        <a href="/admin/posts" class="rounded-xl bg-white border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 transition shadow-sm">
          Batal
        </a>
        <button
          type="submit"
          id="btn-update"
          class="rounded-xl bg-primary px-5 py-2 text-xs font-bold text-white hover:bg-primary-hover transition shadow-md shadow-primary/20"
        >
          💾 Simpan Perubahan
        </button>
      </div>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <div class="lg:col-span-8 space-y-6">
        <!-- Title & Slug -->
        <div class="rounded-2xl bg-white border border-slate-200 p-5 space-y-4 shadow-sm">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Judul Artikel</label>
            <input
              type="text"
              id="post-title"
              name="title"
              required
              value={article.title}
              class="w-full rounded-xl bg-slate-50 border border-slate-200 px-4 py-3 text-base md:text-lg font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white"
            />
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-500 mb-1">Slug URL</label>
            <input
              type="text"
              id="post-slug"
              name="slug"
              value={article.slug}
              class="w-full rounded-xl bg-slate-50 border border-slate-200 px-3 py-2 text-xs text-primary font-mono font-bold focus:outline-none"
            />
          </div>
        </div>

        <!-- Markdown Editor -->
        <div class="rounded-2xl bg-white border border-slate-200 p-4 shadow-sm">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Konten Markdown (.md)</label>
          <textarea
            id="post-content-md"
            name="content_md"
            rows="16"
            class="w-full bg-slate-50 rounded-xl border border-slate-200 p-4 font-mono text-sm text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary focus:bg-white resize-y leading-relaxed"
          >{article.content_md}</textarea>
        </div>

        <!-- Key Takeaways -->
        <div class="rounded-2xl bg-white border border-slate-200 p-5 shadow-sm">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">💡 Key Takeaways (Poin Kunci)</label>
          <textarea
            id="post-key-takeaways"
            name="key_takeaways"
            rows="3"
            class="w-full rounded-xl bg-slate-50 border border-slate-200 p-3 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white"
          >{keyTakeawaysList.map(k => `• ${k}`).join('\n')}</textarea>
        </div>

        <!-- Description -->
        <div class="rounded-2xl bg-white border border-slate-200 p-5 shadow-sm">
          <label class="block text-xs font-semibold text-slate-700 mb-1">Meta Description</label>
          <textarea
            id="post-description"
            name="description"
            rows="3"
            class="w-full rounded-xl bg-slate-50 border border-slate-200 p-3 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white"
          >{article.description}</textarea>
        </div>
      </div>

      <!-- Right Sidebar -->
      <div class="lg:col-span-4 space-y-6">
        <!-- Cover Image -->
        <div class="rounded-2xl bg-white border border-slate-200 p-5 space-y-3 shadow-sm">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">🖼️ Cover Image URL</label>
          <img src={article.featured_image} class="rounded-xl aspect-[16/9] object-cover w-full bg-slate-100 border border-slate-200" />
          <input
            type="url"
            id="post-cover-url"
            name="featured_image"
            value={article.featured_image}
            class="w-full rounded-xl bg-slate-50 border border-slate-200 px-3 py-2 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary focus:bg-white"
          />
        </div>

        <!-- Category & Author -->
        <div class="rounded-2xl bg-white border border-slate-200 p-5 space-y-4 shadow-sm">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Kategori</label>
            <select id="post-category" name="category_id" class="w-full rounded-xl bg-slate-50 border border-slate-200 px-3 py-2 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary focus:bg-white">
              {categories.map((c) => (
                <option value={c.id} selected={c.id === article.category_id}>{c.name}</option>
              ))}
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Penulis</label>
            <select id="post-author" name="author_id" class="w-full rounded-xl bg-slate-50 border border-slate-200 px-3 py-2 text-xs text-slate-800 focus:outline-none focus:ring-1 focus:ring-primary focus:bg-white">
              {authors.map((a) => (
                <option value={a.id} selected={a.id === article.author_id}>{a.name}</option>
              ))}
            </select>
          </div>
        </div>
      </div>
    </div>
  </form>

  <script>
    const form = document.getElementById('post-editor-form') as HTMLFormElement;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Perubahan artikel berhasil disimpan ke D1!');
      window.location.href = '/admin/posts';
    });
  </script>
</AdminLayout>
