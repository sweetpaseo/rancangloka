---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { loadCandidatesLedger, type ExperimentalMediaCandidate } from '../../../lib/media/experimental-storage';
import { BATCH_1_CANONICAL_BRIEFS, BATCH_1_SUPPORTING_BRIEFS } from '../../../lib/media/editorial-visual-intelligence';
import { getDailyUsageSummary } from '../../../lib/media/neurons-usage-service';

const candidates = loadCandidatesLedger();
const neuronsSummary = getDailyUsageSummary();

const articles = [
  {
    id: 9993,
    code: 'ARTICLE_A',
    title: 'Dinding Rembes dan Cat Menggelembung',
    slug: 'dinding-rembes-dan-cat-menggelembung-cara-membedakan-masalah-talang-plesteran-kelembapan-tanah',
    description: 'Cara Membedakan Masalah Talang, Plesteran, dan Kelembapan Tanah',
    editorialDecision: 'PREFER_FLUX',
    decisionNotice: 'Pilihan Editorial Utama: FLUX.1 Schnell v3 direkomendasikan. Kerusakan dinding terlihat jelas dan realistis tanpa lubang bobokan plesteran, lebih sesuai topik artikel, dan komposisi medium-close lebih informatif dibanding SDXL v3. Tetap PENDING_REVIEW menunggu persetujuan final Chief Editor.'
  },
  {
    id: 9999,
    code: 'ARTICLE_B',
    title: '7 Ide Menata Balkon Rumah Kecil',
    slug: '7-ide-menata-balkon-rumah-kecil-agar-nyaman',
    description: 'Penataan Balkon Kompak Tropis agar Nyaman dan Teduh (1.2x2.4 Meter)',
    editorialDecision: 'PREFER_FLUX',
    decisionNotice: 'Pilihan Editorial Utama: FLUX.1 Schnell direkomendasikan karena sambungan decking kayu rapi dan railing proporsional. SDXL Lightning memiliki cacat geometri sambungan decking.'
  },
  {
    id: 10000,
    code: 'ARTICLE_C',
    title: 'Menata Denah Rumah Lebar 5–6 Meter',
    slug: 'menata-denah-rumah-lebar-5-6-meter-solusi-sirkulasi-bukaan-ruang-tengah-tidak-pengap',
    description: 'Solusi Sirkulasi dan Bukaan agar Ruang Tengah Tidak Pengap',
    editorialDecision: 'PREFER_SDXL',
    decisionNotice: 'Pilihan Owner Utama: SDXL Lightning dipertahankan untuk ruang tengah dan inner court. Keterangan Redaksi: Visualisasi interior arsitektural 3D, bukan denah teknis 2D.'
  }
];

function getLatestCandidate(articleId: number, modelTag: string): ExperimentalMediaCandidate | undefined {
  // For article 9993, prefer v3 candidate
  if (articleId === 9993) {
    const v3 = candidates.find(
      (c) => c.article_id === articleId && c.id.includes('v3') && c.model.toLowerCase().includes(modelTag.toLowerCase())
    );
    if (v3) return v3;
  }
  return candidates.find(
    (c) => c.article_id === articleId && c.model.toLowerCase().includes(modelTag.toLowerCase()) && !c.id.includes('v2')
  );
}

function getHistoricalCandidates(articleId: number): ExperimentalMediaCandidate[] {
  return candidates.filter((c) => c.article_id === articleId);
}
---

<AdminLayout title="Perbandingan Visual Batch 1: Finalisasi Hero Image (EVI V1)">
  <div class="max-w-[1560px] mx-auto space-y-8 pb-16">
    <!-- Top Header Banner -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-white border border-slate-200/80 rounded-2xl p-6 shadow-2xs">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-md bg-purple-100 text-purple-800 font-mono text-[11px] font-bold uppercase tracking-wider">
            BATCH 1 HERO FINALIZATION
          </span>
          <span class="text-slate-300">•</span>
          <span class="px-2.5 py-0.5 rounded-md bg-blue-100 text-blue-800 font-mono text-[11px] font-semibold">
            5-DIMENSIONAL QA
          </span>
          <span class="text-slate-300">•</span>
          <span class="text-xs font-mono text-emerald-700 font-semibold">Free Tier Allocation (Konsumsi Akun: Belum Terverifikasi)</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-outfit font-black text-slate-900 tracking-tight mt-2">
          Inspeksi &amp; Komparasi Visual Redaksi Batch 1
        </h1>
        <p class="text-sm text-slate-500 mt-1 max-w-3xl leading-relaxed">
          Evaluasi visual terstruktur berbasis <strong>5-Dimensional Editorial QA</strong> antara <strong>FLUX.1 Schnell</strong> dan <strong>SDXL Lightning</strong>. Membedakan <em>automated heuristics</em> dari verifikasi visual manusia. Seluruh kandidat berada dalam status isolasi <code>PENDING_REVIEW</code>.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <!-- Interactive 16:9 Cover Crop Toggle -->
        <div class="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200 text-xs font-outfit font-bold text-slate-700">
          <button
            type="button"
            id="btn-mode-square"
            onclick="setCropMode('square')"
            class="px-3 py-1.5 rounded-lg bg-white shadow-2xs text-slate-900 transition cursor-pointer"
          >
            ⏹ 1:1 Asli (Square)
          </button>
          <button
            type="button"
            id="btn-mode-169"
            onclick="setCropMode('169')"
            class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition cursor-pointer"
          >
            🎞 16:9 Cover Pratinjau
          </button>
        </div>

        <button
          onclick="window.location.reload()"
          class="rounded-xl bg-[#0066ee] hover:bg-blue-600 text-white px-4 py-2.5 text-xs font-outfit font-bold transition flex items-center gap-1.5 shadow-2xs cursor-pointer"
        >
          <span>🔄 Segarkan Status</span>
        </button>
      </div>
    </div>

    <!-- Cloudflare AI Neurons Usage Quick Widget (Lemon Linen Light Editorial) -->
    <div class="rounded-xl bg-white border border-[#E7E9EE] p-4 text-xs text-[#172033] flex flex-col md:flex-row md:items-center justify-between gap-4 shadow-2xs">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-lg bg-[#FFFDF7] text-[#A76A00] border border-[#E7E9EE] shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-bold text-[#172033] font-sans">Cloudflare AI Neurons Monitor:</span>
            <span class="px-1.5 py-0.5 rounded text-[10px] bg-[#FFFDF7] text-[#A76A00] border border-[#E7E9EE] font-mono font-semibold">
              ESTIMATED
            </span>
            <span class="text-[#596579] font-mono">
              {neuronsSummary.neuronsUsedToday.toLocaleString()} / {neuronsSummary.configuredDailyLimit.toLocaleString()} N ({neuronsSummary.percentageUsed.toFixed(1)}%)
            </span>
          </div>
          <div class="text-[#596579] mt-0.5">
            Estimasi Sisa (Parsial): <strong class="text-[#16805D] font-mono">{neuronsSummary.neuronsRemainingEstimated.toLocaleString()} N</strong>
            <span class="mx-1.5 text-slate-300">|</span>
            Kapasitas: <span class="text-[#172033] font-mono font-semibold">~{neuronsSummary.estimatedRemainingCapacity.fluxImages}x FLUX</span> atau <span class="text-[#A76A00] font-mono font-semibold">SDXL: UNKNOWN</span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/admin/media/usage-monitor"
          class="px-3.5 py-1.5 rounded-lg bg-[#172033] hover:bg-[#23304c] text-white font-semibold text-xs transition flex items-center gap-1.5 shadow-2xs cursor-pointer"
        >
          <span>Buka Usage Monitor ↗</span>
        </a>
      </div>
    </div>

    <!-- Safety Invariant Alert -->
    <div class="rounded-xl bg-amber-50/70 border border-amber-200/80 p-4 text-xs text-amber-900 flex items-start gap-3">
      <span class="text-lg">🛡️</span>
      <div class="space-y-1">
        <p class="font-bold">INVARIAN KESELAMATAN &amp; PEMISAHAN OTORITAS MEDIA:</p>
        <p class="text-amber-800 leading-relaxed">
          Persetujuan media kandidat ini bersifat independen dari publikasi artikel. Memilih atau menyetujui kandidat di sini <strong>TIDAK AKAN</strong> mengubah status artikel menjadi published dan <strong>TIDAK AKAN</strong> menimpa featured image tanpa alur promosi dual-control terverifikasi.
        </p>
      </div>
    </div>

    <!-- Articles Loop -->
    <div class="space-y-12">
      {articles.map((art) => {
        const fluxCandidate = getLatestCandidate(art.id, 'flux');
        const sdxlCandidate = getLatestCandidate(art.id, 'lightning');
        const brief = BATCH_1_CANONICAL_BRIEFS[art.id];
        const historyCandidates = getHistoricalCandidates(art.id);

        return (
          <div class="bg-white border border-slate-200/90 rounded-2xl p-6 sm:p-8 shadow-xs space-y-6">
            <!-- Article Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-5">
              <div>
                <div class="flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 font-mono text-[10px] font-bold">
                    ID {art.id} • {art.code}
                  </span>
                  <a
                    href={`/admin/preview/${art.slug}`}
                    target="_blank"
                    class="text-xs text-[#0066ee] hover:underline font-mono"
                  >
                    Pratinjau Draft Naskah ↗
                  </a>
                </div>
                <h2 class="text-xl sm:text-2xl font-outfit font-bold text-slate-900 mt-1">
                  {art.title}
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">{art.description}</p>
              </div>

              <div class="flex items-center gap-2">
                <span class="text-xs text-slate-400 font-mono">Slot: featured_hero (Target 16:9)</span>
              </div>
            </div>

            <!-- Editorial Decision Banner -->
            <div class={`rounded-xl p-4 text-xs flex items-start gap-3 border ${
              art.editorialDecision === 'REGENERATE_V3_CONTROLLED'
                ? 'bg-blue-50/70 border-blue-200/80 text-blue-900'
                : art.editorialDecision === 'PREFER_FLUX'
                ? 'bg-purple-50/70 border-purple-200/80 text-purple-900'
                : 'bg-emerald-50/70 border-emerald-200/80 text-emerald-900'
            }`}>
              <span class="text-base">📌</span>
              <div>
                <strong class="font-bold uppercase tracking-wider text-[11px]">Keputusan &amp; Rekomendasi Redaksi:</strong>
                <p class="mt-0.5 leading-relaxed">{art.decisionNotice}</p>
              </div>
            </div>

            <!-- Special Editorial Disclaimer for Article #10000 -->
            {art.id === 10000 && (
              <div class="rounded-xl p-3 bg-amber-50/60 border border-amber-200/80 text-amber-900 text-[11px] flex items-center gap-2.5">
                <span class="text-base">⚠️</span>
                <span>
                  <strong>Keterangan Redaksi:</strong> Gambar untuk artikel ini merupakan <em>visualisasi interior arsitektural 3D</em> ruang tengah beratap void/inner court, bukan denah teknis 2D. Jangan mencantumkan klaim denah teknis pada caption atau alt text.
                </span>
              </div>
            )}

            <!-- Version History Drawer (Prominently for Article 9993) -->
            {art.id === 9993 && (
              <details class="text-xs bg-slate-50/80 border border-slate-200/90 rounded-xl p-4 cursor-pointer">
                <summary class="font-outfit font-bold text-slate-800 flex items-center justify-between select-none">
                  <span class="flex items-center gap-2">
                    <span>📜 Riwayat Versi &amp; Audit Trail Generasi (v1, v2, v3)</span>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-200 text-slate-700">
                      {historyCandidates.length} Catatan Arsip
                    </span>
                  </span>
                  <span class="text-slate-400 text-[11px]">Buka Riwayat ▾</span>
                </summary>
                <div class="mt-4 pt-3 border-t border-slate-200 space-y-3 font-sans">
                  <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    <div class="p-3 rounded-lg border border-rose-200 bg-rose-50/40 space-y-1">
                      <div class="flex items-center justify-between">
                        <strong class="font-mono text-[11px] text-rose-900 font-bold">Generasi v1 (Awal)</strong>
                        <span class="px-1.5 py-0.5 rounded text-[9px] font-mono bg-rose-100 text-rose-800 font-bold">REJECTED</span>
                      </div>
                      <p class="text-[11px] text-slate-600 leading-relaxed">
                        Prompt terlalu estetis; kedua model menghasilkan dinding bersih (*spotless pristine wall*) tanpa indikasi kerusakan kelembapan.
                      </p>
                    </div>

                    <div class="p-3 rounded-lg border border-rose-200 bg-rose-50/40 space-y-1">
                      <div class="flex items-center justify-between">
                        <strong class="font-mono text-[11px] text-rose-900 font-bold">Generasi v2 (EVI V2)</strong>
                        <span class="px-1.5 py-0.5 rounded text-[9px] font-mono bg-rose-100 text-rose-800 font-bold">REJECTED</span>
                      </div>
                      <p class="text-[11px] text-slate-600 leading-relaxed">
                        FLUX menghasilkan kerusakan menyerupai dinding dibobok; SDXL menghasilkan kerusakan terlalu ekstrem untuk masalah pemeliharaan bertahap.
                      </p>
                      <div class="pt-1 flex gap-2 text-[10px] text-blue-600 font-mono">
                        <a href="/experimental-media/candidate-9993-flux-1-schnell-v2.jpg" target="_blank" class="hover:underline">Lihat FLUX v2 ↗</a>
                        <span>•</span>
                        <a href="/experimental-media/candidate-9993-sdxl-lightning-v2.jpg" target="_blank" class="hover:underline">Lihat SDXL v2 ↗</a>
                      </div>
                    </div>

                    <div class="p-3 rounded-lg border border-emerald-200 bg-emerald-50/40 space-y-1">
                      <div class="flex items-center justify-between">
                        <strong class="font-mono text-[11px] text-emerald-900 font-bold">Generasi v3 (Terkendali)</strong>
                        <span class="px-1.5 py-0.5 rounded text-[9px] font-mono bg-emerald-100 text-emerald-800 font-bold">ACTIVE (REVIEW)</span>
                      </div>
                      <p class="text-[11px] text-slate-600 leading-relaxed">
                        Prompt terkendali: noda lembap terlokalisasi di bagian bawah, beberapa gelembung cat kecil, sebagian besar dinding bersih dan utuh.
                      </p>
                    </div>
                  </div>
                </div>
              </details>
            )}

            <!-- Comparison Grid: Left (FLUX) vs Right (SDXL) -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
              <!-- LEFT: FLUX.1 Schnell -->
              <div class="flex flex-col border border-purple-200 rounded-xl bg-purple-50/20 p-5 space-y-4">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-purple-600"></span>
                    <strong class="font-outfit text-sm text-slate-900">FLUX.1 Schnell</strong>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-purple-100 text-purple-800 font-bold">PRIMARY</span>
                    {art.id === 9993 && (
                      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-blue-100 text-blue-800 font-bold">v3 TERKENDALI</span>
                    )}
                    {art.id === 9999 && (
                      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold">★ PILIHAN EDITORIAL</span>
                    )}
                  </div>
                  <span id={`status-badge-${fluxCandidate?.id}`} class={`text-xs font-mono font-bold px-2.5 py-0.5 rounded-full ${
                    fluxCandidate?.approval_status === 'APPROVED'
                      ? 'bg-emerald-100 text-emerald-800'
                      : fluxCandidate?.approval_status === 'REJECTED'
                      ? 'bg-rose-100 text-rose-800'
                      : 'bg-amber-100 text-amber-800'
                  }`}>
                    {fluxCandidate?.approval_status || 'NOT_FOUND'}
                  </span>
                </div>

                {fluxCandidate ? (
                  <div class="space-y-4 flex-1 flex flex-col justify-between">
                    <div class="space-y-3">
                      <!-- Image Container with Crop Mode Support -->
                      <div class="image-frame-container relative group rounded-lg overflow-hidden border border-slate-200 bg-slate-950 aspect-square flex items-center justify-center transition-all duration-300">
                        <img
                          src={fluxCandidate.public_url}
                          alt={`Kandidat FLUX untuk artikel ${art.id}`}
                          class="candidate-img w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                          loading="lazy"
                        />

                        <!-- 16:9 Visual Crop Guide Lines -->
                        <div class="crop-guide-overlay absolute inset-0 pointer-events-none border-2 border-emerald-400/80 bg-emerald-500/10 hidden flex-col justify-between p-2">
                          <span class="bg-black/80 text-emerald-400 font-mono text-[9px] px-1.5 py-0.5 rounded self-start">
                            16:9 Cover Safe Zone
                          </span>
                        </div>

                        <a
                          href={fluxCandidate.public_url}
                          target="_blank"
                          class="absolute bottom-3 right-3 rounded-lg bg-black/75 hover:bg-black text-white px-3 py-1.5 text-xs font-outfit font-semibold opacity-0 group-hover:opacity-100 transition shadow"
                        >
                          🔍 Buka Resolusi Penuh
                        </a>
                      </div>

                      <!-- 5-DIMENSIONAL QA SCORECARD -->
                      {fluxCandidate.five_dimensional_qa && (
                        <div class="p-3 bg-white rounded-lg border border-slate-200/80 text-[11px] space-y-2.5">
                          <div class="flex items-center justify-between border-b border-slate-100 pb-1.5">
                            <span class="font-bold text-slate-800">5-Dimensional Editorial QA:</span>
                            <span class="text-[9px] font-mono text-purple-700 bg-purple-50 px-1.5 py-0.5 rounded">
                              Automated Heuristics + Human Audit
                            </span>
                          </div>

                          <div class="space-y-1.5">
                            <!-- 1. Subject Relevance -->
                            <div class="flex items-start justify-between gap-2 text-[10px]">
                              <div>
                                <span class="font-bold text-slate-700">1. Subject Relevance:</span>
                                <p class="text-slate-500">{fluxCandidate.five_dimensional_qa.subjectRelevance.evaluationText}</p>
                              </div>
                              <span class="font-mono font-bold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded shrink-0">HEURISTIC PASS</span>
                            </div>

                            <!-- 2. Damage/Problem Accuracy -->
                            <div class="flex items-start justify-between gap-2 text-[10px]">
                              <div>
                                <span class="font-bold text-slate-700">2. Damage/Problem Accuracy:</span>
                                <p class="text-slate-500">{fluxCandidate.five_dimensional_qa.damageProblemAccuracy.evaluationText}</p>
                              </div>
                              <span class="font-mono font-bold text-slate-700 bg-slate-100 px-1.5 py-0.5 rounded shrink-0">
                                {fluxCandidate.five_dimensional_qa.damageProblemAccuracy.status}
                              </span>
                            </div>

                            <!-- 3. Architectural Geometry -->
                            <div class="flex items-start justify-between gap-2 text-[10px]">
                              <div>
                                <span class="font-bold text-slate-700">3. Architectural Geometry:</span>
                                <p class="text-slate-500">{fluxCandidate.five_dimensional_qa.architecturalGeometry.evaluationText}</p>
                              </div>
                              <span class="font-mono font-bold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded shrink-0">HEURISTIC PASS</span>
                            </div>

                            <!-- 4. Material Realism -->
                            <div class="flex items-start justify-between gap-2 text-[10px]">
                              <div>
                                <span class="font-bold text-slate-700">4. Material Realism:</span>
                                <p class="text-slate-500">{fluxCandidate.five_dimensional_qa.materialRealism.evaluationText}</p>
                              </div>
                              <span class="font-mono font-bold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded shrink-0">HEURISTIC PASS</span>
                            </div>

                            <!-- 5. Editorial Suitability (Human) -->
                            <div class="flex items-start justify-between gap-2 text-[10px] pt-1 border-t border-slate-100 bg-slate-50/70 p-1.5 rounded">
                              <div>
                                <span class="font-bold text-slate-900">5. Editorial Suitability (Chief Editor):</span>
                                <p class="text-slate-600">{fluxCandidate.five_dimensional_qa.editorialSuitability.evaluationText}</p>
                              </div>
                              <span class="font-mono font-bold text-amber-800 bg-amber-100 px-1.5 py-0.5 rounded shrink-0">HUMAN REVIEW</span>
                            </div>
                          </div>

                          <p class="text-[9px] text-slate-400 italic pt-1 border-t border-slate-100">
                            {fluxCandidate.five_dimensional_qa.disclaimer}
                          </p>
                        </div>
                      )}

                      <!-- Metadata Specs -->
                      <div class="grid grid-cols-2 gap-2 text-[11px] font-mono bg-white p-3 rounded-lg border border-slate-100">
                        <div>
                          <span class="text-slate-400">ID / Versi:</span>
                          <span class="font-bold text-slate-700 ml-1">{fluxCandidate.id}</span>
                        </div>
                        <div>
                          <span class="text-slate-400">Ukuran:</span>
                          <span class="font-bold text-slate-700 ml-1">{(fluxCandidate.byte_size / 1024).toFixed(1)} KB</span>
                        </div>
                        <div>
                          <span class="text-slate-400">Resolusi:</span>
                          <span class="font-bold text-slate-700 ml-1">{fluxCandidate.dimensions}</span>
                        </div>
                        <div>
                          <span class="text-slate-400">Steps:</span>
                          <span class="font-bold text-slate-700 ml-1">{fluxCandidate.steps || 4}</span>
                        </div>
                        <div>
                          <span class="text-slate-400">Latency:</span>
                          <span class="font-bold text-slate-700 ml-1">{fluxCandidate.provenance?.latency_ms || '--'} ms</span>
                        </div>
                        <div>
                          <span class="text-slate-400">Usage:</span>
                          <span class="font-bold text-emerald-600 ml-1">~{fluxCandidate.usage.estimated_neurons || '57.60'} Neurons (ESTIMATED)</span>
                        </div>
                      </div>

                      <!-- Prompt Disclosure -->
                      <details class="text-xs text-slate-600 bg-white p-3 rounded-lg border border-slate-100 cursor-pointer">
                        <summary class="font-semibold text-slate-800 select-none">
                          Lihat Prompt Kanonikal Visual
                        </summary>
                        <p class="mt-2 text-slate-600 text-[11px] leading-relaxed font-sans border-t border-slate-100 pt-2">
                          {fluxCandidate.prompt}
                        </p>
                      </details>
                    </div>

                    <!-- Operator Decision Actions -->
                    <div class="pt-3 border-t border-purple-100/80 flex items-center gap-2">
                      <button
                        type="button"
                        onclick={`handleDecision('${fluxCandidate.id}', 'approve')`}
