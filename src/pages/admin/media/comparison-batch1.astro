      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
        <div>
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-[#FFFDF7] border border-[#E7E9EE] text-[#A76A00] text-xs font-semibold mb-2">
