                    </span>
                    <span class="text-xs font-semibold text-[#596579] font-mono">
                      {art.code}
                    </span>
                  </div>
                  <h3 class="text-lg font-outfit font-bold text-[#172033] mt-1">
                    {art.title}
                  </h3>
                </div>
                <div class="text-xs text-[#596579]">
                  Target: <strong>2 Visual Pendamping Terpilih</strong>
                </div>
              </div>

              <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">
                {slots.map((s) => (
                  <div class="rounded-xl bg-[#FFFDF7] border border-[#E7E9EE] p-5 flex flex-col justify-between">
                    <div class="space-y-4">
                      <!-- Badge Header -->
                      <div class="flex flex-wrap items-center justify-between gap-2">
                        <span class="text-xs font-mono font-black px-2.5 py-1 rounded-md bg-[#172033] text-white">
                          SLOT {s.slotId}
                        </span>
                        <div class="flex items-center gap-2">
                          <span class={`text-[11px] font-mono font-bold px-2 py-0.5 rounded ${
                            s.recommendedMethod === 'DETERMINISTIC_SVG'
                              ? 'bg-blue-100 text-blue-900 border border-blue-200'
                              : 'bg-emerald-100 text-emerald-900 border border-emerald-200'
                          }`}>
                            {s.recommendedMethod === 'DETERMINISTIC_SVG' ? '📊 DETERMINISTIC SVG' : '🎨 AI DIFFUSION (FLUX)'}
                          </span>
                          <span class="text-[11px] font-mono font-bold px-2 py-0.5 rounded bg-amber-100 text-amber-900 border border-amber-200">
                            {s.reviewStatus}
                          </span>
                        </div>
                      </div>

                      <!-- Target Section -->
                      <div>
                        <div class="text-[11px] font-semibold text-[#596579] uppercase tracking-wider">
                          Penempatan dalam Naskah:
                        </div>
                        <div class="text-xs font-bold text-[#172033] mt-0.5">
                          {s.articleSection}
                        </div>
                      </div>

                      <!-- Main Subject & Problem/Solution -->
                      <div>
                        <div class="text-[11px] font-semibold text-[#596579] uppercase tracking-wider">
                          Subjek Visual &amp; Bukti:
                        </div>
                        <p class="text-xs font-bold text-[#172033] mt-0.5">
