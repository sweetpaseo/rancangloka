  <script is:inline>
    let currentCropMode = 'square';

    function setCropMode(mode) {
      currentCropMode = mode;
      const btnSquare = document.getElementById('btn-mode-square');
      const btn169 = document.getElementById('btn-mode-169');
      const frames = document.querySelectorAll('.image-frame-container');
      const guides = document.querySelectorAll('.crop-guide-overlay');

      if (mode === '169') {
        btnSquare.className = 'px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition cursor-pointer';
        btn169.className = 'px-3 py-1.5 rounded-lg bg-white shadow-2xs text-slate-900 font-black transition cursor-pointer';

        frames.forEach((frame) => {
          frame.classList.remove('aspect-square');
          frame.classList.add('aspect-video');
        });

        guides.forEach((g) => {
          g.classList.remove('hidden');
          g.classList.add('flex');
        });
      } else {
        btnSquare.className = 'px-3 py-1.5 rounded-lg bg-white shadow-2xs text-slate-900 font-black transition cursor-pointer';
        btn169.className = 'px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition cursor-pointer';

        frames.forEach((frame) => {
          frame.classList.remove('aspect-video');
          frame.classList.add('aspect-square');
        });

        guides.forEach((g) => {
          g.classList.remove('flex');
          g.classList.add('hidden');
        });
      }
    }

    async function handleDecision(candidateId, action) {
      const badge = document.getElementById(`status-badge-${candidateId}`);
      if (badge) {
        badge.textContent = 'Updating...';
        badge.className = 'text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600';
      }

      try {
        const res = await fetch('/api/admin/media/candidate-approval', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: candidateId, action })
        });

        const data = await res.json();
        if (data.status === 'success' && data.candidate) {
          const status = data.candidate.approval_status;
          if (badge) {
            badge.textContent = status;
            if (status === 'APPROVED') {
              badge.className = 'text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800';
            } else if (status === 'REJECTED') {
              badge.className = 'text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-800';
            } else {
              badge.className = 'text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800';
            }
          }
        } else {
          alert('Gagal memutakhirkan status: ' + (data.message || 'Unknown error'));
        }
      } catch (err) {
        alert('Koneksi gagal: ' + err.message);
      }
    }
  </script>
</AdminLayout>
