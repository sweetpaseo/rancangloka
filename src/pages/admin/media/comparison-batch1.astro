    function handleImageLoadError(imgEl, candidateId, publicUrl) {
      if (!imgEl) return;
      imgEl.classList.add('hidden');
      const errBox = document.getElementById('img-error-' + candidateId);
      if (errBox) {
        errBox.classList.remove('hidden');
        errBox.innerHTML = `
          <div class="p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-900 text-xs text-left space-y-1.5">
            <div class="font-bold flex items-center gap-1.5 text-rose-800">
              <span>⚠️ Gagal Memuat Asset Media</span>
            </div>
            <p class="font-mono text-[11px] text-rose-700 break-all bg-white/70 p-1 rounded border border-rose-100">
              URL: ${publicUrl}
            </p>
            <p class="text-[11px] text-rose-600 leading-relaxed">
              File biner tidak dapat diakses (HTTP error atau path salah). Tombol persetujuan dinonaktifkan secara otomatis sampai berkas media diverifikasi.
            </p>
          </div>
        `;
      }
      const approveBtn = document.getElementById('btn-approve-' + candidateId);
      if (approveBtn) {
        approveBtn.disabled = true;
        approveBtn.classList.add('opacity-50', 'cursor-not-allowed');
        approveBtn.title = 'Persetujuan dinonaktifkan karena berkas media gagal dimuat.';
      }
    }

    function setCropMode(mode) {
      currentCropMode = mode;
      const btnSquare = document.getElementById('btn-mode-square');
      const btn169 = document.getElementById('btn-mode-169');
      const frames = document.querySelectorAll('.image-frame-container');
      const guides = document.querySelectorAll('.crop-guide-overlay');

      if (mode === '169') {
        btnSquare.className = 'px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition cursor-pointer';
        btn169.className = 'px-3 py-1.5 rounded-lg bg-white shadow-2xs text-slate-900 font-black transition cursor-pointer';

        frames.forEach((frame) => {
          frame.classList.remove('aspect-square');
          frame.classList.add('aspect-video');
        });

        guides.forEach((g) => {
          g.classList.remove('hidden');
          g.classList.add('flex');
        });
      } else {
        btnSquare.className = 'px-3 py-1.5 rounded-lg bg-white shadow-2xs text-slate-900 font-black transition cursor-pointer';
        btn169.className = 'px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition cursor-pointer';

        frames.forEach((frame) => {
          frame.classList.remove('aspect-video');
          frame.classList.add('aspect-square');
        });

        guides.forEach((g) => {
          g.classList.remove('flex');
          g.classList.add('hidden');
        });
      }
    }

    function showToast(message, type = 'success', duration = 4000) {
      const container = document.getElementById('toast-container');
      if (!container) return;

      const toast = document.createElement('div');
      toast.className = `pointer-events-auto flex items-center justify-between gap-3 p-4 rounded-xl shadow-lg border text-sm font-outfit transition-all duration-300 transform translate-y-2 opacity-0 ${
        type === 'success'
          ? 'bg-emerald-50 border-emerald-200 text-emerald-900'
          : type === 'warning'
          ? 'bg-amber-50 border-amber-200 text-amber-900'
          : type === 'info'
          ? 'bg-sky-50 border-sky-200 text-sky-900'
          : 'bg-rose-50 border-rose-200 text-rose-900'
      }`;

      const icon =
        type === 'success'
          ? '✓'
          : type === 'warning'
          ? '⚠'
          : type === 'info'
          ? 'ℹ'
          : '✕';

      toast.innerHTML = `
        <div class="flex items-center gap-2.5">
          <span class="w-5 h-5 rounded-full flex items-center justify-center font-bold text-xs ${
            type === 'success'
              ? 'bg-emerald-200 text-emerald-800'
              : type === 'warning'
              ? 'bg-amber-200 text-amber-800'
              : type === 'info'
              ? 'bg-sky-200 text-sky-800'
              : 'bg-rose-200 text-rose-800'
          }">${icon}</span>
          <span class="font-medium">${message}</span>
        </div>
        <button type="button" class="text-xs opacity-60 hover:opacity-100 cursor-pointer font-bold ml-2">✕</button>
      `;

      const closeBtn = toast.querySelector('button');
      if (closeBtn) {
        closeBtn.onclick = () => {
          toast.classList.add('opacity-0', 'translate-y-2');
          setTimeout(() => toast.remove(), 300);
        };
      }

      container.appendChild(toast);

      // Trigger animation
      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      // Auto dismiss
      setTimeout(() => {
        if (toast.parentElement) {
          toast.classList.add('opacity-0', 'translate-y-2');
          setTimeout(() => toast.remove(), 300);
        }
      }, duration);
    }

    async function handleSelection(candidateId, action, modelName, articleId, slotIdentifier) {
      if (inFlight[candidateId]) return;
      inFlight[candidateId] = true;

      const btnSelect = document.getElementById(`btn-select-${candidateId}`) || document.getElementById(`btn-approve-${candidateId}`);
      const btnReject = document.getElementById(`btn-reject-${candidateId}`);
      const btnReset = document.getElementById(`btn-reset-${candidateId}`);

      const origSelectHtml = btnSelect ? btnSelect.innerHTML : '';
      const origRejectHtml = btnReject ? btnReject.innerHTML : '';
      const origResetHtml = btnReset ? btnReset.innerHTML : '';

      if (action === 'select' && btnSelect) {
        btnSelect.innerHTML = '⏳ Memilih...';
      } else if (action === 'reject' && btnReject) {
        btnReject.innerHTML = '⏳ Menolak...';
      } else if (action === 'reset' && btnReset) {
        btnReset.innerHTML = '⏳ Mereset...';
      }

      if (btnSelect) btnSelect.disabled = true;
      if (btnReject) btnReject.disabled = true;
      if (btnReset) btnReset.disabled = true;

      try {
        const res = await fetch('/api/admin/media/candidate-approval', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: candidateId,
            action,
            articleId,
            slot: slotIdentifier
          })
        });

        if (res.status === 401) {
          showToast('Sesi admin telah berakhir. Mengalihkan ke login...', 'error');
          setTimeout(() => {
            window.location.href = '/admin/login?redirect=' + encodeURIComponent(window.location.pathname);
          }, 1500);
          return;
        }

        const data = await res.json();

        if (res.ok && data.status === 'success') {
          if (action === 'select') {
            showToast(`✓ Gambar ${modelName || ''} berhasil dipilih untuk Artikel #${articleId}!`, 'success');
          } else if (action === 'reject') {
            showToast(`✕ Gambar ${modelName || ''} telah ditolak.`, 'warning');
          } else {
            showToast(`↺ Status kandidat telah direset.`, 'info');
          }
          // Reload page to reflect authoritative server-side slot evaluations, superseded states, and counters
          setTimeout(() => window.location.reload(), 700);
        } else {
          const msg = data?.message || 'Terjadi kesalahan sistem';
          showToast(`Gagal: ${msg}`, 'error');
          if (btnSelect) {
            btnSelect.innerHTML = origSelectHtml;
            btnSelect.disabled = false;
          }
          if (btnReject) {
            btnReject.innerHTML = origRejectHtml;
            btnReject.disabled = false;
          }
          if (btnReset) {
            btnReset.innerHTML = origResetHtml;
            btnReset.disabled = false;
          }
        }
      } catch (err) {
        showToast(`Koneksi jaringan terputus: ${err.message}`, 'error');
        if (btnSelect) {
          btnSelect.innerHTML = origSelectHtml;
          btnSelect.disabled = false;
        }
        if (btnReject) {
          btnReject.innerHTML = origRejectHtml;
          btnReject.disabled = false;
        }
        if (btnReset) {
          btnReset.innerHTML = origResetHtml;
          btnReset.disabled = false;
        }
      } finally {
        delete inFlight[candidateId];
      }
    }

    async function handleSlotSkip(articleId, slotIdentifier, action = 'skip_slot') {
      const btnKey = `skip-${articleId}-${slotIdentifier}`;
      if (inFlight[btnKey]) return;
      inFlight[btnKey] = true;

      const btnSkip = document.getElementById(`btn-skip-${articleId}-${slotIdentifier}`);
      const origHtml = btnSkip ? btnSkip.innerHTML : '';
      if (btnSkip) {
        btnSkip.innerHTML = '⏳ Menyimpan...';
        btnSkip.disabled = true;
      }

      try {
        const res = await fetch('/api/admin/media/candidate-approval', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action,
            articleId,
            slot: slotIdentifier
          })
        });

        if (res.status === 401) {
          showToast('Sesi admin telah berakhir. Mengalihkan ke login...', 'error');
          setTimeout(() => {
            window.location.href = '/admin/login?redirect=' + encodeURIComponent(window.location.pathname);
          }, 1500);
          return;
        }

        const data = await res.json();

        if (res.ok && data.status === 'success') {
          showToast(
            action === 'unskip_slot'
              ? `Slot ${slotIdentifier} dikembalikan (tidak lagi dilewati).`
              : `Slot ${slotIdentifier} berhasil dilewati (opsional).`,
            'info'
          );
          setTimeout(() => window.location.reload(), 700);
        } else {
          const msg = data?.message || 'Gagal mengubah status slot';
          showToast(`Gagal: ${msg}`, 'error');
          if (btnSkip) {
            btnSkip.innerHTML = origHtml;
            btnSkip.disabled = false;
          }
        }
      } catch (err) {
        showToast(`Koneksi jaringan terputus: ${err.message}`, 'error');
        if (btnSkip) {
          btnSkip.innerHTML = origHtml;
          btnSkip.disabled = false;
        }
      } finally {
        delete inFlight[btnKey];
      }
    }

    async function handleDecision(candidateId, action, modelName, articleId) {
      return handleSelection(candidateId, action === 'approve' ? 'select' : action, modelName, articleId, 'supporting');
    }

    function updateArticleProgressUI(articleId) {
      if (!articleId) return;

      let approved = 0;
      const heroCandidateId = articleId === 9993 
        ? 'candidate-9993-flux-1-schnell-v3' 
        : articleId === 9999 
        ? 'candidate-9999-flux-1-schnell' 
        : 'candidate-10000-sdxl-lightning';
      const heroBadge = document.getElementById('status-badge-' + heroCandidateId);
      if (heroBadge && heroBadge.textContent.trim() === 'APPROVED') approved++;

      const s1Badges = Array.from(document.querySelectorAll('[id^="status-badge-candidate-' + articleId + '-s1"]'));
      if (s1Badges.some(b => b.textContent.trim() === 'APPROVED')) approved++;

      const s2Badges = Array.from(document.querySelectorAll('[id^="status-badge-candidate-' + articleId + '-s2"]'));
      if (s2Badges.some(b => b.textContent.trim() === 'APPROVED')) approved++;

      const isFully = approved === 3;
      const countBadge = document.getElementById('art-approval-badge-' + articleId);
      if (countBadge) {
        countBadge.textContent = approved + '/3 Media Disetujui ' + (isFully ? '✓' : '(' + (3 - approved) + ' Menunggu)');
        countBadge.className = 'px-2.5 py-1 rounded-lg text-xs font-mono font-bold border ' + (isFully ? 'bg-emerald-50 text-emerald-800 border-emerald-300' : 'bg-amber-50 text-amber-800 border-amber-300');
      }

      const ctaWrap = document.getElementById('art-preview-cta-wrap-' + articleId);
      if (ctaWrap) {
        const slug = articleId === 9993 
          ? 'dinding-rembes-dan-cat-menggelembung-cara-membedakan-masalah-talang-plesteran-kelembapan-tanah'
          : articleId === 9999 
          ? '7-ide-menata-balkon-rumah-kecil-agar-nyaman'
          : 'menata-denah-rumah-lebar-5-6-meter-solusi-sirkulasi-bukaan-ruang-tengah-tidak-pengap';
        
        if (isFully) {
          ctaWrap.innerHTML = `
            <a id="btn-preview-next-${articleId}" href="/admin/preview/${slug}" target="_blank" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-xs transition flex items-center gap-1.5 cursor-pointer">
              <span>👁️ Lanjut ke Pratinjau Artikel ↗</span>
            </a>
          `;
          showToast('🎉 Seluruh media untuk Artikel #' + articleId + ' telah disetujui! Tombol "Lanjut ke Pratinjau Artikel" kini aktif.', 'success', 6000);
        } else {
          ctaWrap.innerHTML = `
            <a id="btn-preview-next-${articleId}" href="/admin/preview/${slug}" target="_blank" class="px-3.5 py-1.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold text-xs transition flex items-center gap-1.5">
              <span>👁️ Pratinjau Draf (${approved}/3 Terpasang) ↗</span>
            </a>
          `;
        }
      }
    }
  </script>
</AdminLayout>
