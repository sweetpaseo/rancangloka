---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  getDailyUsageSummary,
  loadMonitorConfig,
  loadUsageLedger,
  probeCloudflareUsageApi,
  getNextResetTimestampUtc
} from '../../../lib/media/neurons-usage-service';

const summary = getDailyUsageSummary();
const config = loadMonitorConfig();
const ledger = loadUsageLedger();
const probe = await probeCloudflareUsageApi();
const nextResetUtc = getNextResetTimestampUtc();

// Sort entries descending by timestamp
const sortedHistory = [...ledger].sort(
  (a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime()
);

const warningBadgeColor =
  summary.budgetStatus === 'BLOCKED'
    ? 'bg-rose-50 text-[#C63D3D] border-rose-200'
    : summary.budgetStatus === 'HIGH_WARNING'
      ? 'bg-amber-50 text-[#A76A00] border-amber-200'
      : summary.budgetStatus === 'WARNING'
        ? 'bg-yellow-50 text-[#A76A00] border-yellow-200'
        : 'bg-emerald-50 text-[#16805D] border-emerald-200';

const progressBarColor =
  summary.budgetStatus === 'BLOCKED'
    ? 'bg-[#C63D3D]'
    : summary.budgetStatus === 'HIGH_WARNING'
      ? 'bg-[#A76A00]'
      : summary.budgetStatus === 'WARNING'
        ? 'bg-[#F5C842]'
        : 'bg-[#16805D]';
---

<AdminLayout title="Cloudflare AI Neurons Usage Monitor">
  <div class="space-y-8 max-w-7xl mx-auto font-sans pb-16">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[#E7E9EE] pb-6">
      <div>
        <div class="flex flex-wrap items-center gap-2.5 mb-2.5">
          <span class="px-2.5 py-0.5 text-xs font-bold rounded-md bg-blue-50 text-[#0066ee] border border-blue-200/80 font-mono uppercase tracking-wider">
            LokaMedia Media Intelligence
          </span>
          <span class="text-slate-300">•</span>
          <span class="px-2.5 py-0.5 text-xs font-bold rounded-md bg-amber-50 text-[#A76A00] border border-amber-200/80 font-mono">
            Sumber Data: <span class="font-bold">ESTIMATED</span>
          </span>
          <span class="text-slate-300">•</span>
          <span class="px-2.5 py-0.5 text-xs font-bold rounded-md bg-slate-100 text-[#596579] border border-[#E7E9EE] font-mono">
            Cloudflare API: <span class="text-[#C63D3D] font-bold">UNAVAILABLE</span>
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black font-outfit text-[#172033] tracking-tight flex items-center gap-2.5">
          <svg class="w-7 h-7 text-[#0066ee]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          Cloudflare AI Neurons Usage Monitor
        </h1>
        <p class="text-sm text-[#596579] mt-1.5 leading-relaxed">
          Observabilitas kuota harian free-tier (10.000 Neurons/hari), estimasi konsumsi LokaMedia, dan pengaman pre-generation budget guard.
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <a
          href="/admin/media/comparison-batch1"
          class="inline-flex items-center gap-2 px-4 py-2 text-xs font-bold text-[#172033] bg-white hover:bg-slate-50 border border-[#E7E9EE] rounded-xl shadow-2xs transition focus:outline-none focus:ring-2 focus:ring-[#F5C842]/40"
        >
          <svg class="w-4 h-4 text-[#596579]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Komparasi Batch 1
        </a>
        <button
          type="button"
          id="btn-recalculate"
          class="inline-flex items-center gap-2 px-4 py-2 text-xs font-bold text-[#172033] bg-[#F5C842] hover:bg-[#EABF32] rounded-xl shadow-xs transition cursor-pointer font-outfit uppercase tracking-wider focus:outline-none focus:ring-2 focus:ring-[#F5C842]/50"
        >
          <svg class="w-4 h-4 text-[#172033]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Sinkronkan Ulang
        </button>
      </div>
    </div>

    <!-- Notice / Policy Banner -->
    <div class="p-5 rounded-2xl border border-[#E7E9EE] bg-[#FFFDF7] shadow-2xs flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-xs text-[#596579]">
      <div class="flex items-start gap-3.5">
        <span class="flex h-3 w-3 relative mt-0.5 shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-[#16805D]"></span>
        </span>
        <div class="space-y-1">
          <div>
            <strong class="text-[#172033]">Kebijakan Akurasi Telemetri:</strong>
            Cloudflare Dashboard mengelola kuota akun, namun belum menyediakan REST API untuk pembacaan kuota free-tier secara live.
            Semua angka Neurons di bawah berstatus <span class="text-[#A76A00] font-bold font-mono uppercase tracking-wider">ESTIMATED</span> berbasis ledger transaksi lokal.
          </div>
          <div class="text-[#596579] leading-relaxed">
            <strong class="text-[#172033]">Catatan Kuota Parsial:</strong>
            Karena tarif model SDXL Lightning belum terdaftar di dokumentasi resmi Cloudflare (Status: <span class="font-bold text-[#A76A00]">UNKNOWN</span>), sisa kuota yang ditampilkan merupakan estimasi parsial dari konsumsi yang diketahui (FLUX.1 Schnell) dan bukan jaminan bahwa 100% sisa alokasi Cloudflare tersedia penuh.
          </div>
        </div>
      </div>
      <div class="text-[#172033] font-mono flex items-center gap-2 bg-white px-3.5 py-2 rounded-xl border border-[#E7E9EE] shadow-2xs shrink-0">
        <svg class="w-4 h-4 text-[#596579]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Reset Kuota: <span id="reset-timer" class="text-[#172033] font-bold" data-reset-utc={nextResetUtc}>00:00:00 UTC</span>
      </div>
    </div>

    <!-- Top KPI Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      <!-- Card 1: Neurons Terpakai Hari Ini -->
      <div class="bg-white border border-[#E7E9EE] rounded-2xl p-6 shadow-2xs relative overflow-hidden flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between text-xs font-bold text-[#596579] uppercase tracking-wider">
            <span>Penggunaan Hari Ini</span>
            <span class={`px-2 py-0.5 rounded text-[11px] font-bold border font-mono ${warningBadgeColor}`}>
              {summary.budgetStatus}
            </span>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <span class="text-3xl font-black tracking-tight text-[#172033] font-mono">
              {summary.neuronsUsedToday.toLocaleString()}
            </span>
            <span class="text-xs text-[#596579] font-mono font-medium">
              / {summary.configuredDailyLimit.toLocaleString()} N
            </span>
          </div>
        </div>

        <!-- Progress Bar -->
        <div class="mt-5">
          <div class="w-full bg-[#E7E9EE] h-2.5 rounded-full overflow-hidden">
            <div
              class={`h-full ${progressBarColor} transition-all duration-500 rounded-full`}
              style={`width: ${Math.min(100, summary.percentageUsed)}%`}
            ></div>
          </div>
          <div class="flex justify-between items-center text-[11px] text-[#596579] mt-2 font-mono">
            <span>{summary.percentageUsed.toFixed(1)}% terpakai</span>
            <span>Batas: {summary.configuredDailyLimit.toLocaleString()} N</span>
          </div>
        </div>
      </div>

      <!-- Card 2: Estimasi Sisa Neurons -->
      <div class="bg-white border border-[#E7E9EE] rounded-2xl p-6 shadow-2xs flex flex-col justify-between">
        <div>
          <div class="text-xs font-bold text-[#596579] uppercase tracking-wider flex items-center justify-between">
            <span>Estimasi Sisa Kuota</span>
            <span class="text-[11px] text-[#596579] font-mono font-bold bg-slate-100 px-2 py-0.5 rounded border border-[#E7E9EE]">Free-Tier</span>
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <span class="text-3xl font-black tracking-tight text-[#16805D] font-mono">
              {summary.neuronsRemainingEstimated.toLocaleString()}
            </span>
            <span class="text-xs text-[#596579] font-mono font-medium">Neurons</span>
          </div>
        </div>
        <div class="mt-5 pt-3 border-t border-[#E7E9EE] flex items-center justify-between text-xs text-[#596579]">
          <span>Alokasi Resmi Cloudflare:</span>
          <span class="font-mono text-[#172033] font-bold">{summary.freeTierAllocation.toLocaleString()} N/hari</span>
        </div>
      </div>

      <!-- Card 3: Estimasi Kapasitas Batch -->
      <div class="bg-white border border-[#E7E9EE] rounded-2xl p-6 shadow-2xs flex flex-col justify-between">
        <div>
          <div class="text-xs font-bold text-[#596579] uppercase tracking-wider">
            Estimasi Kapasitas Gambar
          </div>
          <div class="mt-3 space-y-2.5">
            <div class="flex items-center justify-between">
              <span class="text-xs text-[#172033] font-medium flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
                FLUX.1 Schnell
              </span>
              <span class="font-mono font-bold text-sm text-[#0066ee]">
                ~{summary.estimatedRemainingCapacity.fluxImages} gambar
              </span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-xs text-[#172033] font-medium flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
                SDXL Lightning
              </span>
              <span class="font-mono font-bold text-xs text-[#A76A00] bg-amber-50 px-2 py-0.5 rounded border border-amber-200" title="Tarif model SDXL belum terdaftar di dokumentasi resmi Cloudflare Workers AI">
                UNKNOWN
              </span>
            </div>
          </div>
        </div>
        <div class="mt-4 pt-2.5 border-t border-[#E7E9EE] text-[11px] text-[#596579]">
          FLUX: 57.60 N/gen (resmi) | SDXL: UNKNOWN (belum terdaftar)
        </div>
      </div>

      <!-- Card 4: Status Request & Keberhasilan -->
      <div class="bg-white border border-[#E7E9EE] rounded-2xl p-6 shadow-2xs flex flex-col justify-between">
        <div>
          <div class="text-xs font-bold text-[#596579] uppercase tracking-wider">
            Aktivitas Generasi
          </div>
          <div class="mt-3 flex items-baseline gap-2">
            <span class="text-3xl font-black tracking-tight text-[#172033] font-mono">
              {summary.totalRequestsToday}
            </span>
            <span class="text-xs text-[#596579] font-medium">total request</span>
          </div>
        </div>
        <div class="mt-5 pt-3 border-t border-[#E7E9EE] flex items-center justify-between text-xs font-bold">
          <span class="text-[#16805D] flex items-center gap-1 font-mono">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            {summary.successfulGenerationsToday} Berhasil
          </span>
          <span class="text-[#C63D3D] flex items-center gap-1 font-mono">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            {summary.failedGenerationsToday + summary.blockedGenerations} Gagal/Blok
          </span>
        </div>
      </div>
    </div>

    <!-- Middle Section: Model Breakdown & Pre-Generation Budget Guard -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Left 2 Cols: Pemakaian Per Model -->
      <div class="lg:col-span-2 bg-white border border-[#E7E9EE] rounded-2xl p-6 shadow-2xs">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-base font-bold font-outfit text-[#172033] flex items-center gap-2">
            <svg class="w-5 h-5 text-[#0066ee]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            Pemakaian Berdasarkan Model
          </h2>
          <span class="text-xs text-[#596579] font-mono bg-slate-100 px-2.5 py-1 rounded-lg border border-[#E7E9EE]">
            LokaMedia Isolation Scope
          </span>
        </div>

        <div class="overflow-x-auto rounded-xl border border-[#E7E9EE]">
          <table class="w-full text-left text-sm text-[#172033]">
            <thead class="text-xs text-[#596579] uppercase bg-[#F8F9FA] border-b border-[#E7E9EE] font-mono">
              <tr>
                <th scope="col" class="px-4 py-3">Model</th>
                <th scope="col" class="px-4 py-3 text-center">Estimasi / Gen</th>
                <th scope="col" class="px-4 py-3 text-center">Total Req</th>
                <th scope="col" class="px-4 py-3 text-center">Berhasil</th>
                <th scope="col" class="px-4 py-3 text-right">Neurons Terpakai</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#E7E9EE]">
              {summary.modelBreakdown.map((m) => (
                <tr class="hover:bg-[#FFFDF7] transition-colors">
                  <td class="px-4 py-3.5 font-medium text-[#172033] flex items-center gap-2.5">
                    <span class={`w-2.5 h-2.5 rounded-full ${m.model.includes('flux') ? 'bg-indigo-500' : 'bg-cyan-500'}`}></span>
                    <div>
                      <div class="font-bold">{m.modelName}</div>
                      <div class="text-[11px] text-[#596579] font-mono">{m.model}</div>
                    </div>
                  </td>
                  <td class="px-4 py-3.5 text-center font-mono text-xs">
                    {m.pricingStatus === 'VERIFIED_OFFICIAL' ? (
                      <span class="px-2 py-0.5 rounded text-indigo-700 bg-indigo-50 border border-indigo-200 font-bold" title={m.unitCostNote}>57.60 N</span>
                    ) : (
                      <span class="px-2 py-0.5 rounded text-[#A76A00] bg-amber-50 border border-amber-200 font-bold" title={m.unitCostNote}>UNKNOWN</span>
                    )}
                  </td>
                  <td class="px-4 py-3.5 text-center font-mono font-semibold text-[#172033]">
                    {m.requestCount}
                  </td>
                  <td class="px-4 py-3.5 text-center font-mono font-bold text-[#16805D]">
                    {m.successCount}
                  </td>
                  <td class="px-4 py-3.5 text-right font-mono font-black text-[#172033]">
                    {m.estimatedNeurons !== null ? (
                      `${m.estimatedNeurons.toLocaleString()} N`
                    ) : (
                      <span class="text-[#A76A00] font-mono text-xs font-bold">UNKNOWN</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-4 p-3.5 rounded-xl bg-[#FFFDF7] border border-[#E7E9EE] text-xs text-[#596579] flex items-start gap-2.5">
          <svg class="w-4 h-4 text-[#0066ee] mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div>
            <strong class="text-[#172033]">Isolasi Model:</strong> Hanya pemakaian model gambar LokaMedia (FLUX.1 Schnell & SDXL Lightning) yang dicatat di ledger ini. Model Workers AI teks atau embedding lain dalam akun Cloudflare yang sama tidak akan tercampur.
          </div>
        </div>
      </div>

      <!-- Right 1 Col: Pre-Generation Budget Guard -->
      <div class="bg-[#FFFDF7] border border-[#E7E9EE] rounded-2xl p-6 shadow-2xs flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-base font-bold font-outfit text-[#172033] flex items-center gap-2">
              <svg class="w-5 h-5 text-[#A76A00]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              Budget Guard
            </h2>
            <span class="text-xs px-2.5 py-0.5 rounded-md bg-emerald-50 text-[#16805D] border border-emerald-200 font-bold font-mono">
              Aktif
            </span>
          </div>

          <p class="text-xs text-[#596579] mb-4 leading-relaxed">
            Pengaman pre-generation mencegah pemborosan kuota dan memblokir generasi otomatis jika estimasi melebihi batas yang dikonfigurasi.
          </p>

          <form id="guard-config-form" class="space-y-4">
            <div>
              <label for="custom-limit" class="block text-xs font-bold text-[#172033] uppercase mb-1">
                Batas Harian Kustom (Neurons)
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="custom-limit"
                  name="customDailyLimit"
                  value={config.customDailyLimit || 10000}
                  min="1000"
                  max="10000"
                  step="500"
                  class="w-full bg-white border border-[#E7E9EE] rounded-xl px-3.5 py-2 text-sm text-[#172033] font-mono focus:outline-none focus:border-[#F5C842] focus:ring-2 focus:ring-[#F5C842]/30 transition"
                />
                <span class="absolute right-3.5 top-2.5 text-xs text-[#596579] font-mono font-semibold">Max 10.000</span>
              </div>
              <p class="text-[11px] text-[#596579] mt-1">Dapat diturunkan untuk mencadangkan kuota.</p>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="warning-threshold" class="block text-xs font-bold text-[#172033] uppercase mb-1">
                  Peringatan (%)
                </label>
                <input
                  type="number"
                  id="warning-threshold"
                  name="warningThresholdPercent"
                  value={config.warningThresholdPercent}
                  min="50"
                  max="85"
                  class="w-full bg-white border border-[#E7E9EE] rounded-xl px-3 py-2 text-sm text-[#172033] font-mono focus:outline-none focus:border-[#F5C842] focus:ring-2 focus:ring-[#F5C842]/30 transition"
                />
              </div>
              <div>
                <label for="high-warning-threshold" class="block text-xs font-bold text-[#172033] uppercase mb-1">
                  Peringatan Tinggi (%)
                </label>
                <input
                  type="number"
                  id="high-warning-threshold"
                  name="highWarningThresholdPercent"
                  value={config.highWarningThresholdPercent}
                  min="75"
                  max="99"
                  class="w-full bg-white border border-[#E7E9EE] rounded-xl px-3 py-2 text-sm text-[#172033] font-mono focus:outline-none focus:border-[#F5C842] focus:ring-2 focus:ring-[#F5C842]/30 transition"
                />
              </div>
            </div>

            <!-- Invariant Lock: Paid Usage Disabled -->
            <div class="pt-1">
              <label class="flex items-center gap-3 p-3 rounded-xl bg-white border border-[#E7E9EE] text-xs text-[#596579] cursor-not-allowed shadow-2xs">
                <input
                  type="checkbox"
                  disabled
                  checked={false}
                  class="rounded bg-slate-100 border-[#E7E9EE] text-slate-400 focus:ring-0 disabled:opacity-50 h-4 w-4"
                />
                <div>
                  <div class="font-bold text-[#172033]">Izinkan Penggunaan Berbayar</div>
                  <div class="text-[10px] text-[#C63D3D] font-mono font-bold">DISABLED (Strict Invariant: Free Tier Only)</div>
                </div>
              </label>
            </div>

            <button
              type="submit"
              id="btn-save-guard"
              class="w-full mt-2 px-4 py-2.5 text-xs font-bold text-[#172033] bg-[#F5C842] hover:bg-[#EABF32] rounded-xl transition shadow-xs cursor-pointer font-outfit uppercase tracking-wider focus:outline-none focus:ring-2 focus:ring-[#F5C842]/50"
            >
              Simpan Pengaturan
            </button>
          </form>
        </div>

        <div id="guard-save-msg" class="hidden mt-3 p-2.5 rounded-xl text-xs font-medium text-center"></div>
      </div>
    </div>

    <!-- Bottom Section: Generation History & Audit Ledger -->
    <div class="bg-white border border-[#E7E9EE] rounded-2xl p-6 shadow-2xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div>
          <h2 class="text-base font-bold font-outfit text-[#172033] flex items-center gap-2">
            <svg class="w-5 h-5 text-[#0066ee]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Histori & Audit Pemakaian Neurons
          </h2>
          <p class="text-xs text-[#596579] mt-0.5">
            Mencatat setiap percobaan generasi, estimasi konsumsi, status, latency, dan kategori kegagalan (tanpa double counting).
          </p>
        </div>
        <div class="text-xs font-mono text-[#596579] bg-slate-100 px-3 py-1.5 rounded-xl border border-[#E7E9EE]">
          Total Tercatat: <strong class="text-[#172033]">{sortedHistory.length}</strong> transaksi
        </div>
      </div>

      <div class="overflow-x-auto rounded-xl border border-[#E7E9EE]">
        <table class="w-full text-left text-sm text-[#172033]">
          <thead class="text-xs text-[#596579] uppercase bg-[#F8F9FA] border-b border-[#E7E9EE] font-mono">
            <tr>
              <th scope="col" class="px-4 py-3">Waktu (UTC)</th>
              <th scope="col" class="px-4 py-3">Article ID</th>
              <th scope="col" class="px-4 py-3">Generation ID</th>
              <th scope="col" class="px-4 py-3">Model</th>
              <th scope="col" class="px-4 py-3 text-center">Status</th>
              <th scope="col" class="px-4 py-3 text-center">Neurons</th>
              <th scope="col" class="px-4 py-3 text-center">Sumber</th>
              <th scope="col" class="px-4 py-3 text-right">Latency</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#E7E9EE] font-mono text-xs">
            {sortedHistory.length === 0 ? (
              <tr>
                <td colspan="8" class="px-4 py-8 text-center text-[#596579] font-sans">
                  Belum ada catatan generasi di ledger.
                </td>
              </tr>
            ) : (
              sortedHistory.slice(0, 50).map((e) => {
                const statusColor =
                  e.status === 'SUCCESS'
                    ? 'text-[#16805D] bg-emerald-50 border-emerald-200'
                    : e.status === 'BLOCKED'
                      ? 'text-[#A76A00] bg-amber-50 border-amber-200'
                      : 'text-[#C63D3D] bg-rose-50 border-rose-200';

                return (
                  <tr class="hover:bg-[#FFFDF7] transition-colors">
                    <td class="px-4 py-3 text-[#596579] whitespace-nowrap">
                      {e.timestamp.slice(0, 19).replace('T', ' ')}
                    </td>
                    <td class="px-4 py-3 text-[#172033] font-bold">
                      #{e.articleId}
                    </td>
                    <td class="px-4 py-3 text-[#596579] max-w-[220px] truncate" title={e.id}>
                      <span class="text-[#172033] font-medium">{e.id}</span>
                      {e.auditCorrection && (
                        <span
                          class="ml-1.5 px-1.5 py-0.5 rounded text-[10px] bg-purple-50 text-purple-700 border border-purple-200 font-bold"
                          title={`Koreksi Audit: ${e.auditCorrection.reason}`}
                        >
                          Audit
                        </span>
                      )}
                    </td>
                    <td class="px-4 py-3 text-[#172033] font-sans font-medium">
                      {e.modelName}
                    </td>
                    <td class="px-4 py-3 text-center">
                      <span class={`inline-block px-2.5 py-0.5 rounded text-[10px] font-bold border ${statusColor}`}>
                        {e.status}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-center font-bold text-[#172033]">
                      {e.neuronsEstimated !== null ? (
                        `${e.neuronsEstimated.toLocaleString()} N`
                      ) : (
                        <span class="text-[#A76A00] font-mono text-[11px] font-bold" title="Tarif unverified di docs Cloudflare">UNKNOWN</span>
                      )}
                    </td>
                    <td class="px-4 py-3 text-center">
                      <span class={`px-2 py-0.5 rounded text-[10px] font-bold border ${
                        e.authoritativeSource === 'UNKNOWN'
                          ? 'bg-amber-50 text-[#A76A00] border-amber-200'
                          : e.authoritativeSource === 'ACTUAL'
                            ? 'bg-emerald-50 text-[#16805D] border-emerald-200'
                            : 'bg-blue-50 text-blue-700 border-blue-200'
                      }`}>
                        {e.authoritativeSource}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-right text-[#596579]">
                      {e.latencyMs ? `${e.latencyMs} ms` : '-'}
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    // Live countdown to next reset at 00:00:00 UTC
    function updateResetCountdown() {
      const el = document.getElementById('reset-timer');
      if (!el) return;
      const targetStr = el.getAttribute('data-reset-utc');
      if (!targetStr) return;

      const target = new Date(targetStr).getTime();
      const now = Date.now();
      const diff = Math.max(0, target - now);

      const hours = Math.floor(diff / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);

      el.textContent = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')} UTC`;
    }

    setInterval(updateResetCountdown, 1000);
    updateResetCountdown();

    // Guard config form handler
    const form = document.getElementById('guard-config-form');
    const msg = document.getElementById('guard-save-msg');
    const btnSave = document.getElementById('btn-save-guard');

    if (form && msg && btnSave) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        btnSave.setAttribute('disabled', 'true');
        btnSave.textContent = 'Menyimpan...';

        const customDailyLimit = Number((document.getElementById('custom-limit') as HTMLInputElement)?.value || 10000);
        const warningThresholdPercent = Number((document.getElementById('warning-threshold') as HTMLInputElement)?.value || 70);
        const highWarningThresholdPercent = Number((document.getElementById('high-warning-threshold') as HTMLInputElement)?.value || 90);

        try {
          const res = await fetch('/api/admin/media/neurons-usage', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              custom_daily_limit: customDailyLimit,
              warning_threshold_percent: warningThresholdPercent,
              high_warning_threshold_percent: highWarningThresholdPercent,
              allow_paid_usage: false
            })
          });

          const data = await res.json();
          if (res.ok && data.status === 'ok') {
            msg.className = 'mt-3 p-3 rounded-xl text-xs font-bold text-center bg-emerald-50 text-[#16805D] border border-emerald-200';
            msg.textContent = '✓ Pengaturan budget guard berhasil disimpan.';
            msg.classList.remove('hidden');
            setTimeout(() => window.location.reload(), 1000);
          } else {
            msg.className = 'mt-3 p-3 rounded-xl text-xs font-bold text-center bg-rose-50 text-[#C63D3D] border border-rose-200';
            msg.textContent = `Gagal: ${data.message || 'Terjadi kesalahan sistem'}`;
            msg.classList.remove('hidden');
          }
        } catch (err: any) {
          msg.className = 'mt-3 p-3 rounded-xl text-xs font-bold text-center bg-rose-50 text-[#C63D3D] border border-rose-200';
          msg.textContent = `Network Error: ${err?.message || String(err)}`;
          msg.classList.remove('hidden');
        } finally {
          btnSave.removeAttribute('disabled');
          btnSave.textContent = 'Simpan Pengaturan';
        }
      });
    }

    // Recalculate button handler
    const btnRecalc = document.getElementById('btn-recalculate');
    if (btnRecalc) {
      btnRecalc.addEventListener('click', () => {
        window.location.reload();
      });
    }
  </script>
</AdminLayout>
