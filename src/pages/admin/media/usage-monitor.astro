---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  getDailyUsageSummary,
  loadMonitorConfig,
  loadUsageLedger,
  probeCloudflareUsageApi,
  getNextResetTimestampUtc
} from '../../../lib/media/neurons-usage-service';

const summary = getDailyUsageSummary();
const config = loadMonitorConfig();
const ledger = loadUsageLedger();
const probe = await probeCloudflareUsageApi();
const nextResetUtc = getNextResetTimestampUtc();

// Sort entries descending by timestamp
const sortedHistory = [...ledger].sort(
  (a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime()
);

const warningBadgeColor =
  summary.budgetStatus === 'BLOCKED'
    ? 'bg-red-500/10 text-red-400 border-red-500/20'
    : summary.budgetStatus === 'HIGH_WARNING'
      ? 'bg-amber-500/10 text-amber-400 border-amber-500/20'
      : summary.budgetStatus === 'WARNING'
        ? 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20'
        : 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';

const progressBarColor =
  summary.budgetStatus === 'BLOCKED'
    ? 'bg-red-500'
    : summary.budgetStatus === 'HIGH_WARNING'
      ? 'bg-amber-500'
      : summary.budgetStatus === 'WARNING'
        ? 'bg-yellow-500'
        : 'bg-emerald-500';
---

<AdminLayout title="Cloudflare AI Neurons Usage Monitor">
  <div class="space-y-8 max-w-7xl mx-auto">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
            LokaMedia Media Intelligence
          </span>
          <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full bg-slate-800 text-slate-300 border border-slate-700">
            Sumber Data: <span class="text-amber-400 font-mono font-bold">ESTIMATED</span>
          </span>
          <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full bg-slate-800 text-slate-400 border border-slate-700">
            Cloudflare API: <span class="text-rose-400 font-mono font-bold">UNAVAILABLE</span>
          </span>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-2">
          <svg class="w-7 h-7 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          Cloudflare AI Neurons Usage Monitor
        </h1>
        <p class="text-sm text-slate-400 mt-1">
          Observabilitas kuota harian free-tier (10.000 Neurons/hari), estimasi konsumsi LokaMedia, dan pengaman pre-generation budget guard.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/media/comparison-batch1"
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-slate-300 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg transition-colors"
        >
          <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Komparasi Batch 1
        </a>
        <button
          id="btn-recalculate"
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-500 rounded-lg shadow-sm transition-colors cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Sinkronkan Ulang
        </button>
      </div>
    </div>

    <!-- Alert / Notice Banner -->
    <div class="p-4 rounded-xl border border-slate-800 bg-slate-900/60 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-xs text-slate-400">
      <div class="flex items-center gap-3">
        <span class="flex h-3 w-3 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
        </span>
        <div>
          <strong class="text-slate-200">Kebijakan Akurasi Telemetri:</strong>
          Cloudflare Dashboard mengelola kuota akun, namun belum menyediakan REST API untuk pembacaan kuota free-tier secara live.
          Semua angka Neurons di bawah berstatus <span class="text-amber-400 font-bold uppercase tracking-wider">ESTIMATED</span> berbasis ledger transaksi lokal.
        </div>
      </div>
      <div class="text-slate-400 font-mono flex items-center gap-2 bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700/60">
        <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Reset Kuota: <span id="reset-timer" class="text-slate-200 font-semibold" data-reset-utc={nextResetUtc}>00:00:00 UTC</span>
      </div>
    </div>

    <!-- Top KPI Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      <!-- Card 1: Neurons Terpakai Hari Ini -->
      <div class="bg-slate-900/70 border border-slate-800 rounded-xl p-5 relative overflow-hidden shadow-sm">
        <div class="flex items-center justify-between text-xs font-semibold text-slate-400 uppercase tracking-wider">
          <span>Penggunaan Hari Ini</span>
          <span class={`px-2 py-0.5 rounded text-[11px] font-bold border ${warningBadgeColor}`}>
            {summary.budgetStatus}
          </span>
        </div>
        <div class="mt-3 flex items-baseline gap-2">
          <span class="text-3xl font-black tracking-tight text-white font-mono">
            {summary.neuronsUsedToday.toLocaleString()}
          </span>
          <span class="text-xs text-slate-400 font-mono">
            / {summary.configuredDailyLimit.toLocaleString()} N
          </span>
        </div>

        <!-- Progress Bar -->
        <div class="mt-4">
          <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
            <div
              class={`h-full ${progressBarColor} transition-all duration-500`}
              style={`width: ${Math.min(100, summary.percentageUsed)}%`}
            ></div>
          </div>
          <div class="flex justify-between items-center text-[11px] text-slate-400 mt-1.5">
            <span>{summary.percentageUsed.toFixed(1)}% terpakai</span>
            <span>Batas: {summary.configuredDailyLimit.toLocaleString()} N</span>
          </div>
        </div>
      </div>

      <!-- Card 2: Estimasi Sisa Neurons -->
      <div class="bg-slate-900/70 border border-slate-800 rounded-xl p-5 shadow-sm">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center justify-between">
          <span>Estimasi Tersisa</span>
          <span class="text-[11px] text-slate-500 font-mono font-medium">Batas Free-Tier</span>
        </div>
        <div class="mt-3 flex items-baseline gap-2">
          <span class="text-3xl font-black tracking-tight text-emerald-400 font-mono">
            {summary.neuronsRemainingEstimated.toLocaleString()}
          </span>
          <span class="text-xs text-slate-400 font-mono">Neurons</span>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
          <span>Alokasi Resmi Cloudflare:</span>
          <span class="font-mono text-slate-200 font-semibold">{summary.freeTierAllocation.toLocaleString()} N/hari</span>
        </div>
      </div>

      <!-- Card 3: Estimasi Kapasitas Batch -->
      <div class="bg-slate-900/70 border border-slate-800 rounded-xl p-5 shadow-sm">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
          Estimasi Kapasitas Gambar
        </div>
        <div class="mt-3 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-300 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
              FLUX.1 Schnell
            </span>
            <span class="font-mono font-bold text-sm text-indigo-300">
              ~{summary.estimatedRemainingCapacity.fluxImages} gambar
            </span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-300 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              SDXL Lightning
            </span>
            <span class="font-mono font-bold text-sm text-cyan-300">
              ~{summary.estimatedRemainingCapacity.sdxlImages} gambar
            </span>
          </div>
        </div>
        <div class="mt-3 pt-2 border-t border-slate-800/80 text-[11px] text-slate-500">
          Asumsi: FLUX ~1.500 N/gen, SDXL ~1.200 N/gen
        </div>
      </div>

      <!-- Card 4: Status Request & Keberhasilan -->
      <div class="bg-slate-900/70 border border-slate-800 rounded-xl p-5 shadow-sm">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
          Request Hari Ini
        </div>
        <div class="mt-3 flex items-baseline gap-2">
          <span class="text-3xl font-black tracking-tight text-white font-mono">
            {summary.totalRequestsToday}
          </span>
          <span class="text-xs text-slate-400">total generasi</span>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs">
          <span class="text-emerald-400 flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            {summary.successfulGenerationsToday} Berhasil
          </span>
          <span class="text-rose-400 flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            {summary.failedGenerationsToday} Gagal
          </span>
        </div>
      </div>
    </div>

    <!-- Middle Section: Model Breakdown & Pre-Generation Budget Guard -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Left 2 Cols: Pemakaian Per Model -->
      <div class="lg:col-span-2 bg-slate-900/70 border border-slate-800 rounded-xl p-6 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            Pemakaian Berdasarkan Model
          </h2>
          <span class="text-xs text-slate-500 font-mono">LokaMedia Isolation Scope</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-slate-300">
            <thead class="text-xs text-slate-400 uppercase bg-slate-800/60 border-b border-slate-700">
              <tr>
                <th scope="col" class="px-4 py-3">Model</th>
                <th scope="col" class="px-4 py-3 text-center">Estimasi / Gen</th>
                <th scope="col" class="px-4 py-3 text-center">Total Req</th>
                <th scope="col" class="px-4 py-3 text-center">Berhasil</th>
                <th scope="col" class="px-4 py-3 text-right">Neurons Terpakai</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800">
              {summary.modelBreakdown.map((m) => (
                <tr class="hover:bg-slate-800/30 transition-colors">
                  <td class="px-4 py-3 font-medium text-white flex items-center gap-2">
                    <span class={`w-2.5 h-2.5 rounded-full ${m.model.includes('flux') ? 'bg-indigo-400' : 'bg-cyan-400'}`}></span>
                    <div>
                      <div class="font-bold">{m.modelName}</div>
                      <div class="text-[11px] text-slate-500 font-mono">{m.model}</div>
                    </div>
                  </td>
                  <td class="px-4 py-3 text-center font-mono text-xs text-slate-400">
                    {m.model.includes('flux') ? '1.500 N' : '1.200 N'}
                  </td>
                  <td class="px-4 py-3 text-center font-mono">
                    {m.requestCount}
                  </td>
                  <td class="px-4 py-3 text-center font-mono text-emerald-400">
                    {m.successCount}
                  </td>
                  <td class="px-4 py-3 text-right font-mono font-bold text-white">
                    {m.estimatedNeurons.toLocaleString()} N
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-4 p-3 rounded-lg bg-slate-800/40 border border-slate-800 text-xs text-slate-400 flex items-start gap-2">
          <svg class="w-4 h-4 text-indigo-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div>
            <strong>Isolasi Model:</strong> Hanya pemakaian model gambar LokaMedia (FLUX.1 Schnell & SDXL Lightning) yang dicatat di ledger ini. Model Workers AI teks atau embedding lain dalam akun Cloudflare yang sama tidak akan tercampur.
          </div>
        </div>
      </div>

      <!-- Right 1 Col: Pre-Generation Budget Guard -->
      <div class="bg-slate-900/70 border border-slate-800 rounded-xl p-6 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              Budget Guard
            </h2>
            <span class="text-xs px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-semibold">
              Aktif
            </span>
          </div>

          <p class="text-xs text-slate-400 mb-4 leading-relaxed">
            Pengaman pre-generation mencegah pemborosan kuota dan memblokir generasi otomatis jika estimasi melebihi batas yang dikonfigurasi.
          </p>

          <form id="guard-config-form" class="space-y-4">
            <div>
              <label for="custom-limit" class="block text-xs font-semibold text-slate-300 uppercase mb-1">
                Batas Harian Kustom (Neurons)
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="custom-limit"
                  name="customDailyLimit"
                  value={config.customDailyLimit || 10000}
                  min="1000"
                  max="10000"
                  step="500"
                  class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white font-mono focus:outline-none focus:border-indigo-500"
                />
                <span class="absolute right-3 top-2 text-xs text-slate-500 font-mono">Max 10.000</span>
              </div>
              <p class="text-[11px] text-slate-500 mt-1">Dapat diturunkan untuk mencadangkan kuota.</p>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="warning-threshold" class="block text-xs font-semibold text-slate-300 uppercase mb-1">
                  Peringatan (%)
                </label>
                <input
                  type="number"
                  id="warning-threshold"
                  name="warningThresholdPercent"
                  value={config.warningThresholdPercent}
                  min="50"
                  max="85"
                  class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white font-mono focus:outline-none focus:border-indigo-500"
                />
              </div>
              <div>
                <label for="high-warning-threshold" class="block text-xs font-semibold text-slate-300 uppercase mb-1">
                  Peringatan Tinggi (%)
                </label>
                <input
                  type="number"
                  id="high-warning-threshold"
                  name="highWarningThresholdPercent"
                  value={config.highWarningThresholdPercent}
                  min="75"
                  max="99"
                  class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white font-mono focus:outline-none focus:border-indigo-500"
                />
              </div>
            </div>

            <!-- Invariant Lock: Paid Usage Disabled -->
            <div class="pt-2">
              <label class="flex items-center gap-2 p-3 rounded-lg bg-slate-800/60 border border-slate-700/60 text-xs text-slate-400 cursor-not-allowed">
                <input
                  type="checkbox"
                  disabled
                  checked={false}
                  class="rounded bg-slate-900 border-slate-700 text-indigo-600 focus:ring-0 disabled:opacity-50"
                />
                <div>
                  <div class="font-semibold text-slate-300">Izinkan Penggunaan Berbayar</div>
                  <div class="text-[11px] text-rose-400 font-mono">DISABLED (Strict Invariant: Free Tier Only)</div>
                </div>
              </label>
            </div>

            <button
              type="submit"
              id="btn-save-guard"
              class="w-full mt-2 px-4 py-2 text-sm font-medium text-white bg-slate-800 hover:bg-slate-700 border border-slate-600 rounded-lg transition-colors cursor-pointer"
            >
              Simpan Pengaturan
            </button>
          </form>
        </div>

        <div id="guard-save-msg" class="hidden mt-3 p-2.5 rounded-lg text-xs font-medium text-center"></div>
      </div>
    </div>

    <!-- Bottom Section: Generation History & Audit Ledger -->
    <div class="bg-slate-900/70 border border-slate-800 rounded-xl p-6 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div>
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Histori & Audit Pemakaian Neurons
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">
            Mencatat setiap percobaan generasi, estimasi konsumsi, status, latency, dan kategori kegagalan (tanpa double counting).
          </p>
        </div>
        <div class="text-xs text-slate-400 font-mono">
          Total Tercatat: <strong class="text-white">{sortedHistory.length}</strong> transaksi
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-300">
          <thead class="text-xs text-slate-400 uppercase bg-slate-800/60 border-b border-slate-700">
            <tr>
              <th scope="col" class="px-4 py-3">Waktu (UTC)</th>
              <th scope="col" class="px-4 py-3">Article ID</th>
              <th scope="col" class="px-4 py-3">Generation ID</th>
              <th scope="col" class="px-4 py-3">Model</th>
              <th scope="col" class="px-4 py-3 text-center">Status</th>
              <th scope="col" class="px-4 py-3 text-center">Neurons</th>
              <th scope="col" class="px-4 py-3 text-center">Sumber</th>
              <th scope="col" class="px-4 py-3 text-right">Latency</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800 font-mono text-xs">
            {sortedHistory.length === 0 ? (
              <tr>
                <td colspan="8" class="px-4 py-8 text-center text-slate-500 font-sans">
                  Belum ada catatan generasi di ledger.
                </td>
              </tr>
            ) : (
              sortedHistory.slice(0, 50).map((e) => {
                const statusColor =
                  e.status === 'SUCCESS'
                    ? 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20'
                    : e.status === 'BLOCKED'
                      ? 'text-amber-400 bg-amber-500/10 border-amber-500/20'
                      : 'text-rose-400 bg-rose-500/10 border-rose-500/20';

                return (
                  <tr class="hover:bg-slate-800/30 transition-colors">
                    <td class="px-4 py-2.5 text-slate-400 whitespace-nowrap">
                      {e.timestamp.slice(0, 19).replace('T', ' ')}
                    </td>
                    <td class="px-4 py-2.5 text-white font-semibold">
                      #{e.articleId}
                    </td>
                    <td class="px-4 py-2.5 text-slate-300 max-w-[200px] truncate" title={e.id}>
                      {e.id}
                    </td>
                    <td class="px-4 py-2.5 text-slate-300 font-sans">
                      {e.modelName}
                    </td>
                    <td class="px-4 py-2.5 text-center">
                      <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-bold border ${statusColor}`}>
                        {e.status}
                      </span>
                    </td>
                    <td class="px-4 py-2.5 text-center font-bold text-white">
                      {e.neuronsEstimated ? `${e.neuronsEstimated.toLocaleString()} N` : '0 N'}
                    </td>
                    <td class="px-4 py-2.5 text-center">
                      <span class="px-1.5 py-0.5 rounded text-[10px] bg-slate-800 text-amber-300 border border-slate-700">
                        {e.authoritativeSource}
                      </span>
                    </td>
                    <td class="px-4 py-2.5 text-right text-slate-400">
                      {e.latencyMs ? `${e.latencyMs} ms` : '-'}
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    // Live countdown to next reset at 00:00:00 UTC
    function updateResetCountdown() {
      const el = document.getElementById('reset-timer');
      if (!el) return;
      const targetStr = el.getAttribute('data-reset-utc');
      if (!targetStr) return;

      const target = new Date(targetStr).getTime();
      const now = Date.now();
      const diff = Math.max(0, target - now);

      const hours = Math.floor(diff / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);

      el.textContent = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')} UTC`;
    }

    setInterval(updateResetCountdown, 1000);
    updateResetCountdown();

    // Guard config form handler
    const form = document.getElementById('guard-config-form');
    const msg = document.getElementById('guard-save-msg');
    const btnSave = document.getElementById('btn-save-guard');

    if (form && msg && btnSave) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        btnSave.setAttribute('disabled', 'true');
        btnSave.textContent = 'Menyimpan...';

        const customDailyLimit = Number((document.getElementById('custom-limit') as HTMLInputElement)?.value || 10000);
        const warningThresholdPercent = Number((document.getElementById('warning-threshold') as HTMLInputElement)?.value || 70);
        const highWarningThresholdPercent = Number((document.getElementById('high-warning-threshold') as HTMLInputElement)?.value || 90);

        try {
          const res = await fetch('/api/admin/media/neurons-usage', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              custom_daily_limit: customDailyLimit,
              warning_threshold_percent: warningThresholdPercent,
              high_warning_threshold_percent: highWarningThresholdPercent,
              allow_paid_usage: false
            })
          });

          const data = await res.json();
          if (res.ok && data.status === 'ok') {
            msg.className = 'mt-3 p-2.5 rounded-lg text-xs font-medium text-center bg-emerald-500/10 text-emerald-400 border border-emerald-500/20';
            msg.textContent = '✓ Pengaturan budget guard berhasil disimpan!';
            msg.classList.remove('hidden');
            setTimeout(() => window.location.reload(), 1000);
          } else {
            msg.className = 'mt-3 p-2.5 rounded-lg text-xs font-medium text-center bg-rose-500/10 text-rose-400 border border-rose-500/20';
            msg.textContent = data.message || 'Gagal menyimpan pengaturan.';
            msg.classList.remove('hidden');
          }
        } catch (err: any) {
          msg.className = 'mt-3 p-2.5 rounded-lg text-xs font-medium text-center bg-rose-500/10 text-rose-400 border border-rose-500/20';
          msg.textContent = err.message || 'Kesalahan jaringan.';
          msg.classList.remove('hidden');
        } finally {
          btnSave.removeAttribute('disabled');
          btnSave.textContent = 'Simpan Pengaturan';
        }
      });
    }

    // Recalculate button handler
    const btnRecalc = document.getElementById('btn-recalculate');
    if (btnRecalc) {
      btnRecalc.addEventListener('click', () => {
        window.location.reload();
      });
    }
  </script>
</AdminLayout>
