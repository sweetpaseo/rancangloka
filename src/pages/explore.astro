---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getDb, getAllArticles, getAllCategories, getSiteSettings } from '../lib/db';
import { getResponsiveImageAttrs } from '../lib/image';

const db = await getDb(Astro.locals);
const [allArticles, categories, siteSettings] = await Promise.all([
  getAllArticles(db, 60, 0, 'published'),
  getAllCategories(db),
  getSiteSettings(db)
]);

const currentCategorySlug = Astro.url.searchParams.get('category') || '';
const searchQuery = (Astro.url.searchParams.get('q') || '').toLowerCase().trim();

let displayedArticles = allArticles;

if (currentCategorySlug) {
  displayedArticles = displayedArticles.filter((a) => a.category_slug === currentCategorySlug);
}

if (searchQuery) {
  displayedArticles = displayedArticles.filter((a) => {
    const titleMatch = a.title.toLowerCase().includes(searchQuery);
    const descMatch = (a.description || '').toLowerCase().includes(searchQuery);
    return titleMatch || descMatch;
  });
}

const breadcrumbItems = [
  { name: 'Beranda', url: '/' },
  { name: 'Eksplorasi Arsip', url: '/explore' }
];

function getSafeImage(url?: string, idx = 0) {
  if (url && url.length > 5 && !url.includes('[object')) return url;
  const fallbacks = [
    'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&auto=format&fit=crop&q=80',
    'https://images.unsplash.com/photo-1556911220-e15b29be8c8f?w=800&auto=format&fit=crop&q=80',
    'https://images.unsplash.com/photo-1616594039964-ae9021a400a0?w=800&auto=format&fit=crop&q=80',
    'https://images.unsplash.com/photo-1598928506311-c55ded91a20c?w=800&auto=format&fit=crop&q=80'
  ];
  return fallbacks[idx % fallbacks.length];
}
---

<BaseLayout
  title="Eksplorasi Seluruh Kajian & Panduan Hunian"
  description="Telusuri seluruh artikel, panduan perbaikan, dan komparasi spesifikasi material bangunan untuk rumah di Indonesia."
  categories={categories}
  siteSettings={siteSettings}
>
  <div class="editorial-container py-8 md:py-12">
    <!-- 1. Breadcrumbs -->
    <div class="crumb mb-6">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <!-- 2. Explore Lead (Atlas T03) -->
    <header class="page-hero mb-8">
      <span class="eyebrow">Arsip & Eksplorasi</span>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-normal text-[var(--ink)] leading-[1.12] my-3">
        Jelajahi Seluruh Tulisan
      </h1>
      <p class="text-base sm:text-lg text-[var(--muted)] leading-relaxed max-w-[720px]">
        Kumpulan panduan teknis, kajian material bangunan, dan inspirasi tata ruang yang disusun independen untuk pemilik rumah di Indonesia.
      </p>
    </header>

    <!-- 3. Filter & Category Chips -->
    <div class="chips my-6">
      <b>Filter:</b>
      <a
        href="/explore"
        class={!currentCategorySlug ? 'selected' : ''}
      >
        Semua Topik ({allArticles.length})
      </a>
      {categories.map((c) => (
        <a
          href={`/explore?category=${c.slug}`}
          class={currentCategorySlug === c.slug ? 'selected' : ''}
        >
          {c.name}
        </a>
      ))}
      <a href="/solusi" class="font-bold text-[var(--primary)] border-[var(--lemon)]">✦ Problem Solver</a>
      <a href="/komparasi">Tabel Komparasi</a>
    </div>

    <!-- 4. Result Count & Active Filter Notice -->
    <div class="flex items-center justify-between text-xs text-[var(--muted)] pb-4 border-b border-[var(--line)] mb-8">
      <div>
        Menampilkan <b class="text-[var(--ink)]">{displayedArticles.length}</b> artikel
        {currentCategorySlug && <span> dalam kategori <b class="text-[var(--primary)]">{currentCategorySlug}</b></span>}
        {searchQuery && <span> dengan kata kunci "<b class="text-[var(--primary)]">{searchQuery}</b>"</span>}
      </div>
      {(currentCategorySlug || searchQuery) && (
        <a href="/explore" class="text-[var(--primary)] font-bold hover:underline">
          Reset Filter ✕
        </a>
      )}
    </div>

    <!-- 5. Articles Grid (Atlas T03 Story Cards) -->
    {displayedArticles.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-8">
        {displayedArticles.map((art, idx) => {
          const rawImg = getSafeImage(art.featured_image, idx);
          const cardAttrs = getResponsiveImageAttrs(rawImg, art.image_alt || art.title, { slotType: 'card' });
          return (
            <a class="story group" href={`/${art.slug}`} aria-label={art.title}>
              {cardAttrs && (
                <div class="story-img">
                  <img
                    src={cardAttrs.src}
                    srcset={cardAttrs.srcset}
                    sizes={cardAttrs.sizes}
                    alt={cardAttrs.alt}
                    width={cardAttrs.width}
                    height={cardAttrs.height}
                    loading="lazy"
                    decoding="async"
                    style={cardAttrs.style}
                  />
                </div>
              )}
              <div class="story-pad">
                <span class="meta">{art.category_name || 'KAJIAN'}</span>
                <h3>{art.title}</h3>
                <p>{art.description || 'Kajian teknis dan panduan praktis untuk kenyamanan rumah tinggal.'}</p>
                <small>{art.reading_time_minutes || 5} menit baca · Redaksi</small>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <!-- Empty State -->
      <div class="my-14 p-10 text-center rounded-lg bg-[var(--warm)] border border-[var(--line)] max-w-lg mx-auto">
        <span class="text-3xl block mb-3">📰</span>
        <h3 class="font-serif text-xl font-bold text-[var(--ink)] mb-2">
          Tidak ada artikel yang cocok
        </h3>
        <p class="text-sm text-[var(--muted)] mb-6">
          Tidak ditemukan artikel dengan kriteria filter saat ini.
        </p>
        <a href="/explore" class="btn">
          Lihat Seluruh Artikel
        </a>
      </div>
    )}
  </div>
</BaseLayout>
