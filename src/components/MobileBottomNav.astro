---
// Apple Floating Dock Style Mobile Bottom Navigation Bar (Thumb Zone)
interface Props {
  isArticlePage?: boolean;
}
const { isArticlePage = false } = Astro.props;
---

<div class="fixed inset-x-0 bottom-3 z-50 flex justify-center px-4 md:hidden pointer-events-none">
  <nav class="pointer-events-auto flex h-14 items-center justify-around gap-6 rounded-full apple-glass px-6 shadow-[0_12px_36px_rgba(0,0,0,0.12)] dark:shadow-[0_12px_36px_rgba(0,0,0,0.5)] transition-transform">
    <!-- 1. Home -->
    <a href="/" class="flex flex-col items-center justify-center gap-0.5 text-slate-700 hover:text-[#0071e3] dark:text-slate-300 dark:hover:text-white transition">
      <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span class="text-[9px] font-semibold tracking-tight">Beranda</span>
    </a>

    <!-- 2. Search Trigger -->
    <button data-search-trigger class="flex flex-col items-center justify-center gap-0.5 text-slate-700 hover:text-[#0071e3] dark:text-slate-300 dark:hover:text-white transition">
      <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <span class="text-[9px] font-semibold tracking-tight">Cari</span>
    </button>

    {isArticlePage ? (
      <!-- 3. Quick Share on Article Pages -->
      <button id="mobile-quick-share" class="flex flex-col items-center justify-center gap-0.5 text-[#0071e3] font-bold transition">
        <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
        <span class="text-[9px]">Bagikan</span>
      </button>
    ) : (
      <!-- 3. Dark Mode Toggle -->
      <button class="theme-toggle-btn flex flex-col items-center justify-center gap-0.5 text-slate-700 hover:text-[#0071e3] dark:text-slate-300 dark:hover:text-white transition">
        <svg class="h-4.5 w-4.5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="h-4.5 w-4.5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <span class="text-[9px] font-semibold tracking-tight">Tema</span>
      </button>
    )}
  </nav>
</div>

<script>
  // Mobile Quick Share Native Web Share API
  const shareBtn = document.getElementById('mobile-quick-share');
  if (shareBtn) {
    shareBtn.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({
            title: document.title,
            url: window.location.href
          });
        } catch (err) {}
      } else {
        await navigator.clipboard.writeText(window.location.href);
        alert('Tautan artikel berhasil disalin ke clipboard!');
      }
    });
  }
</script>
