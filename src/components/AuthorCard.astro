---
import type { Author } from '../lib/db';

interface Props {
  author?: Author;
  authorName?: string;
  authorAvatar?: string;
  authorRole?: string;
}

const { author, authorName, authorAvatar, authorRole } = Astro.props;
const name = author?.name || authorName || 'Redaksi Utama';
const avatar = author?.avatar || authorAvatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80';
const role = author?.role || authorRole || 'Senior Editor';
const bio = author?.bio || 'Jurnalis dan analis konten arsitektur yang berdedikasi menyajikan kurasi desain akurat, mendalam, dan terpercaya.';

let socialLinks: Record<string, string> = {};
if (author?.social_links) {
  try {
    socialLinks = JSON.parse(author.social_links);
  } catch (e) {}
}
---

<div class="my-12 rounded-[2rem] border border-black/[0.06] bg-slate-50/70 p-7 sm:p-8 dark:border-white/[0.08] dark:bg-slate-900/60 backdrop-blur-md shadow-sm transition">
  <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5 sm:gap-6">
    <div class="relative flex-shrink-0">
      <img
        src={avatar}
        alt={name}
        class="h-20 w-20 sm:h-22 sm:w-22 rounded-full object-cover ring-4 ring-white dark:ring-slate-800 shadow-md"
        loading="lazy"
      />
      <span class="absolute bottom-0 right-0 rounded-full bg-emerald-500 p-1 text-white ring-2 ring-white dark:ring-slate-900" title="Penulis Terverifikasi">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
        </svg>
      </span>
    </div>

    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-[#c46849] block mb-0.5">
            Dewan Editorial & Penulis
          </span>
          <h3 class="text-lg sm:text-xl font-black text-slate-900 dark:text-white tracking-tight">{name}</h3>
          <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">{role}</p>
        </div>

        {Object.keys(socialLinks).length > 0 && (
          <div class="flex items-center gap-2 text-slate-500">
            {socialLinks.twitter && (
              <a href={socialLinks.twitter} target="_blank" rel="noopener noreferrer" class="rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-2 text-xs font-semibold hover:text-[#c46849] hover:border-blue-300 transition shadow-2xs" aria-label="Twitter">
                𝕏
              </a>
            )}
            {socialLinks.linkedin && (
              <a href={socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-2 text-xs font-semibold hover:text-[#c46849] hover:border-blue-300 transition shadow-2xs" aria-label="LinkedIn">
                in
              </a>
            )}
          </div>
        )}
      </div>

      <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
        {bio}
      </p>
    </div>
  </div>
</div>
