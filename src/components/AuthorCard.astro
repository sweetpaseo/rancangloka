---
import type { Author } from '../lib/db';

interface Props {
  author?: Author;
  authorName?: string;
  authorAvatar?: string;
  authorRole?: string;
}

const { author, authorName, authorAvatar, authorRole } = Astro.props;
const name = author?.name || authorName || 'Redaksi Utama';
const avatar = author?.avatar || authorAvatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80';
const role = author?.role || authorRole || 'Senior Editor';
const bio = author?.bio || 'Jurnalis dan analis konten yang berdedikasi menyajikan berita akurat, mendalam, dan terpercaya.';

let socialLinks: Record<string, string> = {};
if (author?.social_links) {
  try {
    socialLinks = JSON.parse(author.social_links);
  } catch (e) {}
}
---

<div class="my-8 rounded-2xl border border-slate-200 bg-slate-50/60 p-5 dark:border-slate-800 dark:bg-slate-900/60 transition">
  <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
    <img
      src={avatar}
      alt={name}
      class="h-16 w-16 rounded-full object-cover ring-2 ring-primary/20 flex-shrink-0"
      loading="lazy"
    />
    <div class="flex-1">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">{name}</h3>
          <p class="text-xs font-semibold text-primary uppercase tracking-wider">{role}</p>
        </div>

        {Object.keys(socialLinks).length > 0 && (
          <div class="flex items-center gap-2 text-slate-400">
            {socialLinks.twitter && (
              <a href={socialLinks.twitter} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition" aria-label="Twitter">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 24.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            )}
            {socialLinks.linkedin && (
              <a href={socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition" aria-label="LinkedIn">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              </a>
            )}
          </div>
        )}
      </div>
      <p class="mt-2 text-xs md:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        {bio}
      </p>
    </div>
  </div>
</div>
