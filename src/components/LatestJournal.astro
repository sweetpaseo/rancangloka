---
import type { Article } from '../lib/db';

interface Props {
  articles: Article[];
}

const { articles = [] } = Astro.props;
const featured = articles[0];
const secondary = articles.slice(1, 3);

function getImg(url?: string, width = 840) {
  if (!url) return 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=840&auto=format&fit=crop&q=80&fm=webp';
  if (url.includes('images.unsplash.com')) {
    const base = url.split('?')[0];
    return `${base}?w=${width}&auto=format&fit=crop&q=80&fm=webp`;
  }
  return url;
}
---

<section class="w-full py-16 md:py-24 border-b border-stone dark:border-stone/20">
  <div class="mx-auto max-w-[1280px]">
    <!-- Section Header -->
    <div class="flex items-end justify-between mb-10 pb-4 border-b border-stone dark:border-stone/20">
      <div>
        <span class="text-[11px] font-mono font-bold uppercase tracking-[0.14em] text-muted dark:text-stone block mb-1">
          LATEST JOURNAL
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl text-ink dark:text-paper font-normal">
          Recent Architectural Studies
        </h2>
      </div>
      <a
        href="/explore"
        class="text-xs font-mono font-semibold uppercase tracking-wider text-ink dark:text-paper hover:text-accent flex items-center gap-1.5"
      >
        <span>Lihat Semua Arsip</span>
        <span>→</span>
      </a>
    </div>

    <!-- 1 + 2 Asymmetric Editorial Grid (Featured 66% + Secondary 33%) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12">
      <!-- 1. Featured Article (Col 1-8: ~66.67%) -->
      {featured && (
        <div class="lg:col-span-8 group">
          <a href={`/${featured.slug}`} class="block overflow-hidden bg-stone/20 aspect-[16/10] mb-6">
            <img
              src={getImg(featured.featured_image, 840)}
              alt={featured.image_alt || featured.title}
              width="840"
              height="520"
              class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.015]"
              loading="lazy"
              decoding="async"
            />
          </a>

          <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-widest text-muted dark:text-stone mb-3">
            <span>{featured.category_name || 'MATERIAL'}</span>
            <span>·</span>
            <span>⏱️ {featured.reading_time_minutes || 5} MIN</span>
          </div>

          <h3 class="font-serif text-2xl sm:text-3xl md:text-4xl font-normal text-ink dark:text-paper leading-tight group-hover:text-accent transition-colors mb-3">
            <a href={`/${featured.slug}`}>{featured.title}</a>
          </h3>

          {featured.description && (
            <p class="text-sm md:text-base leading-relaxed text-muted dark:text-stone/90 line-clamp-2 max-w-2xl">
              {featured.description}
            </p>
          )}
        </div>
      )}

      <!-- 2. Secondary Column (Col 9-12: ~33.33%) -->
      <div class="lg:col-span-4 flex flex-col justify-between divide-y divide-stone dark:divide-stone/20">
        {secondary.map((art, idx) => (
          <div class={`group ${idx === 0 ? 'pb-8' : 'pt-8'}`}>
            <a href={`/${art.slug}`} class="block overflow-hidden bg-stone/20 aspect-[16/10] mb-4">
              <img
                src={getImg(art.featured_image, 480)}
                alt={art.image_alt || art.title}
                width="480"
                height="300"
                class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.015]"
                loading="lazy"
                decoding="async"
              />
            </a>

            <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-widest text-muted dark:text-stone mb-2">
              <span>{art.category_name || 'ARCHITECTURE'}</span>
              <span>·</span>
              <span>{art.reading_time_minutes || 4} MIN</span>
            </div>

            <h4 class="font-serif text-xl sm:text-2xl font-normal text-ink dark:text-paper leading-snug group-hover:text-accent transition-colors">
              <a href={`/${art.slug}`}>{art.title}</a>
            </h4>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
