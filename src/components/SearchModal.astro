---
// Instant Search Modal Component with Trending Tags
---

<div id="search-modal" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-md transition-opacity">
  <div class="fixed inset-x-4 top-16 mx-auto max-w-2xl rounded-3xl bg-white p-5 shadow-2xl ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800 md:top-24">
    <!-- Header / Input -->
    <div class="flex items-center gap-3 border-b border-slate-100 pb-3.5 dark:border-slate-800">
      <svg class="h-5 w-5 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="search-input"
        type="text"
        placeholder="Cari ide desain, arsitektur, material, atau produk..."
        class="w-full bg-transparent text-sm sm:text-base text-slate-900 placeholder-slate-400 focus:outline-none dark:text-slate-100"
        autocomplete="off"
      />
      <button id="close-search-btn" class="rounded-xl p-2 text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition" aria-label="Tutup Pencarian">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Search Results / Initial Trending Suggestions Container -->
    <div id="search-results" class="mt-4 max-h-96 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800">
      <!-- Default Trending Screen -->
      <div id="search-default-view" class="py-2 space-y-4">
        <div>
          <span class="text-[11px] font-mono font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 block mb-2.5">
            ✦ Eksplorasi Berdasarkan Kebutuhan
          </span>
          <div class="flex flex-wrap gap-2">
            {['Rumah Panas', 'Kamar Sempit', 'Kurang Cahaya', 'Secondary Skin', 'Kusen Aluminium', 'Japandi', 'Ventilasi Silang', 'Otomasi Energi'].map((tag) => (
              <button
                type="button"
                class="search-tag-pill rounded-full bg-slate-100 dark:bg-slate-800 px-3.5 py-1.5 text-xs font-mono font-semibold text-slate-700 dark:text-slate-300 hover:bg-[#0071e3] hover:text-white dark:hover:bg-[#0071e3] transition border border-black/[0.04] dark:border-white/[0.06]"
                data-keyword={tag}
              >
                {tag}
              </button>
            ))}
          </div>
        </div>

        <div class="pt-3 border-t border-slate-100 dark:border-slate-800">
          <span class="text-[11px] font-mono font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 block mb-2">
            ✦ Panduan Pencarian
          </span>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed font-normal">
            Cari solusi spesifik seperti <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-[#0071e3] font-mono">rumah panas</code>, <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-[#0071e3] font-mono">louver aluminium</code>, atau <code class="bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded text-[#0071e3] font-mono">efek cerobong</code> untuk hasil kurasi spasial presisi.
          </p>
        </div>
      </div>

      <!-- Live Search Results (Injected via JS) -->
      <div id="search-live-results" class="hidden"></div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('search-modal');
  const input = document.getElementById('search-input') as HTMLInputElement;
  const defaultView = document.getElementById('search-default-view');
  const liveResults = document.getElementById('search-live-results');
  const closeBtn = document.getElementById('close-search-btn');

  function openSearch() {
    if (modal && input) {
      modal.classList.remove('hidden');
      input.focus();
    }
  }

  function closeSearch() {
    if (modal) {
      modal.classList.add('hidden');
      if (input) input.value = '';
      if (defaultView) defaultView.classList.remove('hidden');
      if (liveResults) {
        liveResults.classList.add('hidden');
        liveResults.innerHTML = '';
      }
    }
  }

  // Trigger buttons
  document.querySelectorAll('[data-search-trigger]').forEach(btn => {
    btn.addEventListener('click', openSearch);
  });

  closeBtn?.addEventListener('click', closeSearch);

  // Close on backdrop click
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeSearch();
  });

  // Close on Escape & ⌘K shortcut
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSearch();
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
  });

  // Tag pills click handler
  document.querySelectorAll('.search-tag-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      const keyword = pill.getAttribute('data-keyword');
      if (input && keyword) {
        input.value = keyword;
        triggerSearch(keyword);
      }
    });
  });

  // Search input handler with debounce
  let timeout: any;
  input?.addEventListener('input', () => {
    clearTimeout(timeout);
    const query = input.value.trim();
    if (!query) {
      if (defaultView) defaultView.classList.remove('hidden');
      if (liveResults) {
        liveResults.classList.add('hidden');
        liveResults.innerHTML = '';
      }
      return;
    }

    timeout = setTimeout(() => triggerSearch(query), 200);
  });

  async function triggerSearch(query: string) {
    if (!liveResults || !defaultView) return;
    defaultView.classList.add('hidden');
    liveResults.classList.remove('hidden');
    liveResults.innerHTML = '<p class="py-6 text-center text-xs text-slate-400 animate-pulse">Mencari kurasi artikel...</p>';

    try {
      const res = await fetch(`/api/search.json?q=${encodeURIComponent(query)}`);
      const articles = await res.json();

      if (!articles || articles.length === 0) {
        liveResults.innerHTML = '<div class="py-8 text-center"><span class="text-2xl block mb-2">🔍</span><p class="text-xs font-semibold text-slate-500">Tidak ada artikel yang cocok dengan kata kunci tersebut.</p></div>';
        return;
      }

      liveResults.innerHTML = `
        <div class="py-2 space-y-2">
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-2">
            Hasil Pencarian (${articles.length})
          </span>
          ${articles.map((a: any) => `
            <a href="/${a.slug}" class="flex items-center gap-3.5 p-2.5 rounded-2xl hover:bg-slate-50 dark:hover:bg-slate-800/60 transition group">
              <img src="${a.featured_image || 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=150'}" alt="${a.title}" class="h-12 w-14 rounded-xl object-cover flex-shrink-0 bg-slate-100" />
              <div class="flex-1 min-w-0">
                <span class="text-[10px] font-bold text-primary uppercase">${a.category_name || 'Artikel'}</span>
                <h4 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white truncate group-hover:text-primary transition">${a.title}</h4>
                <p class="text-[11px] text-slate-500 truncate">${a.description || ''}</p>
              </div>
              <span class="text-xs text-slate-400 group-hover:translate-x-1 transition-transform">→</span>
            </a>
          `).join('')}
        </div>
      `;
    } catch (e) {
      liveResults.innerHTML = '<p class="py-6 text-center text-xs text-red-500">Gagal memuat hasil pencarian.</p>';
    }
  }
</script>
