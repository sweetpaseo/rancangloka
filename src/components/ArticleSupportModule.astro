---
import type { ResolvedPlaneALink } from '../lib/internal-link/types.ts';
import { getCanonicalThumbnailUrl } from '../lib/image.ts';

interface Props {
  links?: ResolvedPlaneALink[];
}

const { links = [] } = Astro.props;

if (!links || links.length === 0) {
  // If no meaningful active relationships exist: render nothing. No empty box.
  return null;
}
---

<section class="my-10 border border-stone/30 dark:border-stone/20 bg-[#faf9f6] dark:bg-[#18181b]/50 p-6 sm:p-8">
  <div class="flex items-center gap-2 mb-3 text-xs font-mono font-bold uppercase tracking-[0.14em] text-accent">
    <span>🧭</span>
    <span>Artikel Pendukung untuk Keputusan Ini</span>
  </div>
  <p class="text-xs sm:text-sm text-muted dark:text-stone/80 mb-6 leading-relaxed font-normal">
    Teruskan pertimbangan desain Anda berdasarkan kondisi nyata dan kebutuhan ruang rumah:
  </p>

  <div class="space-y-5">
    {links.map((link) => {
      const thumbUrl = getCanonicalThumbnailUrl(link.target_featured_image);
      return (
        <article class="border-b border-stone/20 dark:border-stone/10 pb-5 last:border-b-0 last:pb-0">
          <div class="flex items-start gap-3.5 sm:gap-4">
            {thumbUrl && (
              <a
                href={`/${link.target_slug}`}
                tabindex="-1"
                aria-hidden="true"
                class="shrink-0 block w-14 h-14 sm:w-20 sm:h-20 aspect-square overflow-hidden rounded-md bg-stone-100 dark:bg-stone-800 border border-stone-200/60 dark:border-stone-700/60 transition opacity-95 hover:opacity-100 group"
              >
                <img
                  src={thumbUrl}
                  alt=""
                  width="80"
                  height="80"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-105"
                />
              </a>
            )}
            <div class="flex-1 min-w-0">
              <h3 class="text-sm sm:text-base font-semibold text-ink dark:text-paper leading-snug mb-1">
                <a
                  href={`/${link.target_slug}`}
                  class="hover:text-primary transition underline underline-offset-4 decoration-stone/40 hover:decoration-primary"
                >
                  {link.target_title}
                </a>
              </h3>
              {link.target_excerpt && (
                <p class="text-xs sm:text-sm text-muted dark:text-stone/80 font-normal leading-relaxed mb-2 line-clamp-2 sm:line-clamp-3">
                  {link.target_excerpt}
                </p>
              )}
              <div class="flex items-center gap-3 text-[11px] font-mono text-muted dark:text-stone/60">
                <span class="uppercase tracking-wider">{link.relationship_type.replace(/_/g, ' ')}</span>
                {link.target_reading_time_minutes && (
                  <span>• {link.target_reading_time_minutes} min read</span>
                )}
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>
