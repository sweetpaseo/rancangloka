---
import type { Article, Category } from '../lib/db';

interface Props {
  category: Category;
  articles: Article[];
}

const { category, articles = [] } = Astro.props;
if (articles.length === 0) return null;
const leadArticle = articles[0];
const subArticles = articles.slice(1, 4);
---

<section class="my-14">
  <!-- Section Title with Apple-style Pill & Clean Action -->
  <div class="mb-7 flex items-center justify-between border-b border-black/[0.05] dark:border-white/[0.08] pb-3.5">
    <div class="flex items-center gap-3">
      <span class="h-6 w-2 rounded-full" style={`background-color: ${category.color_badge || '#059669'};`}></span>
      <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        {category.name}
      </h2>
    </div>
    <a
      href={`/category/${category.slug}`}
      class="text-xs font-semibold tracking-wide text-[#0071e3] hover:underline flex items-center gap-1 group"
    >
      Lihat Semua <span class="transition-transform group-hover:translate-x-0.5">→</span>
    </a>
  </div>

  <!-- Apple Bento Grid (6 cols Big + 6 cols 3-Stacked) -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
    <!-- Big Bento Card (6 cols) -->
    {leadArticle && (
      <div class="md:col-span-6">
        <article class="apple-card group flex flex-col h-full overflow-hidden">
          <a href={`/${leadArticle.slug}`} class="relative block overflow-hidden aspect-[16/10] bg-slate-100 dark:bg-slate-800">
            <img
              src={leadArticle.featured_image}
              alt={leadArticle.image_alt || leadArticle.title}
              class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
          </a>
          <div class="flex flex-1 flex-col p-6 sm:p-7">
            <h3 class="text-lg sm:text-xl font-bold tracking-tight text-slate-900 dark:text-white group-hover:text-[#0071e3] transition-colors line-clamp-2">
              <a href={`/${leadArticle.slug}`}>
                {leadArticle.title}
              </a>
            </h3>
            <p class="mt-2.5 text-xs sm:text-sm text-slate-500 dark:text-slate-400 line-clamp-3 flex-1 leading-relaxed">
              {leadArticle.description}
            </p>
            <div class="mt-5 flex items-center justify-between text-xs text-slate-400 border-t border-black/[0.04] dark:border-white/[0.06] pt-4">
              <span class="font-medium">{leadArticle.author_name || 'Redaksi'}</span>
              <span>⏱️ {leadArticle.reading_time_minutes} min read</span>
            </div>
          </div>
        </article>
      </div>
    )}

    <!-- 3 Stacked Side Cards (6 cols) -->
    <div class="md:col-span-6 flex flex-col justify-between gap-4">
      {subArticles.map((article) => (
        <article class="apple-card group flex items-center gap-4 p-4">
          <a href={`/${article.slug}`} class="relative block h-20 w-24 sm:h-24 sm:w-32 flex-shrink-0 overflow-hidden rounded-2xl bg-slate-100 dark:bg-slate-800">
            <img
              src={article.featured_image}
              alt={article.image_alt || article.title}
              class="h-full w-full object-cover transition duration-500 ease-out group-hover:scale-108"
              loading="lazy"
            />
          </a>
          <div class="flex flex-1 flex-col justify-center min-w-0">
            <h4 class="text-xs sm:text-sm font-bold tracking-tight text-slate-900 dark:text-white line-clamp-2 group-hover:text-[#0071e3] transition-colors leading-snug">
              <a href={`/${article.slug}`}>
                {article.title}
              </a>
            </h4>
            <div class="mt-2 flex items-center gap-2 text-[11px] text-slate-400">
              <span class="truncate">{article.author_name || 'Redaksi'}</span>
              <span>•</span>
              <span class="whitespace-nowrap">⏱️ {article.reading_time_minutes}m</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
