---
interface Props {
  className?: string;
}

const topics = [
  {
    title: 'Rekayasa Fasad Barat & Termal',
    img: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=64&fm=webp&auto=format&fit=crop&q=55',
    link: '/solusi?q=panas'
  },
  {
    title: 'Efek Cerobong Void Vertikal',
    img: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=64&fm=webp&auto=format&fit=crop&q=55',
    link: '/solusi?q=ventilasi'
  },
  {
    title: 'Komparasi Kayu Ulin vs Jati',
    img: 'https://images.unsplash.com/photo-1513694203232-719a280e022f?w=64&fm=webp&auto=format&fit=crop&q=55',
    link: '/komparasi'
  },
  {
    title: 'Optimalisasi Lahan Sempit 36/60',
    img: 'https://images.unsplash.com/photo-1507089947368-19c1da9775ae?w=64&fm=webp&auto=format&fit=crop&q=55',
    link: '/solusi?q=sempit'
  }
];
---

<div class="w-full bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 py-3">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex items-center gap-3 overflow-x-auto no-scrollbar">
    <span class="text-xs font-bold text-[#003366] dark:text-blue-400 whitespace-nowrap flex-shrink-0">
      Topik Pilihan:
    </span>

    <div class="flex items-center gap-3">
      {topics.map((t) => (
        <a
          href={t.link}
          class="flex items-center gap-2.5 p-1 pr-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-md hover:border-[#003366] dark:hover:border-blue-400 transition flex-shrink-0 group"
        >
          <img
            src={t.img}
            alt={t.title}
            class="h-8 w-8 rounded object-cover"
            loading="lazy"
          />
          <span class="text-xs font-medium text-slate-800 dark:text-slate-200 group-hover:text-[#003366] dark:group-hover:text-blue-400 whitespace-nowrap">
            {t.title}
          </span>
        </a>
      ))}
    </div>
  </div>
</div>
