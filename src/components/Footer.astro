---
interface Props {
  siteTitle?: string;
  copyright?: string;
}

const {
  siteTitle = 'RANCANGLOKA',
  copyright = '© 2026 RancangLoka. All rights reserved. Publikasi editorial independen arsitektur dan hunian tropis.'
} = Astro.props;
---

<footer class="w-full bg-ink text-paper py-16 md:py-20 border-t border-ink">
  <div class="mx-auto max-w-[1280px] px-5 sm:px-8 lg:px-12 grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-8">
    <!-- Col 1: Brand Manifesto (Col 1-6) -->
    <div class="md:col-span-6 space-y-4">
      <div class="flex items-center gap-3">
        <span class="flex h-6 w-6 items-center justify-center bg-paper text-ink font-sans font-bold text-xs tracking-tight">
          R
        </span>
        <span class="font-sans font-bold text-sm md:text-base tracking-[0.1em] uppercase text-paper">
          {siteTitle}
        </span>
      </div>

      <p class="text-xs md:text-sm text-paper/70 font-normal leading-relaxed max-w-md">
        Jurnal kurasi independen arsitektur tropis, materialitas presisi, dan rekayasa spasial hunian di Indonesia.
      </p>

      <p class="text-[11px] font-mono text-paper/40 pt-4">
        {copyright}
      </p>
    </div>

    <!-- Col 2: Explore Hub (Col 7-9) -->
    <div class="md:col-span-3 space-y-3">
      <h4 class="text-[11px] font-mono font-bold uppercase tracking-[0.14em] text-accent">
        EXPLORE
      </h4>
      <ul class="space-y-2 text-xs font-mono text-paper/80">
        <li><a href="/" class="hover:text-paper transition">Journal</a></li>
        <li><a href="/explore" class="hover:text-paper transition">Article Archive</a></li>
        <li><a href="/komparasi" class="hover:text-paper transition">Material Index</a></li>
        <li><a href="/solusi" class="hover:text-paper transition">Problem Solver</a></li>
        <li><a href="/rss.xml" class="hover:text-paper transition">RSS Feed</a></li>
        <li><a href="/sitemap.xml" class="hover:text-paper transition">Sitemap Index</a></li>
      </ul>
    </div>

    <!-- Col 3: Editorial & Integrity (Col 10-12) -->
    <div class="md:col-span-3 space-y-3">
      <h4 class="text-[11px] font-mono font-bold uppercase tracking-[0.14em] text-accent">
        ABOUT & REDAKSI
      </h4>
      <ul class="space-y-2 text-xs font-mono text-paper/80">
        <li><a href="/editorial-standards" class="hover:text-paper transition">✦ Standar Editorial</a></li>
        <li><a href="/metodologi" class="hover:text-paper transition">✦ Metodologi Riset</a></li>
        <li><a href="/tentang-kami" class="hover:text-paper transition">Tentang Kami</a></li>
        <li><a href="/kontak" class="hover:text-paper transition">Hubungi Redaksi</a></li>
        <li><a href="/pedoman-media-siber" class="hover:text-paper transition">Pedoman Media Siber</a></li>
        <li><a href="/kebijakan-privasi" class="hover:text-paper transition">Kebijakan Privasi</a></li>
      </ul>
    </div>
  </div>
</footer>
