---
interface Props {
  siteTitle?: string;
  copyright?: string;
}

const {
  siteTitle = 'RancangLoka.',
  copyright = '© 2026 RancangLoka. Media arsitektur, hunian, dan material bangunan independen Indonesia.'
} = Astro.props;
---

<footer class="w-full bg-[var(--footer)] text-[var(--footer-ink)] pt-8 pb-7 md:pt-12 md:pb-10 lg:pt-14 lg:pb-12 border-t-4 border-[var(--lemon)]">
  <div class="editorial-container px-4.5 sm:px-6">
    <!-- Top Grid: Mobile flex-col with 2-col nav grid, Desktop 12-col unified layout -->
    <div class="flex flex-col lg:grid lg:grid-cols-12 gap-7 md:gap-8 lg:gap-10 pb-7 md:pb-10 border-b border-[var(--footer-line)]">
      <!-- Col 1: Brand & Manifesto (Full width on mobile, 5 cols on lg) -->
      <div class="lg:col-span-5 space-y-3 md:space-y-3.5">
        <a href="/" class="flex items-center gap-2.5 group inline-flex" aria-label="RancangLoka">
          <span class="grid place-items-center w-7 h-7 rounded-md border border-[var(--lemon)] -rotate-6 bg-[var(--surface)] text-[var(--primary)] shadow-xs" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.7" stroke-linejoin="round" class="w-4 h-4 rotate-6">
              <path d="M2 16 16 4l14 12M8 13v15h16V13M13 28V17h7v11" />
            </svg>
          </span>
          <span class="font-brand text-2xl font-black tracking-tight text-white">
            {siteTitle}
          </span>
        </a>

        <p class="text-[13px] md:text-sm text-[#EBE1B7] leading-relaxed max-w-sm">
          Media arsitektur dan hunian yang berbicara dengan bahasa orang rumah, tetapi berpikir seperti editor yang paham teknis.
        </p>

        <p class="text-[11.5px] md:text-xs text-[#D8CE9F] leading-relaxed max-w-sm pt-0.5">
          Setiap panduan disusun dengan prinsip <span class="text-white font-semibold">Evidence-First</span> dan <span class="text-white font-semibold">Monetary Silence</span>: tanpa klaim kosong dan tanpa estimasi harga fiktif.
        </p>
      </div>

      <!-- Navigation Grid: Two columns on mobile (320px–767px), 3 columns on tablet (768px-1023px), 7 cols on lg (1024px+) -->
      <div class="lg:col-span-7 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-7 gap-x-4 sm:gap-x-6 lg:gap-x-6 gap-y-6 lg:gap-y-0">
        <!-- Group 1: Kategori Liputan (Col 1 on mobile, Col 1 on tablet, 3 cols on lg) -->
        <div class="lg:col-span-3 space-y-2 md:space-y-2.5">
          <span class="text-[12px] font-bold uppercase tracking-wider text-[#F9E7A7] block">
            Kategori Liputan
          </span>
          <ul class="space-y-2 text-[13px] font-medium text-[#EBE1B7] leading-[1.45]">
            <li><a href="/category/inspirasi" class="hover:text-white transition-colors">Inspirasi & Desain</a></li>
            <li><a href="/category/ruang" class="hover:text-white transition-colors">Tata Ruang & Tata Letak</a></li>
            <li><a href="/category/renovasi" class="hover:text-white transition-colors">Panduan Renovasi</a></li>
            <li><a href="/category/taman-outdoor" class="hover:text-white transition-colors">Taman & Ruang Luar</a></li>
            <li><a href="/category/material" class="hover:text-white transition-colors">Material & Spesifikasi</a></li>
            <li><a href="/category/smart-home" class="hover:text-white transition-colors">Smart Living & Otomasi</a></li>
            <li><a href="/category/belanja-cerdas" class="hover:text-white transition-colors">Belanja Cerdas</a></li>
          </ul>
        </div>

        <!-- Group 2: Alat & Keputusan (Col 2 on mobile, Col 2 on tablet, 2 cols on lg) -->
        <div class="lg:col-span-2 space-y-2 md:space-y-2.5">
          <span class="text-[12px] font-bold uppercase tracking-wider text-[#F9E7A7] block">
            Alat & Keputusan
          </span>
          <ul class="space-y-2 text-[13px] font-medium text-[#EBE1B7] leading-[1.45]">
            <li><a href="/solusi" class="hover:text-white text-white font-semibold transition-colors">✦ Problem Solver</a></li>
            <li><a href="/komparasi" class="hover:text-white transition-colors">Komparasi Material</a></li>
            <li><a href="/explore" class="hover:text-white transition-colors">Arsip Artikel</a></li>
            <li><a href="/search" class="hover:text-white transition-colors">Pencarian</a></li>
            <li><a href="/sitemap" class="hover:text-white transition-colors">Peta Situs HTML</a></li>
            <li><a href="/rss.xml" class="hover:text-white transition-colors">RSS Feed</a></li>
          </ul>
        </div>

        <!-- Group 3: Redaksi & Standar (Spans 2 columns on mobile, Col 3 on tablet, 2 cols on lg) -->
        <div class="col-span-2 md:col-span-1 lg:col-span-2 space-y-2 md:space-y-2.5 pt-4 md:pt-0 border-t border-[var(--footer-line)]/40 md:border-t-0">
          <span class="text-[12px] font-bold uppercase tracking-wider text-[#F9E7A7] block">
            Redaksi & Standar
          </span>
          <div class="grid grid-cols-2 md:grid-cols-1 gap-x-4 sm:gap-x-6 gap-y-2">
            <ul class="space-y-2 text-[13px] font-medium text-[#EBE1B7] leading-[1.45]">
              <li><a href="/editorial-standards" class="hover:text-white transition-colors">Standar Editorial</a></li>
              <li><a href="/metodologi" class="hover:text-white transition-colors">Metodologi Riset</a></li>
              <li><a href="/pedoman-media-siber" class="hover:text-white transition-colors">Pedoman Siber</a></li>
            </ul>
            <ul class="space-y-2 text-[13px] font-medium text-[#EBE1B7] leading-[1.45]">
              <li><a href="/tentang-kami" class="hover:text-white transition-colors">Tentang Kami</a></li>
              <li><a href="/kontak" class="hover:text-white transition-colors">Hubungi Redaksi</a></li>
              <li><a href="/kebijakan-privasi" class="hover:text-white transition-colors">Kebijakan Privasi</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar: Minimalist Signature -->
    <div class="pt-5 md:pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2.5 md:gap-4 text-xs text-[#D8CE9F]">
      <div class="flex items-center gap-2">
        <span class="font-serif font-bold text-sm text-white">RancangLoka.</span>
        <span class="text-[11.5px] leading-relaxed">— Inspirasi rumah dan keputusan lebih cerdas.</span>
      </div>
      <div class="text-[11px] sm:text-right leading-relaxed">
        <span>{copyright}</span>
      </div>
    </div>
  </div>
</footer>
