---
interface Props {
  title: string;
  url?: string;
  siteSettings?: Record<string, string>;
}

const { title, url = '', siteSettings = {} } = Astro.props;

// If master toggle is disabled, hide component
const isBarEnabled = siteSettings.share_bar_enabled !== 'false';
if (!isBarEnabled) return null;

const enableWa = siteSettings.share_enable_wa !== 'false';
const enableX = siteSettings.share_enable_x !== 'false';
const enableFb = siteSettings.share_enable_facebook !== 'false';
const enableIn = siteSettings.share_enable_linkedin !== 'false';
const enableTg = siteSettings.share_enable_telegram !== 'false';
const enableCopy = siteSettings.share_enable_copy !== 'false';
const twitterHandle = siteSettings.share_twitter_handle || '';
---

<div class="my-6 border-y border-slate-200 py-3 dark:border-slate-800">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
      <svg class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
      </svg>
      Bagikan Artikel:
    </span>

    <div class="flex flex-wrap items-center gap-2">
      <!-- WhatsApp -->
      {enableWa && (
        <a
          id="share-wa"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-3 py-1.5 text-xs font-semibold text-emerald-600 hover:bg-emerald-500 hover:text-white transition dark:bg-emerald-500/20 dark:text-emerald-400"
        >
          <span>WhatsApp</span>
        </a>
      )}

      <!-- X / Twitter -->
      {enableX && (
        <a
          id="share-x"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-800 hover:bg-slate-900 hover:text-white transition dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
        >
          <span>X (Twitter)</span>
        </a>
      )}

      <!-- Facebook -->
      {enableFb && (
        <a
          id="share-fb"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full bg-blue-600/10 px-3 py-1.5 text-xs font-semibold text-blue-700 hover:bg-blue-600 hover:text-white transition dark:bg-blue-600/20 dark:text-blue-300"
        >
          <span>Facebook</span>
        </a>
      )}

      <!-- LinkedIn -->
      {enableIn && (
        <a
          id="share-linkedin"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-blue-500/10 px-3 py-1.5 text-xs font-semibold text-blue-600 hover:bg-blue-600 hover:text-white transition dark:bg-blue-500/20 dark:text-blue-400"
        >
          <span>LinkedIn</span>
        </a>
      )}

      <!-- Telegram -->
      {enableTg && (
        <a
          id="share-tg"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-sky-500/10 px-3 py-1.5 text-xs font-semibold text-sky-600 hover:bg-sky-500 hover:text-white transition dark:bg-sky-500/20 dark:text-sky-400"
        >
          <span>Telegram</span>
        </a>
      )}

      <!-- Copy Link Button -->
      {enableCopy && (
        <button
          id="copy-link-btn"
          class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 transition"
        >
          <span id="copy-btn-text">Salin Tautan</span>
        </button>
      )}
    </div>
  </div>
</div>

<script define:vars={{ title, twitterHandle }}>
  const currentUrl = encodeURIComponent(window.location.href);
  const encodedTitle = encodeURIComponent(title);

  const waBtn = document.getElementById('share-wa');
  if (waBtn) waBtn.href = `https://api.whatsapp.com/send?text=${encodedTitle}%20${currentUrl}`;

  const xBtn = document.getElementById('share-x');
  if (xBtn) {
    const viaParam = twitterHandle ? `&via=${encodeURIComponent(twitterHandle.replace(/^@/, ''))}` : '';
    xBtn.href = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${currentUrl}${viaParam}`;
  }

  const fbBtn = document.getElementById('share-fb');
  if (fbBtn) fbBtn.href = `https://www.facebook.com/sharer/sharer.php?u=${currentUrl}`;

  const inBtn = document.getElementById('share-linkedin');
  if (inBtn) inBtn.href = `https://www.linkedin.com/sharing/share-offsite/?url=${currentUrl}`;

  const tgBtn = document.getElementById('share-tg');
  if (tgBtn) tgBtn.href = `https://t.me/share/url?url=${currentUrl}&text=${encodedTitle}`;

  const copyBtn = document.getElementById('copy-link-btn');
  const copyText = document.getElementById('copy-btn-text');
  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href);
      copyText.innerText = 'Tersalin! ✓';
      setTimeout(() => {
        copyText.innerText = 'Salin Tautan';
      }, 2000);
    });
  }
</script>
