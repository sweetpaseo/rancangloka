---
/**
 * RancangLoka Visual Design & Material Index
 * Architecture, Materiality, & Spatial Elements Discovery
 */

const materials = [
  { name: 'Kayu Ulin & Jati', count: '12 Proyek', desc: 'Ketahanan cuaca ekstrem & serat hangat', query: 'kayu' },
  { name: 'Batu Andesit Alur', count: '8 Proyek', desc: 'Tekstur monolitik dinding luar', query: 'batu' },
  { name: 'Beton Ekspos (Exposed Concrete)', count: '15 Proyek', desc: 'Kejujuran material brutalist kontemporer', query: 'beton' },
  { name: 'Kaca Rendah Emisi (Low-E)', count: '9 Proyek', desc: 'Isolasi termal & reduksi radiasi matahari', query: 'kaca' },
  { name: 'Bata Ringan Terakota', count: '6 Proyek', desc: 'Ventilasi bernapas & aksen warna bumi', query: 'terakota' },
  { name: 'Baja Ringan & Aluminium Hitam', count: '14 Proyek', desc: 'Struktur ramping & presisi fasad modern', query: 'aluminium' }
];

const elements = [
  { name: 'Secondary Skin Fasad', query: 'secondary skin' },
  { name: 'Void Vertikal 5 Meter', query: 'void' },
  { name: 'Taman Kering (Zen Garden)', query: 'taman' },
  { name: 'Skylight Kaca Terlindung', query: 'skylight' },
  { name: 'Plafon Kisi Kayu', query: 'plafon' },
  { name: 'Sumbu Ventilasi Silang', query: 'ventilasi' }
];
---

<section class="my-20">
  <div class="mb-8 border-b border-black/[0.06] dark:border-white/[0.08] pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
    <div>
      <span class="text-[11px] font-mono font-bold tracking-widest text-[#c46849] uppercase block mb-1">
        THE DESIGN & MATERIAL INDEX
      </span>
      <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white">
        Eksplorasi Berdasarkan Material & Elemen Spasial
      </h2>
    </div>
    <span class="text-xs text-slate-400 font-medium">Panduan Spesifikasi Materialitas</span>
  </div>

  <!-- Material Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-8">
    {materials.map((mat) => (
      <a
        href={`/search?q=${encodeURIComponent(mat.query)}`}
        class="apple-card group p-6 rounded-[2rem] border border-black/[0.06] dark:border-white/[0.08] bg-white dark:bg-slate-900 hover:border-[#c46849]/40 transition duration-500 flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-[11px] font-bold text-[#c46849] uppercase tracking-wider">
              {mat.count}
            </span>
            <span class="text-slate-300 dark:text-slate-600 group-hover:text-[#c46849] group-hover:translate-x-1 transition">
              →
            </span>
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-[#c46849] transition">
            {mat.name}
          </h3>
          <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            {mat.desc}
          </p>
        </div>
      </a>
    ))}
  </div>

  <!-- Spatial Elements Pills -->
  <div class="rounded-2xl bg-slate-50/80 dark:bg-slate-900/60 border border-black/[0.04] dark:border-white/[0.06] p-4 sm:p-5 flex flex-wrap items-center gap-2.5">
    <span class="text-xs font-bold text-slate-700 dark:text-slate-300 mr-2 font-mono uppercase tracking-wider">
      Elemen Arsitektural:
    </span>
    {elements.map((elem) => (
      <a
        href={`/search?q=${encodeURIComponent(elem.query)}`}
        class="rounded-full bg-white dark:bg-slate-800 border border-black/[0.06] dark:border-white/[0.08] hover:border-[#c46849] hover:text-[#c46849] px-3.5 py-1 text-xs font-semibold text-slate-600 dark:text-slate-300 transition shadow-2xs"
      >
        {elem.name}
      </a>
    ))}
  </div>
</section>
