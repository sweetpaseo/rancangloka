---
import type { Article } from '../lib/db';

interface Props {
  featuredArticle: Article;
  secondaryArticles: Article[];
}

const { featuredArticle, secondaryArticles = [] } = Astro.props;
if (!featuredArticle) return null;

const editorialCurations = [
  {
    label: 'MATERIAL MINGGU INI',
    reason: 'Dipilih karena pendekatannya menarik dalam merespons radiasi panas dan kelembapan tropis.'
  },
  {
    label: 'DETAIL ARSITEKTUR',
    reason: 'Studi eksplorasi sirkulasi vertikal void pada denah hunian kompak.'
  },
  {
    label: 'KENYAMANAN SPASIAL',
    reason: 'Layering pencahayaan alami untuk mengurangi kontras visual pada ruang istirahat.'
  }
];
---

<section class="mb-14 relative">
  <!-- Issue Header Line -->
  <div class="flex items-center justify-between border-b border-black/[0.06] dark:border-white/[0.08] pb-3 mb-6">
    <div class="flex items-center gap-3">
      <span class="rounded-full bg-slate-900 text-white dark:bg-white dark:text-slate-900 px-3 py-0.5 text-[10px] font-mono font-bold uppercase tracking-wider">
        ISSUE #04
      </span>
      <span class="text-xs font-mono font-semibold text-slate-700 dark:text-slate-300">
        Fokus: Fasad, Materialitas & Hunian Tropis Bernapas
      </span>
    </div>
    <span class="hidden sm:inline text-xs font-mono text-slate-400">Terbitan Mingguan</span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- 1. Full-Bleed Dramatic Feature Story (7 cols) -->
    <div class="lg:col-span-7">
      <article class="group relative flex flex-col justify-end overflow-hidden rounded-[2.5rem] bg-slate-950 aspect-[16/11] md:aspect-[16/10] shadow-[0_12px_40px_rgba(0,0,0,0.08)] transition duration-700 hover:shadow-[0_24px_60px_rgba(0,0,0,0.18)]">
        <img
          src={featuredArticle.featured_image}
          alt={featuredArticle.image_alt || featuredArticle.title}
          class="absolute inset-0 h-full w-full object-cover opacity-90 transition duration-1000 ease-out group-hover:scale-105"
          fetchpriority="high"
          loading="eager"
          sizes="(max-width: 768px) 100vw, 750px"
          onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1200&auto=format&fit=crop&q=80'"
        />
        <!-- Cinematic Depth Gradient -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/45 to-transparent"></div>

        <div class="relative z-10 p-7 sm:p-9 md:p-11">
          <div class="flex items-center gap-3 mb-4">
            <span class="rounded-full bg-white/20 backdrop-blur-md px-3.5 py-1 text-[10px] font-mono font-bold uppercase tracking-wider text-white border border-white/20">
              COVER STORY
            </span>
            <span class="text-xs text-white/80 font-mono">
              {featuredArticle.reading_time_minutes} menit baca
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-white leading-snug line-clamp-2 md:line-clamp-3 group-hover:text-blue-200 transition-colors">
            <a href={`/${featuredArticle.slug}`}>
              {featuredArticle.title}
            </a>
          </h1>

          <p class="mt-3.5 text-xs sm:text-sm text-slate-200 line-clamp-2 hidden sm:block font-normal leading-relaxed">
            {featuredArticle.description}
          </p>

          <div class="mt-6 flex items-center justify-between text-xs text-white/70 pt-4 border-t border-white/15 font-mono">
            <div class="flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              <span class="font-semibold text-white/90">{featuredArticle.author_name || 'RancangLoka Editorial Desk'}</span>
            </div>
            <span>Edisi Terbit</span>
          </div>
        </div>
      </article>
    </div>

    <!-- 2. Editor's Curated Stories Column with Explicit Reasons (5 cols) -->
    <div class="lg:col-span-5 flex flex-col justify-between space-y-3.5">
      <div class="flex items-center justify-between border-b border-black/[0.06] dark:border-white/[0.08] pb-2">
        <h2 class="text-xs font-mono font-bold uppercase tracking-widest text-slate-900 dark:text-white flex items-center gap-2">
          <span>✦</span>
          <span>CATATAN KURASI REDAKSI</span>
        </h2>
        <span class="text-[11px] font-mono text-slate-400">Alasan Kurasi</span>
      </div>

      {secondaryArticles.slice(0, 3).map((article, idx) => {
        const num = (idx + 1).toString().padStart(2, '0');
        const curation = editorialCurations[idx] || { label: 'KURASI SPASIAL', reason: 'Studi kasus pilihan redaksi.' };

        return (
          <article class="apple-card group flex items-start gap-4 p-4 rounded-[1.5rem] border border-black/[0.05] dark:border-white/[0.08] bg-white dark:bg-slate-900 shadow-sm hover:shadow-md transition duration-500">
            <span class="font-mono text-base font-black text-[#0071e3] opacity-60 group-hover:opacity-100 transition pt-1">
              {num}
            </span>

            <div class="flex flex-1 flex-col min-w-0">
              <div class="flex items-center justify-between mb-1">
                <span class="text-[9px] font-mono font-bold uppercase tracking-wider text-[#0071e3]">
                  {curation.label}
                </span>
                <span class="text-[10px] font-mono text-slate-400">
                  {article.reading_time_minutes} mnt
                </span>
              </div>

              <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white line-clamp-2 group-hover:text-[#0071e3] transition-colors leading-snug tracking-tight mb-1.5">
                <a href={`/${article.slug}`}>
                  {article.title}
                </a>
              </h3>

              <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-1 italic font-serif">
                “{curation.reason}”
              </p>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
