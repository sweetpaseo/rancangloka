---
import type { Article } from '../lib/db';

interface Props {
  featuredArticle: Article;
  secondaryArticles: Article[];
}

const { featuredArticle, secondaryArticles = [] } = Astro.props;
if (!featuredArticle) return null;
---

<section class="mb-14">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- 1. Apple-Style Cinematic Featured Story (7 cols) -->
    <div class="lg:col-span-7">
      <article class="group relative flex flex-col justify-end overflow-hidden rounded-[2rem] bg-slate-950 aspect-[16/11] md:aspect-[16/10] shadow-[0_10px_30px_rgba(0,0,0,0.06)] transition duration-500 hover:shadow-[0_20px_40px_rgba(0,0,0,0.12)]">
        <img
          src={featuredArticle.featured_image}
          alt={featuredArticle.image_alt || featuredArticle.title}
          class="absolute inset-0 h-full w-full object-cover opacity-90 transition duration-700 ease-out group-hover:scale-105"
          fetchpriority="high"
          loading="eager"
          onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1200&auto=format&fit=crop&q=80'"
        />
        <!-- Apple Soft Cinematic Gradient -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>

        <div class="relative z-10 p-6 sm:p-8 md:p-10">
          <div class="flex items-center gap-2 mb-3.5">
            <span class="rounded-full bg-white/20 backdrop-blur-md px-3.5 py-1 text-[11px] font-bold uppercase tracking-wider text-white border border-white/20">
              {featuredArticle.category_name || 'Featured Story'}
            </span>
            <span class="text-xs text-white/70 font-medium">
              ⏱️ {featuredArticle.reading_time_minutes} min read
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white leading-tight line-clamp-2 md:line-clamp-3 group-hover:text-blue-200 transition-colors">
            <a href={`/${featuredArticle.slug}`}>
              {featuredArticle.title}
            </a>
          </h1>

          <p class="mt-3 text-xs sm:text-sm text-white/80 line-clamp-2 hidden sm:block font-normal leading-relaxed">
            {featuredArticle.description}
          </p>

          <div class="mt-5 flex items-center gap-3 text-xs text-white/60 pt-4 border-t border-white/10">
            <span class="font-medium text-white/90">Oleh {featuredArticle.author_name || 'Redaksi'}</span>
            <span>•</span>
            <span>{new Date(featuredArticle.published_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
          </div>
        </div>
      </article>
    </div>

    <!-- 2. Apple Side Stories Cards (5 cols) -->
    <div class="lg:col-span-5 flex flex-col justify-between gap-4">
      {secondaryArticles.slice(0, 3).map((article) => (
        <article class="apple-card group flex items-center gap-4 p-4 hover:border-black/10 dark:hover:border-white/20 transition">
          <a href={`/${article.slug}`} class="relative block h-24 w-28 sm:h-28 sm:w-36 flex-shrink-0 overflow-hidden rounded-2xl bg-slate-100 dark:bg-slate-800">
            <img
              src={article.featured_image}
              alt={article.image_alt || article.title}
              class="h-full w-full object-cover transition duration-500 ease-out group-hover:scale-108"
              loading="lazy"
              onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&auto=format&fit=crop&q=80'"
            />
          </a>

          <div class="flex flex-1 flex-col justify-center min-w-0">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[#0071e3]">
              {article.category_name || 'Topik'}
            </span>
            <h2 class="mt-1 text-sm sm:text-base font-bold text-slate-900 dark:text-white line-clamp-2 group-hover:text-[#0071e3] transition-colors leading-snug tracking-tight">
              <a href={`/${article.slug}`}>
                {article.title}
              </a>
            </h2>
            <div class="mt-2.5 flex items-center gap-2 text-[11px] text-slate-400">
              <span class="truncate">{article.author_name || 'Redaksi'}</span>
              <span>•</span>
              <span class="whitespace-nowrap">⏱️ {article.reading_time_minutes}m</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
