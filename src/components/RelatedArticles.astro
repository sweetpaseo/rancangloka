---
import type { Article } from '../lib/db';

interface Props {
  articles: Article[];
}

const { articles = [] } = Astro.props;
if (articles.length === 0) return null;
---

<section class="mt-20 border-t border-black/[0.06] dark:border-white/[0.08] bg-slate-50/70 dark:bg-slate-900/40 py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header Section -->
    <div class="mb-10 flex items-center justify-between border-b border-black/[0.05] dark:border-white/[0.08] pb-4">
      <div class="flex items-center gap-3">
        <span class="h-6 w-2 rounded-full bg-[#0066ee]"></span>
        <div>
          <h2 class="text-xl sm:text-2xl font-black tracking-tight text-slate-900 dark:text-white">
            Eksplorasi Kurasi & Artikel Terkait
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Inspirasi pilihan editor untuk melengkapi bacaan Anda</p>
        </div>
      </div>
    </div>

    <!-- 3-Column Luxury Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {articles.map((article) => (
        <article class="apple-card group flex flex-col overflow-hidden bg-white dark:bg-slate-900 rounded-[2rem] border border-black/[0.05] dark:border-white/[0.08] shadow-sm hover:shadow-xl transition-all duration-500">
          <!-- Thumbnail -->
          <a href={`/${article.slug}`} class="relative block overflow-hidden aspect-[16/10] bg-slate-100 dark:bg-slate-800">
            <img
              src={article.featured_image}
              alt={article.image_alt || article.title}
              class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-106"
              loading="lazy"
              onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&auto=format&fit=crop&q=80'"
            />
            <span class="absolute top-4 left-4 rounded-full bg-slate-950/70 backdrop-blur-md px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-white border border-white/20">
              {article.category_name || 'Inspirasi'}
            </span>
          </a>

          <!-- Content -->
          <div class="flex flex-1 flex-col p-6 sm:p-7">
            <h3 class="text-base sm:text-lg font-bold tracking-tight text-slate-900 dark:text-white line-clamp-2 group-hover:text-[#0066ee] transition-colors leading-snug">
              <a href={`/${article.slug}`}>
                {article.title}
              </a>
            </h3>

            <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-400 line-clamp-2 flex-1 leading-relaxed">
              {article.description}
            </p>

            <div class="mt-6 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 border-t border-black/[0.04] dark:border-white/[0.06] pt-4 font-medium">
              <span class="font-semibold text-slate-700 dark:text-slate-300">{article.author_name || 'Redaksi'}</span>
              <span>⏱️ {article.reading_time_minutes} min read</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
