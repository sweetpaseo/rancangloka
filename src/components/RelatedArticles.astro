---
import type { Article } from '../lib/db';

interface Props {
  articles: Article[];
}

const { articles = [] } = Astro.props;
if (articles.length === 0) return null;
---

<section class="my-10 border-t border-slate-200 pt-8 dark:border-slate-800">
  <div class="mb-6 flex items-center justify-between">
    <h3 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
      <span class="h-5 w-1.5 rounded-full bg-primary"></span>
      Artikel Terkait Lainnya
    </h3>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {articles.map((article) => (
      <article class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900 hover:shadow-lg transition-all">
        <!-- Thumbnail -->
        <a href={`/${article.slug}`} class="relative block overflow-hidden aspect-[16/9] bg-slate-100 dark:bg-slate-800">
          <img
            src={article.featured_image}
            alt={article.image_alt || article.title}
            class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
            loading="lazy"
            onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&auto=format&fit=crop&q=80'"
          />
          <span class="absolute top-3 left-3 rounded-full bg-slate-900/80 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white backdrop-blur-sm">
            {article.category_name || 'Artikel'}
          </span>
        </a>

        <!-- Content -->
        <div class="flex flex-1 flex-col p-4">
          <h4 class="text-base font-bold text-slate-900 dark:text-white line-clamp-2 group-hover:text-primary transition">
            <a href={`/${article.slug}`}>
              {article.title}
            </a>
          </h4>
          <p class="mt-2 text-xs text-slate-600 dark:text-slate-400 line-clamp-2 flex-1">
            {article.description}
          </p>

          <div class="mt-4 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400 border-t border-slate-100 pt-3 dark:border-slate-800 font-medium">
            <span>{article.author_name || 'Redaksi'}</span>
            <span>⏱️ {article.reading_time_minutes} min read</span>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
