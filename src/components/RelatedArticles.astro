---
import type { Article } from '../lib/db';
import { getResponsiveImageAttrs } from '../lib/image';

interface Props {
  articles: Article[];
}

const { articles = [] } = Astro.props;
if (!articles || articles.length === 0) return null;
---

<section
  class="w-full bg-[var(--warm)] border-t border-[var(--line)] py-12 sm:py-16 my-8"
  aria-labelledby="related-articles-heading"
>
  <div class="editorial-container">
    <!-- Header Section -->
    <div class="mb-8 sm:mb-10 flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-[var(--line)] pb-4">
      <div>
        <span class="eyebrow block text-xs font-bold uppercase tracking-wider text-[var(--meta)] mb-1">
          Rekomendasi Editor
        </span>
        <h2
          id="related-articles-heading"
          class="font-heading text-2xl sm:text-3xl font-bold text-[var(--ink)] tracking-tight"
        >
          Baca Juga di RancangLoka
        </h2>
        <p class="text-xs sm:text-sm text-[var(--muted)] mt-1">
          Artikel pilihan untuk melanjutkan eksplorasi rumahmu.
        </p>
      </div>
      <a
        href="/explore"
        class="text-xs sm:text-sm font-semibold text-[var(--primary)] hover:text-[var(--deep)] transition-colors self-start sm:self-auto flex items-center gap-1 group"
      >
        <span>Lihat Semua Artikel</span>
        <span class="inline-block transition-transform duration-200 group-hover:translate-x-1">→</span>
      </a>
    </div>

    <!-- Responsive Cards Grid: 1 col on mobile, 2 col on tablet, 3 col on desktop -->
    <div
      class={`grid gap-6 sm:gap-8 ${
        articles.length === 1
          ? 'grid-cols-1 max-w-md mx-auto'
          : articles.length === 2
          ? 'grid-cols-1 sm:grid-cols-2 max-w-3xl mx-auto'
          : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3'
      }`}
    >
      {articles.map((article) => {
        const imgAttrs = article.featured_image
          ? getResponsiveImageAttrs(article.featured_image, article.image_alt || article.title, {
              slotType: 'card',
              isPriority: false,
              aspectRatio: '16/10'
            })
          : null;

        return (
          <article class="group flex flex-col bg-white rounded-xl border border-[var(--line)] overflow-hidden shadow-xs hover:shadow-md hover:border-[var(--lemon)] transition-all duration-300">
            <!-- Thumbnail Image -->
            <a
              href={`/${article.slug}`}
              class="relative block overflow-hidden aspect-[16/10] bg-[var(--neutral-soft)]"
              aria-hidden="true"
              tabindex="-1"
            >
              {imgAttrs ? (
                <img
                  src={imgAttrs.src}
                  srcset={imgAttrs.srcset}
                  sizes={imgAttrs.sizes}
                  alt={imgAttrs.alt}
                  width={imgAttrs.width}
                  height={imgAttrs.height}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-103"
                  style={imgAttrs.style}
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-[var(--wash)] text-[var(--primary)] text-3xl">
                  🏡
                </div>
              )}
              <span class="absolute top-3 left-3 bg-white/95 backdrop-blur-xs text-[var(--primary)] text-[10px] sm:text-[11px] font-bold px-2.5 py-1 rounded-md border border-[var(--line)] shadow-xs uppercase tracking-wider">
                {article.category_name || 'Inspirasi'}
              </span>
            </a>

            <!-- Content -->
            <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="font-heading text-base sm:text-lg font-bold text-[var(--ink)] group-hover:text-[var(--primary)] transition-colors line-clamp-2 leading-snug">
                  <a href={`/${article.slug}`}>
                    {article.title}
                  </a>
                </h3>

                {article.description && (
                  <p class="mt-2 text-xs sm:text-sm text-[var(--muted)] line-clamp-2 leading-relaxed">
                    {article.description}
                  </p>
                )}
              </div>

              <!-- Metadata -->
              <div class="mt-5 pt-3 border-t border-[var(--line)] flex items-center justify-between text-xs text-[var(--muted)] font-medium">
                <span class="font-semibold text-[var(--ink)]">
                  {article.author_name || 'Redaksi RancangLoka'}
                </span>
                <span>
                  {article.reading_time_minutes ? `${article.reading_time_minutes} menit baca` : 'Kajian praktis'}
                </span>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
