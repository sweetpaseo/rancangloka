---
/**
 * RancangLoka Magazine 2.1 — Contextual Technical References Component
 * MISSION: RANCANGLOKA_EDITORIAL_REFERENCES_1
 * 
 * Rules:
 * - Semantic native HTML: <section> and typography
 * - Zero client-side JavaScript dependencies
 * - Lemon Linen theme tokens and typography (Plus Jakarta Sans)
 * - Strict optionality: renders null if referencesHtml is empty or undefined
 * - Full accessibility
 */

export interface Props {
  referencesHtml?: string | null;
  title?: string;
  badge?: string;
}

const {
  referencesHtml,
  title = 'Referensi & Standar Teknis',
  badge = 'STANDAR & ACUAN'
} = Astro.props;

const hasReferences = Boolean(referencesHtml && referencesHtml.trim().length > 0);
---

{hasReferences && (
  <section
    class="technical-references my-10 pt-8 border-t border-[var(--line)]"
    aria-labelledby="technical-references-title"
  >
    <div class="mb-4">
      <span class="meta text-xs uppercase tracking-wider font-semibold text-[var(--primary)]">
        {badge}
      </span>
      <h3
        id="technical-references-title"
        class="font-heading text-xl sm:text-2xl font-bold text-[var(--ink)] mt-1 tracking-tight"
      >
        {title}
      </h3>
    </div>

    <div class="prose-magazine text-sm sm:text-base text-[var(--muted)] leading-relaxed space-y-2 font-sans" set:html={referencesHtml} />
  </section>
)}
