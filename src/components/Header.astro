---
import type { Category } from '../lib/db';

interface Props {
  categories?: Category[];
  siteSettings?: Record<string, string>;
}

const { categories = [], siteSettings = {} } = Astro.props;
const siteTitle = siteSettings.site_title || 'RANCANGLOKA';
const siteLogo = siteSettings.site_logo || '';
---

<header class="sticky top-0 z-40 w-full bg-paper/95 dark:bg-ink/95 backdrop-blur-sm border-b border-stone dark:border-stone/20 transition-colors">
  <div class="mx-auto max-w-[1280px] px-5 sm:px-8 lg:px-12 flex h-[64px] md:h-[76px] items-center justify-between">
    <!-- Brand Logo / Title -->
    <a href="/" class="flex items-center gap-3 group text-ink dark:text-paper">
      {siteLogo ? (
        <img src={siteLogo} alt={siteTitle} class="h-6 md:h-7 w-auto object-contain" />
      ) : (
        <span class="flex h-7 w-7 md:h-8 md:w-8 items-center justify-center bg-ink text-paper dark:bg-paper dark:text-ink font-sans font-bold text-xs md:text-sm tracking-tight">
          R
        </span>
      )}
      <span class="font-sans font-bold text-sm md:text-base tracking-[0.08em] uppercase text-ink dark:text-paper group-hover:text-accent transition-colors">
        {siteTitle}
      </span>
    </a>

    <!-- Desktop Navigation (Quiet Luxury 12-13px) -->
    <nav class="hidden md:flex items-center gap-8 text-[12px] font-medium tracking-[0.06em] text-ink dark:text-paper uppercase">
      <a href="/" class="hover:text-accent transition-colors">Journal</a>
      <a href="/explore" class="hover:text-accent transition-colors">Explore</a>
      <a href="/solusi" class="hover:text-accent transition-colors">Intelligence</a>
      <a href="/komparasi" class="hover:text-accent transition-colors">Material Matrix</a>
      <a href="/tentang-kami" class="hover:text-accent transition-colors">About</a>
    </nav>

    <!-- Header Actions (Search, Bookmark, Theme) -->
    <div class="flex items-center gap-2 sm:gap-3 text-ink dark:text-paper">
      <!-- Search Trigger -->
      <button
        data-search-trigger
        class="flex items-center gap-2 p-2 hover:text-accent transition text-ink dark:text-paper"
        aria-label="Cari artikel atau material"
        title="Search (⌘K)"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>

      <!-- Bookmark Collection Trigger -->
      <button
        data-bookmark-trigger
        class="relative p-2 hover:text-accent transition text-ink dark:text-paper"
        aria-label="Saved Inspiration"
        title="Saved Inspiration"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
        </svg>
        <span class="bookmark-badge hidden absolute top-1 right-1 flex h-3.5 min-w-[14px] items-center justify-center rounded-full bg-ink text-paper dark:bg-paper dark:text-ink px-1 text-[8px] font-bold">
          0
        </span>
      </button>

      <!-- Theme Switcher -->
      <button
        class="theme-toggle-btn p-2 hover:text-accent transition text-ink dark:text-paper"
        aria-label="Toggle Theme"
        title="Toggle Theme"
      >
        <svg class="h-4 w-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="h-4 w-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 hover:text-accent transition text-ink dark:text-paper ml-1"
        aria-label="Open Navigation Menu"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation Menu -->
  <div id="mobile-nav-panel" class="hidden md:hidden border-t border-stone dark:border-stone/20 bg-paper dark:bg-ink px-6 py-6 space-y-4 text-xs uppercase tracking-widest font-medium">
    <a href="/" class="block py-2 border-b border-stone/50 dark:border-stone/10 hover:text-accent">Journal</a>
    <a href="/explore" class="block py-2 border-b border-stone/50 dark:border-stone/10 hover:text-accent">✦ Explore & Archive</a>
    <a href="/solusi" class="block py-2 border-b border-stone/50 dark:border-stone/10 hover:text-accent">Problem Solver</a>
    <a href="/komparasi" class="block py-2 border-b border-stone/50 dark:border-stone/10 hover:text-accent">Material Matrix</a>
    <a href="/tentang-kami" class="block py-2 border-b border-stone/50 dark:border-stone/10 hover:text-accent">Editorial & About</a>
    
    <div class="pt-2">
      <span class="text-[10px] text-muted block mb-2 font-mono">KATEGORI LIPUTAN</span>
      <div class="flex flex-wrap gap-2">
        {categories.map((c) => (
          <a href={`/category/${c.slug}`} class="px-2.5 py-1 text-[10px] border border-stone dark:border-stone/20 rounded-xs hover:border-ink dark:hover:border-paper">
            {c.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileNav = document.getElementById('mobile-nav-panel');
  mobileBtn?.addEventListener('click', () => {
    mobileNav?.classList.toggle('hidden');
  });
</script>
