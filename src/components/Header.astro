---
import type { Category } from '../lib/db';

interface Props {
  categories?: Category[];
  siteSettings?: Record<string, string>;
}

const { categories = [], siteSettings = {} } = Astro.props;
const siteTitle = siteSettings.site_title || 'RancangLoka.';

// 7 Approved HGTV-style editorial categories as fallback or canonical alignment
const defaultCategories = [
  { name: 'Inspirasi', slug: 'inspirasi' },
  { name: 'Ruang', slug: 'ruang' },
  { name: 'Renovasi', slug: 'renovasi' },
  { name: 'Taman & Outdoor', slug: 'taman-outdoor' },
  { name: 'Material', slug: 'material' },
  { name: 'Smart Home', slug: 'smart-home' },
  { name: 'Belanja Cerdas', slug: 'belanja-cerdas' }
];

const navCategories = categories.length > 0 ? categories : defaultCategories;
const currentPath = Astro.url.pathname;
---

<header class="w-full bg-white border-t-[5px] border-[var(--lemon)] border-b border-[var(--line)] sticky top-0 z-40 shadow-[0_4px_16px_rgba(85,72,27,0.04)]">
  <!-- Main Nav Bar -->
  <div class="editorial-container flex items-center justify-between gap-4 h-16 py-2.5 md:py-3">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group flex-shrink-0" aria-label="RancangLoka Beranda">
      <span class="grid place-items-center w-8 h-8 rounded-md border-2 border-[var(--lemon)] -rotate-6 bg-white shadow-xs group-hover:rotate-0 transition-transform duration-300" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.7" stroke-linejoin="round" class="w-5 h-5 rotate-6 group-hover:rotate-0 text-[var(--primary)] transition-transform duration-300">
          <path d="M2 16 16 4l14 12M8 13v15h16V13M13 28V17h7v11" />
        </svg>
      </span>
      <span class="font-brand text-2xl font-black tracking-tight text-[var(--primary)] group-hover:text-[var(--deep)] transition-colors">
        {siteTitle}
      </span>
    </a>

    <!-- Desktop Categories Nav -->
    <nav class="hidden lg:flex items-center gap-6 text-[13.5px] font-medium text-[var(--ink)]" aria-label="Navigasi Utama">
      <a
        href="/category/inspirasi"
        class={`py-1 transition-colors hover:text-[var(--primary)] ${
          currentPath.startsWith('/category/inspirasi') ? 'text-[var(--primary)] font-bold border-b-2 border-[var(--lemon)]' : 'text-[var(--muted)]'
        }`}
      >
        Inspirasi
      </a>
      <a
        href="/category/renovasi"
        class={`py-1 transition-colors hover:text-[var(--primary)] ${
          currentPath.startsWith('/category/renovasi') ? 'text-[var(--primary)] font-bold border-b-2 border-[var(--lemon)]' : 'text-[var(--muted)]'
        }`}
      >
        Renovasi
      </a>
      <a
        href="/category/material"
        class={`py-1 transition-colors hover:text-[var(--primary)] ${
          currentPath.startsWith('/category/material') ? 'text-[var(--primary)] font-bold border-b-2 border-[var(--lemon)]' : 'text-[var(--muted)]'
        }`}
      >
        Material
      </a>
      <a
        href="/komparasi"
        class={`py-1 transition-colors hover:text-[var(--primary)] ${
          currentPath === '/komparasi' ? 'text-[var(--primary)] font-bold border-b-2 border-[var(--lemon)]' : 'text-[var(--muted)]'
        }`}
      >
        Komparasi
      </a>
      <a
        href="/solusi"
        class={`py-1 transition-colors hover:text-[var(--primary)] ${
          currentPath === '/solusi' ? 'text-[var(--primary)] font-bold border-b-2 border-[var(--lemon)]' : 'text-[var(--primary)] font-semibold'
        }`}
      >
        ✦ Solusi
      </a>
      <a
        href="/explore"
        class={`py-1 transition-colors hover:text-[var(--primary)] ${
          currentPath === '/explore' ? 'text-[var(--primary)] font-bold border-b-2 border-[var(--lemon)]' : 'text-[var(--muted)]'
        }`}
      >
        Eksplorasi
      </a>
    </nav>

    <!-- Right Controls: Search & Mobile Menu Button -->
    <div class="flex items-center gap-3">
      <!-- Search Input Trigger Button (Opens Modal or navigates to /search) -->
      <a
        href="/search"
        data-search-trigger
        class="hidden sm:inline-flex items-center gap-2 text-xs text-[var(--muted)] hover:text-[var(--ink)] bg-[var(--warm)] border border-[var(--line)] rounded-full px-3.5 py-1.5 transition hover:border-[var(--lemon)] whitespace-nowrap cursor-pointer"
        aria-label="Pencarian Ide Rumah"
      >
        <svg class="w-3.5 h-3.5 text-[var(--primary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span>Cari ide rumah...</span>
      </a>

      <!-- Mobile Search Icon Button -->
      <a
        href="/search"
        data-search-trigger
        class="sm:hidden p-2 text-[var(--ink)] hover:text-[var(--primary)] transition rounded-md"
        aria-label="Cari"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="theme-mobile-menu-toggle"
        type="button"
        class="lg:hidden p-2 text-[var(--ink)] hover:text-[var(--primary)] transition rounded-md"
        aria-label="Buka Menu Navigasi"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Collapsible Menu Drawer -->
  <div id="theme-mobile-menu" class="hidden lg:hidden border-t border-[var(--line)] bg-[var(--surface)] px-5 py-6">
    <div class="grid grid-cols-2 gap-6 text-sm">
      <div>
        <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--meta)] block mb-3">Kategori</span>
        <ul class="space-y-2.5 font-medium text-[var(--ink)]">
          {navCategories.map((c) => (
            <li>
              <a href={`/category/${c.slug}`} class="hover:text-[var(--primary)] block transition-colors">
                {c.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--meta)] block mb-3">Fitur & Tools</span>
        <ul class="space-y-2.5 font-medium text-[var(--ink)]">
          <li>
            <a href="/solusi" class="hover:text-[var(--primary)] font-bold text-[var(--primary)] block transition-colors">
              ✦ Problem Solver
            </a>
          </li>
          <li>
            <a href="/komparasi" class="hover:text-[var(--primary)] block transition-colors">
              Komparasi Material
            </a>
          </li>
          <li>
            <a href="/explore" class="hover:text-[var(--primary)] block transition-colors">
              Jelajahi Arsip
            </a>
          </li>
          <li>
            <a href="/editorial-standards" class="hover:text-[var(--primary)] block transition-colors">
              Standar Editorial
            </a>
          </li>
          <li>
            <a href="/metodologi" class="hover:text-[var(--primary)] block transition-colors">
              Metodologi
            </a>
          </li>
          <li>
            <a href="/kontak" class="hover:text-[var(--primary)] block transition-colors">
              Kontak Kami
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</header>

<script>
  const mobileToggle = document.getElementById('theme-mobile-menu-toggle');
  const mobileMenu = document.getElementById('theme-mobile-menu');

  mobileToggle?.addEventListener('click', () => {
    const isExpanded = mobileToggle.getAttribute('aria-expanded') === 'true';
    mobileToggle.setAttribute('aria-expanded', String(!isExpanded));
    mobileMenu?.classList.toggle('hidden');
  });
</script>
