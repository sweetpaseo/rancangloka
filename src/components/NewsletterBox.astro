---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'RANCANGLOKA WEEKLY',
  subtitle = '7 gagasan desain, wawasan material, dan studi proyek arsitektur tropis terpilih yang layak Anda simpan. Terbit setiap Jumat pagi langsung ke inbox Anda.'
} = Astro.props;
---

<div class="my-20 overflow-hidden rounded-[2.5rem] border border-black/[0.08] bg-[#0f1a15] text-white p-8 sm:p-14 shadow-2xl relative">
  <div class="pointer-events-none absolute -left-20 -top-20 h-72 w-72 rounded-full bg-[#c46849]/15 blur-3xl"></div>

  <div class="mx-auto max-w-2xl text-center space-y-5 relative z-10">
    <div class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1 text-[11px] font-mono font-bold uppercase tracking-widest text-[#c46849] border border-white/15">
      <span>✦</span> JURNAL KURASI MINGGUAN
    </div>

    <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-white leading-tight">
      {title}
    </h2>

    <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-xl mx-auto font-normal">
      {subtitle}
    </p>

    <!-- Curated Value Highlights (3+2+1+1 = 7 Items) -->
    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-xs text-slate-300 font-mono py-2">
      <span class="flex items-center gap-1.5"><span class="text-[#c46849]">✦</span> 3 Studi Kasus</span>
      <span class="flex items-center gap-1.5"><span class="text-[#c46849]">✦</span> 2 Bedah Material</span>
      <span class="flex items-center gap-1.5"><span class="text-[#c46849]">✦</span> 1 Detail Spasial</span>
      <span class="flex items-center gap-1.5"><span class="text-[#c46849]">✦</span> 1 Wawasan Tropis</span>
    </div>

    <!-- Subscription Form -->
    <form id="newsletter-form" class="mt-4 flex flex-col sm:flex-row items-center justify-center gap-3 max-w-md mx-auto">
      <input
        type="email"
        id="newsletter-email"
        placeholder="Alamat email Anda..."
        required
        class="w-full sm:flex-1 rounded-2xl bg-white/10 border border-white/20 px-4 py-3.5 text-xs sm:text-sm text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#c46849] shadow-inner transition"
      />
      <button
        type="submit"
        id="newsletter-btn"
        class="w-full sm:w-auto rounded-2xl bg-[#c46849] hover:bg-[#a85336] text-white font-bold px-6 py-3.5 text-xs sm:text-sm transition shadow-lg shadow-[#c46849]/25 whitespace-nowrap"
      >
        Berlangganan Gratis
      </button>
    </form>

    <div id="newsletter-msg" class="hidden text-xs font-semibold pt-2 transition"></div>

    <p class="text-[11px] font-mono text-slate-500 pt-2">
      Bebas spam. Berhenti berlangganan kapan saja dalam satu klik.
    </p>
  </div>
</div>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  const emailInput = document.getElementById('newsletter-email') as HTMLInputElement;
  const btn = document.getElementById('newsletter-btn') as HTMLButtonElement;
  const msg = document.getElementById('newsletter-msg') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!emailInput || !btn || !msg) return;

    const email = emailInput.value.trim();
    if (!email) return;

    btn.disabled = true;
    btn.innerText = 'Mendaftarkan...';
    msg.classList.add('hidden');

    try {
      const res = await fetch('/api/newsletter/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, source: 'homepage_weekly' })
      });
      const data = await res.json();

      if (res.ok) {
        msg.innerText = data.message || 'Terima kasih! Anda telah terdaftar di RancangLoka Weekly.';
        msg.className = 'text-xs font-semibold pt-2 text-emerald-400 block';
        emailInput.value = '';
      } else {
        msg.innerText = data.error || 'Terjadi kesalahan.';
        msg.className = 'text-xs font-semibold pt-2 text-red-400 block';
      }
    } catch (err) {
      msg.innerText = 'Terjadi kesalahan koneksi.';
      msg.className = 'text-xs font-semibold pt-2 text-red-400 block';
    } finally {
      btn.disabled = false;
      btn.innerText = 'Kirim ke Inbox Saya →';
    }
  });
</script>
