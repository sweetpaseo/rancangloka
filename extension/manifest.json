{
  "manifest_version": 3,
  "name": "LokaMedia Extension",
  "version": "1.0.0",
  "description": "Operator companion extension connecting manual image generation directly to RancangLoka LokaMedia Foundation.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LokaMedia"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:4321/*",
    "http://127.0.0.1:4321/*",
    "https://*.workers.dev/*",
    "https://rancangloka.com/*"
  ]
}
