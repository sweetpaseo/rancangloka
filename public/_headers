# Cloudflare Static Assets Header Rules (Task 2: Content-Addressed Immutability)

# 1. Truly immutable, content-hashed Vite JS/CSS bundles
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 1a. Truly immutable, self-hosted typography fonts
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# 2. Truly immutable, SHA-256 content-addressed media image variants
/media/images/*
  Cache-Control: public, max-age=31536000, immutable

# 3. Named static room images (changeable in place, 1-week revalidation)
/media/rooms/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# 4. Standard public root assets (favicon, robots, sitemap)
/favicon.svg
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=3600
